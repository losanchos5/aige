---
// Doc: the reading layout for the Manifesto, the Body of Knowledge and the meta
// pages. Wraps Base and lays out a chapter rail, the prose well and an
// on-this-page TOC — three columns ≥1100px, two ≥840px, one below with the
// rail as an off-canvas drawer. All behaviour lives in /ui-doc.js (CSP-safe).
// The search dialog now lives in Base, so it is available on every page.
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import { site } from '../data/site';
import ChapterHeader from '../components/ChapterHeader.astro';
import SidebarNav from '../components/SidebarNav.astro';
import Toc from '../components/Toc.astro';
import PrevNext from '../components/PrevNext.astro';
import EditOnGitHub from '../components/EditOnGitHub.astro';
import Citation from '../components/Citation.astro';
import { getChapterBySlug } from '../data/chapters';
import { readSource } from '../lib/md-parse';
import { wordCount, readingTime } from '../lib/reading';

interface Adjacent {
  slug: string;
  shortTitle: string;
}

interface Props {
  title: string;
  summary?: string;
  kicker?: string;
  headings?: MarkdownHeading[];
  prev?: Adjacent;
  next?: Adjacent;
  editPath?: string;
  slug?: string;
  updated?: string;
  sidebar?: boolean;
  wide?: boolean;
  activeSlug?: string;
  activeManifesto?: boolean;
  cite?: boolean;
  image?: string;
}

const {
  title,
  summary,
  kicker,
  headings = [],
  prev,
  next,
  editPath,
  slug,
  updated,
  sidebar = true,
  wide = false,
  activeSlug,
  activeManifesto = false,
  cite = false,
  image,
} = Astro.props;

const withSidebar = sidebar && !wide;
const withToc = !wide && headings.some((h) => h.depth === 2 || h.depth === 3);
const mode = wide ? 'wide' : withSidebar ? 'chapter' : 'doc';
const pageTitle = `${title} · ${site.name}`;

// Reading estimate for BoK chapters, from the raw Markdown (reading.ts). Only
// computed when the slug is a known chapter; other Doc pages get no estimate.
let words: number | undefined;
let minutes: number | undefined;
const statsChapter = slug ? getChapterBySlug(slug) : undefined;
if (statsChapter) {
  try {
    const markdown = readSource(`bok/${statsChapter.id}.md`);
    words = wordCount(markdown);
    minutes = readingTime(markdown);
  } catch {
    // Source unreadable (e.g. a shallow checkout); skip the estimate silently.
  }
}
---

<Base title={pageTitle} description={summary} image={image}>
  <div class="doc-progress" data-doc-progress aria-hidden="true"></div>

  <div class="doc container" data-mode={mode}>
    {
      withSidebar && (
        <div class="doc-drawerbar">
          <button
            type="button"
            class="drawer-btn"
            data-drawer-open
            aria-expanded="false"
            aria-controls="doc-sidebar"
          >
            Chapters
          </button>
          <button type="button" class="drawer-btn" data-search-open>
            Search
          </button>
        </div>
      )
    }

    <div class="doc-layout">
      {
        withSidebar && (
          <aside id="doc-sidebar" class="doc-sidebar" data-pagefind-ignore>
            <SidebarNav activeSlug={activeSlug} activeManifesto={activeManifesto} />
          </aside>
        )
      }

      <div class="doc-main">
        <article class="prose" data-pagefind-body>
          <ChapterHeader
            kicker={kicker}
            title={title}
            summary={summary}
            updated={updated}
            words={words}
            minutes={minutes}
          />
          <slot />
        </article>

        {
          (editPath || (cite && slug)) && (
            <footer class="doc-foot">
              {editPath && <EditOnGitHub path={editPath} />}
              {cite && slug && <Citation title={title} slug={slug} />}
            </footer>
          )
        }

        {(prev || next) && <PrevNext prev={prev} next={next} />}
      </div>

      {
        withToc && (
          <aside class="doc-toc" data-pagefind-ignore>
            <Toc headings={headings} />
          </aside>
        )
      }
    </div>
  </div>

  {withSidebar && <div class="doc-scrim" data-drawer-close hidden />}

  <script is:inline src="/ui-doc.js" defer></script>
  <script is:inline src="/glossary-cards.js" defer></script>
</Base>

<style>
  /* Per-page reading hairline: pinned just under the sticky header (ui-doc.js
     sets `top` to the header height) and scaled on scroll to the read fraction. */
  .doc-progress {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 19;
    width: 100%;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
    pointer-events: none;
  }

  .doc {
    padding-block: var(--s-6) var(--s-8);
  }

  .doc-drawerbar {
    display: flex;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }

  .drawer-btn {
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .drawer-btn:hover {
    border-color: var(--ink-2);
  }

  .doc-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
  }

  .doc-main {
    min-width: 0;
    max-width: 72ch;
    margin-inline: auto;
  }

  .doc-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  /* On-this-page: only from 1100px up. */
  .doc-toc {
    display: none;
  }

  /* Chapter rail: off-canvas drawer below 840px. */
  .doc-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 40;
    width: min(320px, 86vw);
    padding: var(--s-6) var(--s-5);
    background: var(--bg);
    border-right: 1px solid var(--line);
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform var(--dur) var(--ease);
  }

  .doc-sidebar.is-open {
    transform: none;
  }

  .doc-scrim {
    position: fixed;
    inset: 0;
    z-index: 39;
    background: rgba(0, 0, 0, 0.4);
  }

  @media (min-width: 840px) {
    .doc-drawerbar {
      display: none;
    }

    .doc-sidebar {
      position: sticky;
      top: var(--s-6);
      inset: auto;
      z-index: auto;
      width: auto;
      max-height: calc(100dvh - var(--s-7));
      padding: 0;
      background: none;
      border-right: 0;
      transform: none;
    }

    .doc-scrim {
      display: none;
    }

    [data-mode='chapter'] .doc-layout {
      grid-template-columns: 240px minmax(0, 1fr);
    }

    /* With a chapter rail the well fills its column instead of re-centring a
       72ch cap inside it: when the rail leaves less than 72ch, the auto margins
       otherwise let the well overflow its track and push a horizontal scrollbar.
       The single-column doc mode keeps its centred cap until the TOC appears. */
    [data-mode='chapter'] .doc-main {
      max-width: none;
      margin-inline: 0;
    }
  }

  @media (min-width: 1100px) {
    .doc-toc {
      display: block;
    }

    [data-mode='chapter'] .doc-layout {
      grid-template-columns: 260px minmax(0, 72ch) 220px;
      justify-content: center;
    }

    [data-mode='doc'] .doc-layout {
      grid-template-columns: minmax(0, 72ch) 220px;
      justify-content: center;
    }

    /* The doc mode gains its TOC rail here, so its well now fills the 72ch
       track too (the chapter well already does, from 840px up). The 72ch cap +
       auto margins resolve against the well's own font — wider than the space
       the rails leave for the track — so left in place they let the well spill
       past the track and under the "On this page" TOC. */
    [data-mode='doc'] .doc-main {
      max-width: none;
      margin-inline: 0;
    }
  }
</style>
