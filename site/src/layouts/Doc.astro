---
// Doc: the reading layout for the Thesis, the Body of Knowledge and the meta
// pages. Wraps Base. With the rail (`sidebar`, the default) it lays out three
// columns ≥1280px (the rail, a 44rem reading column, the on-this-page TOC with
// the cite card), two ≥840px (the TOC folds into a disclosure under the
// header) and one below, with the rail as an off-canvas drawer. The rail lists
// the book's parts, or one nav.ts group (`navGroup`). Without the rail the
// page keeps the wide well with a TOC column ≥1100px (index and tool pages).
// All behaviour lives in /ui-doc.js (CSP-safe). The search dialog lives in
// Base, so it is available on every page.
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import '../styles/reading.css';
import Breadcrumb from '../components/Breadcrumb.astro';
import { breadcrumbJsonLd, type Crumb } from '../lib/breadcrumbs';
import type { JsonLdInput } from '../lib/jsonld';
import ChapterHeader from '../components/ChapterHeader.astro';
import SidebarNav from '../components/SidebarNav.astro';
import Toc from '../components/Toc.astro';
import PrevNext from '../components/PrevNext.astro';
import EditOnGitHub from '../components/EditOnGitHub.astro';
import Citation from '../components/Citation.astro';
import { getChapterBySlug } from '../data/chapters';
import { nav, type NavGroup } from '../data/nav';
import { readSource } from '../lib/md-parse';
import { fitsSiteSuffix } from '../lib/seo-title';
import { wordCount, readingTime } from '../lib/reading';
import { translator } from '../i18n/ui';
import { LOCALE_INFO, isLocale } from '../i18n/locales';

interface Adjacent {
  slug: string;
  shortTitle: string;
}

interface Props {
  title: string;
  /** The document title (<title>, og:title) when it should differ from the
      visible H1: a chapter's search-phrased `seoTitle`. The site-name suffix is
      kept only when it fits (lib/seo-title.ts). */
  seoTitle?: string;
  summary?: string;
  /** Meta description; defaults to `summary`. A chapter passes the manifest's
      trimmed summary here, because its visible lede is the full blockquote and
      runs past the ~160 characters a search snippet shows. */
  description?: string;
  /** Breadcrumb trail rendered above the chapter header (parent crumbs only;
      Home is prepended in the JSON-LD). */
  crumbs?: Crumb[];
  /** Add the BreadcrumbList for `crumbs` to the page graph (default true).
      Pages whose own graph already carries one pass false to avoid a duplicate. */
  crumbsJsonLd?: boolean;
  headings?: MarkdownHeading[];
  prev?: Adjacent;
  next?: Adjacent;
  editPath?: string;
  slug?: string;
  updated?: string;
  sidebar?: boolean;
  wide?: boolean;
  activeSlug?: string;
  activeThesis?: boolean;
  cite?: boolean;
  image?: string;
  /** og:image:alt when the shared card's own title is in another language; see Seo. */
  imageAlt?: string;
  jsonLd?: JsonLdInput;
  lang?: string;
  locale?: string;
  alternates?: { hreflang: string; href: string }[];
  /** Open Graph `article:*` metadata; set by the dated long reads (chapters,
      the two Thesis translations). See components/Seo.astro. */
  article?: { publishedTime?: string; modifiedTime?: string; author?: string };
  /** The Markdown the reading estimate counts, when it is not the English
      chapter file (a translated chapter passes its own body). */
  markdown?: string;
  /** Where the pager's chapters live (default `/bok`; `/de/bok` on a German page). */
  pagerBase?: string;
  /** The URL the cite box cites, when it is not `/bok/<slug>` (a translation). */
  citeUrl?: string;
  /** Chapter rail links that go to a translation instead of the English page,
      keyed by chapter slug (label in the page's language). */
  sidebarLinks?: Record<string, { href: string; label: string }>;
  /** The rail's Thesis link (default /thesis). */
  thesisHref?: string;
  /** Show the site's BoK version in the header's meta line (default true);
      see ChapterHeader. */
  siteVersion?: boolean;
  /** Fill the rail with this nav.ts group instead of the book's parts. */
  navGroup?: NavGroup['id'];
}

const {
  title,
  seoTitle,
  summary,
  description,
  crumbs,
  crumbsJsonLd = true,
  headings = [],
  prev,
  next,
  editPath,
  slug,
  updated,
  sidebar = true,
  wide = false,
  activeSlug,
  activeThesis = false,
  cite = false,
  image,
  imageAlt,
  jsonLd,
  lang,
  locale,
  alternates,
  article,
  markdown: markdownProp,
  pagerBase,
  citeUrl,
  sidebarLinks,
  thesisHref,
  siteVersion = true,
  navGroup,
} = Astro.props;
const t = translator(lang);
// Open Graph locale: given, or the page language's (English pages keep Seo's default).
const ogLocale = locale ?? (isLocale(lang) && lang !== 'en' ? LOCALE_INFO[lang].og : undefined);

const withSidebar = sidebar && !wide;
const withToc = !wide && headings.some((h) => h.depth === 2 || h.depth === 3);
const withCite = cite && Boolean(slug);
const mode = wide ? 'wide' : withSidebar ? 'chapter' : 'doc';
// The drawer button names what the rail holds: the book's chapters or the group.
const railLabel = navGroup ? nav.find((g) => g.id === navGroup)?.label : t('doc.chapters');

// The page's own nodes plus, unless the page already carries one, the
// BreadcrumbList for the visible trail. Seo.astro merges these into the single
// site graph in the head, so <Breadcrumb> never emits a script of its own.
const graphNodes = [
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ...(crumbs && crumbsJsonLd ? [breadcrumbJsonLd(crumbs)] : []),
];

// Reading estimate for BoK chapters, from the raw Markdown (reading.ts). Only
// computed when the slug is a known chapter; other Doc pages get no estimate.
let words: number | undefined;
let minutes: number | undefined;
const statsChapter = slug ? getChapterBySlug(slug) : undefined;
// A layer colour means that layer and nothing else (audit SL-06): the crumb
// square takes a layer's colour only when the chapter is about one stack layer
// (chapters.ts `layer`).
const headerLayer = statsChapter?.layer ? `l${statsChapter.layer}` : undefined;
if (statsChapter) {
  try {
    const markdown = markdownProp ?? readSource(`bok/${statsChapter.id}.md`);
    words = wordCount(markdown);
    minutes = readingTime(markdown);
  } catch {
    // Source unreadable (e.g. a shallow checkout); skip the estimate silently.
  }
}
---

<Base
  title={seoTitle ?? title}
  titleSuffix={seoTitle ? fitsSiteSuffix(seoTitle) : undefined}
  description={description ?? summary}
  image={image}
  imageAlt={imageAlt}
  jsonLd={graphNodes.length ? graphNodes : undefined}
  lang={lang}
  locale={ogLocale}
  alternates={alternates}
  article={article}
>
  <div class="doc-progress" data-doc-progress aria-hidden="true"></div>

  <div class="doc container" data-mode={mode}>
    {
      withSidebar && (
        <div class="doc-drawerbar">
          <button
            type="button"
            class="drawer-btn"
            data-drawer-open
            aria-expanded="false"
            aria-controls="doc-sidebar"
          >
            {railLabel}
          </button>
          <button
            type="button"
            class="drawer-btn"
            data-search-open
            data-umami-event="search-open"
            data-umami-event-location="doc-drawer"
          >
            {t('doc.search')}
          </button>
        </div>
      )
    }

    <div class="doc-layout">
      {
        withSidebar && (
          <div id="doc-sidebar" class="doc-sidebar" data-pagefind-ignore>
            <SidebarNav
              activeSlug={activeSlug}
              activeThesis={activeThesis}
              lang={lang}
              links={sidebarLinks}
              thesisHref={thesisHref}
              group={navGroup}
            />
          </div>
        )
      }

      <div class="doc-main">
        {
          crumbs && (
            <div class="doc-crumbs" data-pagefind-ignore>
              <Breadcrumb
                items={crumbs}
                lang={lang}
                swatch={headerLayer ? `var(--${headerLayer})` : undefined}
              />
            </div>
          )
        }

        <article class="prose" data-pagefind-body>
          <ChapterHeader
            title={title}
            summary={summary}
            updated={updated}
            words={words}
            minutes={minutes}
            chapterSlug={statsChapter?.slug}
            lang={lang}
            siteVersion={siteVersion}
          >
            {/* The compact on-this-page list for the widths without the TOC
                column, under the header's meta line. It carries data-nosnippet
                so a crawler never quotes the navigation as chapter text. */}
            {
              withToc && (
                <details
                  class="doc-toc-m"
                  data-toc-mobile
                  data-pagefind-ignore
                  data-nosnippet
                  slot="toc"
                >
                  <summary>{t('doc.onThisPage')}</summary>
                  <ol>
                    {headings
                      .filter((h) => h.depth === 2 || h.depth === 3)
                      .map((h) => (
                        <li class={`toc-m-h${h.depth}`}>
                          <a href={`#${h.slug}`}>{h.text}</a>
                        </li>
                      ))}
                  </ol>
                </details>
              )
            }
          </ChapterHeader>
          <slot />
        </article>

        {
          editPath && (
            <footer class="doc-foot">
              <EditOnGitHub path={editPath} lang={lang} />
            </footer>
          )
        }

        {(prev || next) && <PrevNext prev={prev} next={next} base={pagerBase} lang={lang} />}
      </div>

      {/* The right column: the TOC and the cite card. Below the column's
          breakpoint it dissolves (display: contents): the TOC hides, since the
          disclosure in the header takes over, and the cite card falls under
          the article in the reading column. */}
      {
        (withToc || withCite) && (
          <aside class="doc-toc" aria-label={t('doc.onThisPage')} data-pagefind-ignore data-nosnippet>
            {withToc && <Toc headings={headings} lang={lang} />}
            {withCite && (
              <Citation
                title={title}
                slug={slug}
                url={citeUrl}
                kind={citeUrl ? 'chapter' : undefined}
                lang={lang}
                card
              />
            )}
          </aside>
        )
      }
    </div>
  </div>

  {/* Full-width bands after the reading layout (a closing band with the
      related links and the sign-up): outside the grid, so they span the page. */}
  <slot name="after" />

  {withSidebar && <div class="doc-scrim" data-drawer-close hidden />}

  <script is:inline src="/inert.js" defer></script>
  <script is:inline src="/ui-doc.js" defer></script>
  <script is:inline src="/glossary-cards.js" defer></script>

  {/* Diagram behaviour, loaded once per page. A <Diagram> component (Base /
      Marketing pages) may have already emitted this via the same locals flag;
      here it covers chapter figures injected by rehype-diagrams and the
      thesis. The file is tiny and no-ops when the page has no figures. */}
  {
    !Astro.locals.diagramScript &&
      (Astro.locals.diagramScript = true) && (
        <script is:inline src="/diagram.js" defer></script>
      )
  }
</Base>

<style>
  /* Per-page reading progress: a flat 2px accent bar pinned just under the
     sticky header (ui-doc.js sets `top` to the header height) and scaled on
     scroll to the read fraction. */
  .doc-progress {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 19;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
    pointer-events: none;
  }

  /* Where the browser supports a scroll-progress timeline, drive the fill in CSS
     off the root scroller. ui-doc.js detects the same support and stops writing
     style.transform, so the two never fight; v4.spec still reads a computed
     scaleX near 1 at the foot of the page. */
  @supports (animation-timeline: scroll()) {
    .doc-progress {
      animation: doc-progress-grow linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes doc-progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .doc {
    padding-block: var(--s-6) var(--s-8);
  }

  .doc-drawerbar {
    display: flex;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }

  .drawer-btn {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-ctl);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
  }

  .drawer-btn:hover {
    border-color: var(--ink-2);
  }

  .doc-layout {
    /* Max width of the wide well of the pages without a rail (index and tool
       pages); the prose stays at 72ch inside it. */
    --doc-well: min(1100px, 100%);
    /* Where the sticky TOC of those pages settles: just under the sticky site
       header, like the in-page anchors. */
    --doc-rail-top: calc(var(--anchor-offset) + var(--s-3));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  /* Breadcrumb trail above the chapter header (chapters and About sub-pages). */
  .doc-crumbs {
    margin-bottom: var(--s-5);
  }

  .doc-main {
    min-width: 0;
    /* Query container for the figures. It always stretches to fill its grid
       track: the measure is capped inside, because auto margins on a
       size-contained box collapse it to zero width. */
    container-type: inline-size;
  }

  .doc-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    max-width: 72ch;
    margin-top: var(--s-7);
    margin-inline: auto;
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .doc-main :global(.pager) {
    max-width: 72ch;
    margin-inline: auto;
  }

  /* The right column dissolves below its breakpoint: the TOC hides and the
     cite card becomes a block in the reading column, after the article. */
  .doc-toc {
    display: contents;
  }

  .doc-toc :global(nav.toc) {
    display: none;
  }

  .doc-toc :global(.cite-wrap) {
    grid-column: -2 / -1;
    min-width: 0;
  }

  /* Compact, collapsible on-this-page in the header, for the widths without
     the TOC column. */
  .doc-toc-m {
    margin: 28px 0 0;
    border: 1px solid var(--line);
    border-radius: var(--r-blk);
    background: var(--panel);
  }

  /* Phones: the tighter header stack (ChapterHeader) keeps the lede and the
     glossary's A-Z row inside the first screen. */
  @media (max-width: 639px) {
    .doc-toc-m {
      margin-top: 16px;
    }
  }

  .doc-toc-m > summary {
    padding: 12px 16px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .doc-toc-m > summary::-webkit-details-marker {
    display: none;
  }

  .doc-toc-m ol {
    list-style: none;
    margin: 0 16px 14px;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .doc-toc-m li {
    margin: 0;
  }

  .doc-toc-m a {
    display: block;
    padding: 5px 0 5px 12px;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--ink-2);
    text-decoration: none;
  }

  .doc-toc-m a:hover {
    color: var(--ink);
  }

  .doc-toc-m .toc-m-h3 a {
    padding-left: 28px;
    font-size: 0.8125rem;
  }

  /* Rail: off-canvas drawer below 840px. Closed, it is also visibility:
     hidden, so its links leave the tab order and the accessibility tree
     instead of sitting off-screen as invisible tab stops. The hide waits one
     transition so the slide-out still plays. */
  .doc-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 40;
    width: min(320px, 88vw);
    padding: 20px 20px 48px;
    background: var(--bg);
    border-right: 1px solid var(--line);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(-102%);
    visibility: hidden;
  }

  .doc-sidebar.is-open {
    transform: none;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .doc-sidebar {
      transition:
        transform 240ms var(--ease),
        visibility 0s linear 240ms;
    }

    .doc-sidebar.is-open {
      transition:
        transform 240ms var(--ease),
        visibility 0s;
    }
  }

  .doc-scrim {
    position: fixed;
    inset: 0;
    z-index: 39;
    background: rgb(10 12 15 / 0.45);
  }

  /* ---- With the rail (chapter mode): the reading grid ---- */
  .doc[data-mode='chapter'] {
    padding-top: var(--s-5);
  }

  /* The column is the measure: prose, footer and pager fill it. */
  .doc[data-mode='chapter'] .doc-main :global(.prose),
  .doc[data-mode='chapter'] .doc-foot,
  .doc[data-mode='chapter'] .doc-main :global(.pager) {
    max-width: none;
  }

  @media (min-width: 840px) {
    .doc-drawerbar {
      display: none;
    }

    .doc[data-mode='chapter'] {
      padding-top: 0;
    }

    .doc[data-mode='chapter'] .doc-main {
      padding-top: 32px;
    }

    /* `inset` goes before `top`: written after it, it reset `top` to auto and
       the rail scrolled away with the page instead of sticking. */
    .doc-sidebar {
      position: sticky;
      inset: auto;
      top: var(--header-h);
      z-index: auto;
      width: auto;
      max-height: calc(100dvh - var(--header-h));
      padding: 28px 20px 48px 0;
      background: none;
      transform: none;
      visibility: visible;
      transition: none;
    }

    .doc-scrim {
      display: none;
    }

    [data-mode='chapter'] .doc-layout {
      grid-template-columns: 260px minmax(0, 44rem);
      justify-content: center;
    }
  }

  @media (min-width: 1024px) {
    .doc[data-mode='chapter'] .doc-main {
      padding-top: 48px;
    }
  }

  @media (min-width: 1280px) {
    /* Grow the container past the 1200px site width so the three columns fit
       at their full widths; the site header stays at 1200px. */
    .doc[data-mode='chapter'] {
      max-width: calc(280px + 44rem + 13rem + 5rem + 2 * var(--s-6));
      padding-inline: var(--s-6);
    }

    [data-mode='chapter'] .doc-layout {
      grid-template-columns: 280px minmax(0, 44rem) 13rem;
    }

    [data-mode='chapter'] .doc-toc {
      display: block;
      position: sticky;
      top: var(--header-h);
      align-self: start;
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      padding: 52px var(--s-1) var(--s-5);
    }

    [data-mode='chapter'] .doc-toc :global(nav.toc) {
      display: block;
    }

    [data-mode='chapter'] .doc-toc :global(nav.toc + .cite-wrap) {
      margin-top: var(--s-6);
    }

    [data-mode='chapter'] .doc-toc-m {
      display: none;
    }
  }

  /* ---- Without the rail (doc and wide modes): the wide well ---- */
  @media (min-width: 1100px) {
    [data-mode='doc'] .doc-toc {
      display: block;
      position: sticky;
      top: var(--doc-rail-top);
      align-self: start;
      max-height: calc(100dvh - var(--doc-rail-top) - var(--s-5));
      overflow-y: auto;
      padding: 0 var(--s-2) var(--s-2);
    }

    [data-mode='doc'] .doc-toc :global(nav.toc) {
      display: block;
    }

    [data-mode='doc'] .doc-toc :global(nav.toc + .cite-wrap) {
      margin-top: var(--s-6);
    }

    [data-mode='doc'] .doc-toc-m {
      display: none;
    }

    .doc:not([data-mode='chapter']) {
      max-width: 1440px;
    }

    [data-mode='doc'] .doc-layout {
      grid-template-columns: minmax(0, var(--doc-well)) 220px;
      justify-content: center;
    }

    /* Wide pages have no rails: the single track carries the well, centred,
       and the prose still holds at 72ch inside it. */
    [data-mode='wide'] .doc-layout {
      grid-template-columns: minmax(0, var(--doc-well));
      justify-content: center;
    }
  }

  @media (min-width: 1600px) {
    .doc:not([data-mode='chapter']) {
      max-width: 1680px;
    }

    .doc:not([data-mode='chapter']) .doc-layout {
      --doc-well: min(1300px, 100%);
    }
  }
</style>
