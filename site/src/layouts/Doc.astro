---
// Doc: the reading layout for the Thesis, the Body of Knowledge and the meta
// pages. Wraps Base and lays out a chapter rail, the prose well and an
// on-this-page TOC — three columns ≥1100px, two ≥840px, one below with the
// rail as an off-canvas drawer. All behaviour lives in /ui-doc.js (CSP-safe).
// The search dialog now lives in Base, so it is available on every page.
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { breadcrumbJsonLd, type Crumb } from '../lib/breadcrumbs';
import type { JsonLdInput } from '../lib/jsonld';
import ChapterHeader from '../components/ChapterHeader.astro';
import SidebarNav from '../components/SidebarNav.astro';
import Toc from '../components/Toc.astro';
import PrevNext from '../components/PrevNext.astro';
import EditOnGitHub from '../components/EditOnGitHub.astro';
import Citation from '../components/Citation.astro';
import { getChapterBySlug } from '../data/chapters';
import { readSource } from '../lib/md-parse';
import { wordCount, readingTime } from '../lib/reading';

interface Adjacent {
  slug: string;
  shortTitle: string;
}

interface Props {
  title: string;
  summary?: string;
  /** Meta description; defaults to `summary`. A chapter passes the manifest's
      trimmed summary here, because its visible lede is the full blockquote and
      runs past the ~160 characters a search snippet shows. */
  description?: string;
  kicker?: string;
  /** Breadcrumb trail rendered above the chapter header (parent crumbs only;
      Home is prepended in the JSON-LD). */
  crumbs?: Crumb[];
  /** Add the BreadcrumbList for `crumbs` to the page graph (default true).
      Pages whose own graph already carries one pass false to avoid a duplicate. */
  crumbsJsonLd?: boolean;
  headings?: MarkdownHeading[];
  prev?: Adjacent;
  next?: Adjacent;
  editPath?: string;
  slug?: string;
  updated?: string;
  sidebar?: boolean;
  wide?: boolean;
  activeSlug?: string;
  activeThesis?: boolean;
  cite?: boolean;
  image?: string;
  jsonLd?: JsonLdInput;
  lang?: string;
  locale?: string;
  alternates?: { hreflang: string; href: string }[];
  /** Open Graph `article:*` metadata; set by the dated long reads (chapters,
      the two Thesis translations). See components/Seo.astro. */
  article?: { publishedTime?: string; modifiedTime?: string; author?: string };
}

const {
  title,
  summary,
  description,
  kicker,
  crumbs,
  crumbsJsonLd = true,
  headings = [],
  prev,
  next,
  editPath,
  slug,
  updated,
  sidebar = true,
  wide = false,
  activeSlug,
  activeThesis = false,
  cite = false,
  image,
  jsonLd,
  lang,
  locale,
  alternates,
  article,
} = Astro.props;

const withSidebar = sidebar && !wide;
const withToc = !wide && headings.some((h) => h.depth === 2 || h.depth === 3);
const mode = wide ? 'wide' : withSidebar ? 'chapter' : 'doc';

// The page's own nodes plus, unless the page already carries one, the
// BreadcrumbList for the visible trail. Seo.astro merges these into the single
// site graph in the head, so <Breadcrumb> never emits a script of its own.
const graphNodes = [
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ...(crumbs && crumbsJsonLd ? [breadcrumbJsonLd(crumbs)] : []),
];

// Reading estimate for BoK chapters, from the raw Markdown (reading.ts). Only
// computed when the slug is a known chapter; other Doc pages get no estimate.
let words: number | undefined;
let minutes: number | undefined;
const statsChapter = slug ? getChapterBySlug(slug) : undefined;
// Layer tint for the ChapterHeader band: chapter.order % 5 (the same rotation
// SidebarNav uses). Thesis / meta pages are not chapters → no layer → neutral.
const headerLayers = ['l1', 'l2', 'l3', 'l4', 'l5'];
const headerLayer = statsChapter
  ? headerLayers[statsChapter.order % headerLayers.length]
  : undefined;
// The same layer's ink colours the reading chrome (prose.css reads it for the
// h2 dash). Set on the layout root so the prose and both rails inherit it; pages
// without a layer leave it unset and the consumers fall back to --l1-ink.
const chapterInk = headerLayer ? `--chapter-ink: var(--${headerLayer}-ink)` : undefined;
if (statsChapter) {
  try {
    const markdown = readSource(`bok/${statsChapter.id}.md`);
    words = wordCount(markdown);
    minutes = readingTime(markdown);
  } catch {
    // Source unreadable (e.g. a shallow checkout); skip the estimate silently.
  }
}
---

<Base
  title={title}
  description={description ?? summary}
  image={image}
  jsonLd={graphNodes.length ? graphNodes : undefined}
  lang={lang}
  locale={locale}
  alternates={alternates}
  article={article}
>
  <div class="doc-progress" data-doc-progress aria-hidden="true"></div>

  <div class="doc container" data-mode={mode} style={chapterInk}>
    {
      withSidebar && (
        <div class="doc-drawerbar">
          <button
            type="button"
            class="drawer-btn"
            data-drawer-open
            aria-expanded="false"
            aria-controls="doc-sidebar"
          >
            Chapters
          </button>
          <button type="button" class="drawer-btn" data-search-open>
            Search
          </button>
        </div>
      )
    }

    <div class="doc-layout">
      {
        withSidebar && (
          <aside id="doc-sidebar" class="doc-sidebar" aria-label="Chapters" data-pagefind-ignore>
            <SidebarNav activeSlug={activeSlug} activeThesis={activeThesis} />
          </aside>
        )
      }

      <div class="doc-main">
        {
          crumbs && (
            <div class="doc-crumbs" data-pagefind-ignore>
              <Breadcrumb
                items={crumbs}
                swatch={headerLayer ? `var(--${headerLayer})` : undefined}
              />
            </div>
          )
        }
        {/* The compact on-this-page list precedes the <h1> in the source order,
            so it carries data-nosnippet: a crawler must not open a chapter's
            search snippet with its navigation. The position is deliberate (the
            layout puts it above the prose on narrow viewports), so the markup
            itself is not moved. */}
        {
          withToc && (
            <details class="doc-toc-m" data-toc-mobile data-pagefind-ignore data-nosnippet>
              <summary>On this page</summary>
              <ul>
                {headings
                  .filter((h) => h.depth === 2 || h.depth === 3)
                  .map((h) => (
                    <li class={`toc-m-h${h.depth}`}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
              </ul>
            </details>
          )
        }

        <article class="prose" data-pagefind-body>
          <ChapterHeader
            kicker={kicker}
            title={title}
            summary={summary}
            updated={updated}
            words={words}
            minutes={minutes}
            layer={headerLayer}
            lang={lang}
          />
          <slot />
        </article>

        {
          (editPath || (cite && slug)) && (
            <footer class="doc-foot">
              {editPath && <EditOnGitHub path={editPath} />}
              {cite && slug && <Citation title={title} slug={slug} />}
            </footer>
          )
        }

        {(prev || next) && <PrevNext prev={prev} next={next} />}
      </div>

      {
        withToc && (
          <aside class="doc-toc" aria-label="On this page" data-pagefind-ignore data-nosnippet>
            <Toc headings={headings} />
          </aside>
        )
      }
    </div>
  </div>

  {withSidebar && <div class="doc-scrim" data-drawer-close hidden />}

  <script is:inline src="/ui-doc.js" defer></script>
  <script is:inline src="/glossary-cards.js" defer></script>

  {/* Diagram behaviour, loaded once per page. A <Diagram> component (Base /
      Marketing pages) may have already emitted this via the same locals flag;
      here it covers chapter figures injected by rehype-diagrams and the
      thesis. The file is tiny and no-ops when the page has no figures. */}
  {
    !Astro.locals.diagramScript &&
      (Astro.locals.diagramScript = true) && (
        <script is:inline src="/diagram.js" defer></script>
      )
  }
</Base>

<style>
  /* Per-page reading hairline: pinned just under the sticky header (ui-doc.js
     sets `top` to the header height) and scaled on scroll to the read fraction. */
  .doc-progress {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 19;
    width: 100%;
    height: 2px;
    background: linear-gradient(to right, var(--l1-ink), var(--l5-ink));
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
    pointer-events: none;
  }

  /* Where the browser supports a scroll-progress timeline, drive the fill in CSS
     off the root scroller. ui-doc.js detects the same support and stops writing
     style.transform, so the two never fight; v4.spec still reads a computed
     scaleX near 1 at the foot of the page. */
  @supports (animation-timeline: scroll()) {
    .doc-progress {
      animation: doc-progress-grow linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes doc-progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .doc {
    padding-block: var(--s-6) var(--s-8);
  }

  .doc-drawerbar {
    display: flex;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }

  .drawer-btn {
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .drawer-btn:hover {
    border-color: var(--ink-2);
  }

  .doc-layout {
    /* Max width of the central reading well on desktop. The prose column stays
       at 72ch inside it; the extra room is what lets a diagram figure break out
       (see .diagram in diagrams.css). Only consumed by the ≥1100px rules. */
    --doc-well: min(1100px, 100%);
    /* Where the sticky rails (chapter sidebar, TOC) settle: just under the
       sticky site header, like the in-page anchors. */
    --doc-rail-top: calc(var(--anchor-offset) + var(--s-3));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
  }

  /* Breadcrumb trail above the chapter header (chapters and About sub-pages). */
  .doc-crumbs {
    margin-bottom: var(--s-5);
  }

  .doc-main {
    min-width: 0;
    /* Query container for the full-bleed diagram breakout: the figure reads the
       well width from here, so the prose can stay narrow while the figure widens.
       .doc-main always stretches to fill its grid track — the 72ch reading
       measure is capped on the prose/footer/pager inside, NOT here, because auto
       margins on a size-contained (container-type) box collapse it to zero width. */
    container-type: inline-size;
  }

  /* The reading chrome (footer, pager) tracks the 72ch prose measure, centred in
     the well, so it does not stretch to the full breakout width on desktop. */
  .doc-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    max-width: 72ch;
    margin-top: var(--s-7);
    margin-inline: auto;
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .doc-main :global(.pager) {
    max-width: 72ch;
    margin-inline: auto;
  }

  /* On-this-page: only from 1100px up. */
  .doc-toc {
    display: none;
  }

  /* Compact, collapsible on-this-page for narrow viewports (below 1100px, where
     the sidebar TOC is hidden). Pure HTML/CSS via <details>; hidden once the
     sticky sidebar TOC takes over. */
  .doc-toc-m {
    margin-bottom: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
  }

  .doc-toc-m > summary {
    padding: var(--s-3) var(--s-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    cursor: pointer;
    list-style: none;
  }

  .doc-toc-m > summary::-webkit-details-marker {
    display: none;
  }

  .doc-toc-m ul {
    list-style: none;
    margin: 0;
    padding: 0 var(--s-4) var(--s-4);
    border-top: 1px solid var(--line);
  }

  .doc-toc-m li {
    margin: 0;
  }

  .doc-toc-m a {
    display: block;
    padding: var(--s-2) 0;
    color: var(--ink-2);
    text-decoration: none;
    line-height: 1.35;
  }

  .doc-toc-m a:hover {
    color: var(--ink);
  }

  .doc-toc-m .toc-m-h3 a {
    padding-left: var(--s-4);
    font-size: 0.9375rem;
  }

  /* Chapter rail: off-canvas drawer below 840px. Closed, it is also
     visibility: hidden, so its links leave the tab order and the accessibility
     tree instead of sitting off-screen as invisible tab stops. The hide waits
     one --dur so the slide-out still plays. */
  .doc-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 40;
    width: min(320px, 86vw);
    padding: var(--s-6) var(--s-5);
    background: var(--bg);
    border-right: 1px solid var(--line);
    overflow-y: auto;
    transform: translateX(-100%);
    visibility: hidden;
  }

  .doc-sidebar.is-open {
    transform: none;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .doc-sidebar {
      transition:
        transform var(--dur) var(--ease),
        visibility 0s linear var(--dur);
    }

    .doc-sidebar.is-open {
      transition:
        transform var(--dur) var(--ease),
        visibility 0s;
    }
  }

  .doc-scrim {
    position: fixed;
    inset: 0;
    z-index: 39;
    background: rgba(0, 0, 0, 0.4);
  }

  @media (min-width: 840px) {
    .doc-drawerbar {
      display: none;
    }

    /* `inset` goes before `top`: written after it, it reset `top` to auto and
       the rail scrolled away with the page instead of sticking. No mask at the
       foot either (it made the last chapter read as dimmed text); the bottom
       padding keeps the last row clear of the edge when the rail scrolls. */
    .doc-sidebar {
      position: sticky;
      inset: auto;
      top: var(--doc-rail-top);
      z-index: auto;
      width: auto;
      max-height: calc(100dvh - var(--doc-rail-top) - var(--s-5));
      padding: 0 0 var(--s-5);
      background: none;
      border-right: 0;
      transform: none;
      visibility: visible;
      transition: none;
    }

    .doc-scrim {
      display: none;
    }

    [data-mode='chapter'] .doc-layout {
      grid-template-columns: 240px minmax(0, 1fr);
    }
  }

  @media (min-width: 1100px) {
    /* The TOC column sticks as a whole (align-self: start keeps the grid item
       at its content height, so it has the whole row to travel). A TOC taller
       than the viewport scrolls inside; the inline padding leaves room for the
       links' focus ring and hover nudge inside that scroll box. */
    .doc-toc {
      display: block;
      position: sticky;
      top: var(--doc-rail-top);
      align-self: start;
      max-height: calc(100dvh - var(--doc-rail-top) - var(--s-5));
      overflow-y: auto;
      padding: 0 var(--s-2) var(--s-2);
    }

    /* The sticky sidebar TOC takes over here. */
    .doc-toc-m {
      display: none;
    }

    /* Grow the reading container past the 1200px site width so the rails leave a
       real well for a full-bleed figure (well ≈ 1440 − 260 − 220 − gaps ≈ 880px
       in chapter mode). The site header stays at 1200px, which is accepted. */
    .doc {
      max-width: 1440px;
    }

    [data-mode='chapter'] .doc-layout {
      grid-template-columns: 260px minmax(0, var(--doc-well)) 220px;
      justify-content: center;
    }

    [data-mode='doc'] .doc-layout {
      grid-template-columns: minmax(0, var(--doc-well)) 220px;
      justify-content: center;
    }

    /* Wide pages (the Thesis) have no rails: the single track carries the well
       and is centred in the container, so .doc-main fills it (stretched, not
       auto-margined — see .doc-main) and the prose still holds at 72ch inside. */
    [data-mode='wide'] .doc-layout {
      grid-template-columns: minmax(0, var(--doc-well));
      justify-content: center;
    }
  }

  /* On large desktops grow container and well once more so a chapter figure
     reaches its natural width (~1200px): 1680 − 260 − 220 − gaps ≈ 1130px. */
  @media (min-width: 1600px) {
    .doc {
      max-width: 1680px;
    }

    .doc-layout {
      --doc-well: min(1300px, 100%);
    }
  }
</style>
