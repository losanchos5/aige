---
/**
 * Marketing: wraps Base for editorial/landing pages. Direct <section> children
 * span full width (each holds its own .container), and a 1px hairline is drawn
 * automatically between adjacent sections. Use the `.full-bleed` utility on a
 * section for a tinted, edge-to-edge band.
 */
import Base from './Base.astro';
import type { PreloadImage } from './Base.astro';
import type { JsonLdInput } from '../lib/jsonld';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Page nodes for the site-wide JSON-LD graph (Seo.astro merges them). */
  jsonLd?: JsonLdInput;
  /** Append ` · {site.name}` to the document title (default true); see Seo. */
  titleSuffix?: boolean;
  /** Passed to Base: the header floats over a full-viewport hero. */
  overlayHeader?: boolean;
  /** Passed to Base: extra fonts to preload. */
  preloadFonts?: string[];
  /** Passed to Base: a hero image to preload. */
  preloadImage?: PreloadImage;
}

const {
  title,
  description,
  image,
  jsonLd,
  titleSuffix,
  overlayHeader,
  preloadFonts,
  preloadImage,
} = Astro.props;
---

<Base
  title={title}
  description={description}
  image={image}
  jsonLd={jsonLd}
  titleSuffix={titleSuffix}
  overlayHeader={overlayHeader}
  preloadFonts={preloadFonts}
  preloadImage={preloadImage}
>
  <div class="marketing">
    <slot />
  </div>
</Base>

<style>
  /* The rule: a 1px line between sections. Sections own their own padding
     (use the .section utility or a component's built-in rhythm). position:
     relative keeps every section a containing block for its positioned
     descendants, including plain <section>s that do not carry .sec. */
  .marketing > :global(section + section) {
    position: relative;
    border-top: 1px solid var(--line);
  }
</style>
