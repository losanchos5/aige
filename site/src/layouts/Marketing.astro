---
/**
 * Marketing — wraps Base for editorial/landing pages. Direct <section> children
 * span full width (each holds its own .container), and a thin, mono-numbered
 * "register rule" is drawn automatically between adjacent sections. Use the
 * `.full-bleed` utility on a section for a tinted, edge-to-edge band.
 */
import Base from './Base.astro';
import type { JsonLdInput } from '../lib/jsonld';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Page nodes for the site-wide JSON-LD graph (Seo.astro merges them). */
  jsonLd?: JsonLdInput;
  /** Append ` · {site.name}` to the document title (default true); see Seo. */
  titleSuffix?: boolean;
}

const { title, description, image, jsonLd, titleSuffix } = Astro.props;
---

<Base
  title={title}
  description={description}
  image={image}
  jsonLd={jsonLd}
  titleSuffix={titleSuffix}
>
  <div class="marketing">
    <slot />
  </div>
</Base>

<style>
  .marketing {
    counter-reset: rule;
  }

  /* The register rule: a 1px line between sections with a running mono number
     aligned to the container's left edge. Sections own their own padding
     (use the .section utility or a component's built-in rhythm). */
  .marketing > :global(section + section) {
    counter-increment: rule;
    position: relative;
    border-top: 1px solid var(--line);
  }

  .marketing > :global(section + section)::before {
    content: counter(rule, decimal-leading-zero);
    position: absolute;
    top: 0;
    left: max(var(--s-4), calc(50% - var(--container) / 2 + var(--s-4)));
    transform: translateY(-50%);
    padding-right: var(--s-3);
    z-index: 2;
    background: var(--sec-bg, var(--bg));
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    /* --ink-2, not --muted: the number sits on the section's own colour
       (--sec-bg), and --muted drops below AA on tinted bands. */
    color: var(--ink-2);
  }
</style>
