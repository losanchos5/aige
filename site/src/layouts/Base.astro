---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/utilities.css';
import '../styles/effects.css';
import '../styles/prose.css';
import '../styles/diagrams.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { site } from '../data/site';
import type { JsonLdInput } from '../lib/jsonld';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
  locale?: string;
  jsonLd?: JsonLdInput;
  alternates?: { hreflang: string; href: string }[];
  /** Append ` · {site.name}` to the document title (default true); see Seo. */
  titleSuffix?: boolean;
  /** Open Graph `article:*` metadata for dated long reads; see Seo. */
  article?: { publishedTime?: string; modifiedTime?: string; author?: string };
}

const {
  title,
  description,
  image,
  lang = 'en',
  locale,
  jsonLd,
  alternates,
  titleSuffix,
  article,
} = Astro.props;

// Cloudflare Web Analytics: only injected when a token is provided at build time
// via PUBLIC_CF_BEACON_TOKEN (a Cloudflare secret). No token → no beacon.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

// Umami (self-hosted, cookieless): only injected when a website id is provided
// at build time via PUBLIC_UMAMI_WEBSITE_ID. No id → no script.
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiSrc = 'https://admin.stocktcg.net/script.js';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Seo
      title={title}
      description={description}
      image={image}
      locale={locale}
      jsonLd={jsonLd}
      alternates={alternates}
      titleSuffix={titleSuffix}
      article={article}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Browser UI tint. The light value is the manifest's `theme_color`; the
        dark value is the --bg token of the dark theme (styles/tokens.css). A
        browser that ignores `media` takes the first, i.e. the manifest colour. */}
    <meta name="theme-color" content="#F6F4EE" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121417" media="(prefers-color-scheme: dark)" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — chapters and releases`}
      href="/rss.xml"
    />

    {/* The site's plain-text summary for language models (src/pages/llms.txt.ts). */}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Apply persisted theme before paint; exposes window.__setTheme. -->
    <script is:inline src="/theme.js"></script>

    {
      cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }

    {
      umamiWebsiteId && (
        <script is:inline defer src={umamiSrc} data-website-id={umamiWebsiteId} />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- Global search dialog: opened by the header's [data-search-open] button
         (and Ctrl/Cmd+K) on every page. Loads Pagefind lazily on first open. -->
    <SearchDialog />

    <!-- Progressive enhancement: theme toggle, reveal-on-scroll, menu. -->
    <script is:inline defer src="/ui.js"></script>
  </body>
</html>
