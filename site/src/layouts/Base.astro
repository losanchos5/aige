---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/utilities.css';
import '../styles/effects.css';
// prose, figures and diagrams CSS are not global: the pages that render them
// import styles/reading.css right after their layout, so the render-blocking
// stylesheet every page shares stays small.
import '../styles/print.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { site } from '../data/site';
import type { JsonLdInput } from '../lib/jsonld';
import { themeScript } from '../lib/theme-script';
import { t } from '../i18n/ui';

/** A responsive image preloaded from the head (href is the fallback). */
export interface PreloadImage {
  href: string;
  srcset?: string;
  sizes?: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** og:image size, type and alt when not a 1200x630 card; see Seo. */
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  imageAlt?: string;
  lang?: string;
  locale?: string;
  jsonLd?: JsonLdInput;
  alternates?: { hreflang: string; href: string }[];
  /** Append ` · {site.name}` to the document title (default true); see Seo. */
  titleSuffix?: boolean;
  /** Open Graph `article:*` metadata for dated long reads; see Seo. */
  article?: { publishedTime?: string; modifiedTime?: string; author?: string };
  /** Emit `<meta name="robots" content="noindex">`; see Seo. */
  noindex?: boolean;
  /** Float the header, transparent, over a full-viewport hero (the home). */
  overlayHeader?: boolean;
  /** Extra /fonts/*.woff2 files this page preloads (the home hero's serif). */
  preloadFonts?: string[];
  /** A hero image this page preloads at high priority (the home hero's painting). */
  preloadImage?: PreloadImage;
  /** Absolute canonical URL when another page holds the canonical text (for
   *  example /resources/reading-list, a filtered view of /bok/reading-list).
   *  Omitted: Seo derives the canonical from the page's own clean URL. */
  canonical?: string;
}

const {
  title,
  description,
  image,
  imageWidth,
  imageHeight,
  imageType,
  imageAlt,
  lang = 'en',
  locale,
  jsonLd,
  alternates,
  titleSuffix,
  article,
  noindex,
  overlayHeader = false,
  preloadFonts = [],
  preloadImage,
  canonical,
} = Astro.props;

// Cloudflare Web Analytics: only injected when a token is provided at build time
// via PUBLIC_CF_BEACON_TOKEN (a Cloudflare secret). No token → no beacon.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

// Umami (self-hosted, cookieless): only injected when a website id is provided
// at build time via PUBLIC_UMAMI_WEBSITE_ID. No id → no script. The tracker
// runs with data-exclude-hash and data-exclude-search: the /toolkit tools keep
// a reader's answers in the URL fragment, and the notice on every tool promises
// that nothing entered leaves the browser, so neither the fragment nor the
// query string is ever sent.
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiSrc = 'https://admin.stocktcg.net/script.js';

// The theme bootstrap, inlined so it costs no request before the stylesheets;
// the CSP allows it by hash (src/lib/theme-script.ts fails the build if the
// hash in public/_headers is stale).
const theme = themeScript();

// The page language drives the chrome's strings (src/i18n/ui.ts) in the
// header, footer and search dialog; the alternates feed the header's language
// switcher, which shows only when the page exists in two languages.
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Seo
      title={title}
      description={description}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      imageType={imageType}
      imageAlt={imageAlt}
      locale={locale}
      jsonLd={jsonLd}
      alternates={alternates}
      titleSuffix={titleSuffix}
      article={article}
      noindex={noindex}
      canonical={canonical}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Browser UI tint. The light value is the manifest's `theme_color`; the
        dark value is the --bg token of the dark theme (styles/tokens.css). A
        browser that ignores `media` takes the first, i.e. the manifest colour. */}
    <meta name="theme-color" content="#F6F4EE" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121417" media="(prefers-color-scheme: dark)" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} · chapters and releases`}
      href="/rss.xml"
    />

    {/* The site's plain-text summary for language models (src/pages/llms.txt.ts). */}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }

    <!-- Both themes are supported; the tokens set color-scheme per theme. -->
    <meta name="color-scheme" content="light dark" />
    <!-- Apply persisted theme before paint; exposes window.__setTheme. Inline
         (src/scripts/theme.js, minified), allowed by its sha256 in the CSP. -->
    <script is:inline set:html={theme.source} />

    {
      cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }

    {
      umamiWebsiteId && (
        <script
          is:inline
          defer
          src={umamiSrc}
          data-website-id={umamiWebsiteId}
          data-exclude-hash="true"
          data-exclude-search="true"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip', lang)}</a>

    <Header overlay={overlayHeader} lang={lang} alternates={alternates} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />

    <!-- Global search dialog: opened by the header's [data-search-open] button
         (and Ctrl/Cmd+K) on every page. Loads Pagefind lazily on first open. -->
    <SearchDialog lang={lang} />

    <!-- Progressive enhancement: theme toggle, reveal-on-scroll, menu. -->
    <script is:inline defer src="/ui.js"></script>

    <!-- Motion API (window.aigeMotion): bundled by Astro into an external
         same-origin module under /_astro/, so the CSP script-src 'self' holds. -->
    <script>
      import '../scripts/motion-ui.ts';
    </script>
  </body>
</html>
