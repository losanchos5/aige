---
/**
 * ComparisonPage: the body of one "<A> vs <B>" page under /resources/crosswalk
 * (SXO-04 of the 2026-09-25 audit). Each page file passes its slug and its own
 * <title> and meta description (literals there, so llms.txt can read them); the
 * rest comes from src/data/comparisons.ts (the answer box, the two questions,
 * the "In short" passage, the FAQ, the "At a glance" facts and their sources)
 * and src/lib/comparisons.ts (the per-topic overlap table, its counts, the
 * obligation and pattern links, the question wording and the sources, all
 * derived from the crosswalk and the obligation register). The Markdown twin
 * (/resources/crosswalk/<slug>.md, lib/llms-corpus.ts comparisonDoc) prints the
 * same pieces. After "Which should you start with?" comes the next step: the
 * pair's one to three toolkit pages (SXO-N-06 of the 2026-09-26 audit).
 *
 * Structured data: a TechArticle and the BreadcrumbList. No FAQPage markup:
 * the questions are ordinary headings.
 */
import Base from '../layouts/Base.astro';
// The "In short" callout is the chapters' summary callout (prose.css), which
// lives in the reading stylesheet; imported right after the layout, as
// reading.css asks.
import '../styles/reading.css';
import PageHero from './PageHero.astro';
import Byline from './Byline.astro';
import Callout from './Callout.astro';
import PillarLink from './PillarLink.astro';
import NextStep from './NextStep.astro';
import Chart from './Chart.astro';
import ComparisonButterfly from './ComparisonButterfly.astro';
import { site } from '../data/site';
import { disclaimer, obligationPath } from '../data/frameworks';
import { crosswalkAsOf } from '../data/crosswalk';
import { stacked100 } from '../lib/charts';
import { patternPath } from '../data/patterns';
import {
  comparisons,
  comparisonBySlug,
  comparisonPath,
  comparisonSourceFiles,
  glance,
  glanceRows,
  type GlanceFacts,
} from '../data/comparisons';
import {
  buildComparison,
  canUseQuestion,
  comparisonSources,
  gapQuestion,
  inShortText,
  levelGloss,
  levelLabel,
  overlapSummary,
  type SideRef,
} from '../lib/comparisons';
import { comparisonOgImage } from '../lib/og-cards';
import { breadcrumbJsonLd } from '../lib/breadcrumbs';
import { authorNodes, authorRefs, lastModified, ORG_ID, WEBSITE_ID } from '../lib/jsonld';
import { gitCreated } from '../lib/reading';
import { fitsSiteSuffix } from '../lib/seo-title';
import '../styles/resources.css';
import '../styles/overlap-marks.css';

interface Props {
  slug: string;
  title: string;
  description: string;
}

const { slug, title, description } = Astro.props;
const def = comparisonBySlug(slug);
if (!def) throw new Error(`ComparisonPage: no comparison "${slug}" in src/data/comparisons.ts`);
const cmp = buildComparison(def);
const { fa, fb, rows, counts } = cmp;
const ga: GlanceFacts | undefined = glance[fa.id];
const gb: GlanceFacts | undefined = glance[fb.id];
if (!ga || !gb) throw new Error(`ComparisonPage: no glance facts for "${ga ? fb.id : fa.id}"`);

const h1 = `${def.aName} vs ${def.bName}`;
const path = comparisonPath(def);
const pageUrl = new URL(path, site.url).href;
const sourceFiles = comparisonSourceFiles(slug);
// Dated like the sitemap (astro.config.ts lists the same files): the newest
// commit across the page, its template and the data it reads.
const updated = lastModified(...sourceFiles);
const published = gitCreated(sourceFiles[0]);

const faq = [...def.faq, gapQuestion(cmp)];
const sources = comparisonSources(cmp);
const inShort = inShortText(cmp);
const ogImage = comparisonOgImage(def);
const others = comparisons.filter((c) => c.slug !== slug);
const crumbs = [
  { label: 'Resources', href: '/resources' },
  { label: 'Crosswalk', href: '/resources/crosswalk' },
  { label: h1 },
];

// How many clauses a cell shows before it points to the full crosswalk row.
const SHOWN = 3;
const topicHref = (id: string) => `/resources/crosswalk#topic-${id}`;
const isLaw = (type: string) => type === 'law';
const instrumentNode = (fw: typeof fa) => ({
  '@type': isLaw(fw.type) ? 'Legislation' : 'CreativeWork',
  name: fw.name,
  ...(fw.url ? { url: fw.url } : {}),
});

const jsonLd = [
  {
    '@type': 'TechArticle',
    '@id': `${pageUrl}#article`,
    headline: title,
    alternativeHeadline: h1,
    description,
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    inLanguage: 'en',
    datePublished: published,
    dateModified: updated,
    image: new URL(ogImage, site.url).href,
    author: [...authorRefs],
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': WEBSITE_ID },
    about: [instrumentNode(fa), instrumentNode(fb)],
    citation: sources.map((s) => s.url),
    ...(site.licenseUrl ? { license: site.licenseUrl } : {}),
  },
  ...authorNodes,
  breadcrumbJsonLd(crumbs),
];

const cellItems = (list: SideRef[]) => list.slice(0, SHOWN);

// The overlap bar beside "In short": the topics either instrument reaches,
// split by overlap level (the counts overlapSummary states), each series in the
// state the butterfly's group swatch repeats. 'figc' mode: reading.css brings
// figures.css. A topic neither reaches stays outside the bar, named in its label.
const partial = counts.both - counts.strong;
const passingNote = (n: number) => (n > 0 ? ` (${n} in passing)` : '');
const barBase = {
  title: 'Topic overlap at a glance',
  desc: `The ${rows.length} crosswalk topics ${def.aName} or ${def.bName} reaches, by overlap level: ${counts.strong} strong, ${partial} partial, ${counts.aOnly} ${def.aName} only and ${counts.bOnly} ${def.bName} only.`,
  source: 'the topic × framework crosswalk',
  asOf: crosswalkAsOf,
  unit: 'share of topics',
  itemHeader: 'Topics',
  series: [
    { label: `Strong: ${counts.strong}` },
    { label: `Partial: ${partial}`, state: 'hatched' as const },
    { label: `${def.aName} only: ${counts.aOnly}${passingNote(counts.aPassing)}`, state: 'outline' as const },
    { label: `${def.bName} only: ${counts.bOnly}${passingNote(counts.bPassing)}`, state: 'dashed' as const },
  ],
  items: [
    {
      label: counts.neither > 0 ? `${rows.length} of ${counts.topics} topics` : `All ${counts.topics} topics`,
      values: [counts.strong, partial, counts.aOnly, counts.bOnly],
    },
  ],
};
const barWide = stacked100({ ...barBase, id: 'cmp-bar-w', width: 960 });
const barNarrow = stacked100({ ...barBase, id: 'cmp-bar-n', width: 340 });
const oneSided = counts.aOnly + counts.bOnly;
// The same four counts as headline tiles above the bar, each with the swatch
// of its series (the butterfly's group headings repeat them).
const inPassing = (n: number) => (n > 0 ? `, ${n} of them in passing` : '');
const stats = [
  { n: counts.strong, label: levelLabel('strong', cmp), gloss: levelGloss('strong', cmp), swatch: 'fill' },
  { n: partial, label: levelLabel('partial', cmp), gloss: levelGloss('partial', cmp), swatch: 'hatch' },
  { n: counts.aOnly, label: levelLabel('a-only', cmp), gloss: `${levelGloss('a-only', cmp)}${inPassing(counts.aPassing)}`, swatch: 'line' },
  { n: counts.bOnly, label: levelLabel('b-only', cmp), gloss: `${levelGloss('b-only', cmp)}${inPassing(counts.bPassing)}`, swatch: 'dash' },
];
const barCaption =
  `Of the ${counts.topics} crosswalk topics, ${counts.both} have a clause in both and ${counts.strong} of those a core clause on each side` +
  (counts.neither > 0 ? `; ${counts.neither} ${counts.neither === 1 ? 'is' : 'are'} reached by neither and ${counts.neither === 1 ? 'sits' : 'sit'} outside the bar.` : '.') +
  ` The ${oneSided} one-sided ${oneSided === 1 ? 'topic is' : 'topics are'} the ones to plan for separately; the topic-by-topic chart further down names ${oneSided === 1 ? 'it' : 'them'}.`;
---

<Base
  title={title}
  titleSuffix={fitsSiteSuffix(title)}
  description={description}
  image={ogImage}
  jsonLd={jsonLd}
  article={{
    publishedTime: `${published}T00:00:00Z`,
    modifiedTime: `${updated}T00:00:00Z`,
    author: site.authors[0],
  }}
>
  <PageHero variant="res" crumbs={crumbs} title={h1}>
    <Byline slot="lede" date={updated} published={published} />
  </PageHero>

  <div class="container res-page cmp" data-pagefind-body>
    <section class="res-section" aria-label="Short answer">
      <p class="cmp-answer" data-cmp-answer>{def.answer}</p>
      {/* "In short": the self-contained passage (130 to 170 words), in the
          chapters' summary callout (prose.css data-kind="summary"). */}
      <div class="prose cmp-in-short">
        <aside class="callout" data-kind="summary" data-cmp-in-short>
          <p class="callout-title">In short</p>
          <p>{inShort}</p>
        </aside>
      </div>
      <ul class="cmp-stats" aria-label="Crosswalk topics by overlap level">
        {
          stats.map((s) => (
            <li class="cmp-stat">
              <span class:list={['cmp-sw', `ov-${s.swatch}`]} aria-hidden="true" />
              <span class="cmp-stat-n">{s.n}</span>
              <span class="cmp-stat-label">{s.label}</span>
              <span class="cmp-stat-gloss">{s.gloss}</span>
            </li>
          ))
        }
      </ul>
      <Chart id="cmp-bar" chart={barWide} narrow={barNarrow} title="Topic overlap at a glance" caption={barCaption} />
    </section>

    <section class="res-section" aria-labelledby="cmp-glance">
      <div class="res-section-head">
        <h2 id="cmp-glance">At a glance</h2>
        <p>
          The two instruments side by side, as the Body of Knowledge states them. Each cell names the
          primary source it rests on; the last row links the chapter sections each line comes from.
        </p>
      </div>
      <div class="res-tablewrap">
        <table class="res-table cmp-table" data-cmp-glance>
          <caption class="visually-hidden">{fa.name} and {fb.name} compared, attribute by attribute</caption>
          <thead>
            <tr>
              <th scope="col">Attribute</th>
              <th scope="col">{fa.name}</th>
              <th scope="col">{fb.name}</th>
            </tr>
          </thead>
          <tbody>
            {
              glanceRows.map((row) => (
                <tr>
                  <th scope="row" class="c-name">{row.label}</th>
                  {[ga, gb].map((g, i) => (
                    <td data-label={i === 0 ? def.aName : def.bName}>
                      <span class="cmp-cell">{g[row.key]}</span>
                      <span class="cmp-src">
                        {g.sources[row.key].length > 1 ? 'Sources' : 'Source'}:{' '}
                        {g.sources[row.key].map((src, j) => (
                          <>{j > 0 && ', '}<a href={src.url} rel="noopener">{src.label}</a></>
                        ))}
                      </span>
                    </td>
                  ))}
                </tr>
              ))
            }
            <tr>
              <th scope="row" class="c-name">In the Body of Knowledge</th>
              {
                [ga, gb].map((g, i) => (
                  <td data-label={i === 0 ? def.aName : def.bName}>
                    <ul class="cmp-list">
                      {g.read.map((r) => (
                        <li>
                          <a href={r.href}>{r.label}</a>
                        </li>
                      ))}
                    </ul>
                  </td>
                ))
              }
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="res-section" aria-labelledby="cmp-overlap">
      <div class="res-section-head">
        <h2 id="cmp-overlap">Where they overlap, topic by topic</h2>
        <p data-cmp-overlap-summary>{overlapSummary(cmp)}</p>
        <p>
          <strong>Strong</strong>: both file a core clause. <strong>Partial</strong>: both file a
          clause, at least one only in passing. <strong>Only, in passing</strong>: one side files a
          related clause and the other none. Clause ids link to their page in the
          <a href="/obligations">obligation register</a> where one exists. The last column names a
          pattern only where it serves a core clause on both sides: the
          <a href="/resources/crosswalk">crosswalk</a> row's register entry lists it and the pattern's
          own "Maps to" line names that clause. Otherwise the cell is empty.
        </p>
      </div>
      <ComparisonButterfly cmp={cmp} asOf={crosswalkAsOf} />
      <div class="res-tablewrap">
        <table class="res-table cmp-table" data-cmp-overlap>
          <caption class="visually-hidden">
            Per-topic overlap of {fa.name} and {fb.name}, from the crosswalk, core clauses first
          </caption>
          <thead>
            <tr>
              <th scope="col">Topic</th>
              <th scope="col">What {def.aName} asks for</th>
              <th scope="col">What {def.bName} asks for</th>
              <th scope="col">Overlap</th>
              <th scope="col">Patterns for both</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr data-level={row.level}>
                  <th scope="row" class="c-name">
                    <a href={topicHref(row.topic.id)}>{row.topic.name}</a>
                  </th>
                  {[row.a, row.b].map((list, i) => (
                    <td data-label={i === 0 ? def.aName : def.bName}>
                      {list.length === 0 ? (
                        <span class="cmp-none">Not mapped</span>
                      ) : (
                        <ul class="cmp-list">
                          {cellItems(list).map((s) => (
                            <li>
                              {s.obligation ? (
                                <a class="cmp-clause" href={obligationPath(s.obligation)}>
                                  {s.label}
                                </a>
                              ) : (
                                <span class="cmp-clause">{s.label}</span>
                              )}{' '}
                              {s.title}
                              {s.ref.verified === false && (
                                <span class="cmp-unverified"> (not yet verified against the source)</span>
                              )}
                            </li>
                          ))}
                          {list.length > SHOWN && (
                            <li>
                              <a href={topicHref(row.topic.id)}>
                                {list.length - SHOWN} more in the crosswalk
                              </a>
                            </li>
                          )}
                        </ul>
                      )}
                    </td>
                  ))}
                  <td data-label="Overlap">
                    <span class="type-tag cmp-level">{levelLabel(row.level, cmp, row.passing)}</span>
                  </td>
                  {row.shared.length === 0 ? (
                    <td class="cmp-empty" />
                  ) : (
                    <td data-label="Patterns for both">
                      <ul class="cmp-list">
                        {row.shared.slice(0, SHOWN).map((p) => (
                          <li>
                            <a href={patternPath(p)}>{p.title}</a>
                          </li>
                        ))}
                      </ul>
                    </td>
                  )}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="res-section cmp-qa" aria-labelledby="cmp-can-use">
      <h2 id="cmp-can-use">{canUseQuestion(cmp)}</h2>
      <p data-cmp-qa>{def.canUse}</p>
    </section>

    <section class="res-section cmp-qa" aria-labelledby="cmp-start">
      <h2 id="cmp-start">Which should you start with?</h2>
      <p data-cmp-qa>{def.startWith}</p>
    </section>

    <section class="res-section cmp-qa" aria-labelledby="cmp-next">
      <h2 id="cmp-next">Next step</h2>
      <p>Put the comparison to work on your own systems, in the browser.</p>
      <NextStep steps={def.nextSteps} />
    </section>

    <section class="res-section cmp-qa" aria-labelledby="cmp-faq">
      <h2 id="cmp-faq">Frequently asked questions</h2>
      {
        faq.map((item) => (
          <div class="cmp-faq-item" data-cmp-faq>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
            {item.sources && (
              <p class="cmp-src">
                {item.sources.length > 1 ? 'Sources' : 'Source'}:{' '}
                {item.sources.map((src, j) => (
                  <>{j > 0 && ', '}<a href={src.url} rel="noopener">{src.label}</a></>
                ))}
              </p>
            )}
          </div>
        ))
      }
    </section>

    <div class="res-section">
      <Callout kind="note" title="Illustrative mapping, not a conformity assessment">
        <p>{disclaimer} A mapping cell is not evidence; see the
        <a href="/patterns/framework-crosswalk">Framework Crosswalk pattern</a> for what turns a
        crosswalk into an auditable control.</p>
      </Callout>
    </div>

    <div class="res-section">
      <PillarLink
        lead="Both instruments sit inside a wider field:"
        anchor="AI governance, explained"
        tail=", from the laws and standards to the engineering practice."
      />
    </div>

    <section class="res-section" aria-labelledby="cmp-sources">
      <h2 id="cmp-sources">Sources</h2>
      <ul class="cmp-sources" data-cmp-sources>
        {
          sources.map((s) => (
            <li>
              {s.label}: <a href={s.url} rel="noopener">{s.url}</a>
            </li>
          ))
        }
      </ul>
      <p class="cmp-more">
        Every clause on this page, with its note and verification status, is in the
        <a href="/resources/crosswalk">topic × framework crosswalk</a> and its
        <a href="/resources/crosswalk.json">JSON download</a>.
      </p>
      {
        others.length > 0 && (
          <p class="cmp-more" data-cmp-others>
            Other comparisons:{' '}
            {others.map((c, i) => (
              <>
                {i > 0 && ' · '}
                <a href={comparisonPath(c)}>{`${c.aName} vs ${c.bName}`}</a>
              </>
            ))}
          </p>
        )
      }
    </section>
  </div>
</Base>

<style>
  /* CLS (performance NEW-1 of the 2026-09-25 audit, 0.19 on phones): the
     current-page crumb ("ISO 42001 vs EU AI Act") fit the breadcrumb line in
     the fallback monospace and wrapped to a second line once JetBrains Mono
     loaded, pushing the page down 20px. Here the crumb takes the rest of the
     first line and truncates instead of wrapping, so the hero is as tall with
     either font. Global because PageHero renders the breadcrumb; this style
     ships only with this component, so only the comparison pages get it. */
  :global(.hero--res .crumbs ol) {
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.hero--res .crumbs li:last-child) {
    flex: 1 1 0;
    min-width: 0;
  }

  :global(.hero--res .crumbs li:last-child [aria-current='page']) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The answer box: the neutral Callout frame (1px --line, --surface), set at
     the lede size so it reads as the page's first answer. */
  .cmp-answer {
    max-width: var(--prose);
    margin: 0;
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  /* Headline tiles above the overlap bar: the count in the display face, the
     series swatch (the bar's own states) before it. */
  .cmp-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 40%), 1fr));
    gap: var(--s-3);
    max-width: 60rem;
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .cmp-stat {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    column-gap: var(--s-2);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
  }

  .cmp-stat-n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.5rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .cmp-stat-label {
    font-weight: 600;
    color: var(--ink);
  }

  @media (max-width: 480px) {
    .cmp-stat {
      grid-template-columns: auto 1fr;
      padding: var(--s-3);
    }

    .cmp-stat-n {
      font-size: 2rem;
    }

    .cmp-stat-label {
      grid-column: 1 / -1;
      margin-top: var(--s-1);
    }
  }

  .cmp-stat-gloss {
    grid-column: 1 / -1;
    margin-top: var(--s-2);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .cmp-sw {
    align-self: center;
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 2px;
    box-sizing: border-box;
  }

  .cmp-stats + :global(.chart-fig) {
    margin-top: var(--s-3);
  }

  .cmp-qa h2 {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
  }

  .cmp-qa p,
  .cmp-more {
    max-width: var(--prose);
    margin-top: var(--s-2);
    color: var(--ink-2);
  }

  .cmp-faq-item + .cmp-faq-item {
    margin-top: var(--s-4);
  }

  .cmp-faq-item h3 {
    margin-top: var(--s-4);
    color: var(--ink);
  }

  #cmp-sources {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
  }

  .cmp-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cmp-list li + li {
    margin-top: var(--s-1);
  }

  .cmp-clause {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .cmp-none,
  .cmp-unverified {
    color: var(--ink-2);
  }

  /* The In short callout sits under the answer box, one rhythm step down,
     left-aligned with it (.prose centres its column by default). */
  .cmp-in-short {
    max-width: var(--prose);
    margin-inline: 0;
  }

  .cmp-in-short .callout {
    margin-top: var(--s-4);
  }

  /* The source line of a cell or an answer: small, on its own line. */
  .cmp-src {
    display: block;
    margin-top: var(--s-1);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .cmp-src a {
    color: var(--ink-2);
  }

  .cmp-table th[scope='row'] {
    text-align: left;
    vertical-align: top;
  }

  .cmp-table td {
    line-height: 1.5;
  }

  .cmp-sources {
    margin-top: var(--s-3);
    padding-left: var(--s-5);
  }

  .cmp-sources li + li {
    margin-top: var(--s-1);
  }

  .cmp-sources a {
    overflow-wrap: anywhere;
  }

  /* Below 720px the shared table styles stack each row as a card of labelled
     cells; the row header joins the card as its title. */
  @media (max-width: 720px) {
    /* A row with no pattern for both leaves no empty labelled line in its card. */
    .cmp-table td.cmp-empty {
      display: none;
    }

    .cmp-table th[scope='row'] {
      display: block;
      width: 100%;
      padding: 0 0 var(--s-2);
      border: 0;
    }
  }
</style>
