---
/**
 * ThemeToggle — a button that flips light/dark via window.__setTheme (exposed by
 * /theme.js). The click handler lives in /ui.js to satisfy CSP (no inline JS).
 * It shows a moon in light contexts and a sun in dark ones; ui.js keeps
 * aria-pressed in sync with the resolved theme.
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Switch to dark theme"
>
  <svg class="i i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
    <path
      d="M20 14.5A8.5 8.5 0 0 1 9.5 4 7 7 0 1 0 20 14.5Z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
  </svg>
  <svg class="i i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--ink-2);
  }

  .i-sun {
    display: none;
  }

  /* Dark, explicit or by system preference -> show the sun. */
  :global(:root[data-theme='dark']) .i-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .i-sun {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-moon {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .i-sun {
      display: block;
    }
  }
</style>
