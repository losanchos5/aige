---
// Toc: on-this-page navigation built from the rendered headings (H2/H3). Doc's
// .doc-toc column holds it sticky on wide viewports. Each H2 entry carries its
// two-digit number (the same count the prose prints before the H2), H3 entries
// sit indented under it. ui-doc.js adds aria-current to the section in view and
// .is-past to every entry before it; the current entry takes a 2px accent rule
// and a heavier weight, so the state never rests on colour alone.
import type { MarkdownHeading } from 'astro';
import { chapterNum } from '../data/parts';
import { t } from '../i18n/ui';

interface Props {
  // numbered: false marks an H2 the prose does not count (a classed component
  // heading with its own number, such as a control record), see prose.css.
  headings: (MarkdownHeading & { numbered?: boolean })[];
  lang?: string;
}

const { headings, lang = 'en' } = Astro.props;
let h2 = 0;
const items = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ ...h, num: h.depth === 2 && h.numbered !== false ? chapterNum(++h2) : '' }));
---

{
  items.length > 0 && (
    <nav class="toc" aria-label={t('doc.onThisPage', lang)}>
      <p class="toc-label">{t('doc.onThisPage', lang)}</p>
      <ol>
        {items.map((heading) => (
          <li class={`toc-h${heading.depth}`}>
            <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
              <span class="n" aria-hidden="true">{heading.num}</span>
              <span>{heading.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc-label {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line);
  }

  .toc li {
    margin: 0;
  }

  .toc a {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr);
    margin-left: -1px;
    padding: 5px 0 5px 12px;
    border-left: 2px solid transparent;
    font-size: 0.84375rem;
    line-height: 1.4;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .toc .n {
    padding-top: 1px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
  }

  .toc-h3 a {
    grid-template-columns: 2.4rem minmax(0, 1fr);
    font-size: 0.8125rem;
  }

  /* Sections already read step up from --muted to --ink-2; the current one
     takes the full ink, weight and the accent rule. */
  .toc a.is-past {
    color: var(--ink-2);
  }

  .toc a:hover {
    color: var(--ink);
  }

  .toc a:is([aria-current='true'], [aria-current='location']) {
    border-left-color: var(--accent);
    color: var(--ink);
    font-weight: 600;
  }

  .toc a:is([aria-current='true'], [aria-current='location']) .n {
    color: var(--accent);
  }
</style>
