---
// Toc: on-this-page navigation built from the rendered headings (H2/H3). Sticky
// on wide viewports; ui-doc.js adds aria-current to the section in view.
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav class="toc" aria-label="On this page">
      <p class="toc-label">On this page</p>
      <div class="toc-list">
        <span class="toc-marker" data-toc-marker aria-hidden="true" />
        <ul>
          {items.map((heading) => (
            <li class={`toc-h${heading.depth}`}>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

<style>
  .toc {
    position: sticky;
    top: var(--s-7);
    font-size: 0.875rem;
  }

  .toc-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--s-3);
  }

  /* The active marker is a single 2px rule that slides between entries rather
     than a per-link border that jumps. */
  .toc-list {
    position: relative;
  }

  .toc-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 0;
    background: var(--ink);
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .toc-marker {
      transition:
        transform 200ms var(--ease),
        height 200ms var(--ease);
    }
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .toc li {
    margin: 0;
  }

  .toc a {
    display: block;
    padding: var(--s-1) var(--s-3);
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.35;
    transition: color var(--dur) var(--ease);
  }

  .toc-h3 a {
    padding-left: var(--s-5);
    font-size: 0.8125rem;
  }

  .toc a:hover {
    color: var(--ink);
  }

  /* Entries scrolled past fade back to muted; the active one takes the ink. */
  .toc a.is-past {
    color: var(--muted);
  }

  .toc a[aria-current='true'] {
    color: var(--ink);
  }
</style>
