---
// Toc: on-this-page navigation built from the rendered headings (H2/H3). Doc's
// .doc-toc column holds it sticky on wide viewports; ui-doc.js adds
// aria-current to the section in view and
// .is-past to every entry before it, so each entry reads as current, read or
// pending: by colour only, never opacity.
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav class="toc" aria-label="On this page">
      <p class="toc-label">On this page</p>
      <div class="toc-list">
        <span class="toc-marker" data-toc-marker aria-hidden="true" />
        <ul>
          {items.map((heading) => (
            <li class={`toc-h${heading.depth}`}>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

<style>
  .toc {
    font-size: 0.875rem;
  }

  /* Same kicker register as the chapter rail's section label (SidebarNav). */
  .toc-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: var(--s-3);
  }

  /* The active marker is a single 2px rule that slides between entries rather
     than a per-link border that jumps. Transform-only: ui-doc.js sets
     translateY(top) scaleY(entry height / this box's height), so the marker
     moves and resizes without animating layout. Hidden (scaleY 0) until then. */
  .toc-list {
    position: relative;
  }

  .toc-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: var(--s-5);
    background: var(--ink);
    box-shadow: 0 0 6px color-mix(in srgb, var(--ink) 40%, transparent);
    transform: scaleY(0);
    transform-origin: top;
  }

  @media (prefers-reduced-motion: no-preference) {
    .toc-marker {
      transition: transform var(--dur) var(--ease);
    }
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .toc li {
    margin: 0;
  }

  .toc a {
    display: block;
    padding: var(--s-1) var(--s-3);
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.35;
    transition: color var(--dur) var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .toc a {
      transition:
        color var(--dur) var(--ease),
        transform var(--dur) var(--ease);
    }
    .toc a:hover {
      transform: translateX(2px);
    }
  }

  .toc-h3 a {
    padding-left: var(--s-5);
    font-size: 0.8125rem;
  }

  /* Three reading states, by colour only (never opacity) and each ≥ 4.5:1 on the
     page background in both themes: pending entries (the default above) stay
     --muted, sections already read step up to --ink-2, and the current one takes
     the full ink plus weight, with the sliding marker beside it. */
  .toc a.is-past {
    color: var(--ink-2);
  }

  .toc a:is([aria-current='true'], [aria-current='location']) {
    color: var(--ink);
    font-weight: 600;
  }

  .toc a:hover {
    color: var(--ink);
  }
</style>
