---
/**
 * ResourceTiles — a row of luminous tiles linking to the resource indexes, each
 * with a title, a one-line description and a trailing arrow. Laid out on the
 * shared .bento grid (effects.css); each <li> carries --i so a .reveal-stagger
 * class passed in cascades the entrance, while the lift stays on the link (the
 * reveal animation owns the <li>'s transform).
 */
export interface ResourceTile {
  label: string;
  href: string;
  desc: string;
}

interface Props {
  tiles: ResourceTile[];
  class?: string;
}

const { tiles, class: className } = Astro.props;
---

<ul class:list={['tiles', 'bento', className]}>
  {
    tiles.map((tile, i) => (
      <li style={`--i:${i}`}>
        <a class="tile card-lum lift" href={tile.href}>
          <span class="label">
            {tile.label}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </span>
          <span class="desc">{tile.desc}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* Columns and gap come from .bento; this only resets the list. */
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Surface (border, radius, background, shadow) comes from .card-lum in
     effects.css; this rule keeps only the tile's layout and ink colour. */
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    height: 100%;
    padding: var(--s-5);
    color: var(--ink);
    text-decoration: none;
  }

  .label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
  }

  .arrow {
    color: var(--muted);
    font-size: var(--fs-body);
  }

  .desc {
    font-size: var(--fs-small);
    color: var(--muted);
    text-wrap: pretty;
  }

  a.tile:hover {
    border-color: var(--ink-2);
  }

  a.tile:hover .arrow {
    color: var(--ink);
  }

  /* Keeps .card-lum/.lift's transform and shadow transitions alongside the
     border colour (a bare border-color transition here would override them). */
  @media (prefers-reduced-motion: no-preference) {
    a.tile {
      transition:
        border-color var(--dur) var(--ease),
        transform var(--dur) var(--ease),
        box-shadow var(--dur) var(--ease);
    }
  }
</style>
