---
/**
 * PageHero — the single full-bleed page hero shared by the editorial landings
 * (/role, /stack, /path, /map) and the reference pages (/resources and its
 * sub-pages). It renders a `<section>` that is a direct child of <main>/.marketing,
 * so its inert gradient mesh (defined in effects.css) sits at inset:0 and
 * reaches both viewport edges, while the content stays inside the centred
 * `.container`. No `100vw`, so no horizontal scroll (layout.spec guards this).
 *
 * Two variants that read differently at a glance:
 * - `page` (landing): a display-size title on a tall ~40vh band over the full
 *   mesh, with no eyebrow above it; `related` adds a small line under the lede
 *   linking the related chapter.
 * - `res` (reference): an H1-scale title on a tight band under a faint mesh,
 *   with a Breadcrumb (`crumbs`) above the title.
 * There is no kicker and no dot texture (audit SL-04, SL-18). The `lede` and
 * `note` slots take copy that carries inline markup.
 */
import Breadcrumb from './Breadcrumb.astro';
import type { Crumb } from '../lib/breadcrumbs';

interface Props {
  title: string;
  lede?: string;
  /** A Breadcrumb above the title (reference pages). The matching
      BreadcrumbList JSON-LD is the page's job: pass `breadcrumbJsonLd(crumbs)`
      to the layout's `jsonLd`, which lands it in the single head graph. */
  crumbs?: Crumb[];
  /** A small line under the lede linking the related chapter (landings). */
  related?: { label: string; href: string };
  /** Draw the gradient mesh layer (default true; false on Lighthouse routes). */
  mesh?: boolean;
  variant?: 'page' | 'res';
}

const { title, lede, crumbs, related, mesh = true, variant = 'page' } = Astro.props;

const landing = variant === 'page';
---

<section
  class:list={['hero', 'section', 'hero--page', landing ? 'hero--landing' : 'hero--res']}
>
  {mesh && <div class="bg-mesh" aria-hidden="true"></div>}
  <div class="container">
    <header class="hero-head hero-in">
      {
        crumbs && (
          <div class="hero-eyebrow">
            <Breadcrumb items={crumbs} />
          </div>
        )
      }
      <h1 class="hero-title">{title}</h1>
      {lede && <p class="hero-lede">{lede}</p>}
      <slot name="lede" />
      {
        related && (
          <p class="hero-related">
            <a href={related.href}>{related.label}</a>
          </p>
        )
      }
      {
        Astro.slots.has('note') && (
          <div class="hero-note">
            <slot name="note" />
          </div>
        )
      }
    </header>
  </div>
</section>

<style>
  /* The full-bleed band: relative + isolated so the inert mesh stays
     behind the raised content. A softer mesh runs via a local --mesh-alpha
     override. The band itself does not clip: .bg-mesh clips its own drifting
     glows (overflow + contain in effects.css), so text enlarged to 200% wraps
     inside the band instead of being cut at its edge (WCAG 1.4.4). (Moved here
     from the .hero--page / .res-hero rules that used to live in pages.css.) */
  .hero--page {
    position: relative;
    isolation: isolate;
    min-height: 40vh;
    --mesh-alpha: 0.7;
  }

  .hero--page > .container {
    position: relative;
    z-index: 1;
  }

  /* The head: breadcrumb (reference pages) + title + lede, left-aligned. */
  .hero-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    max-width: var(--prose);
  }

  /* The breadcrumb row. It wraps on phones. */
  .hero-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    max-width: 100%;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
    max-width: 20ch;
    text-wrap: balance;
    /* A word wider than the column (a long word at 200% text) breaks rather
       than overflowing; `anywhere` also lets the flex item shrink to fit. */
    overflow-wrap: anywhere;
  }

  /* Landing title on phones: from the display size down to the H1 size, so a
     long title takes three lines at 390px, not four. It scales with the
     viewport between ~390 and ~510px and rejoins --fs-display above that. */
  .hero--landing .hero-title {
    font-size: min(var(--fs-display), max(var(--fs-h1), 10.25vw));
  }

  .hero-lede {
    margin: 0;
    max-width: 60ch;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* The related-chapter line under the lede: body face at --fs-small, in
     sentence case, a plain underlined link (SL-04, SL-05). */
  .hero-related {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .hero-related a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.2em;
  }

  .hero-related a:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  .hero-note {
    max-width: 62ch;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .hero-note :global(p) {
    margin: 0;
  }

  .hero-note :global(p + p) {
    margin-top: var(--s-3);
  }

  /* Reference variant: dense pages get an H1-scale title, a tighter band
     (--s-6 against the landing's --s-8) and a faint wash of mesh. (Moved here
     from .res-hero / .res-head / .res-title in the page and resources
     stylesheets.) */
  .hero--res {
    min-height: 0;
    padding-block: var(--s-6) var(--s-5);
    --mesh-alpha: 0.35;
  }

  .hero--res .hero-title {
    font-size: var(--fs-h1);
    max-width: var(--prose);
  }

  /* Timed entrance for the hero content, staggered top-to-bottom by source
     order. A lift only, transform and no opacity: the hero sits in the first
     viewport, where a fractional opacity would be blended into the contrast
     ratio by axe and Lighthouse. Motion-gated, so no-JS and reduced-motion
     readers see the text at rest. (Moved here from pages.css.) */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in > * {
      animation: hero-up 0.6s var(--ease) both;
    }
    .hero-in > *:nth-child(1) {
      animation-delay: 0ms;
    }
    .hero-in > *:nth-child(2) {
      animation-delay: 70ms;
    }
    .hero-in > *:nth-child(3) {
      animation-delay: 140ms;
    }
    .hero-in > *:nth-child(4) {
      animation-delay: 210ms;
    }
    .hero-in > *:nth-child(5) {
      animation-delay: 280ms;
    }
  }

  @keyframes hero-up {
    from {
      transform: translateY(10px);
    }
    to {
      transform: none;
    }
  }
</style>
