---
/**
 * GovernanceLoop: the home page's governance loop, from the obligation to the
 * auditor across four lanes (data in src/data/loop.ts). One DOM, two layouts,
 * picked by the figure's own width (a container query, not the viewport):
 *
 *   canvas (760px and up): a fixed-aspect canvas in the loop's user space.
 *     Lanes, steps and edge labels sit in percent of that space and the SVG
 *     wires fill it, so everything lines up at any width. A beam walks the
 *     edges in loop order; the step it reaches rings once. The detail strip
 *     under the canvas shows the active step: every panel is stacked in one
 *     grid cell, so the strip is always as tall as its tallest panel and
 *     switching steps never moves the page. Nothing is drawn over a step:
 *     lanes, wires, beams and labels take no pointer events.
 *   list (narrower): the same ordered list, stacked, with each edge's verb
 *     on a rail between the steps; a tap opens a step's note in line.
 *
 * public/loop.js keeps one state, the active step, as data-active on the
 * figure (hover and focus on the canvas, click or tap to pin, Escape or a
 * press outside to release) and plays the beam's single lap (under 5 s, WCAG
 * 2.2.2) each time the figure comes into view. Without it the figure is
 * complete and static. Every animation is gated on prefers-reduced-motion:
 * no-preference, and none of them changes a text's opacity. Each step button is described by its note, so a screen
 * reader gets the detail the strip shows; the strip itself is aria-hidden.
 *
 * Slot: the figure caption.
 */
import {
  LOOP_VIEW,
  loopEdges,
  loopIcons,
  loopLaneName,
  loopLanes,
  loopSteps,
  loopVerb,
} from '../data/loop';

const { w: W, h: H } = LOOP_VIEW;
const px = (value: number, of: number) => `${+((value / of) * 100).toFixed(4)}%`;
---

<figure class="loop" data-loop>
  <div class="loop-panel">
    <div class="loop-canvas" data-loop-canvas style={`--ar:${W} / ${H}`}>
      <div class="loop-lanes" aria-hidden="true">
        {
          loopLanes.map((lane, i) => (
            <div
              class="loop-lane"
              data-lane={i}
              style={`--x:${px(lane.x, W)};--w:${px(lane.w, W)}`}
            >
              <span class="loop-lane-head">
                {lane.n} / {lane.name}
              </span>
            </div>
          ))
        }
      </div>

      <svg
        class="loop-wires"
        viewBox={`0 0 ${W} ${H}`}
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <marker
            id="loop-tip"
            viewBox="0 0 10 10"
            refX="10"
            refY="5"
            markerWidth="9"
            markerHeight="9"
            markerUnits="userSpaceOnUse"
            orient="auto"
          >
            <path class="loop-tip" d="M0 0.5 10 5 0 9.5Z"></path>
          </marker>
          <marker
            id="loop-tip-lit"
            viewBox="0 0 10 10"
            refX="10"
            refY="5"
            markerWidth="10"
            markerHeight="10"
            markerUnits="userSpaceOnUse"
            orient="auto"
          >
            <path class="loop-tip loop-tip--lit" d="M0 0.5 10 5 0 9.5Z"></path>
          </marker>
        </defs>
        {
          loopEdges.map((edge) => (
            <g
              class="loop-edge"
              data-from={edge.from}
              data-to={edge.to}
              data-loop-edge={edge.loop ? '' : undefined}
              style={`--slot:${edge.slot};--beats:${edge.beats ?? 1};--len:${edge.len}`}
            >
              <path class="loop-wire" d={edge.d} />
              <path class="loop-beam" d={edge.d} pathLength={edge.len} />
            </g>
          ))
        }
      </svg>

      <ol class="loop-steps" role="list">
        {
          loopSteps.map((step, i) => {
            const verb = loopVerb(step.id);
            return (
              <li
                class="loop-step"
                data-step={step.id}
                data-lane={step.lane}
                data-layer={step.layer ?? 'none'}
                style={`--x:${px(step.x, W)};--y:${px(step.y, H)};--w:${px(step.w, W)};--h:${px(step.h, H)};--slot:${i}`}
              >
                <button
                  type="button"
                  class="loop-node"
                  data-step={step.id}
                  aria-expanded="false"
                  aria-describedby={`loop-note-${step.id}`}
                >
                  <span class="loop-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false" set:html={loopIcons[step.icon]} />
                  </span>
                  <span class="loop-label">{step.label}</span>
                  <span class="loop-meta">
                    <span class="loop-tag">{step.tag}</span>
                    <span class="loop-lane-name"> · {loopLaneName(step)}</span>
                  </span>
                </button>
                <div class="loop-note" id={`loop-note-${step.id}`}>
                  <code class="loop-sample">{step.sample}</code>
                  <p class="loop-note-text">{step.note}</p>
                </div>
                {verb && <p class="loop-verb">{verb}</p>}
              </li>
            );
          })
        }
      </ol>
      <p class="loop-return">
        <svg class="loop-return-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
        Evidence closes the loop, back to the obligation.
      </p>

      <div class="loop-pills" aria-hidden="true">
        {
          loopEdges.map((edge) => (
            <span
              class="loop-pill"
              data-from={edge.from}
              data-to={edge.to}
              data-align={edge.at.align}
              style={`--x:${px(edge.at.x, W)};--y:${px(edge.at.y, H)}`}
            >
              {edge.label}
            </span>
          ))
        }
      </div>
    </div>

    <div class="loop-detail" aria-hidden="true">
      <p class="loop-detail-panel loop-detail-idle is-shown" data-for="">
        Hover or focus a step to see what it does; click it to keep it open.
      </p>
      {
        loopSteps.map((step) => (
          <div class="loop-detail-panel" data-for={step.id} data-layer={step.layer ?? 'none'}>
            <p class="loop-detail-head">
              <span class="loop-detail-label">{step.label}</span>
              <span class="loop-detail-tag">{step.tag}</span>
              <code class="loop-sample">{step.sample}</code>
            </p>
            <p class="loop-detail-note">{step.note}</p>
          </div>
        ))
      }
    </div>
  </div>

  <figcaption class="loop-caption"><slot /></figcaption>
</figure>

<script is:inline defer src="/loop.js"></script>

<style>
  /* ---------------------------------------------------------------- Shell */
  .loop {
    container: loop / inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin: 0;
    /* Opaque ground (the panel, and the label chips that mask the dashed
       return edge), an opaque wire ink (3:1 on the panel and the lanes, both
       themes) so arrow tips never double up, and the beam in the L1 ink. */
    --loop-ground: linear-gradient(var(--surface), var(--surface)), var(--bg);
    --loop-wire: color-mix(in srgb, var(--ink) 55%, var(--bg));
    --loop-beam: var(--l1-ink);
    /* One lap: six one-beat edges and the two-beat return, 8 x 0.6s = 4.8s. */
    --loop-beat: 0.6s;
  }

  .loop-panel {
    --muted: var(--ink-2);
    padding: var(--s-4);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--loop-ground);
    box-shadow: var(--shadow-2);
  }

  .loop-caption {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.3em;
    margin: 0;
    font-size: var(--fs-small);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* Layer colour: each step (and its detail panel) carries its stack layer;
     the law and the auditor stay neutral. */
  [data-layer] {
    --layer: color-mix(in srgb, var(--ink) 8%, var(--bg));
    --layer-ink: var(--ink-2);
  }

  [data-layer='1'] {
    --layer: var(--l1);
    --layer-ink: var(--l1-ink);
  }

  [data-layer='2'] {
    --layer: var(--l2);
    --layer-ink: var(--l2-ink);
  }

  [data-layer='3'] {
    --layer: var(--l3);
    --layer-ink: var(--l3-ink);
  }

  [data-layer='4'] {
    --layer: var(--l4);
    --layer-ink: var(--l4-ink);
  }

  [data-layer='5'] {
    --layer: var(--l5);
    --layer-ink: var(--l5-ink);
  }

  /* ------------------------------------------------- Steps (both layouts) */
  .loop-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .loop-node {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'icon label'
      'icon meta';
    column-gap: var(--s-3);
    row-gap: 2px;
    align-items: center;
    width: 100%;
    padding: var(--s-3);
    border: 1px solid color-mix(in srgb, var(--layer-ink) 24%, var(--line));
    border-radius: 12px;
    background: color-mix(in srgb, var(--layer) 30%, var(--bg));
    box-shadow: var(--shadow-1);
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .loop-node:hover,
  .loop-step.is-active .loop-node {
    border-color: var(--ink);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--ink) 12%, transparent),
      var(--shadow-2);
  }

  /* A pinned step keeps a solid ink ring, so it reads apart from a hover. */
  .loop-step.is-pinned .loop-node {
    border-color: var(--ink);
    box-shadow:
      0 0 0 2px var(--ink),
      var(--shadow-2);
  }

  /* The ring the beam leaves as it reaches a step (animated below). A border
     on a decorative layer, never the text. */
  .loop-node::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1.5px solid var(--loop-beam);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }

  .loop-icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--layer);
    color: var(--layer-ink);
  }

  .loop-icon svg,
  .loop-return-icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .loop-label {
    grid-area: label;
    font-weight: 600;
    line-height: 1.25;
  }

  .loop-meta {
    grid-area: meta;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: 1.35;
    color: var(--layer-ink);
  }

  .loop-sample {
    display: inline-block;
    padding: 1px 8px;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--layer) 55%, var(--bg));
    font-size: var(--fs-label);
    line-height: 1.6;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  /* --------------------------------------------- List layout (the default) */
  .loop-lanes,
  .loop-wires,
  .loop-pills,
  .loop-detail {
    display: none;
  }

  .loop-note {
    display: none;
    margin-top: var(--s-2);
    padding: var(--s-3);
    border: 1px solid color-mix(in srgb, var(--layer-ink) 18%, var(--line));
    border-radius: 10px;
    background: color-mix(in srgb, var(--layer) 16%, var(--bg));
  }

  .loop-step.is-active .loop-note {
    display: block;
  }

  .loop-note-text {
    margin: var(--s-2) 0 0;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* The rail between two steps: a line down from the icon's centre (padding
     12 + border 1 + half the 36px chip = 31px) with the edge's verb beside it. */
  .loop-verb {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 40px;
    margin: 0;
    padding-left: 52px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-2);
  }

  .loop-verb::before {
    content: '';
    position: absolute;
    left: 30px;
    top: 4px;
    bottom: 8px;
    width: 2px;
    border-radius: 1px;
    background: var(--loop-wire);
  }

  .loop-verb::after {
    content: '';
    position: absolute;
    left: 27px;
    bottom: 4px;
    width: 8px;
    height: 5px;
    background: var(--loop-wire);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  .loop-return {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: var(--s-4) 0 0;
    padding: var(--s-2) var(--s-3);
    border: 1px dashed var(--loop-wire);
    border-radius: 999px;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-2);
  }

  .loop-return-icon {
    flex: none;
    width: 16px;
    height: 16px;
  }

  /* --------------------------------------------------------- Canvas layout */
  @container loop (min-width: 760px) {
    .loop-panel {
      padding: var(--s-5);
    }

    .loop-canvas {
      position: relative;
      aspect-ratio: var(--ar);
    }

    .loop-lanes,
    .loop-pills {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .loop-wires {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }

    .loop-lane {
      position: absolute;
      top: 0;
      bottom: 0;
      left: var(--x);
      width: var(--w);
      border: 1px solid color-mix(in srgb, var(--ink) 7%, transparent);
      border-radius: 14px;
      background: color-mix(in srgb, var(--ink) 2.5%, transparent);
    }

    .loop-lane-head {
      position: absolute;
      top: clamp(8px, 1.1cqi, 12px);
      left: clamp(10px, 1.4cqi, 16px);
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      line-height: 1.3;
      white-space: nowrap;
      color: var(--ink-2);
    }

    .loop-steps {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .loop-step {
      position: absolute;
      left: var(--x);
      top: var(--y);
      width: var(--w);
      height: var(--h);
      pointer-events: auto;
    }

    /* Icon and tag on top, the name along the foot. */
    .loop-node {
      height: 100%;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'icon meta'
        'label label';
      align-content: space-between;
      align-items: start;
      padding: clamp(10px, 1.2cqi, 14px);
      border-radius: 14px;
    }

    .loop-icon {
      width: clamp(28px, 3.2cqi, 38px);
      height: clamp(28px, 3.2cqi, 38px);
      border-radius: 9px;
    }

    .loop-icon svg {
      width: 58%;
      height: 58%;
    }

    .loop-meta {
      justify-self: end;
      text-align: right;
    }

    .loop-label {
      font-size: clamp(0.875rem, 1.42cqi, 1.0625rem);
      line-height: 1.2;
    }

    /* The lanes carry the lane names, the wires the verbs, the strip the
       notes: here those texts stay for screen readers only. */
    .loop-lane-name,
    .loop-verb,
    .loop-return {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .loop-step.is-active .loop-note {
      display: none;
    }

    /* Wires: one opaque ink, a solid tip; the return edge dashed. */
    .loop-wire {
      fill: none;
      stroke: var(--loop-wire);
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      marker-end: url(#loop-tip);
    }

    .loop-edge[data-loop-edge] .loop-wire {
      stroke-dasharray: 5 6;
    }

    .loop-tip {
      fill: var(--loop-wire);
    }

    .loop-tip--lit {
      fill: var(--ink);
    }

    .loop-edge.is-lit .loop-wire {
      stroke: var(--ink);
      stroke-width: 2;
      marker-end: url(#loop-tip-lit);
    }

    .loop-beam {
      display: none;
    }

    /* Edge labels: small chips beside their runs, on the panel's ground (the
       return edge's chip sits on its own dashed channel and masks it). */
    .loop-pill {
      position: absolute;
      left: var(--x);
      top: var(--y);
      translate: -100% -50%;
      padding: 2px 8px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--loop-ground);
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      line-height: 1.4;
      white-space: nowrap;
      color: var(--ink-2);
      transition:
        border-color var(--dur) var(--ease),
        color var(--dur) var(--ease);
    }

    .loop-pill[data-align='center'] {
      translate: -50% -50%;
    }

    .loop-pill.is-lit {
      border-color: var(--ink);
      color: var(--ink);
    }

    /* The detail strip: every panel in one cell, only the active one shown. */
    .loop-detail {
      display: grid;
      grid-template-areas: 'panel';
      margin-top: var(--s-5);
      padding-top: var(--s-4);
      border-top: 1px solid var(--line);
    }

    .loop-detail-panel {
      grid-area: panel;
      margin: 0;
      visibility: hidden;
    }

    .loop-detail-panel.is-shown {
      visibility: visible;
    }

    .loop-detail-idle {
      align-self: start;
      font-size: var(--fs-small);
      color: var(--ink-2);
    }

    .loop-detail-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--s-1) var(--s-3);
      margin: 0 0 var(--s-2);
    }

    .loop-detail-label {
      font-weight: 600;
      color: var(--ink);
    }

    .loop-detail-tag {
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      color: var(--layer-ink);
    }

    .loop-detail-note {
      max-width: 88ch;
      margin: 0;
      font-size: var(--fs-small);
      line-height: 1.55;
      color: var(--ink-2);
    }
  }

  /* ------------------------------------------------------------ Motion */
  /* One lap when the figure comes into view (loop.js sets data-play), under
     5 s: each edge's beam is one short dash that runs the edge in its beats
     (pathLength = the edge's length, so the dash has the same length on every
     edge) and each step rings once in its beat, as the beam reaches it. The
     return edge runs two beats while the auditor rings. Hidden and paused
     while a step is active. */
  @media (prefers-reduced-motion: no-preference) {
    .loop[data-play] .loop-node::after {
      animation: loop-arrive var(--loop-beat) ease-out both;
      animation-delay: calc(var(--slot) * var(--loop-beat));
    }

    @container loop (min-width: 760px) {
      .loop-beam {
        display: inline;
        fill: none;
        stroke: var(--loop-beam);
        stroke-width: 3;
        stroke-linecap: round;
        stroke-dasharray: 36 4000;
        stroke-dashoffset: 36;
      }

      .loop[data-play] .loop-beam {
        animation: loop-beam calc(var(--beats) * var(--loop-beat)) var(--ease) both;
        animation-delay: calc(var(--slot) * var(--loop-beat));
      }
    }

    .loop[data-active] .loop-beam,
    .loop[data-active] .loop-node::after {
      visibility: hidden;
      animation-play-state: paused;
    }

    @keyframes loop-beam {
      from {
        stroke-dashoffset: 36;
      }
      to {
        stroke-dashoffset: calc(var(--len) * -1px);
      }
    }

    @keyframes loop-arrive {
      0% {
        opacity: 0;
      }
      25% {
        opacity: 1;
      }
      60% {
        opacity: 1;
      }
      100% {
        opacity: 0;
      }
    }
  }
</style>
