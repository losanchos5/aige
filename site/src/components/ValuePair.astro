---
/**
 * ValuePair — one value of the Thesis, typeset as a big mono index, the value
 * stated as an affirmation, and a one-sentence gloss of what it builds away
 * from. An optional mono tag flags whether the value is established practice or new to AI
 * engineering or new to AI. (Name kept for import stability.)
 */
import type { Value } from '../data/values';

interface Props {
  value: Value;
  /** `row` (default) keeps the original ruled-row rendering; `bento` renders a
   *  flat card with a large muted index for the values bento grid. */
  variant?: 'row' | 'bento';
  class?: string;
}

const { value, variant = 'row', class: className } = Astro.props;
const index = String(value.n).padStart(2, '0');
const tag = value.note
  ? /^established/i.test(value.note)
    ? 'established'
    : 'new'
  : undefined;
---

<div
  class:list={['pair', variant === 'bento' && 'pair-bento card-lum', className]}
  data-testid="value-pair"
>
  <span class="index" aria-hidden="true">{index}</span>
  <div class="body">
    <p class="title">{value.title}</p>
    <p class="summary">{value.summary}</p>
  </div>
  {tag && <span class="tag">{tag}</span>}
</div>

<style>
  .pair {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .index {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  .title {
    margin: 0;
    font-weight: 600;
    color: var(--ink);
  }

  .summary {
    margin: var(--s-1) 0 0;
    color: var(--muted);
  }

  .tag {
    flex: none;
    align-self: baseline;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Bento variant: a flat card (hairline + surface come from .card-lum; no
     lift, it is not a link) with a large index, a display-font title and an
     --ink-2 summary. Overrides the row layout defined above. */
  .pair-bento {
    flex-direction: column;
    align-items: stretch;
    gap: var(--s-3);
    padding: var(--s-5);
    height: 100%;
  }

  .pair-bento .index {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 1.9rem + 3vw, 4rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    /* Decorative large text (>= 40px, bold): --muted eased 20% toward the
       ground stays >= 3:1 on the card fill in both themes (3.5:1 light,
       3.8:1 dark). A neutral, not a layer tint: the pastels fell to ~1.2:1. */
    color: color-mix(in srgb, var(--muted) 80%, var(--bg));
  }

  .pair-bento .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
  }

  .pair-bento .summary {
    color: var(--ink-2);
  }
</style>
