---
/**
 * ValuePair — one manifesto value typeset as "Left · over · Right": the item we
 * value more, a small mono "over", then the item we build away from. An optional
 * mono tag flags whether the value is inherited from GRC engineering or new.
 */
interface Props {
  /** The item we value more (the left-hand side). */
  over: string;
  /** The item we still use but build away from (the right-hand side). */
  under: string;
  /** Full note from the data; condensed to an `inherited`/`new` tag. */
  note?: string;
  class?: string;
}

const { over, under, note, class: className } = Astro.props;
const tag = note ? (/^inherited/i.test(note) ? 'inherited' : 'new') : undefined;
---

<div class:list={['pair', className]} data-testid="value-pair">
  <p class="terms">
    <span class="over">{over}</span>
    <span class="rel">over</span>
    <span class="under">{under}</span>
  </p>
  {tag && <span class="tag">{tag}</span>}
</div>

<style>
  .pair {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .terms {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
    margin: 0;
    min-width: 0;
  }

  .over {
    font-weight: 600;
    color: var(--ink);
  }

  .rel {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  .under {
    color: var(--muted);
  }

  .tag {
    flex: none;
    align-self: baseline;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
