---
/**
 * ValuePair — one value of the Thesis, typeset as a big mono index, the value
 * stated as an affirmation, and a one-sentence gloss of what it builds away
 * from. An optional mono tag flags whether the value is established practice or new to AI
 * engineering or new to AI. (Name kept for import stability.)
 */
import type { Value } from '../data/values';

interface Props {
  value: Value;
  class?: string;
}

const { value, class: className } = Astro.props;
const index = String(value.n).padStart(2, '0');
const tag = value.note
  ? /^established/i.test(value.note)
    ? 'established'
    : 'new'
  : undefined;
---

<div class:list={['pair', className]} data-testid="value-pair">
  <span class="index" aria-hidden="true">{index}</span>
  <div class="body">
    <p class="title">{value.title}</p>
    <p class="summary">{value.summary}</p>
  </div>
  {tag && <span class="tag">{tag}</span>}
</div>

<style>
  .pair {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .index {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  .title {
    margin: 0;
    font-weight: 600;
    color: var(--ink);
  }

  .summary {
    margin: var(--s-1) 0 0;
    color: var(--muted);
  }

  .tag {
    flex: none;
    align-self: baseline;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
