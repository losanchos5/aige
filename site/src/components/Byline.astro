---
/**
 * Byline: the author and date block under the H1 of a reference page
 * (glossary term, obligation, case), shown as an article byline: AuthorBadge
 * (photo, name linked to /about with rel="author", LinkedIn button, title)
 * with the dates the page already knows, in <time datetime>, after the title.
 * Chapters carry the same badge through ChapterHeader. English only: the
 * reference pages it sits on are English. The badge sits in its painting mat
 * (AuthorBadge `framed`). The <p class="byline" data-byline>
 * wrapper is what the SEO tests and crawlers key on, so it stays.
 */
import AuthorBadge from './AuthorBadge.astro';

interface Props {
  /** YYYY-MM-DD: the page's last update (or review) date. */
  date?: string;
  /** Label before the date (default "Updated"; an obligation says "Reviewed"). */
  dateLabel?: string;
  /** YYYY-MM-DD the page was first published; shown only when it differs from `date`. */
  published?: string;
}

const { date, dateLabel = 'Updated', published } = Astro.props;
---

<p class="byline" data-byline>
  <AuthorBadge placement="byline" framed>
    {
      date && (
        <span>
          {dateLabel} <time datetime={date}>{date}</time>
        </span>
      )
    }
    {
      published && published !== date && (
        <span>
          First published <time datetime={published}>{published}</time>
        </span>
      )
    }
  </AuthorBadge>
</p>

<style>
  .byline {
    margin: var(--s-4) 0 0;
    line-height: 1.5;
  }
</style>
