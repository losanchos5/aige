---
/**
 * SignNote — the "sign the thesis" aside. Two ways to sign: a one-click edit of
 * bok/CONTRIBUTORS.md (GitHub opens a fork and its editor in a single click), or
 * a short issue form for people who would rather not open a pull request.
 */
interface Props {
  signUrl: string;
  issueUrl: string;
  class?: string;
}

const { signUrl, issueUrl, class: className } = Astro.props;
---

<aside class:list={['sign-note', className]}>
  <p>
    This is a living document. <a href={signUrl} target="_blank" rel="noopener noreferrer">Sign
    it</a> by adding your name in a pull request to <code>bok/CONTRIBUTORS.md</code>, or
    <a href={issueUrl} target="_blank" rel="noopener noreferrer">use the sign-the-thesis form</a>
    if you would rather not open a pull request.
  </p>
</aside>

<style>
  .sign-note {
    margin-bottom: var(--s-5);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    /* Neutral tint, not a layer colour (audit SL-06); body size, on the token
       scale (the note is set apart by its box, not by a smaller size). */
    background: var(--tint-bg);
    font-size: var(--fs-body);
  }

  .sign-note p {
    color: var(--ink-2);
  }

  .sign-note a {
    color: var(--ink);
    font-weight: 600;
  }

  /* The file path is one long token: let it break rather than push the page
     sideways when text is enlarged on a phone (WCAG 1.4.4). */
  .sign-note code {
    overflow-wrap: anywhere;
  }

  .sign-note a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
</style>
