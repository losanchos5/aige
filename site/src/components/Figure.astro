---
/**
 * Figure: the conceptual-infographic figure for editorial pages, with the same
 * markup the chapter pipeline emits (src/lib/rehype-diagrams.ts): a framed
 * canvas, a two-sentence figcaption and an optional <details> text alternative.
 * The canvas holds slotted content: an inline <svg> from src/figures, or, when
 * real navigation links are more accessible than SVG links, plain HTML (see the
 * reading-paths map on the /bok index). Styling comes from figures.css, which
 * the page loads through styles/reading.css imported right after its layout;
 * light and dark both follow the tokens.
 */
import { getFigure } from '../data/figures';
import { hasFigureArt } from '../lib/figure-reuse';

interface Props {
  /** Short title (≤ 6 words) shown in the figcaption. */
  title: string;
  /** Two-sentence caption ending "Drawn from chapter NN." */
  caption?: string;
  /** Fuller text alternative rendered in a <details>; omit when the slotted
   *  content is already accessible text (e.g. real links). */
  description?: string;
  /** Extra class on the <figure> (e.g. a figure-specific layout hook). */
  class?: string;
  /** Optional data-figure id for styling/testing hooks. When it names a figure
   *  of src/data/figures.ts, the <figure> also gets id="figure-<id>" and the
   *  caption links the figure's permalink page. */
  id?: string;
  /** Link the permalink page from the caption (default true for a known
   *  figure); the permalink page itself passes false. */
  permalink?: boolean;
}

const { title, caption, description, class: className, id, permalink = true } = Astro.props;
const known = id !== undefined && getFigure(id) !== undefined && hasFigureArt(id);
---

<figure
  class:list={['figure', 'figure--infographic', className]}
  id={known ? `figure-${id}` : undefined}
  data-figure={id}
>
  <div class="figure-canvas"><slot /></div>
  <figcaption class="figure-figcaption">
    <span class="figure-fig-title">{title}</span>
    {caption && <span class="figure-fig-desc">{caption}</span>}
    {
      known && permalink && (
        <a class="figure-permalink" href={`/figures/${id}`}>
          Permalink, downloads and citation
        </a>
      )
    }
  </figcaption>
  {
    description && (
      <details class="figure-alt">
        <summary class="figure-alt-summary" data-pagefind-ignore>Text description</summary>
        <p>{description}</p>
      </details>
    )
  }
</figure>
