---
/**
 * OpenWork: the project's open work (src/data/work.ts) as announcement rows:
 * the date it last changed and its state (with the version) in mono on the
 * left, the artefact linked and one sentence on the right, hairlines between.
 * Every state is the real one; nothing is shown as reviewed or published
 * before it is. Used on the home and on /about.
 */
import { work as allWork, WORK_STATUS_LABEL, workProblems, type WorkItem } from '../data/work';
import { formatDate } from '../lib/applies-now';

interface Props {
  /** Defaults to every row of work.ts. */
  items?: readonly WorkItem[];
}

const problems = workProblems();
if (problems.length > 0) {
  throw new Error(`work: ${problems.length} problem(s) in the open work list:\n${problems.join('\n')}`);
}

const { items = allWork } = Astro.props;
---

<ol class="work-list" role="list">
  {
    items.map((item) => (
      <li class="work-item" data-status={item.status}>
        <p class="work-meta">
          <time class="work-date" datetime={item.updated}>
            {formatDate(item.updated)}
          </time>
          <span class="work-state">
            {WORK_STATUS_LABEL[item.status]}
            {item.version && <> · v{item.version}</>}
          </span>
        </p>
        <div class="work-body">
          <a class="work-title" href={item.href}>
            {item.title}
          </a>
          <p class="work-note">{item.note}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .work-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .work-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-2) 32px;
    margin: 0;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 720px) {
    .work-item {
      grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .work-meta {
    display: grid;
    gap: var(--s-1);
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .work-date {
    font-size: 0.8125rem;
    color: var(--accent);
  }

  .work-state {
    font-size: var(--fs-label);
    color: var(--muted);
  }

  .work-title {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .work-title:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .work-note {
    margin: 6px 0 0;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-2);
  }
</style>
