---
/**
 * Footer: a full site map built from data/nav.ts (brand + Read/Practice/For
 * you/Reference/About columns, feeds & data and the project links, then every
 * chapter grouped by part in a full-width block) over a meta line. Identity
 * values come from data/site.ts. The tinted band, grid texture and display
 * watermark are kept. `lang` translates the footer's own strings (the group
 * titles, the blurb); the links still go to the English pages.
 */
import RegisterMark from './RegisterMark.astro';
import { site } from '../data/site';
import { nav, feeds, project, type NavGroup } from '../data/nav';
import { bookParts } from '../data/parts';
import { translator, type UiKey } from '../i18n/ui';
import { LOCALE_INFO } from '../i18n/locales';
import { translationIndex } from '../lib/i18n-content';

interface Props {
  /** Page language (the <html lang>); English by default. */
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = translator(lang);
const groupLabel = (group: NavGroup) => t(`nav.${group.id}` as UiKey);
const partLabel = (id: string, fallback: string) =>
  bookParts.some((part) => part.id === id) ? t(`part.${id}` as UiKey) : fallback;
// The landing (/<lang>) of every language that has machine translations, in
// locale order; none, and the list is not rendered (lib/i18n-content.ts).
const langs = (['es', 'fr', 'de', 'pt'] as const).filter((lang) => translationIndex().langs.has(lang));

const domain = new URL(site.url).host;
const byId = (id: NavGroup['id']) => nav.find((g) => g.id === id)!;
const thesis = byId('thesis');
const bok = byId('bok');
const practice = byId('practice');
const forYou = byId('for-you');
const reference = byId('reference');
const map = byId('map');
const about = byId('about');
---

<footer class="site-footer">
  <div class="container">
    <nav class="sitemap" aria-label={t('footer.siteMap')}>
      <div class="col col-brand">
        <RegisterMark size="sm" label={site.name} />
        <p class="blurb">
          {t('footer.blurb', { author: site.author })}
        </p>
        <ul class="brand-links" aria-label={t('footer.site')}>
          <li><a href="/">{t('footer.home')}</a></li>
          <li><a href={map.href}>{groupLabel(map)}</a></li>
        </ul>
        {
          langs.length > 0 && (
            <ul class="brand-links brand-langs" aria-label={t('footer.languages')} data-footer-langs>
              {langs.map((lang) => (
                <li>
                  <a href={`/${lang}`} hreflang={lang} lang={lang}>
                    {LOCALE_INFO[lang].autonym}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="col col-read">
        <p class="group-title" id="fg-read">{t('footer.read')}</p>
        <ul aria-labelledby="fg-read">
          <li><a href={thesis.href}>{groupLabel(thesis)}</a></li>
          {thesis.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
          <li><a href={bok.href}>{groupLabel(bok)}</a></li>
        </ul>
      </div>

      <div class="col col-practice">
        <p class="group-title" id="fg-practice">{t('footer.practice')}</p>
        <ul aria-labelledby="fg-practice">
          {practice.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col col-for-you">
        <p class="group-title" id="fg-for-you">{groupLabel(forYou)}</p>
        <ul aria-labelledby="fg-for-you">
          <li><a href={forYou.href}>{t('footer.allRoutes')}</a></li>
          {forYou.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col col-reference">
        <p class="group-title" id="fg-reference">{t('footer.reference')}</p>
        <ul aria-labelledby="fg-reference">
          <li><a href={reference.href}>{t('footer.allResources')}</a></li>
          {reference.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col col-about">
        <p class="group-title" id="fg-about">{t('footer.about')}</p>
        <ul aria-labelledby="fg-about">
          <li><a href={about.href}>{t('footer.about')}</a></li>
          {about.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col col-feeds">
        <p class="group-title" id="fg-feeds">{t('footer.feeds')}</p>
        <ul aria-labelledby="fg-feeds">
          {feeds.map((item) => (
            <li>
              <a
                href={item.href}
                {...(item.event
                  ? {
                      'data-umami-event': item.event,
                      'data-umami-event-file': item.href,
                      'data-umami-event-location': 'footer',
                    }
                  : {})}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col col-project">
        <p class="group-title" id="fg-project">{t('footer.project')}</p>
        <ul aria-labelledby="fg-project">
          {project.map((item) => (
            <li>
              <a
                href={item.href}
                {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col col-chapters">
        <p class="group-title" id="fg-chapters">{t('footer.byPart', { bok: groupLabel(bok) })}</p>
        <div class="fparts">
          {(bok.sections ?? []).map((section) => (
            <div class="fpart">
              <p class="fpart-title" id={`fg-part-${section.id}`}>
                {partLabel(section.id, section.label)} <span class="fpart-range">{section.range}</span>
              </p>
              <ol class="fchap" aria-labelledby={`fg-part-${section.id}`}>
                {section.items.map((item) => (
                  <li>
                    <a href={item.href}>
                      <span class="num" aria-hidden="true">{item.num}</span>
                      <span>{item.label}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </div>
    </nav>

    <p class="meta">{site.license} · v{site.bokVersion} · {domain}</p>

    <p class="foot-wordmark" aria-hidden="true">{site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--line);
    margin-top: clamp(64px, 10vw, 128px);
    padding-block: var(--s-7);
    background: color-mix(in srgb, var(--l2) 18%, var(--bg));
    color: var(--muted);
    font-size: var(--fs-small);
  }

  /* Faint 48px grid over the band, behind the content and dimmer in dark. */
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--tex-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--tex-line) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: var(--texture-alpha);
    pointer-events: none;
  }

  /* Query container for the wordmark below: its font-size is sized in cqw so
     the whole name always fits this wrapper (max 1200px) at every viewport. */
  .container {
    container-type: inline-size;
  }

  /* Phones: two tracks so the link groups pair up (the long Reference list
     beside Feeds, For you beside About, Project on its own); the brand and the
     chapters by part take full rows. */
  .sitemap {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      'brand brand'
      'read practice'
      'for-you about'
      'reference feeds'
      'project project'
      'chapters chapters';
    gap: var(--s-6) var(--s-5);
  }

  .col-brand {
    grid-area: brand;
  }
  .col-read {
    grid-area: read;
  }
  .col-practice {
    grid-area: practice;
  }
  .col-for-you {
    grid-area: for-you;
  }
  .col-reference {
    grid-area: reference;
  }
  .col-about {
    grid-area: about;
  }
  .col-feeds {
    grid-area: feeds;
  }
  .col-project {
    grid-area: project;
  }
  .col-chapters {
    grid-area: chapters;
  }

  /* From 720px the link groups flow into tracks that never shrink below their
     longest link, beside the brand; the chapters by part always close the map
     on a row of their own. */
  @media (min-width: 720px) {
    .sitemap {
      grid-template-columns: 1.4fr repeat(3, minmax(max-content, 1fr));
      grid-template-areas: none;
      gap: var(--s-6);
    }

    .sitemap > .col {
      grid-area: auto;
    }

    .sitemap > .col-chapters {
      grid-column: 1 / -1;
    }
  }

  .col-brand {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    max-width: 40ch;
  }

  /* Wide: the brand takes a row of its own (mark, blurb and its two links side
     by side), then one track per link group (Read and six more), so no group
     wraps alone onto a second row and the brand is never squeezed to a sliver
     beside seven lists. */
  @media (min-width: 1100px) {
    .sitemap {
      grid-template-columns: repeat(7, minmax(max-content, 1fr));
    }

    .sitemap > .col-brand {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: flex-start;
      gap: var(--s-6);
      max-width: none;
    }

    .col-brand .blurb {
      max-width: 60ch;
    }
  }

  .blurb {
    margin: 0;
    color: var(--ink-2);
  }

  .group-title {
    margin: 0 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    /* --ink: the group heads sit one step above their --ink-2 link rows
       (never --muted: the footer is a tinted band). */
    color: var(--ink);
  }

  .col ul,
  .brand-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  /* The language landings sit on one line under the brand's own links. */
  .brand-langs {
    flex-flow: row wrap;
    gap: var(--s-2) var(--s-4);
  }

  /* Chapters by part: the parts flow into two columns on phones and three
     from 720px, never split across a column; from 1100px one part per track. */
  .fparts {
    columns: 2;
    column-gap: var(--s-5);
  }

  @media (min-width: 720px) {
    .fparts {
      columns: 3;
      column-gap: var(--s-6);
    }
  }

  @media (min-width: 1100px) {
    .fparts {
      columns: auto;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s-6);
    }
  }

  .fpart {
    break-inside: avoid;
    padding-bottom: var(--s-4);
  }

  /* Sentence-case mono caption naming each part's list; --ink over --ink-2
     rows, never --muted on the tinted band. */
  .fpart-title {
    margin: 0 0 var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--ink);
  }

  .fpart-range {
    font-weight: 400;
    color: var(--ink-2);
  }

  .fchap {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fchap li {
    break-inside: avoid;
  }

  .fchap a {
    display: flex;
    gap: var(--s-2);
    padding: 2px 0;
  }

  /* --ink-2, not --muted: --muted fell to ~3.8:1 on the tinted band where it
     crosses the grid lines (audit SL-17); --ink-2 clears 4.5:1 in both themes. */
  .num {
    font-family: var(--font-mono);
    color: var(--ink-2);
  }

  .col a,
  .brand-links a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .col a:hover,
  .brand-links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* display: block overrides the global inline-flex .meta chip (effects.css) so
     the hairline above the meta line spans the whole container. */
  .meta {
    display: block;
    margin: var(--s-6) 0 0;
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    /* The colophon runs to ~45 characters (licence, version, domain), so it
       drops the global .meta capitals (audit SL-05). */
    text-transform: none;
    /* --ink-2, not --muted: the footer is a tinted band. */
    color: var(--ink-2);
  }

  /* Big display wordmark as a faint watermark closing the footer. aria-hidden
     and decorative. Sized in container-query units against .container so the
     whole name always fits its width; overflow:hidden + nowrap as a safety net. */
  .foot-wordmark {
    margin: var(--s-6) 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 5.6cqw, 5.5rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: color-mix(in srgb, var(--ink) 10%, var(--bg));
    white-space: nowrap;
    overflow: hidden;
  }
</style>
