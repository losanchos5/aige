---
/**
 * Footer — a full site map built from data/nav.ts (brand + Read/Practice/
 * Reference/About columns, the eleven chapters, feeds & data, and the project
 * links) over a meta line. Identity values come from data/site.ts. The tinted
 * band, grid texture and display watermark are kept.
 */
import RegisterMark from './RegisterMark.astro';
import { site } from '../data/site';
import { nav, feeds, project, type NavGroup } from '../data/nav';

const domain = new URL(site.url).host;
const byId = (id: NavGroup['id']) => nav.find((g) => g.id === id)!;
const thesis = byId('thesis');
const bok = byId('bok');
const practice = byId('practice');
const reference = byId('reference');
const map = byId('map');
const about = byId('about');
---

<footer class="site-footer">
  <div class="container">
    <nav class="sitemap" aria-label="Site map">
      <div class="col col-brand">
        <RegisterMark size="sm" label={site.name} />
        <p class="blurb">
          An open Body of Knowledge for the discipline of AI Governance
          Engineering. Written and maintained by {site.author} · AI Governance
          Engineer.
        </p>
        <ul class="brand-links" aria-label="Site">
          <li><a href="/">Home</a></li>
          <li><a href={map.href}>{map.label}</a></li>
        </ul>
      </div>

      <div class="col">
        <p class="group-title" id="fg-read">Read</p>
        <ul aria-labelledby="fg-read">
          <li><a href={thesis.href}>{thesis.label}</a></li>
          {thesis.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
          <li><a href={bok.href}>{bok.label}</a></li>
        </ul>
        <ol class="fchap" aria-label="Chapters">
          {bok.items.map((item) => (
            <li>
              <a href={item.href}>
                <span class="num" aria-hidden="true">{item.num}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <div class="col">
        <p class="group-title" id="fg-practice">Practice</p>
        <ul aria-labelledby="fg-practice">
          {practice.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col">
        <p class="group-title" id="fg-reference">Reference</p>
        <ul aria-labelledby="fg-reference">
          <li><a href={reference.href}>All resources</a></li>
          {reference.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col">
        <p class="group-title" id="fg-about">About</p>
        <ul aria-labelledby="fg-about">
          <li><a href={about.href}>About</a></li>
          {about.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col">
        <p class="group-title" id="fg-feeds">Feeds &amp; data</p>
        <ul aria-labelledby="fg-feeds">
          {feeds.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col">
        <p class="group-title" id="fg-project">Project</p>
        <ul aria-labelledby="fg-project">
          {project.map((item) => (
            <li>
              <a
                href={item.href}
                {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <p class="meta">{site.license} · v{site.bokVersion} · {domain}</p>

    <p class="foot-wordmark" aria-hidden="true">{site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--line);
    margin-top: clamp(64px, 10vw, 128px);
    padding-block: var(--s-7);
    background: color-mix(in srgb, var(--l2) 18%, var(--bg));
    color: var(--muted);
    font-size: var(--fs-small);
  }

  /* Faint 48px grid over the band, behind the content and dimmer in dark. */
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--tex-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--tex-line) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: var(--texture-alpha);
    pointer-events: none;
  }

  /* Query container for the wordmark below: its font-size is sized in cqw so
     the whole name always fits this wrapper (max 1200px) at every viewport. */
  .container {
    container-type: inline-size;
  }

  .sitemap {
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 720px) {
    .sitemap {
      grid-template-columns: 2fr repeat(3, 1fr);
      gap: var(--s-6) var(--s-7);
    }
  }

  @media (min-width: 1100px) {
    .sitemap {
      grid-template-columns: 1.6fr repeat(5, 1fr);
    }
  }

  .col-brand {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    max-width: 40ch;
  }

  .blurb {
    margin: 0;
    color: var(--ink-2);
  }

  .group-title {
    margin: 0 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    /* --ink-2, not --muted: the footer is a tinted band. */
    color: var(--ink-2);
  }

  .col ul,
  .brand-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .fchap {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    columns: 2;
    column-gap: var(--s-5);
  }

  .fchap li {
    break-inside: avoid;
  }

  .fchap a {
    display: flex;
    gap: var(--s-2);
    padding: 2px 0;
  }

  .num {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .col a,
  .brand-links a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .col a:hover,
  .brand-links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .meta {
    margin: var(--s-6) 0 0;
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    /* --ink-2, not --muted: the footer is a tinted band. */
    color: var(--ink-2);
  }

  /* Big display wordmark as a faint watermark closing the footer. aria-hidden
     and decorative. Sized in container-query units against .container so the
     whole name always fits its width; overflow:hidden + nowrap as a safety net. */
  .foot-wordmark {
    margin: var(--s-6) 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 5.6cqw, 5.5rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: color-mix(in srgb, var(--ink) 10%, var(--bg));
    white-space: nowrap;
    overflow: hidden;
  }
</style>
