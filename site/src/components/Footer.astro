---
/**
 * Footer: a full site map built from data/nav.ts (brand + Read/Practice/
 * Reference/About columns, feeds & data and the project links, then every
 * chapter grouped by part in a full-width block) over a meta line. Identity
 * values come from data/site.ts. The tinted band, grid texture and display
 * watermark are kept.
 */
import RegisterMark from './RegisterMark.astro';
import { site } from '../data/site';
import { nav, feeds, project, type NavGroup } from '../data/nav';

const domain = new URL(site.url).host;
const byId = (id: NavGroup['id']) => nav.find((g) => g.id === id)!;
const thesis = byId('thesis');
const bok = byId('bok');
const practice = byId('practice');
const reference = byId('reference');
const map = byId('map');
const about = byId('about');
---

<footer class="site-footer">
  <div class="container">
    <nav class="sitemap" aria-label="Site map">
      <div class="col col-brand">
        <RegisterMark size="sm" label={site.name} />
        <p class="blurb">
          An open Body of Knowledge for the discipline of AI Governance
          Engineering. Written and maintained by {site.author} · AI Governance
          Engineer.
        </p>
        <ul class="brand-links" aria-label="Site">
          <li><a href="/">Home</a></li>
          <li><a href={map.href}>{map.label}</a></li>
        </ul>
      </div>

      <div class="col col-read">
        <p class="group-title" id="fg-read">Read</p>
        <ul aria-labelledby="fg-read">
          <li><a href={thesis.href}>{thesis.label}</a></li>
          {thesis.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
          <li><a href={bok.href}>{bok.label}</a></li>
        </ul>
      </div>

      <div class="col col-practice">
        <p class="group-title" id="fg-practice">Practice</p>
        <ul aria-labelledby="fg-practice">
          {practice.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col col-reference">
        <p class="group-title" id="fg-reference">Reference</p>
        <ul aria-labelledby="fg-reference">
          <li><a href={reference.href}>All resources</a></li>
          {reference.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col col-about">
        <p class="group-title" id="fg-about">About</p>
        <ul aria-labelledby="fg-about">
          <li><a href={about.href}>About</a></li>
          {about.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col col-feeds">
        <p class="group-title" id="fg-feeds">Feeds &amp; data</p>
        <ul aria-labelledby="fg-feeds">
          {feeds.map((item) => (
            <li>
              <a
                href={item.href}
                {...(item.event
                  ? {
                      'data-umami-event': item.event,
                      'data-umami-event-file': item.href,
                      'data-umami-event-location': 'footer',
                    }
                  : {})}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col col-project">
        <p class="group-title" id="fg-project">Project</p>
        <ul aria-labelledby="fg-project">
          {project.map((item) => (
            <li>
              <a
                href={item.href}
                {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col col-chapters">
        <p class="group-title" id="fg-chapters">{bok.label}, by part</p>
        <div class="fparts">
          {(bok.sections ?? []).map((section) => (
            <div class="fpart">
              <p class="fpart-title" id={`fg-part-${section.id}`}>
                {section.label} <span class="fpart-range">{section.range}</span>
              </p>
              <ol class="fchap" aria-labelledby={`fg-part-${section.id}`}>
                {section.items.map((item) => (
                  <li>
                    <a href={item.href}>
                      <span class="num" aria-hidden="true">{item.num}</span>
                      <span>{item.label}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </div>
    </nav>

    <p class="meta">{site.license} · v{site.bokVersion} · {domain}</p>

    <p class="foot-wordmark" aria-hidden="true">{site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--line);
    margin-top: clamp(64px, 10vw, 128px);
    padding-block: var(--s-7);
    background: color-mix(in srgb, var(--l2) 18%, var(--bg));
    color: var(--muted);
    font-size: var(--fs-small);
  }

  /* Faint 48px grid over the band, behind the content and dimmer in dark. */
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--tex-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--tex-line) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: var(--texture-alpha);
    pointer-events: none;
  }

  /* Query container for the wordmark below: its font-size is sized in cqw so
     the whole name always fits this wrapper (max 1200px) at every viewport. */
  .container {
    container-type: inline-size;
  }

  /* Phones: two tracks so the link groups pair up (the long Reference list
     beside Feeds, the short About beside Project); the brand and the chapters
     by part take full rows. */
  .sitemap {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      'brand brand'
      'read practice'
      'reference feeds'
      'about project'
      'chapters chapters';
    gap: var(--s-6) var(--s-5);
  }

  .col-brand {
    grid-area: brand;
  }
  .col-read {
    grid-area: read;
  }
  .col-practice {
    grid-area: practice;
  }
  .col-reference {
    grid-area: reference;
  }
  .col-about {
    grid-area: about;
  }
  .col-feeds {
    grid-area: feeds;
  }
  .col-project {
    grid-area: project;
  }
  .col-chapters {
    grid-area: chapters;
  }

  /* From 720px the link groups flow into tracks that never shrink below their
     longest link, beside the brand; the chapters by part always close the map
     on a row of their own. */
  @media (min-width: 720px) {
    .sitemap {
      grid-template-columns: 1.4fr repeat(3, minmax(max-content, 1fr));
      grid-template-areas: none;
      gap: var(--s-6);
    }

    .sitemap > .col {
      grid-area: auto;
    }

    .sitemap > .col-chapters {
      grid-column: 1 / -1;
    }
  }

  /* Wide: one track per column (brand, Read and five link groups), so no group
     wraps alone onto a second row. */
  @media (min-width: 1100px) {
    .sitemap {
      grid-template-columns: 1.4fr repeat(6, minmax(max-content, 1fr));
    }
  }

  .col-brand {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    max-width: 40ch;
  }

  .blurb {
    margin: 0;
    color: var(--ink-2);
  }

  .group-title {
    margin: 0 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    /* --ink: the group heads sit one step above their --ink-2 link rows
       (never --muted: the footer is a tinted band). */
    color: var(--ink);
  }

  .col ul,
  .brand-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  /* Chapters by part: the parts flow into two columns on phones and three
     from 720px, never split across a column; from 1100px one part per track. */
  .fparts {
    columns: 2;
    column-gap: var(--s-5);
  }

  @media (min-width: 720px) {
    .fparts {
      columns: 3;
      column-gap: var(--s-6);
    }
  }

  @media (min-width: 1100px) {
    .fparts {
      columns: auto;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s-6);
    }
  }

  .fpart {
    break-inside: avoid;
    padding-bottom: var(--s-4);
  }

  /* Sentence-case mono caption naming each part's list; --ink over --ink-2
     rows, never --muted on the tinted band. */
  .fpart-title {
    margin: 0 0 var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--ink);
  }

  .fpart-range {
    font-weight: 400;
    color: var(--ink-2);
  }

  .fchap {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fchap li {
    break-inside: avoid;
  }

  .fchap a {
    display: flex;
    gap: var(--s-2);
    padding: 2px 0;
  }

  /* --ink-2, not --muted: --muted fell to ~3.8:1 on the tinted band where it
     crosses the grid lines (audit SL-17); --ink-2 clears 4.5:1 in both themes. */
  .num {
    font-family: var(--font-mono);
    color: var(--ink-2);
  }

  .col a,
  .brand-links a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .col a:hover,
  .brand-links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* display: block overrides the global inline-flex .meta chip (effects.css) so
     the hairline above the meta line spans the whole container. */
  .meta {
    display: block;
    margin: var(--s-6) 0 0;
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    /* The colophon runs to ~45 characters (licence, version, domain), so it
       drops the global .meta capitals (audit SL-05). */
    text-transform: none;
    /* --ink-2, not --muted: the footer is a tinted band. */
    color: var(--ink-2);
  }

  /* Big display wordmark as a faint watermark closing the footer. aria-hidden
     and decorative. Sized in container-query units against .container so the
     whole name always fits its width; overflow:hidden + nowrap as a safety net. */
  .foot-wordmark {
    margin: var(--s-6) 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 5.6cqw, 5.5rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: color-mix(in srgb, var(--ink) 10%, var(--bg));
    white-space: nowrap;
    overflow: hidden;
  }
</style>
