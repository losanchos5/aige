---
/**
 * Header: sticky, near-solid ground (frosted only on desktop), 1px bottom line.
 * Left: RegisterMark + wordmark (the wordmark drops below 360px; the link keeps
 * its name via aria-label). Right: the grouped desktop nav (WAI-ARIA disclosure
 * navigation), a search button, the theme toggle and a burger. At >=840px the
 * group bar shows inline; below that it collapses into a modal <dialog> drawer
 * (MobileNav, a sibling of the header, so the header still holds exactly one
 * search button and one theme toggle). All behaviour is in /nav.js (CSP
 * script-src 'self').
 * `overlay` (the home) floats the bar over the full-viewport hero: fixed and
 * fully transparent at the top of the page, it takes the same ground, hairline
 * and elevation as everywhere else once the page scrolls (.is-scrolled, ui.js).
 * `lang` translates the chrome's own strings (src/i18n/ui.ts; the destinations
 * stay the English pages); `alternates`, the page's hreflang set, feeds the
 * language switcher, which only appears when the page exists in two languages
 * and machine translations are published (I18N_PUBLISHED, src/i18n/locales.ts;
 * off since 2026-09-25, so the Thesis links its Spanish version in the page).
 */
import RegisterMark from './RegisterMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import MobileNav from './MobileNav.astro';
import { site } from '../data/site';
import { nav, resolveCurrent, type NavGroup, type NavItem } from '../data/nav';
import { bookParts } from '../data/parts';
import { I18N_PUBLISHED, stripLocale } from '../i18n/locales';
import { translator, type UiKey } from '../i18n/ui';

interface Props {
  /** Float the bar, transparent until scrolled, over a full-viewport hero. */
  overlay?: boolean;
  /** Page language (the <html lang>); English by default. */
  lang?: string;
  /** The page's hreflang alternates, for the language switcher. */
  alternates?: { hreflang: string; href: string }[];
}

const { overlay = false, lang = 'en', alternates } = Astro.props;
const t = translator(lang);
const groupLabel = (group: NavGroup) => t(`nav.${group.id}` as UiKey);
// Part titles, keyed by part id (the chapter sections of the Body of Knowledge).
const partLabel = (id: string, fallback: string) =>
  bookParts.some((part) => part.id === id) ? t(`part.${id}` as UiKey) : fallback;

// A translated page (/de/bok/x) lights the same group as its English page, but
// no English link claims to be the current page (aria-current).
const pathname = Astro.url.pathname;
const englishPath = stripLocale(pathname);
const current = resolveCurrent(englishPath);
const currentHref = englishPath === pathname ? current.href : undefined;
const currentGroup = current.groupId;

const slugify = (text: string) =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const itemId = (groupId: string, item: NavItem) => `nav-${groupId}-${slugify(item.label)}`;
const isCurrentLink = (href: string, groupId: string) =>
  currentHref === href && currentGroup === groupId;
const leadLabel = (group: NavGroup) =>
  group.id === 'reference' ? t('header.allResources') : groupLabel(group);
const panelItems = (group: NavGroup) => group.items.filter((i) => i.placement !== 'footer');
const rowItems = (group: NavGroup) => panelItems(group).filter((i) => !i.num);
const chapterOf = (group: NavGroup) => panelItems(group).filter((i) => i.num);
const isDirect = (group: NavGroup) => panelItems(group).length === 0;
---

<header class="site-header" data-overlay={overlay ? '' : undefined}>
  <div class="container bar">
    <a class="brand" href="/" aria-label={t('header.home', { name: site.name })}>
      <RegisterMark size="sm" label={site.name} />
      <span class="wordmark">{site.name}</span>
    </a>

    <div class="right">
      <nav class="nav-desktop" aria-label={t('header.primary')}>
        <ul class="nav-top">
          {
            nav.map((group) =>
              isDirect(group) ? (
                <li class="nav-item" data-current={currentGroup === group.id ? '' : undefined}>
                  <a
                    class="nav-link"
                    href={group.href}
                    aria-current={isCurrentLink(group.href!, group.id) ? 'page' : undefined}
                  >
                    {groupLabel(group)}
                  </a>
                </li>
              ) : (
                <li
                  class="nav-group"
                  data-nav-group={group.id}
                  data-current={currentGroup === group.id ? '' : undefined}
                >
                  <button
                    type="button"
                    class="nav-trigger"
                    aria-expanded="false"
                    aria-controls={`nav-menu-${group.id}`}
                    data-nav-trigger
                  >
                    {groupLabel(group)}
                    <svg
                      class="chev"
                      viewBox="0 0 24 24"
                      width="14"
                      height="14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="m6 9 6 6 6-6"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>

                  <div class="nav-menu" id={`nav-menu-${group.id}`} hidden data-nav-menu>
                    <div class="container nav-menu-in">
                      <div class="nav-card" data-lead={group.href ? '' : undefined}>
                        {group.href ? (
                          <a
                            class="nav-lead"
                            href={group.href}
                            aria-describedby={`${group.id}-lead-d`}
                            aria-current={isCurrentLink(group.href, group.id) ? 'page' : undefined}
                          >
                            {leadLabel(group)}
                          </a>
                        ) : (
                          <p class="nav-lead">{groupLabel(group)}</p>
                        )}
                        <p class="nav-lead-d" id={`${group.id}-lead-d`}>
                          {group.description}
                        </p>
                      </div>

                      <div class="nav-menu-body">

                      {rowItems(group).length > 0 && (
                        <ul class="nav-menu-list">
                          {rowItems(group).map((item) => (
                            <li>
                              <a
                                id={itemId(group.id, item)}
                                href={item.href}
                                aria-describedby={`${itemId(group.id, item)}-d`}
                                aria-current={
                                  isCurrentLink(item.href, group.id) ? 'page' : undefined
                                }
                              >
                                {item.label}
                              </a>
                              <p id={`${itemId(group.id, item)}-d`}>{item.description}</p>
                            </li>
                          ))}
                        </ul>
                      )}

                      {group.sections ? (
                        <div class="nav-parts">
                          {group.sections.map((section) => (
                            <div class="nav-part">
                              <p class="nav-part-title" id={`nav-part-${section.id}`}>
                                {partLabel(section.id, section.label)}{' '}
                                <span class="nav-part-range">{section.range}</span>
                              </p>
                              <ol
                                class="nav-menu-chapters"
                                aria-labelledby={`nav-part-${section.id}`}
                              >
                                {section.items.map((item) => (
                                  <li>
                                    <a
                                      href={item.href}
                                      aria-current={
                                        isCurrentLink(item.href, group.id) ? 'page' : undefined
                                      }
                                    >
                                      <span class="num" aria-hidden="true">
                                        {item.num}
                                      </span>
                                      <span class="ch-label">{item.label}</span>
                                    </a>
                                  </li>
                                ))}
                              </ol>
                            </div>
                          ))}
                        </div>
                      ) : (
                        chapterOf(group).length > 0 && (
                          <ol class="nav-menu-chapters" aria-label={t('header.chapters')}>
                            {chapterOf(group).map((item) => (
                              <li>
                                <a
                                  href={item.href}
                                  aria-current={
                                    isCurrentLink(item.href, group.id) ? 'page' : undefined
                                  }
                                >
                                  <span class="num" aria-hidden="true">
                                    {item.num}
                                  </span>
                                  <span class="ch-label">{item.label}</span>
                                </a>
                              </li>
                            ))}
                          </ol>
                        )
                      )}
                      </div>
                    </div>
                  </div>
                </li>
              )
            )
          }
        </ul>
      </nav>

      {I18N_PUBLISHED && <LangSwitcher lang={lang} alternates={alternates} />}

      <button
        type="button"
        class="icon-btn search-btn"
        data-search-open
        data-umami-event="search-open"
        data-umami-event-location="header"
        aria-label={t('header.search')}
        aria-haspopup="dialog"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>

      <ThemeToggle lang={lang} />

      <button
        type="button"
        class="icon-btn burger"
        data-nav-open
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label={t('header.menu')}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<MobileNav lang={lang} alternates={alternates} />

<script is:inline defer src="/nav.js"></script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    /* Frosted bar: translucent ground + backdrop blur. The hairline + the
       --shadow-1 elevation are held back until the page is scrolled past 8px
       (initHeader in ui.js: passive, rAF-throttled). The 1px border is always
       present but transparent so the bar height never shifts. */
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
  }

  /* The blur is re-rendered on every scrolled frame, which low-end phones pay
     for; below the desktop breakpoint, and whenever the user asks for less
     transparency, the bar is a near-solid ground with no backdrop-filter.
     Written as an override so browsers without prefers-reduced-transparency
     keep the frosted desktop bar. */
  @media (max-width: 839px), (prefers-reduced-transparency: reduce) {
    .site-header {
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition:
        border-color var(--dur) var(--ease),
        box-shadow var(--dur) var(--ease);
    }
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: var(--shadow-1);
  }

  /* Overlay (the home): the bar floats over the hero's gradient field, so the
     hero starts at the top of the viewport and the brand sits on the field.
     Unscrolled it has no ground, blur, hairline or elevation (the field keeps
     the links >= 4.5:1 under the bar, see hero-field.js); once scrolled it
     falls back to the rules above, frosted on desktop and near-solid below
     840px or under prefers-reduced-transparency. Fixed, not sticky, so it takes
     no room in the flow; its height is unchanged. The selector outranks the
     narrow/reduced-transparency override. */
  .site-header[data-overlay] {
    position: fixed;
    inset: 0 0 auto;
  }

  .site-header[data-overlay]:not(.is-scrolled) {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* On the bare field the chevrons (--muted) step up to --ink-2, as muted
     text does over the mesh; the menus keep their own ground and colours. */
  .site-header[data-overlay]:not(.is-scrolled) .chev {
    color: var(--ink-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header[data-overlay] {
      transition:
        background-color var(--dur) var(--ease),
        border-color var(--dur) var(--ease),
        box-shadow var(--dur) var(--ease);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    padding-block: var(--s-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--ink);
    text-decoration: none;
  }

  /* break-word, not anywhere: it leaves the min-content width at the longest
     word, which is what tells the phone bar below to wrap. */
  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    line-height: 1;
    overflow-wrap: break-word;
  }

  .right {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  /* Phones (the drawer layout). Text enlarged to 200% (WCAG 1.4.4) made the
     wordmark alone wider than the bar: the page scrolled sideways to ~435px at
     390 and the menu button left the viewport. Here the bar may wrap. The
     brand's flex basis is 0, so the row only breaks when the wordmark's longest
     word cannot sit beside the buttons (enlarged text); at normal sizes it stays
     one row and the brand grows up to its own width, the wordmark wrapping
     between words as before. On a second row the buttons stay pinned right.
     The desktop bar (>=840px) keeps its single-row flex. */
  @media (max-width: 839px) {
    .bar {
      flex-wrap: wrap;
    }

    .brand {
      flex: 1 1 0;
      max-width: max-content;
    }

    .right {
      margin-left: auto;
    }
  }

  /* 320px reflow (WCAG 1.4.10): the wordmark plus three 44px buttons overflow
     below 360px, so the bar tightens its gaps and keeps only the mark; the
     brand link is still named by its aria-label. */
  @media (max-width: 359px) {
    .bar {
      gap: var(--s-3);
    }

    .right {
      gap: var(--s-2);
    }

    .wordmark {
      display: none;
    }
  }

  /* ---------- Desktop group bar (>=840px) ---------- */
  .nav-desktop {
    display: none;
  }

  .nav-top {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The group li stays static so its panel anchors to the sticky header, not to
     the (narrower, centred) container. */
  .nav-group {
    position: static;
  }

  .nav-link,
  .nav-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    /* A 25px hit area (WCAG 2.5.8 asks 24) around the 15px label: the
       padding grows the box, the equal negative margin keeps the bar's
       layout exactly as it was. */
    margin: -5px 0;
    padding: 5px 0;
    border: 0;
    background: none;
    color: var(--ink-2);
    font-family: inherit;
    font-size: 0.9375rem;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }

  .nav-link:hover,
  .nav-trigger:hover {
    color: var(--ink);
  }

  .nav-link[aria-current='page'],
  .nav-item[data-current] .nav-link,
  .nav-group[data-current] .nav-trigger {
    color: var(--ink);
    font-weight: 600;
  }

  /* Group chevron: flips to point up while its panel is open (aria-expanded). */
  .chev {
    color: var(--muted);
    transform-origin: 50% 50%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chev {
      transition: transform var(--dur) var(--ease);
    }
  }

  .nav-trigger[aria-expanded='true'] .chev {
    transform: rotate(180deg);
  }

  /* Underline that grows from the left on hover/focus, on the open trigger and
     on the current link/group. */
  .nav-link::after,
  .nav-trigger::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    /* 6px under the label, as before the hit-area padding (5px of it). */
    bottom: -1px;
    height: 2px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-link::after,
    .nav-trigger::after {
      transition: transform var(--dur) var(--ease);
    }
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[aria-current='page']::after,
  .nav-item[data-current] .nav-link::after,
  .nav-trigger:hover::after,
  .nav-trigger:focus-visible::after,
  .nav-trigger[aria-expanded='true']::after,
  .nav-group[data-current] .nav-trigger::after {
    transform: scaleX(1);
  }

  /* The panel: anchored to the sticky header, spanning its full width; hidden
     keeps it out of the a11y tree and out of scrollWidth. */
  .nav-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 30;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--ink) 8%, transparent);
    padding-block: var(--s-5) var(--s-6);
    /* The Body of Knowledge panel lists every chapter: on a short window it
       scrolls inside itself rather than running off the bottom of the screen
       (the header is sticky, so the page cannot scroll it into view). */
    max-height: calc(100dvh - 72px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .nav-menu[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-menu:not([hidden]) .nav-menu-in {
      animation: nav-in var(--dur) var(--ease);
    }
  }

  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* The panel: a card on the left carries the group's name and one-line
     description on a static cut of the home hero's gradient field (the same
     --field-1..3 tokens), fading to the page ground where the text sits so
     it reads as it does on the plain panel; the group's links fill the
     column on the right. The card is the lead link when the group has a
     landing page (its whole face is clickable). */
  .nav-menu-in {
    display: grid;
    grid-template-columns: minmax(220px, 288px) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: stretch;
  }

  .nav-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2px;
    min-height: 168px;
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background:
      linear-gradient(to bottom, transparent 8%, var(--bg) 60%),
      radial-gradient(60% 80% at 100% 0%, var(--field-1), transparent 72%),
      radial-gradient(70% 85% at 60% 0%, var(--field-2), transparent 72%),
      radial-gradient(80% 95% at 0% 0%, var(--field-3), transparent 72%),
      var(--bg);
    overflow: hidden;
  }

  .nav-card[data-lead] .nav-lead::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .nav-card[data-lead]:hover {
    border-color: color-mix(in srgb, var(--hero-ink) 35%, var(--line));
  }

  .nav-menu-body {
    align-self: center;
    min-width: 0;
  }

  .nav-lead {
    display: inline-block;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--hero-ink);
    text-decoration: none;
  }

  .nav-lead:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .nav-lead-d {
    margin: 0;
    max-width: 64ch;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .nav-menu-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2) var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-menu-list li {
    position: relative;
    margin-inline: calc(-1 * var(--s-3));
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-sm);
  }

  .nav-menu-list li:hover,
  .nav-menu-list li:focus-within {
    background: var(--tint-bg);
  }

  .nav-menu-list a {
    display: inline-block;
    color: var(--ink);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
  }

  /* Whole row clickable: the link's overlay covers the li (label + description);
     the accessible name stays just the label. */
  .nav-menu-list a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .nav-menu-list a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .nav-menu-list li p {
    margin: 2px 0 0;
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .nav-menu-chapters {
    columns: 2;
    column-gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-menu-chapters li {
    break-inside: avoid;
  }

  .nav-menu-chapters a {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    margin-inline: calc(-1 * var(--s-2));
    padding: var(--s-1) var(--s-2);
    border-radius: var(--r-sm);
    color: var(--ink);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .nav-menu-chapters a:hover,
  .nav-menu-chapters a:focus-visible {
    background: var(--tint-bg);
  }

  .nav-menu-chapters a:hover .ch-label {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .nav-menu-chapters a[aria-current='page'] {
    font-weight: 600;
  }

  .nav-menu-chapters .num {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--hero-ink);
  }

  /* The Body of Knowledge by part: one named list per part, the parts flowed
     into columns (two, three from 1024px, four from 1280px, so a column stays
     wide enough for "22 Principles & Standards" on one line) and never split
     across a column, so a part and its chapters always read as one block. */
  .nav-parts {
    columns: 2;
    column-gap: var(--s-6);
  }

  @media (min-width: 1024px) {
    .nav-parts {
      columns: 3;
    }
  }

  @media (min-width: 1280px) {
    .nav-parts {
      columns: 4;
    }
  }

  .nav-part {
    break-inside: avoid;
    padding-bottom: var(--s-4);
  }

  .nav-part .nav-menu-chapters {
    columns: 1;
  }

  /* Sentence-case mono caption over each part's list (not an eyebrow: it names
     the list below it, like the footer's group titles). */
  .nav-part-title {
    margin: 0 0 var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--ink);
  }

  .nav-part-range {
    font-weight: 400;
    color: var(--ink-2);
  }

  /* ---------- Icon buttons + burger ---------- */
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
