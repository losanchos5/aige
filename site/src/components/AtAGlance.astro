---
/**
 * AtAGlance, the opening register of a chapter: three or four one-sentence
 * takeaways in a numbered grid, rendered between the ChapterHeader and the
 * prose. On desktop it bleeds to the reading well like a diagram figure
 * (container-query full-bleed, see diagrams.css) so the first viewport has a
 * structured block before the text starts. Items come from `chapter.glance`
 * in src/data/chapters.ts. The column count follows the item count, so no
 * row is left with a single orphan: four items read 2×2, three read 3×1.
 */
interface Props {
  items?: readonly string[];
  class?: string;
}

const { items, class: className } = Astro.props;
const count = items?.length ?? 0;
const cols = count % 3 === 0 ? 3 : count % 2 === 0 ? 2 : 1;
---

{
  items && items.length > 0 && (
    <aside class:list={['glance', className]} aria-labelledby="glance-label">
      <p class="glance-label" id="glance-label">At a glance</p>
      <ol class="glance-list" data-cols={cols}>
        {items.map((item, i) => (
          <li class="glance-item">
            <span class="glance-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="glance-text">{item}</span>
          </li>
        ))}
      </ol>
    </aside>
  )
}

<style>
  /* A flat box: --surface fill and a 1px --line frame, no shadow, no hover
     ring and no accent rule (the list is not a set of layers). It is its own
     inline-size container so the grid below can size to the box. */
  .glance {
    container-type: inline-size;
    margin: var(--s-5) 0 var(--s-6);
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  /* Same bleed as .prose > .diagram: take the whole well, not the 72ch column. */
  :global(.prose) > .glance {
    width: 100cqw;
    margin-inline: calc(50% - 50cqw);
  }

  .glance-label {
    margin: 0 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .glance-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4) var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container (min-width: 440px) {
    .glance-list[data-cols='2'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 660px) {
    .glance-list[data-cols='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .glance-item {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    margin: 0;
    padding: 0;
  }

  .glance-num {
    flex: none;
    padding-top: 0.2em;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-2);
  }

  .glance-text {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink);
    text-wrap: pretty;
  }
</style>
