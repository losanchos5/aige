---
/**
 * AtAGlance, the opening register of a chapter: three or four one-sentence
 * takeaways in a numbered grid, rendered between the ChapterHeader and the
 * prose. On desktop it bleeds to the reading well like a diagram figure
 * (container-query full-bleed, see diagrams.css) so the first viewport has a
 * structured block before the text starts. Items come from `chapter.glance`
 * in src/data/chapters.ts. The column count follows the item count, so no
 * row is left with a single orphan: four items read 2×2, three read 3×1.
 *
 * Under it sits "Key terms in this chapter": the chapter's `keyTerms`
 * (chapters.ts), resolved to glossary entries by the page, as a flat row of
 * term links to /glossary/<slug>. They carry the same `a.term` class and
 * `data-term` key as the terms rehype-glossary wraps in the prose, so the
 * hover cards (public/glossary-cards.js) work on them too. A chapter with key
 * terms and no glance (the preface) shows the row alone.
 */
interface KeyTerm {
  /** Display name, from the glossary entry. */
  term: string;
  /** /glossary/<slug>. */
  url: string;
  /** The term's `t-` id, the hover cards' key. */
  id: string;
}

import { translator } from '../i18n/ui';

interface Props {
  items?: readonly string[];
  terms?: readonly KeyTerm[];
  class?: string;
  /** Page language, for the two labels. */
  lang?: string;
  /** Language of the term names when it is not the page's (English terms on a
      translated page). */
  termsLang?: string;
}

const { items, terms, class: className, lang = 'en', termsLang } = Astro.props;
const t = translator(lang);
const count = items?.length ?? 0;
const cols = count % 3 === 0 ? 3 : count % 2 === 0 ? 2 : 1;
---

{
  items && items.length > 0 && (
    <aside class:list={['glance', className]} aria-labelledby="glance-label">
      <p class="glance-label" id="glance-label">{t('glance.label')}</p>
      <ol class="glance-list" data-cols={cols}>
        {items.map((item, i) => (
          <li class="glance-item">
            <span class="glance-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="glance-text">{item}</span>
          </li>
        ))}
      </ol>
    </aside>
  )
}
{
  terms && terms.length > 0 && (
    <div class:list={['key-terms', !(items && items.length > 0) && className]}>
      <p class="key-terms-label" id="key-terms-label">
        {t('glance.keyTerms')}
      </p>
      <ul class="key-terms-list" aria-labelledby="key-terms-label" lang={termsLang}>
        {terms.map((t) => (
          <li>
            <a class="term" href={t.url} data-term={t.id}>
              {t.term}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  /* A flat box: --surface fill and a 1px --line frame, no shadow, no hover
     ring and no accent rule (the list is not a set of layers). It is its own
     inline-size container so the grid below can size to the box. */
  .glance {
    container-type: inline-size;
    margin: var(--s-5) 0 var(--s-6);
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  /* Same bleed as .prose > .diagram: take the whole well, not the 72ch column. */
  :global(.prose) > .glance {
    width: 100cqw;
    margin-inline: calc(50% - 50cqw);
  }

  .glance-label {
    margin: 0 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .glance-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4) var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container (min-width: 440px) {
    .glance-list[data-cols='2'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 660px) {
    .glance-list[data-cols='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .glance-item {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    margin: 0;
    padding: 0;
  }

  .glance-num {
    flex: none;
    padding-top: 0.2em;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-2);
  }

  .glance-text {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* Key terms: a hairline-ruled row under the glance box, not a second box.
     It takes the same bleed so its label lines up with the box's content. */
  .key-terms {
    margin: var(--s-5) 0 var(--s-6);
    padding: var(--s-3) var(--s-5);
    border-block: 1px solid var(--line);
  }

  :global(.prose) > .key-terms {
    width: 100cqw;
    margin-inline: calc(50% - 50cqw);
  }

  /* Tuck the row under the glance box: one --s-3 step instead of --s-6. */
  .glance:has(+ .key-terms) {
    margin-bottom: var(--s-3);
  }

  .glance + .key-terms {
    margin-top: 0;
  }

  .key-terms-label {
    margin: 0 0 var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .key-terms-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .key-terms-list li {
    margin: 0;
    padding: 0;
  }
</style>
