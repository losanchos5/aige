---
// PrevNext: chapter pager. prev / next are chapter-shaped records; either may be
// absent at the ends of the sequence. Each link is a hairline block: a mono
// "Previous" / "Next" label over the chapter's number and title. Only the arrow
// glyph is aria-hidden, so the link's accessible name is its visible text,
// "Previous <title>" / "Next <title>" (WCAG 2.5.3 label in name). `base` is
// where the chapters live (`/bok`, or `/de/bok` on a German page) and `lang`
// translates the labels.
import { getChapterBySlug } from '../data/chapters';
import { chapterNum } from '../data/parts';
import { translator } from '../i18n/ui';

interface Adjacent {
  slug: string;
  shortTitle: string;
}

interface Props {
  prev?: Adjacent;
  next?: Adjacent;
  base?: string;
  lang?: string;
}

const { prev, next, base = '/bok', lang = 'en' } = Astro.props;
const t = translator(lang);
// The chapter number before the title, when the neighbour is a chapter.
const num = (slug: string) => {
  const chapter = getChapterBySlug(slug);
  return chapter ? chapterNum(chapter.order) : undefined;
};
---

<nav class="pager" aria-label={t('pager.chapters')}>
  {
    prev ? (
      <a
        class="pager-link prev"
        href={`${base}/${prev.slug}`}
        rel="prev"
      >
        <span class="dir">
          <span class="arrow" aria-hidden="true">←</span>
          <span>{t('pager.previous')}</span>
        </span>
        <span class="name">{num(prev.slug) && <span class="n">{num(prev.slug)}</span>}{prev.shortTitle}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next ? (
      <a
        class="pager-link next"
        href={`${base}/${next.slug}`}
        rel="next"
      >
        <span class="dir">
          <span>{t('pager.next')}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </span>
        <span class="name">{num(next.slug) && <span class="n">{num(next.slug)}</span>}{next.shortTitle}</span>
      </a>
    ) : (
      <span />
    )
  }
</nav>

<style>
  /* Two equal tracks: prev always left, next always right (the empty <span>
     holds the missing side at either end of the sequence). One column on
     phones. */
  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    margin-top: 72px;
  }

  @media (max-width: 639px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }

    .pager > span:empty {
      display: none;
    }
  }

  .pager-link {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--r-blk);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .pager-link:hover {
    border-color: var(--accent-line);
    box-shadow: var(--lift);
  }

  @media (min-width: 640px) {
    .pager-link.next {
      grid-column: 2;
      justify-items: end;
      text-align: right;
    }
  }

  .dir {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  .arrow {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .arrow {
      transition: transform var(--dur) var(--ease);
    }
    .pager-link.prev:hover .arrow {
      transform: translateX(-4px);
    }
    .pager-link.next:hover .arrow {
      transform: translateX(4px);
    }
  }

  .name {
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.35;
  }

  .n {
    margin-right: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--accent);
  }
</style>
