---
// PrevNext: chapter pager. prev / next are chapter-shaped records; either may be
// absent at the ends of the sequence. Each link is a luminous card (card-lum +
// lift from effects.css): a small "Previous" / "Next" kicker over the chapter
// title. Only the arrow glyph is aria-hidden, so the link's accessible name is
// its visible text, "Previous <title>" / "Next <title>" (WCAG 2.5.3 label in
// name). `base` is where the chapters live (`/bok`, or `/de/bok` on a German
// page) and `lang` translates the labels.
import { translator } from '../i18n/ui';

interface Adjacent {
  slug: string;
  shortTitle: string;
}

interface Props {
  prev?: Adjacent;
  next?: Adjacent;
  base?: string;
  lang?: string;
}

const { prev, next, base = '/bok', lang = 'en' } = Astro.props;
const t = translator(lang);
---

<nav class="pager" aria-label={t('pager.chapters')}>
  {
    prev ? (
      <a
        class="pager-link prev card-lum lift"
        href={`${base}/${prev.slug}`}
        rel="prev"
      >
        <span class="dir">
          <span class="arrow" aria-hidden="true">←</span>
          <span>{t('pager.previous')}</span>
        </span>
        <span class="name">{prev.shortTitle}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next ? (
      <a
        class="pager-link next card-lum lift"
        href={`${base}/${next.slug}`}
        rel="next"
      >
        <span class="dir">
          <span>{t('pager.next')}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </span>
        <span class="name">{next.shortTitle}</span>
      </a>
    ) : (
      <span />
    )
  }
</nav>

<style>
  /* Two equal tracks: prev always left, next always right (the empty <span>
     holds the missing side at either end of the sequence). */
  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  /* card-lum (global) supplies border, surface, soft shadow and the hover ring;
     lift (global) the hover elevation. Only the card's inner layout lives here. */
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-4);
    text-decoration: none;
    color: var(--ink);
  }

  @media (min-width: 600px) {
    .pager-link {
      padding-inline: var(--s-5);
    }
  }

  .pager-link.next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }

  /* Kicker line: mono, uppercase, the site's label register. --ink-2 rather than
     a dimmed ink, so it holds AA on the card surface in both themes. */
  .dir {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .arrow {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .arrow {
      transition: transform var(--dur) var(--ease);
    }
    .pager-link.prev:hover .arrow {
      transform: translateX(-4px);
    }
    .pager-link.next:hover .arrow {
      transform: translateX(4px);
    }
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.25;
  }
</style>
