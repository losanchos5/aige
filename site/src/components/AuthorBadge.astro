---
/**
 * AuthorBadge: the author as an article byline shows them. A round photo, the
 * name (linked to /about with rel="author"), a LinkedIn button and the short
 * title, with room after the title for the dates the caller already prints.
 * One component for the three places the author appears (reference-page
 * Byline, ChapterHeader, /about), so they never drift apart. Built only from
 * phrasing elements (span, a, img, svg) because Byline nests it in a <p>.
 * `placement` only labels the analytics event, so a click can be traced to
 * where the reader was.
 */
import { site } from '../data/site';
import { translator } from '../i18n/ui';

interface Props {
  /** sm: the 40px byline under an H1. lg: the 160px block that opens /about. */
  size?: 'sm' | 'lg';
  placement: 'byline' | 'chapter' | 'about';
  lang?: string;
}

const { size = 'sm', placement, lang = 'en' } = Astro.props;
const author = site.authorDetails[0];
const t = translator(lang);
const px = size === 'lg' ? 160 : 40;
// The WebP files are the photo at 2x for each size (96 covers 40, 320 covers 160).
const src = `/images/author/jorge-garcia-aibar-${size === 'lg' ? 320 : 96}.webp`;
---

<span class:list={['ab', `ab--${size}`]}>
  {/* Empty alt: the name sits right next to the photo, so the image adds nothing for a screen reader. */}
  <img class="ab-photo" src={src} width={px} height={px} alt="" decoding="async" fetchpriority={size === 'lg' ? 'high' : undefined} />
  <span class="ab-name-row">
    {
      placement === 'about' ? (
        <span class="ab-name">{author.name}</span>
      ) : (
        <a class="ab-name" rel="author" href="/about">
          {author.name}
        </a>
      )
    }
    <a
      class="ab-in"
      href={site.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t('author.linkedin', { name: author.name })}
      data-umami-event="linkedin-click"
      data-umami-event-placement={placement}
    >
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
        ></path>
      </svg>
    </a>
  </span>
  <span class="ab-sub">
    <span>{author.headline}</span>
    <slot />
  </span>
</span>

<style>
  /* Photo in the first column across both rows; name row on top, title and
     dates below. Text stays at --ink / --ink-2, never dimmed with opacity. */
  .ab {
    display: inline-grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--s-3);
    row-gap: 2px;
    align-items: center;
  }

  .ab-photo {
    grid-row: 1 / span 2;
    border-radius: 50%;
    object-fit: cover;
    background: var(--line);
  }

  .ab-name-row {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    align-self: end;
  }

  .ab-name {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--ink);
  }

  a.ab-name {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.18em;
  }

  a.ab-name:hover {
    text-decoration-color: currentColor;
  }

  /* 28px hit area around the 16px glyph (WCAG 2.5.8 asks for 24). */
  .ab-in {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--r-sm);
    color: var(--ink-2);
  }

  .ab-in:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .ab-sub {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
    align-self: start;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-2);
  }

  .ab-sub > :global(* + *)::before {
    content: '·' / '';
    margin-right: var(--s-3);
    color: var(--ink-2);
  }

  .ab--sm .ab-name {
    font-size: var(--fs-small);
  }

  .ab--lg {
    column-gap: var(--s-5);
  }

  .ab--lg .ab-name {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    line-height: 1.15;
  }

  .ab--lg .ab-sub {
    font-size: var(--fs-small);
  }

  /* Phones: the large block stacks, photo above the text. */
  @media (max-width: 539px) {
    .ab--lg {
      grid-template-columns: 1fr;
      row-gap: var(--s-3);
    }

    .ab--lg .ab-photo {
      grid-row: auto;
      width: 120px;
      height: 120px;
    }
  }
</style>
