---
/**
 * Breadcrumb, a mono, uppercase trail of short labels: an optional layer
 * square, then an ordered list of crumbs separated by aria-hidden chevrons. The
 * last crumb is the current page (`aria-current="page"`, no link).
 *
 * This is the visible trail only. The matching schema.org BreadcrumbList is
 * built with `breadcrumbJsonLd(items)` (lib/breadcrumbs.ts) and handed to the
 * layout, so it lands in the page's single ld+json graph in the head: see
 * Doc.astro, which does it for the crumbs it renders, and the pages that render
 * a PageHero trail.
 */
import type { Crumb } from '../lib/breadcrumbs';
import { t } from '../i18n/ui';

interface Props {
  items: Crumb[];
  /** CSS colour for the 4px square: --ink by default, a layer var (e.g.
      `var(--l1)`) only when the page is about that layer. */
  swatch?: string;
  /** Draw a trailing 1px rule after the trail. */
  rule?: boolean;
  class?: string;
  /** Page language, for the landmark's name. */
  lang?: string;
}

const { items, swatch = 'var(--ink)', rule = false, class: className, lang = 'en' } = Astro.props;
---

<nav class:list={['crumbs', className]} aria-label={t('breadcrumb.label', lang)}>
  <span class="square" style={`background:${swatch}`} aria-hidden="true"></span>
  <ol>
    {
      items.map((crumb, i) => (
        <li class:list={{ current: !crumb.href }}>
          {i > 0 && (
            <span class="sep" aria-hidden="true">
              ›
            </span>
          )}
          {crumb.href ? (
            <a href={crumb.href}>{crumb.label}</a>
          ) : (
            <span aria-current="page">{crumb.label}</span>
          )}
        </li>
      ))
    }
  </ol>
  {rule && <span class="rule" aria-hidden="true"></span>}
</nav>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0;
    color: var(--muted);
  }

  .square {
    flex: none;
    width: 4px;
    height: 4px;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    flex: 1 1 auto;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .crumbs a,
  .crumbs [aria-current='page'],
  .sep {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  /* The current page's crumb: a touch stronger than the muted links. It is the
     one crumb long enough to overflow a phone's line, and it used to wrap: a
     trail that fit one line in the fallback monospace took two once JetBrains
     Mono loaded, pushing the page down 20px (CLS 0.22 on the glossary terms,
     audit of 2026-09-26). Sub-pixel width differences decide a trail that
     just fits, so instead the crumb takes what is left of the first line
     (flex-basis 0, so it never starts a line of its own) and truncates with
     an ellipsis: the trail is one line with either font. The page's <h1>,
     right below, carries the full title. */
  .crumbs li.current {
    flex: 1 1 0;
    min-width: 0;
  }

  .crumbs [aria-current='page'] {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-2);
    line-height: 1.3;
  }

  .sep {
    color: var(--muted);
  }

  .rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
</style>
