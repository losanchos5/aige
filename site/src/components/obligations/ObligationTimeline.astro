---
/**
 * ObligationTimeline: the application line of one register row, under the
 * evidence chain of /obligations/<id>. The date the row first applies, in its
 * status, and each later dated step with the system class it concerns and the
 * chapter's note, on a 2024 to 2031 axis (wider when the row's dates reach
 * further), against the row's review date as the dashed "As of" line: never
 * the build clock. A row with no date draws nothing. The facts list keeps
 * every date in text. Generated per page (lib/page-charts/obligation-strip.ts),
 * not registered in figures.ts; 'figc' mode, as the page loads figures.css
 * (reading.css).
 */
import Chart from '../Chart.astro';
import { appliesStatusLabels, systemClassLabels, type Obligation } from '../../data/frameworks';
import { obligationStrip, type StripEvent } from '../../lib/page-charts/obligation-strip';
import '../../styles/obligation-visuals.css';

interface Props {
  row: Obligation;
  /** The row's "applies from" note as the page prints it (status and date stripped). */
  note?: string;
}

const { row, note } = Astro.props;

const events: StripEvent[] = row.appliesFrom
  ? [
      {
        date: row.appliesFrom,
        style: row.appliesStatus,
        heading: appliesStatusLabels[row.appliesStatus],
        ...(note ? { detail: note } : {}),
      },
      ...(row.milestones ?? []).map((m) => ({
        date: m.date,
        style: m.date <= row.reviewed ? ('step-reached' as const) : ('step-ahead' as const),
        heading: m.systemClass?.length ? m.systemClass.map((c) => systemClassLabels[c]).join(' · ') : 'Later step',
        detail: m.note,
      })),
    ]
  : [];
const years = events.map((e) => Number(e.date.slice(0, 4)));
const base = events.length
  ? {
      title: 'When this obligation applies',
      desc: `${events.length === 1 ? 'The date' : `${events.length} dates`} of ${row.id} on a time axis, against its review date ${row.reviewed}.`,
      source: 'Obligation register (chapter 08)',
      events,
      from: `${Math.min(2024, ...years)}-01-01`,
      to: `${Math.max(2031, Math.max(...years) + 1)}-01-01`,
      marker: row.reviewed,
      tableCaption: `Dates of ${row.id}`,
    }
  : undefined;
const wide = base && obligationStrip({ ...base, id: 'obs-w', width: 720 });
const narrow = base && obligationStrip({ ...base, id: 'obs-n', width: 340 });
---

{
  wide && narrow && (
    <Chart
      class="obs"
      chart={wide}
      narrow={narrow}
      title="When this obligation applies"
      caption="The first date in the row's status, then each later step: filled once its date has passed, outlined while it is still ahead of the review date."
      tableLabel="Data table: the dates"
    />
  )
}

<style>
  :global(.obs) {
    max-width: 58rem;
    margin: 0 0 var(--s-6);
  }
</style>
