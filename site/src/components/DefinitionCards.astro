---
/**
 * DefinitionCards: a small row of luminous cards, each with a mono index, a
 * short title and a one-to-two-sentence body. Used on the home page for the
 * discipline's three core questions. Laid out on the shared .bento grid
 * (effects.css), held at three equal columns from 960px (the questions are
 * peers); in bento's two-column step the last card spans the row so none is
 * orphaned. Each <li> carries --i for a .reveal-stagger class passed in; the
 * card (and its lift) sits one level down because the reveal animation owns
 * the <li>'s transform.
 */
export interface DefinitionItem {
  /** Mono index label, e.g. `01`. */
  index: string;
  /** Card title. */
  title: string;
  /** One-to-two-sentence body. */
  body: string;
  /** Layer colour for the index swatch, e.g. `var(--l1)`. */
  swatch?: string;
}

interface Props {
  items: DefinitionItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ol class:list={['cards', 'bento', className]}>
  {
    items.map((item, i) => (
      <li style={`--i:${i}`}>
        <div class="card card-lum lift" style={`--tint:${item.swatch ?? 'var(--ink)'}`}>
          <p class="head">
            <span class="square" aria-hidden="true" />
            <span class="idx">{item.index}</span>
          </p>
          <h3 class="title">{item.title}</h3>
          <p class="body">{item.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  /* Gap and the one/two-column steps come from .bento; this resets the list
     and holds three columns (not bento's four) from 960px. */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 600px) and (max-width: 959.98px) {
    .cards > li:last-child:nth-child(odd) {
      grid-column: span 2;
    }
  }

  @media (min-width: 960px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Surface (border, radius, background, shadow) comes from .card-lum in
     effects.css; this rule keeps only the card's own layout. */
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    height: 100%;
    padding: var(--s-5);
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0;
  }

  .square {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--tint);
    border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .idx {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
  }

  .body {
    margin: 0;
    color: var(--ink-2);
    text-wrap: pretty;
  }
</style>
