---
/**
 * Seo — head metadata: title, description, canonical and Open Graph/Twitter.
 * Rendered inside <head> by the Base layout. The og:image default (/og/default.png)
 * is produced by a separate build block; this only references it.
 */
import { site } from '../data/site';
import { siteGraph, type JsonLdInput } from '../lib/jsonld';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  /** Open Graph locale, e.g. `en_US` (default) or `es_ES`. */
  locale?: string;
  /** JSON-LD structured data, merged into the site-wide @graph. */
  jsonLd?: JsonLdInput;
  /** hreflang alternates, e.g. Spanish translations of the page. */
  alternates?: { hreflang: string; href: string }[];
  /** Append ` · {site.name}` to the document title (default true). The home
      page and any page whose title already names the site pass false. */
  titleSuffix?: boolean;
}

const {
  title,
  description = site.description,
  // build.format is 'file', so Astro.url.pathname carries a `.html` suffix;
  // the canonical mirrors the clean URLs used by the nav, sitemap and JSON-LD.
  canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), site.url).href,
  image = '/og/default.png',
  locale = 'en_US',
  jsonLd,
  alternates,
  titleSuffix = true,
} = Astro.props;

// A search snippet is capped at ~160 characters. Most descriptions are written
// to that budget already; a chapter's lede is written for reading, so it is
// trimmed here on a word boundary with the same `…` the chapter manifest uses
// (see data/chapters.ts, "summaries … trimmed to <=160 chars").
const MAX_DESCRIPTION = 160;
function snippet(text: string): string {
  const clean = text.replace(/\s+/g, ' ').trim();
  if (clean.length <= MAX_DESCRIPTION) return clean;
  const cut = clean.slice(0, MAX_DESCRIPTION - 1);
  const lastSpace = cut.lastIndexOf(' ');
  return `${(lastSpace > 0 ? cut.slice(0, lastSpace) : cut).replace(/[\s,;:.]+$/, '')}…`;
}

const metaDescription = snippet(description);
const ogImage = new URL(image, site.url).href;
// The one place the site name is appended: layouts and pages pass the bare page
// title, so no title can carry the suffix twice.
const pageTitle = titleSuffix ? `${title} · ${site.name}` : title;
// Exactly one ld+json block per page: Organization + WebSite + the page's nodes.
const graph = siteGraph(jsonLd);
---

<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />

{alternates?.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />

{
  /* JSON-LD is a data block, not executable script, so CSP script-src does
     not apply; `<` is still escaped so page content can never break out. */
}
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(graph).replace(/</g, '\\u003c')}
/>
