---
// SidebarNav: the reading rail. The search button, a lead link (the Thesis, or
// the nav group's landing page), then numbered modules: by default the five
// parts of the Body of Knowledge (data/parts.ts), or, with `group`, the one
// module of a nav.ts group (Reference for the research notes, Practice for the
// controls, About, For you). Each module is a <details> with a large mono
// number, its title and its range over a tree of rows: a 1px rail with a tick
// per row and an L at the last one. The current row carries aria-current and
// shows a soft accent fill, a 1px ring and a heavier weight (never colour
// alone). Book rows keep the per-chapter reading register (.nav-track), which
// ui-doc.js fills as the chapter is read.
import { bookParts, chapterNum, formatRange } from '../data/parts';
import { nav, type NavGroup } from '../data/nav';
import { translator, type UiKey } from '../i18n/ui';

interface Props {
  activeSlug?: string;
  activeThesis?: boolean;
  /** Page language; translates the rail's labels. */
  lang?: string;
  /** Chapters that link to a translation instead of the English page, by slug. */
  links?: Record<string, { href: string; label: string }>;
  /** The Thesis link (default /thesis). */
  thesisHref?: string;
  /** Render this nav.ts group instead of the book's parts. */
  group?: NavGroup['id'];
}

const { activeSlug, activeThesis = false, lang = 'en', links, thesisHref = '/thesis', group } = Astro.props;
const t = translator(lang);
// On a translated page an English chapter title is marked as English.
const englishLang = lang === 'en' ? undefined : 'en';

interface Row {
  href: string;
  num: string;
  label: string;
  lang?: string;
  slug?: string;
  current: boolean;
}
interface Module {
  key: string;
  num: string;
  title: string;
  range: string;
  open: boolean;
  rows: Row[];
}

let label: string;
let lead: { href: string; label: string; current: boolean } | undefined;
let modules: Module[];

const navGroup = group ? nav.find((g) => g.id === group) : undefined;
if (group && !navGroup) throw new Error(`SidebarNav: no nav group "${group}"`);

if (navGroup) {
  // The static build renders /about as /about.html; compare without either suffix.
  const here = Astro.url.pathname.replace(/(\.html|\/)$/, '') || '/';
  const owns = (href: string) => here === href || here.startsWith(`${href}/`);
  const items = navGroup.items.filter((item) => !item.external && item.placement !== 'footer');
  label = navGroup.label;
  lead = navGroup.href ? { href: navGroup.href, label: navGroup.label, current: here === navGroup.href } : undefined;
  modules = [
    {
      key: navGroup.id,
      num: chapterNum(nav.indexOf(navGroup) + 1),
      title: navGroup.label,
      range: formatRange(items.map((_, i) => i + 1)),
      open: true,
      rows: items.map((item, i) => ({
        href: item.href,
        num: chapterNum(i + 1),
        label: item.label,
        current: owns(item.href),
      })),
    },
  ];
} else {
  label = t('sidebar.chapters');
  lead = { href: thesisHref, label: t('sidebar.thesis'), current: activeThesis };
  modules = bookParts.map((part, i) => {
    const rows = part.chapters.map((chapter) => ({
      href: links?.[chapter.slug]?.href ?? `/bok/${chapter.slug}`,
      num: chapterNum(chapter.order),
      label: links?.[chapter.slug]?.label ?? chapter.shortTitle,
      lang: links?.[chapter.slug] ? undefined : englishLang,
      slug: chapter.slug,
      current: activeSlug === chapter.slug,
    }));
    return {
      key: part.id,
      num: chapterNum(i + 1),
      title: t(`part.${part.id}` as UiKey),
      range: part.range,
      open: rows.some((row) => row.current),
      rows,
    };
  });
}
---

<nav class="sidebar-nav" aria-label={label}>
  <button
    type="button"
    class="sidebar-search"
    data-search-open
    data-umami-event="search-open"
    data-umami-event-location="sidebar"
  >
    <span class="ss-glyph" aria-hidden="true">&gt;</span>
    <span class="ss-text">{t('sidebar.search')}</span>
    <kbd>Ctrl K</kbd>
  </button>

  {
    lead && (
      <a href={lead.href} class="rail-link" aria-current={lead.current ? 'page' : undefined}>
        <span>{lead.label}</span>
        <span aria-hidden="true">→</span>
      </a>
    )
  }

  {
    modules.map((m) => (
      <details class="part" open={m.open}>
        <summary>
          <span class="pn" id={`sb-${m.key}-n`}>{m.num}</span>
          <span class="part-title" id={`sb-${m.key}-t`}>{m.title}</span>
          <span class="pr" id={`sb-${m.key}-r`}>{m.range}</span>
          <span class="chev" aria-hidden="true" />
        </summary>
        <ol class="tree" aria-labelledby={`sb-${m.key}-n sb-${m.key}-t sb-${m.key}-r`}>
          {m.rows.map((row) => (
            <li>
              <a
                href={row.href}
                class="nav-item"
                data-chapter-slug={row.slug}
                aria-current={row.current ? 'page' : undefined}
              >
                {row.slug && (
                  <span class="nav-track" aria-hidden="true">
                    <span class="nav-fill" />
                  </span>
                )}
                <span class="nav-num">{row.num}</span>
                <span class="nav-title" lang={row.lang}>{row.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    ))
  }
</nav>

<style>
  .sidebar-nav {
    font-size: var(--fs-small);
  }

  /* The search opener, drawn as the mockup's mono field: a prompt glyph, the
     label and the shortcut. It opens the site search dialog (Base). */
  .sidebar-search {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    width: 100%;
    height: 40px;
    padding: 0 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-ctl);
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-align: left;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }

  .sidebar-search:hover {
    border-color: var(--ink-2);
    color: var(--ink);
  }

  .ss-glyph {
    color: var(--accent);
    font-weight: 600;
  }

  .ss-text {
    flex: 1;
  }

  .sidebar-search kbd {
    padding: 1px 6px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font: inherit;
    font-size: var(--fs-label);
  }

  .rail-link {
    display: flex;
    justify-content: space-between;
    margin: var(--s-4) 0 var(--s-2);
    padding: 10px;
    border-radius: var(--r-ctl);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }

  .rail-link:hover {
    background: var(--hover);
    color: var(--accent);
  }

  .rail-link[aria-current='page'] {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px var(--accent-line);
    color: var(--accent);
  }

  /* One module per part: large mono number in the accent, mono title, range. */
  .part {
    border-top: 1px solid var(--line);
  }

  .part summary {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--s-2);
    padding: 14px 10px 14px 0;
    cursor: pointer;
    list-style: none;
  }

  .part summary::-webkit-details-marker {
    display: none;
  }

  .pn {
    font-family: var(--font-mono);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1;
    color: var(--accent);
  }

  .part-title {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .part[open] .part-title,
  .part summary:hover .part-title {
    color: var(--ink);
  }

  .part:has([aria-current='page']) .part-title {
    color: var(--accent);
  }

  .pr {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
  }

  /* Open or closed is shown by shape, not colour alone: the chevron points
     right when closed and down when open. */
  .chev {
    width: 7px;
    height: 7px;
    margin: 0 2px 0 4px;
    border-right: 1.5px solid var(--ink-2);
    border-bottom: 1.5px solid var(--ink-2);
    transform: rotate(-45deg);
  }

  .part[open] .chev {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .chev {
      transition: transform var(--dur) var(--ease);
    }
  }

  /* The tree: a 1px rail down every row (half a row on the last, the L) and a
     tick into each row. */
  .tree {
    margin: 0 0 14px 11px;
    padding: 0;
    list-style: none;
  }

  .tree li {
    position: relative;
    margin: 0;
    padding-left: 16px;
  }

  .tree li::before,
  .tree li::after {
    content: '';
    position: absolute;
    left: 0;
    background: var(--line-strong);
  }

  .tree li::before {
    top: 0;
    bottom: 0;
    width: 1px;
  }

  .tree li:last-child::before {
    bottom: 50%;
  }

  .tree li::after {
    top: 50%;
    width: 10px;
    height: 1px;
  }

  .nav-item {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr);
    gap: var(--s-1);
    padding: 6px 10px;
    border-radius: var(--r-ctl);
    line-height: 1.4;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .nav-num {
    padding-top: 1px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
  }

  .nav-item:hover {
    background: var(--hover);
    color: var(--accent);
  }

  .nav-item:hover .nav-num,
  .nav-item[aria-current='page'] .nav-num {
    color: var(--accent);
  }

  .nav-item[aria-current='page'] {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px var(--accent-line);
    color: var(--accent);
    font-weight: 500;
  }

  /* Reading register: the row's stretch of the rail, positioned on the <li>
     (the link is not a containing block). The current chapter fills in the
     accent as it is read; chapters marked read in localStorage show it full. */
  .nav-track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    overflow: hidden;
  }

  .tree li:last-child .nav-track {
    bottom: 50%;
  }

  .nav-fill {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleY(var(--np, 0));
    transform-origin: top;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-fill {
      transition: transform var(--dur) var(--ease);
    }
  }

  .nav-item.is-read .nav-fill {
    transform: scaleY(1);
    background: var(--muted);
  }
</style>
