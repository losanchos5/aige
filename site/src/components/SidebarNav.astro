---
// SidebarNav: the chapter rail. The Thesis on top, then the eleven BoK chapters
// with mono 00–10 indices. The active row carries aria-current and shows a
// neutral ink tick. No per-row layer colour: chapters are not layers (SL-06).
import { chaptersOrdered } from '../data/chapters';

interface Props {
  activeSlug?: string;
  activeThesis?: boolean;
}

const { activeSlug, activeThesis = false } = Astro.props;
---

<nav class="sidebar-nav" aria-label="Chapters">
  <span class="nav-rail" data-nav-rail aria-hidden="true"></span>

  <div class="sidebar-tools">
    <button type="button" class="sidebar-search" data-search-open>
      <span>Search</span>
      <kbd>Ctrl K</kbd>
    </button>
  </div>

  <a
    href="/thesis"
    class="nav-item nav-thesis"
    aria-current={activeThesis ? 'page' : undefined}
  >
    <span class="nav-num">§</span>
    <span class="nav-title">The Thesis</span>
  </a>

  <p class="nav-label">Body of Knowledge</p>
  <ol class="nav-list">
    {
      chaptersOrdered.map((chapter) => (
        <li>
          <a
            href={`/bok/${chapter.slug}`}
            class="nav-item"
            data-chapter-slug={chapter.slug}
            aria-current={activeSlug === chapter.slug ? 'page' : undefined}
          >
            <span class="nav-track" aria-hidden="true">
              <span class="nav-fill" />
            </span>
            <span class="nav-num">{String(chapter.order).padStart(2, '0')}</span>
            <span class="nav-title">{chapter.shortTitle}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .sidebar-nav {
    position: relative;
    font-size: 0.9375rem;
    /* Absorb the rows' negative inline margins (their active/hover fill bleeds
       to the rail edge) so nothing extends past the nav box and forces a
       horizontal scrollbar on the sticky sidebar. */
    padding-inline: var(--s-2);
  }

  /* A single accent that ui-doc.js slides onto the current row (mirrors the TOC
     marker). Sits at the rows' left bleed edge (x=0 of the nav's border box, so
     it never widens the box: layout.spec forbids horizontal overflow here) and
     takes the current layer's ink. Transform and background are set by JS
     (translateY to the row, scaleY to its height over this box's height), so it
     moves without animating layout; with no JS it stays at scaleY(0) and the
     active row's fill carries the state. */
  .nav-rail {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: var(--s-6);
    border-radius: 2px;
    background: var(--ink);
    box-shadow: 0 0 6px color-mix(in srgb, var(--ink) 35%, transparent);
    transform: scaleY(0);
    transform-origin: top;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-rail {
      transition: transform var(--dur) var(--ease);
    }
  }

  .sidebar-tools {
    margin-bottom: var(--s-4);
  }

  .sidebar-search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    width: 100%;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    font-size: var(--fs-small);
    transition: border-color var(--dur) var(--ease);
  }

  .sidebar-search:hover {
    border-color: var(--ink-2);
    color: var(--ink);
  }

  .sidebar-search kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }

  /* Section kicker: the site's label register (mono, --fs-label, label
     tracking) in --ink-2, matching the TOC's "On this page" label. */
  .nav-label {
    margin: var(--s-5) 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* --layer-ink is the row's accent, used by the hover tint and copied onto the
     rail by ui-doc.js when the row is current. Neutral on every row: the rail
     rotated the five layer inks by index, which read as a layer code. */
  .nav-item {
    --layer-ink: var(--ink-2);
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-3);
    margin-inline: calc(var(--s-2) * -1);
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--ink-2);
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }


  /* Reading "register": a 3px track per chapter row. The current page fills as
     it is read; chapters marked read in localStorage show a muted full bar. */
  .nav-track {
    position: absolute;
    left: var(--s-1);
    top: var(--s-1);
    bottom: var(--s-1);
    width: 3px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    overflow: hidden;
  }

  .nav-fill {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleY(var(--np, 0));
    transform-origin: top;
    background: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-fill {
      transition: transform var(--dur) var(--ease);
    }
  }

  .nav-item.is-read .nav-fill {
    transform: scaleY(1);
    background: var(--muted);
  }

  .nav-item:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--layer-ink) 10%, transparent);
  }

  /* On the tinted hover fill --muted drops under AA; step the index up to
     --ink-2 there (the same re-scope every non-flat surface gets). */
  .nav-item:hover .nav-num {
    color: var(--ink-2);
  }

  .nav-num {
    flex: none;
    width: 1.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
  }

  .nav-title {
    line-height: 1.3;
  }

  .nav-thesis {
    --layer-ink: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
  }

  /* The current row: a soft fill and heavier weight (the no-JS active state);
     the sliding .nav-rail is layered on top when JS runs. */
  .nav-item[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
    background: var(--surface);
  }

  .nav-item[aria-current='page'] .nav-num { color: var(--ink); }
</style>
