---
/**
 * NewsletterForm: a plain, backend-free sign-up that posts straight to the
 * newsletter provider named in data/site.ts. The browser does the POST; there
 * is no script here, and the address never reaches this site. It renders
 * nothing while `site.newsletter.action` is empty, so the feature stays dark
 * until a real endpoint is configured.
 *
 * `location` names where the form sits (home, chapter, about): it becomes the
 * field id suffix, so two forms never share an id, and the Umami event's
 * `location` property on the submit button (a declarative data attribute; it
 * does nothing unless Base.astro loads Umami, and it never sends the address).
 */
import { site } from '../data/site';

interface Props {
  location?: string;
}

const { location = 'about' } = Astro.props;
const { action } = site.newsletter;
const fieldId = `nl-email-${location}`;
---

{
  action && (
    <form class="newsletter" method="post" action={action}>
      <label class="nl-label" for={fieldId}>
        Get an email when a chapter changes
      </label>
      <div class="nl-row">
        <input
          class="nl-input"
          id={fieldId}
          type="email"
          name="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
        />
        <button
          class="btn btn-primary nl-submit"
          type="submit"
          data-umami-event="newsletter-subscribe"
          data-umami-event-location={location}
        >
          Subscribe
        </button>
      </div>
      <p class="nl-note">
        Occasional updates when a chapter changes. The form posts straight to Buttondown; this
        site never receives your address.
      </p>
    </form>
  )
}

<style>
  /* Vertical rhythm on the spacing scale: label → field row --s-2 (the label
     belongs to the input), row → note --s-3, wrapped input/button --s-3. */
  .newsletter {
    max-width: 32rem;
  }

  .nl-label {
    display: block;
    margin-bottom: var(--s-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
  }

  .nl-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .nl-input {
    flex: 1 1 14rem;
    /* Shrink below the input's intrinsic width: with text at 200% the 14rem
       basis is wider than a 390px screen. */
    min-width: 0;
    max-width: 100%;
    min-height: 44px;
    padding: 0 var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink);
  }

  .nl-input::placeholder {
    color: var(--muted);
  }

  .nl-input:focus-visible {
    border-color: var(--ink-2);
  }

  /* One ring for both controls; beats the global .btn:focus-visible ink ring. */
  .nl-input:focus-visible,
  .nl-submit:focus-visible {
    outline: 2px solid var(--l1-ink);
    outline-offset: 2px;
  }

  .nl-submit {
    flex: 0 0 auto;
  }

  /* Helper text in --ink-2 (colour, never opacity): --muted sits at ~4.8:1 on
     --bg and gives nothing to spare on a tinted surface. */
  .nl-note {
    margin: var(--s-3) 0 0;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
</style>
