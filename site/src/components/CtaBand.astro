---
/**
 * CtaBand — a full-width ink block with ground-coloured text, a headline and up
 * to two buttons. Primary = ground fill on ink with the .btn-glow halo;
 * secondary = a quiet outline (softened ground border) at the same height.
 * Place as a direct child of <main> (outside .container) so it spans full width.
 */
interface Cta {
  label: string;
  href: string;
}

interface Props {
  title: string;
  sub?: string;
  primary: Cta;
  secondary?: Cta;
  class?: string;
}

const { title, sub, primary, secondary, class: className } = Astro.props;
---

<section class:list={['band', className]}>
  <div class="bg-mesh" aria-hidden="true"></div>
  <div class="container inner">
    <div class="copy">
      <h2 class="title">{title}</h2>
      {sub && <p class="sub">{sub}</p>}
    </div>
    <div class="actions">
      <a class="cta cta-primary" href={primary.href}>{primary.label}</a>
      {secondary && <a class="cta cta-secondary" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  /* The band's ::before belongs to the Marketing register rule (the numbered
     notch between sections), so it gets the section contract: --sec-bg notches
     the number on the ink ground, and --ink-2 (the number's colour) is
     re-scoped to the softened ground so it reads on ink in both themes. No
     overflow clip: the notch straddles the top edge like every other section
     (the mesh clips itself). */
  .band {
    position: relative;
    isolation: isolate;
    background: var(--ink);
    color: var(--bg);
    padding-block: clamp(48px, 7vw, 96px);
    --sec-bg: var(--ink);
    --ink-2: color-mix(in srgb, var(--bg) 82%, var(--ink));
  }

  /* 2px gradient hairline along the top edge, under the register notch. */
  .band::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--grad-border);
    z-index: 1;
    pointer-events: none;
  }

  /* Faint mesh behind the copy; --mesh-alpha dialled right down so it reads as
     a whisper of depth, not colour. */
  .band .bg-mesh {
    --mesh-alpha: 0.25;
    z-index: 0;
  }

  .inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
  }

  .copy {
    max-width: 40ch;
  }

  .title {
    margin: 0;
    color: var(--bg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h2);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
  }

  .sub {
    margin: var(--s-3) 0 0;
    color: color-mix(in srgb, var(--bg) 82%, var(--ink));
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s-5);
    border: 1px solid var(--bg);
    border-radius: var(--r-sm);
    font-weight: 600;
    text-decoration: none;
  }

  /* Primary: the ground fill carries the same soft --glow-1 halo as .btn-glow
     (the gradient itself would vanish on the ink ground). */
  .cta-primary {
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 2px 12px var(--glow-1);
  }

  /* Secondary: an outline one weight down — the border is the ground at 45%,
     so the label (full ground colour) keeps its contrast. */
  .cta-secondary {
    background: transparent;
    color: var(--bg);
    border-color: color-mix(in srgb, var(--bg) 45%, transparent);
  }

  .cta:focus-visible {
    outline: 2px solid var(--bg);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cta {
      transition:
        background-color var(--dur) var(--ease),
        border-color var(--dur) var(--ease),
        color var(--dur) var(--ease),
        box-shadow var(--dur) var(--ease),
        transform var(--dur) var(--ease);
    }

    .cta-primary:hover {
      box-shadow: 0 8px 24px var(--glow-1);
      transform: translateY(-1px);
    }
  }

  .cta-secondary:hover {
    background: color-mix(in srgb, var(--bg) 14%, transparent);
    border-color: var(--bg);
  }
</style>
