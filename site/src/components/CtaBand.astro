---
/**
 * CtaBand — a full-width closing band with a headline and up to two buttons.
 * Light theme: an ink block with ground-coloured text. Dark theme: the L1
 * layer's deep tone with the page's own ink (inverting there would make it a
 * cream slab, the brightest thing on the page). Primary = a solid fill in the
 * band's text colour, no halo; secondary = a quiet outline at the same height.
 * Place as a direct child of <main> (outside .container) so it spans full width.
 */
interface Cta {
  label: string;
  href: string;
}

interface Props {
  title: string;
  sub?: string;
  primary: Cta;
  secondary?: Cta;
  class?: string;
}

const { title, sub, primary, secondary, class: className } = Astro.props;
---

<section class:list={['band', className]}>
  <div class="bg-mesh" aria-hidden="true"></div>
  <div class="container inner">
    <div class="copy">
      <h2 class="title">{title}</h2>
      {sub && <p class="sub">{sub}</p>}
    </div>
    <div class="actions">
      <a class="cta cta-primary" href={primary.href}>{primary.label}</a>
      {secondary && <a class="cta cta-secondary" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  /* The band's colours live in three locals so the dark theme can swap them in
     one place: --band-fill (ground), --band-text (title, labels, borders) and
     --band-text-2 (the sub line). The Marketing rule draws the 1px hairline on
     top like on every other section; the mesh clips itself. */
  .band {
    --band-fill: var(--ink);
    --band-text: var(--bg);
    --band-text-2: color-mix(in srgb, var(--bg) 82%, var(--ink));
    position: relative;
    isolation: isolate;
    background: var(--band-fill);
    color: var(--band-text);
    padding-block: clamp(48px, 7vw, 96px);
  }

  /* Dark theme: the deep L1 tone (dark --l1) instead of the inverted ink, with
     the page's --ink / --ink-2 on it. Same two selectors as tokens.css. */
  :global(:root[data-theme='dark']) .band {
    --band-fill: var(--l1);
    --band-text: var(--ink);
    --band-text-2: var(--ink-2);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .band {
      --band-fill: var(--l1);
      --band-text: var(--ink);
      --band-text-2: var(--ink-2);
    }
  }

  /* 2px gradient hairline along the top edge. */
  .band::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--grad-border);
    z-index: 1;
    pointer-events: none;
  }

  /* Faint mesh behind the copy; --mesh-alpha dialled right down so it reads as
     a whisper of depth, not colour. */
  .band .bg-mesh {
    --mesh-alpha: 0.25;
    z-index: 0;
  }

  .inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
  }

  .copy {
    max-width: 40ch;
  }

  .title {
    margin: 0;
    color: var(--band-text);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h2);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
  }

  .sub {
    margin: var(--s-3) 0 0;
    color: var(--band-text-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s-5);
    border: 1px solid var(--band-text);
    border-radius: var(--r-sm);
    font-weight: 600;
    text-decoration: none;
  }

  /* Primary: a solid fill in the band's text colour with the band's ground
     for the label. No coloured halo: the fill carries the weight. */
  .cta-primary {
    background: var(--band-text);
    color: var(--band-fill);
  }

  /* Secondary: an outline one weight down — the border is the text colour at
     45%, so the label (full text colour) keeps its contrast. */
  .cta-secondary {
    background: transparent;
    color: var(--band-text);
    border-color: color-mix(in srgb, var(--band-text) 45%, transparent);
  }

  .cta:focus-visible {
    outline: 2px solid var(--band-text);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cta {
      transition:
        background-color var(--dur) var(--ease),
        border-color var(--dur) var(--ease),
        color var(--dur) var(--ease),
        transform var(--dur) var(--ease);
    }

    .cta-primary:hover {
      transform: translateY(-1px);
    }
  }

  .cta-secondary:hover {
    background: color-mix(in srgb, var(--band-text) 14%, transparent);
    border-color: var(--band-text);
  }
</style>
