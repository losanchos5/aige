---
/**
 * CtaBand: the single dark closing band (editorial restraint). A --band
 * ground with --band-ink text, a 1px --band-line hairline on top, a Newsreader
 * sentence and one button; an optional secondary reads as a plain text link,
 * not a second button. No mesh, glow or gradient.
 * The named slot "art" sits behind the copy: a <Painting> there covers the
 * band under a flat veil (the home's closing band); it is empty by default.
 * Place as a direct child of <main> (outside .container) so it spans full width.
 */
interface Cta {
  label: string;
  href: string;
}

interface Props {
  title: string;
  sub?: string;
  primary: Cta;
  secondary?: Cta;
  class?: string;
}

const { title, sub, primary, secondary, class: className } = Astro.props;
---

<section class:list={['band', className]}>
  {Astro.slots.has('art') && <div class="art" aria-hidden="true"><slot name="art" /></div>}
  <div class="container inner">
    <div class="copy">
      <h2 class="title">{title}</h2>
      {sub && <p class="sub">{sub}</p>}
    </div>
    <div class="actions">
      <a class="cta" href={primary.href}>{primary.label}</a>
      {secondary && <a class="link" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  /* --band / --band-ink / --band-ink-2 / --band-line are theme tokens
     (tokens.css), so the band needs no per-theme rules here. */
  .band {
    position: relative;
    isolation: isolate;
    background: var(--band);
    color: var(--band-ink);
    border-top: 1px solid var(--band-line);
    padding-block: clamp(72px, 9vw, 120px);
  }

  /* Painting layer: fills the band under the copy. */
  .art {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* One column, as in the mockup: sentence, sub line, then the button. */
  .inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 36px;
  }

  /* anywhere: a word wider than a phone (text at 200%) breaks instead of
     pushing the page sideways; at normal sizes no word reaches the edge. */
  .copy {
    max-width: 56rem;
    overflow-wrap: anywhere;
  }

  .title {
    max-width: 22ch;
    margin: 0;
    color: var(--band-ink);
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.25rem, 1.5rem + 2.8vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .sub {
    max-width: 56ch;
    margin: 20px 0 0;
    font-size: var(--fs-lede);
    color: var(--band-ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }

  /* The one button: a band-ink fill with the light theme's ink as label
     (the mockup's .band .btn), dark on light in both themes. */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--s-5);
    border: 1px solid var(--band-ink);
    border-radius: var(--r-ctl);
    background: var(--band-ink);
    color: #15171c;
    font: 600 var(--fs-body) / 1 var(--font-body);
    text-decoration: none;
  }

  .cta:hover {
    background: color-mix(in srgb, var(--band-ink) 86%, var(--band));
  }

  /* Secondary: a mono label link, never a second button. */
  .link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--band-ink);
    text-decoration: underline;
    text-decoration-color: var(--band-line);
    text-underline-offset: 0.35em;
  }

  .link:hover {
    text-decoration-color: var(--band-ink);
  }

  .cta:focus-visible,
  .link:focus-visible {
    outline: 2px solid var(--band-ink);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cta {
      transition: background-color var(--dur) var(--ease);
    }
  }

  /* A painting in the art slot covers the band under a flat veil of the band
     colour (about a quarter of it shows): even over a white patch the band
     ink stays above 7:1, in both themes. */
  .art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--band) 74%, transparent);
  }

  @media (forced-colors: active) {
    .art {
      display: none;
    }
  }
</style>
