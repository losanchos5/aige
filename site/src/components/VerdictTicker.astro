---
/**
 * VerdictTicker — a 1px-ruled row of mono verdict log lines under the
 * verdict-beat sentence: the verdict word in its semantic ink (PASS in the L5
 * ink, BLOCK in the L3 ink), then the stage that ran it and the check. No run
 * numbers: the lines are illustrative, not telemetry. A static list that
 * wraps to the width it has; it never loops or scrolls. The items rise once on
 * reveal through the shared .reveal-stagger utility (resting state for no-JS
 * and reduced motion). Generic, illustrative items only — no vendor names.
 * Decorative, so the whole strip is aria-hidden.
 */
interface Props {
  /** `lg` enlarges the verdicts and labels (used on the home verdict beat);
   *  `md` (default) keeps the thin strip. */
  size?: 'md' | 'lg';
}

interface Item {
  stage: string;
  verdict: 'pass' | 'block';
  detail: string;
}

const { size = 'md' } = Astro.props;

const items: readonly Item[] = [
  { stage: 'pre-merge', verdict: 'pass', detail: 'eval.safety 0.97' },
  { stage: 'release gate', verdict: 'block', detail: 'pii.leak detected' },
  { stage: 'build', verdict: 'pass', detail: 'aibom.signed' },
  { stage: 'runtime', verdict: 'pass', detail: 'scope.bound · trace ok' },
  { stage: 'release gate', verdict: 'block', detail: 'eval.jailbreak 0.71' },
  { stage: 'admission', verdict: 'pass', detail: 'policy.allow deploy' },
  { stage: 'post-deploy', verdict: 'pass', detail: 'oscal.evidence written' },
  { stage: 'registry', verdict: 'block', detail: 'owner missing' },
  { stage: 'runtime', verdict: 'pass', detail: 'kill-switch armed' },
  { stage: 'nightly', verdict: 'pass', detail: 'eval.groundedness 0.96' },
];
---

<div class:list={['vt', size === 'lg' && 'vt-lg']} aria-hidden="true">
  <ul class="vt-list container reveal-stagger">
    {
      items.map((item, i) => (
        <li class="vt-item" style={`--i:${i}`}>
          <span class:list={['vt-verdict', `vt-${item.verdict}`]}>
            {item.verdict === 'pass' ? 'PASS' : 'BLOCK'}
          </span>
          <span class="vt-stage">{item.stage}</span>
          <span class="vt-detail">{item.detail}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .vt {
    border-top: 1px solid var(--line);
    padding-top: var(--s-4);
  }

  /* .container supplies the centred well and its side inset; the row wraps
     onto as many lines as the width needs. */
  .vt-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin-block: 0;
    list-style: none;
  }

  /* An item stays on one line unless it alone is wider than the row (narrow
     phones), where its detail drops under the verdict instead of overflowing. */
  .vt-item {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s-2);
  }

  /* The verdict word: plain mono text in its semantic ink, no fill or frame. */
  .vt-verdict {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .vt-pass {
    color: var(--l5-ink);
  }

  .vt-block {
    color: var(--l3-ink);
  }

  .vt-stage {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .vt-detail {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  /* Large size: bigger verdicts and labels, used on the home verdict beat.
     Every colour token here is re-scoped by .sec--dark, so it reads correctly
     on the dark band too. */
  .vt-lg .vt-list {
    gap: var(--s-3) var(--s-6);
  }

  .vt-lg .vt-verdict {
    font-size: var(--fs-small);
  }

  .vt-lg .vt-stage,
  .vt-lg .vt-detail {
    font-size: var(--fs-body);
  }
</style>
