---
/**
 * StackFlow — the five-layer stack as an interactive layer-flow diagram.
 *
 * On wide screens, an SVG shows the five layers as horizontal bands (05 at the
 * top, 01 at the foot, so evidence flows up) on the left, and a clean flow lane
 * on the right where each artefact rides its own vertical lane up into the
 * layer(s) it feeds. Clicking or keyboard-activating a band (role="button")
 * highlights it, dims the rest, redraws its paths and reveals that layer's
 * detail panel beside the diagram.
 *
 * On narrow screens the SVG is replaced by a simplified stacked list of the
 * same bands (real <button>s), with the detail panel below. Both band sets
 * carry data-band/data-layer, so public/stack.js drives them with one handler.
 * With no JS every band and path is static and layer 01's panel is shown.
 */
import { layers } from '../data/stack';

const pad = (n: number) => String(n).padStart(2, '0');

// SVG geometry (viewBox 0 0 900 420). Bands fill the left column; the right is a
// flow lane where each artefact gets its own vertical x-lane, so orthogonal
// paths and mono labels never overlap.
const BAND_X = 56;
const BAND_W = 520;
const BAND_H = 58;
const TOP = 29;
const PITCH = 76;
const RIGHT = BAND_X + BAND_W; // 576 — bands' right edge, where every flow starts/ends.

/** Vertical centre of a layer's band. 05 is at the top, 01 at the foot. */
const cy = (n: number) => TOP + (5 - n) * PITCH + BAND_H / 2;

// Bands top-to-bottom: 05, 04, 03, 02, 01.
const bandsOrder = [...layers].sort((a, b) => b.n - a.n);

// The one artefact each producing layer emits (05 is the sink; it emits none).
const artefact: Record<number, string> = {
  1: 'policy verdict',
  2: 'registry entry',
  3: 'eval result',
  4: 'guardrail decision',
};

// Each producing layer's vertical lane, left→right in artefact order (policy
// verdict nearest the bands). 05 is the assurance sink every artefact reaches;
// 02/03 also feed the next layer up, so those two lanes branch.
const LANE_X: Record<number, number> = { 1: 630, 2: 692, 3: 754, 4: 816 };

// Where each lane leaves its source band's right edge. 03 and 04 are also the
// target of a lower lane, so their exit sits just above the incoming arrow.
const SRC_Y: Record<number, number> = { 1: cy(1), 2: cy(2), 3: cy(3) - 12, 4: cy(4) - 12 };

// Rotated lane-label anchor: to the right of each lane, in its clear lower run.
const LABEL_Y: Record<number, number> = { 1: 346, 2: 256, 3: 170, 4: 84 };

// The four 05 collectors nest without crossing: the further-right lane enters
// higher. 03/04 entries sit below their band centre, clear of that band's exit.
const lanes: { from: number; text: string; targets: { to: number; ey: number }[] }[] = [
  { from: 1, text: artefact[1], targets: [{ to: 5, ey: 73 }] },
  { from: 2, text: artefact[2], targets: [{ to: 3, ey: cy(3) + 12 }, { to: 5, ey: 63 }] },
  { from: 3, text: artefact[3], targets: [{ to: 4, ey: cy(4) + 12 }, { to: 5, ey: 53 }] },
  { from: 4, text: artefact[4], targets: [{ to: 5, ey: 43 }] },
];

const r2 = (v: number) => Math.round(v * 100) / 100;

/** An orthogonal polyline through `pts` with `r`-radius rounded corners. */
function roundedPath(pts: number[][], r: number): string {
  let d = `M ${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [x0, y0] = pts[i - 1];
    const [x1, y1] = pts[i];
    const [x2, y2] = pts[i + 1];
    const d1 = Math.hypot(x1 - x0, y1 - y0) || 1;
    const d2 = Math.hypot(x2 - x1, y2 - y1) || 1;
    const rr = Math.min(r, d1 / 2, d2 / 2);
    const ax = r2(x1 - ((x1 - x0) / d1) * rr);
    const ay = r2(y1 - ((y1 - y0) / d1) * rr);
    const bx = r2(x1 + ((x2 - x1) / d2) * rr);
    const by = r2(y1 + ((y2 - y1) / d2) * rr);
    d += ` L ${ax} ${ay} Q ${x1} ${y1} ${bx} ${by}`;
  }
  const [lx, ly] = pts[pts.length - 1];
  d += ` L ${lx} ${ly}`;
  return d;
}

// One orthogonal path per source→target edge (horizontal out of the source,
// vertical up the lane, horizontal into the target). A branch that leaves a
// still-climbing lane is marked with a junction dot.
const flows = lanes.flatMap((lane) => {
  const sy = SRC_Y[lane.from];
  const x = LANE_X[lane.from];
  const topEy = Math.min(...lane.targets.map((t) => t.ey));
  return lane.targets.map((t) => ({
    from: lane.from,
    to: t.to,
    d: roundedPath([[RIGHT, sy], [x, sy], [x, t.ey], [RIGHT, t.ey]], 8),
    dot: t.ey !== topEy ? { x, y: t.ey } : null,
  }));
});

const dots = flows
  .map((f) => f.dot)
  .filter((d): d is { x: number; y: number } => d !== null);

const laneLabels = lanes.map((lane) => ({
  from: lane.from,
  x: LANE_X[lane.from] + 16,
  y: LABEL_Y[lane.from],
  text: lane.text,
}));

// "Evidence flows up" axis in the left gutter.
const AXIS_X = 34;
const axisTop = cy(5) + 12; // just below the top band's centre
const axisBottom = cy(1) - 12;
---

<figure class="flow" data-flow>
  <div class="flow-grid">
    <div class="flow-stage">
      <svg
        class="flow-svg"
        data-flow-svg
        viewBox="0 0 900 420"
        role="group"
        aria-label="Layer flow diagram: each layer's artefact flows up into continuous assurance. Activate a layer for its detail."
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <marker
            id="flow-arrow"
            markerUnits="userSpaceOnUse"
            markerWidth="9"
            markerHeight="9"
            refX="7"
            refY="4"
            orient="auto"
          >
            <path class="flow-arrow-head" d="M0,0 L8,4 L0,8 Z" />
          </marker>
        </defs>

        {/* Evidence-flows-up axis */}
        <line class="flow-axis-line" x1={AXIS_X} y1={axisBottom} x2={AXIS_X} y2={axisTop} />
        <path class="flow-axis-arrow" d={`M ${AXIS_X} ${axisTop - 8} L ${AXIS_X - 4} ${axisTop} L ${AXIS_X + 4} ${axisTop} Z`} />
        <text
          class="flow-axis"
          x="18"
          y="210"
          text-anchor="middle"
          transform="rotate(-90 18 210)">Evidence flows up</text>

        {/* Artefact flows: one vertical lane per artefact, drawn over the bands
            so arrowheads meet each band edge. */}
        <g class="flows" aria-hidden="true">
          {flows.map((edge) => (
            <path
              class="flow-path"
              data-from={edge.from}
              data-to={edge.to}
              d={edge.d}
              pathLength="1"
              marker-end="url(#flow-arrow)"
            />
          ))}
          {dots.map((dot) => (
            <circle class="flow-dot" cx={dot.x} cy={dot.y} r="3" />
          ))}
          {laneLabels.map((lab) => (
            <text
              class="flow-label"
              data-from={lab.from}
              data-to="5"
              x={lab.x}
              y={lab.y}
              text-anchor="middle"
              transform={`rotate(-90 ${lab.x} ${lab.y})`}>{lab.text}</text>
          ))}
        </g>

        {/* Bands: interactive, top (05) to foot (01) */}
        <g class="bands">
          {bandsOrder.map((layer) => (
            <g
              class:list={['band', layer.n === 1 && 'is-active']}
              data-band
              data-layer={layer.n}
              role="button"
              tabindex="0"
              aria-pressed={layer.n === 1 ? 'true' : 'false'}
              aria-label={`Layer ${pad(layer.n)}: ${layer.name}. Show details.`}
            >
              <rect
                class="band-rect"
                x={BAND_X}
                y={cy(layer.n) - BAND_H / 2}
                width={BAND_W}
                height={BAND_H}
                rx="10"
                style={`fill: var(${layer.colorVar})`}
              />
              <text class="band-idx" x={BAND_X + 24} y={cy(layer.n)} style={`fill: var(${layer.colorVar}-ink)`}>
                {pad(layer.n)}
              </text>
              <text class="band-name" x={BAND_X + 64} y={cy(layer.n)}>{layer.name}</text>
            </g>
          ))}
        </g>
      </svg>

      {/* Narrow, simplified layout: the same bands as a stacked button list. */}
      <ul class="flow-narrow">
        {bandsOrder.map((layer) => (
          <li>
            <button
              type="button"
              class:list={['nband', layer.n === 1 && 'is-active']}
              data-band
              data-layer={layer.n}
              aria-pressed={layer.n === 1 ? 'true' : 'false'}
            >
              <span class="nband-sq" aria-hidden="true" style={`background: var(${layer.colorVar})`}></span>
              <span class="nband-idx">{pad(layer.n)}</span>
              <span class="nband-body">
                <span class="nband-name">{layer.name}</span>
                <span class="nband-tag">{layer.tagline}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    {/* Detail panels, pre-rendered for every layer; only the active one shows. */}
    <div class="flow-panels">
      {layers.map((layer) => (
        <div class="flow-panel" data-panel={layer.n} hidden={layer.n !== 1}>
          <p class="fp-eyebrow">
            <span class="fp-sq" aria-hidden="true" style={`background: var(${layer.colorVar})`}></span>
            Layer {pad(layer.n)} · {layer.name}
          </p>
          <p class="fp-proves">{layer.proves}</p>
          <div class="fp-field">
            <p class="fp-label">Artefacts</p>
            <ul class="chips">
              {layer.artefacts.map((a) => <li class="chip">{a}</li>)}
            </ul>
          </div>
          <div class="fp-field">
            <p class="fp-label">Maps to</p>
            <ul class="chips">
              {layer.mapsTo.map((m) => <li class="chip">{m}</li>)}
            </ul>
          </div>
          <a class="chapter-link" href={`/bok/the-stack#${layer.chapterAnchor}`}>
            Read layer {pad(layer.n)} in chapter 04 <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <figcaption class="flow-cap">
    Evidence flows up: each layer emits a structured artefact that layer 05
    aggregates into audit-ready assurance.
  </figcaption>
</figure>

<style>
  .flow {
    margin: 0;
  }

  .flow-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }

  @media (min-width: 840px) {
    .flow-grid {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
      align-items: start;
      gap: var(--s-6);
    }
  }

  /* ---- diagram ---- */
  .flow-svg {
    display: none;
    width: 100%;
    height: auto;
  }

  @media (min-width: 840px) {
    .flow-svg {
      display: block;
    }
  }

  .band-rect {
    stroke: var(--ink);
    stroke-width: 1;
  }

  .band-idx {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.08em;
    dominant-baseline: middle;
  }

  .band-name {
    fill: var(--ink);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 20px;
    dominant-baseline: middle;
  }

  .band {
    cursor: pointer;
  }

  .band:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .band.is-active .band-rect,
  .band:focus-visible .band-rect {
    stroke-width: 2;
  }

  .flow-path {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    opacity: 0.7;
  }

  .flow-arrow-head {
    /* Follow the owning path's stroke: --muted by default, --ink when lit. */
    fill: context-stroke;
  }

  .flow-dot {
    fill: var(--ink);
  }

  .flow-label {
    fill: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    dominant-baseline: middle;
  }

  .flow-axis-line {
    stroke: var(--line);
    stroke-width: 1;
  }

  .flow-axis-arrow {
    fill: var(--muted);
  }

  .flow-axis {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* Active state (JS only): dim the rest, light the active layer's flows. The
     lane labels stay at full --ink-2 strength so every lane stays named. */
  .flow.flow-js.has-active [data-band]:not(.is-active) {
    opacity: 0.4;
  }

  .flow.flow-js.has-active .flow-path {
    opacity: 0.25;
  }

  .flow.flow-js.has-active .flow-path.is-lit {
    stroke: var(--ink);
    opacity: 1;
    stroke-width: 1.6;
  }

  .flow-label.is-lit {
    fill: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .band,
    .flow-path,
    .flow-label,
    .nband {
      transition:
        opacity var(--dur) var(--ease),
        stroke var(--dur) var(--ease),
        stroke-width var(--dur) var(--ease);
    }

    .flow.flow-js .flow-path.is-lit.draw {
      animation: flow-draw 400ms var(--ease) both;
    }

    @keyframes flow-draw {
      from {
        stroke-dashoffset: 1;
      }
      to {
        stroke-dashoffset: 0;
      }
    }
  }

  /* ---- narrow band list ---- */
  .flow-narrow {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 840px) {
    .flow-narrow {
      display: none;
    }
  }

  .nband {
    display: grid;
    grid-template-columns: 10px auto 1fr;
    align-items: center;
    gap: var(--s-3);
    width: 100%;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--ink);
    text-align: left;
    cursor: pointer;
  }

  .nband.is-active {
    border-color: var(--ink);
  }

  .flow.flow-js.has-active .nband:not(.is-active) {
    opacity: 0.4;
  }

  .nband-sq {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .nband-idx {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
  }

  .nband-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .nband-name {
    font-weight: 600;
    line-height: 1.2;
  }

  .nband-tag {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  /* ---- panels ---- */
  .flow-panels {
    min-width: 0;
  }

  .flow-panel {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  /* The class's display would otherwise defeat the [hidden] attribute that JS
     (and the no-JS default) toggles to reveal one panel at a time. */
  .flow-panel[hidden] {
    display: none;
  }

  .fp-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  .fp-sq {
    width: 8px;
    height: 8px;
    flex: none;
  }

  .fp-proves {
    margin: 0;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .fp-field {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .fp-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  .flow-cap {
    margin-top: var(--s-5);
    max-width: 60ch;
    font-size: var(--fs-small);
    color: var(--muted);
  }
</style>
