---
// ChapterHeader: the register that opens every Doc page, on the paper with no
// band. On a chapter, a mono pill with its position in the book ("Chapter 02 of
// 24", the total counted from the data) and its part; then the H1 (the page's
// only H1, since remark-lead strips the Markdown one) in the display serif; the
// author byline in its painting frame (AuthorBadge: photo, the name the JSON-LD
// Person node carries linked to /about with rel="author", LinkedIn, title);
// the meta line as mono chips; the compact on-this-page list Doc passes in the
// `toc` slot; and the summary lede. A hairline closes the meta line.
import { site } from '../data/site';
import { chaptersOrdered, getChapterBySlug } from '../data/chapters';
import { bookParts, chapterNum } from '../data/parts';
import AuthorBadge from './AuthorBadge.astro';
import { intlLocale, translator, type UiKey } from '../i18n/ui';

interface Props {
  title: string;
  summary?: string;
  updated?: string;
  words?: number;
  minutes?: number;
  /** A Body of Knowledge chapter's slug: shows its position pill and part. */
  chapterSlug?: string;
  /** Page language, passed down by Doc; drives the meta line's labels. */
  lang?: string;
  /** Show the author byline. Default: on every dated page except the
      Thesis (/thesis and its translations), which is co-authored and states
      its own authorship. */
  byline?: boolean;
  /** Print the site's BoK version before the date (default true). A versioned
      artefact that states its own version under the H1 (a research note, a
      control profile) passes false, so the reader sees one version, not two. */
  siteVersion?: boolean;
}

const {
  title,
  summary,
  updated,
  words,
  minutes,
  chapterSlug,
  lang = 'en',
  siteVersion = true,
} = Astro.props;
const isThesis = /(^|\/)thesis(\.html)?\/?$/.test(Astro.url.pathname);
const byline = (Astro.props.byline ?? !isThesis) && Boolean(updated);

// The meta line is the only copy this component writes itself, so it is the only
// thing that has to follow the page language: its labels come from the UI
// strings (src/i18n/ui.ts, where the hand-written Spanish of /es/thesis lives),
// its number format from the language.
const t = translator(lang);
const labels = {
  updated: t('chapter.updated'),
  read: t('chapter.minRead'),
  words: t('chapter.words'),
  locale: intlLocale(lang),
};

// Position in the book. The words "Chapter" and "Part" have no UI string yet,
// so a translated chapter shows the numbers alone.
const chapter = chapterSlug ? getChapterBySlug(chapterSlug) : undefined;
const partIndex = chapter ? bookParts.findIndex((part) => part.id === chapter.part) : -1;
const position = chapter
  ? {
      pill:
        lang === 'en'
          ? `Chapter ${chapterNum(chapter.order)} of ${chaptersOrdered.length}`
          : `${chapterNum(chapter.order)} / ${chaptersOrdered.length}`,
      part: `${lang === 'en' ? 'Part ' : ''}${chapterNum(partIndex + 1)} · ${t(`part.${chapter.part}` as UiKey)}`,
    }
  : undefined;

// One meta line, joined into chips: reading estimate, version, date, licence.
// The date bit carries the machine-readable value so it renders inside a <time>
// element; every other bit is plain text.
interface MetaBit {
  text: string;
  /** YYYY-MM-DD for the <time datetime> attribute; omitted on plain bits. */
  datetime?: string;
}
const metaBits: MetaBit[] = [];
if (minutes && words)
  metaBits.push(
    { text: `${minutes} ${labels.read}` },
    { text: `${words.toLocaleString(labels.locale)} ${labels.words}` },
  );
if (updated && siteVersion) metaBits.push({ text: `v${site.bokVersion}` });
if (updated) metaBits.push({ text: labels.updated, datetime: updated });
if (updated) metaBits.push({ text: site.license });
---

<header class="chapter-header">
  {
    position && (
      <p class="ch-pos">
        <span class="ch-pill">{position.pill}</span>
        <span class="ch-part">{position.part}</span>
      </p>
    )
  }
  <h1 data-pagefind-meta="title">{title}</h1>
  {
    byline && (
      <div class="ch-byline">
        <AuthorBadge placement="chapter" lang={lang} framed />
      </div>
    )
  }
  {
    metaBits.length > 0 && (
      <ul class="ch-meta">
        {metaBits.map((bit) => (
          <li>
            {bit.datetime ? (
              <span>
                {bit.text} <time datetime={bit.datetime}>{bit.datetime}</time>
              </span>
            ) : (
              bit.text
            )}
          </li>
        ))}
      </ul>
    )
  }
  <slot name="toc" />
  {summary && <p class="lede">{summary}</p>}
</header>

<style>
  .chapter-header {
    margin-bottom: var(--s-6);
  }

  .ch-pos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin: 0 0 22px;
  }

  .ch-pill {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 10px;
    border-radius: var(--r-pill);
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px var(--accent-line);
    color: var(--accent);
    white-space: nowrap;
  }

  .ch-pill,
  .ch-part,
  .ch-meta li {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .ch-part {
    color: var(--muted);
  }

  .chapter-header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h1-doc);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .ch-byline {
    margin-top: 28px;
  }

  .ch-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 20px 0 0;
    padding: 0 0 28px;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .ch-meta li {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    margin: 0;
    padding: 0 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .lede {
    margin-top: 32px;
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* Phones: a tighter stack, so the lede (and the glossary's A-Z row) start
     inside the first screen. */
  @media (max-width: 639px) {
    .ch-pos {
      margin-bottom: 14px;
    }

    .ch-byline {
      margin-top: 20px;
    }

    .ch-meta {
      margin-top: 14px;
      padding-bottom: 18px;
    }

    .lede {
      margin-top: 20px;
      font-size: 1.125rem;
    }
  }
</style>
