---
// ChapterHeader: the register that opens every Doc page — a kicker, the H1 (the
// page's only H1, since remark-lead strips the Markdown one), a summary lede and
// a meta line. Renders its own kicker markup; the lead may later swap it for the
// Block A <Kicker> component.
import { site } from '../data/site';
import RegisterMark from './RegisterMark.astro';

interface Props {
  kicker?: string;
  title: string;
  summary?: string;
  updated?: string;
  words?: number;
  minutes?: number;
}

const { kicker, title, summary, updated, words, minutes } = Astro.props;

// One meta line, joined by middots: version/date, reading estimate, licence.
const metaBits: string[] = [];
if (updated) metaBits.push(`v${site.bokVersion}`, `Updated ${updated}`);
if (minutes && words) metaBits.push(`${minutes} min read`, `${words.toLocaleString('en-US')} words`);
if (updated) metaBits.push(site.license);
---

<header class="chapter-header">
  {
    kicker && (
      <div class="kicker-row">
        <RegisterMark size="sm" class="kicker-mark" label={site.name} />
        <p class="kicker">{kicker}</p>
      </div>
    )
  }
  <h1 data-pagefind-meta="title">{title}</h1>
  {summary && <p class="lede">{summary}</p>}
  {metaBits.length > 0 && <p class="chapter-meta">{metaBits.join(' · ')}</p>}
</header>

<style>
  .chapter-header {
    margin-bottom: var(--s-6);
  }

  .kicker-row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
  }

  .kicker-mark {
    flex: none;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .chapter-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .lede {
    margin-top: var(--s-4);
    max-width: 60ch;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .chapter-meta {
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
