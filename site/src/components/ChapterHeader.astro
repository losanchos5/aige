---
// ChapterHeader: the register that opens every Doc page, the H1 (the page's
// only H1, since remark-lead strips the Markdown one), a summary lede and a meta
// line. No eyebrow above the H1 (audit SL-04): a chapter's book and number are
// already in the breadcrumb above the header. Everything sits in a full-bleed
// band (.ch-band), neutral unless Doc.astro passes the layer of a chapter that is
// about one stack layer (chapters.ts `layer`). The meta line opens with the
// author byline (audit C4/V2): the name the JSON-LD Person node carries, linked
// to /about with rel="author".
import { site } from '../data/site';
import { intlLocale, translator } from '../i18n/ui';

interface Props {
  title: string;
  summary?: string;
  updated?: string;
  words?: number;
  minutes?: number;
  /** Layer key (l1..l5) that tints the band; omit for a neutral band. */
  layer?: string;
  /** Page language, passed down by Doc; drives the meta line's labels. */
  lang?: string;
  /** Show the author in the meta line. Default: on every dated page except the
      Thesis (/thesis and its translations), which is co-authored and states
      its own authorship. */
  byline?: boolean;
  /** Print the site's BoK version before the date (default true). A versioned
      artefact that states its own version under the H1 (a research note, a
      control profile) passes false, so the reader sees one version, not two. */
  siteVersion?: boolean;
}

const {
  title,
  summary,
  updated,
  words,
  minutes,
  layer,
  lang = 'en',
  siteVersion = true,
} = Astro.props;
const isThesis = /(^|\/)thesis(\.html)?\/?$/.test(Astro.url.pathname);
const byline = (Astro.props.byline ?? !isThesis) && Boolean(updated);

// The meta line is the only copy this component writes itself, so it is the only
// thing that has to follow the page language: its labels come from the UI
// strings (src/i18n/ui.ts, where the hand-written Spanish of /es/thesis lives),
// its number format from the language.
const t = translator(lang);
const labels = {
  updated: t('chapter.updated'),
  read: t('chapter.minRead'),
  words: t('chapter.words'),
  locale: intlLocale(lang),
};

// One meta line, joined into list items: version/date, reading estimate, licence.
// The date bit carries the machine-readable value so it renders inside a <time>
// element; every other bit is plain text.
interface MetaBit {
  text: string;
  /** YYYY-MM-DD for the <time datetime> attribute; omitted on plain bits. */
  datetime?: string;
  /** Render the bit as the author byline: `text` is the "By" label. */
  author?: boolean;
}
const metaBits: MetaBit[] = [];
// "By" is written here only in English: the UI strings carry no label for it, so
// a translated page shows the linked name alone.
if (byline) metaBits.push({ text: lang === 'en' ? 'By' : '', author: true });
if (updated && siteVersion) metaBits.push({ text: `v${site.bokVersion}` });
if (updated) metaBits.push({ text: labels.updated, datetime: updated });
if (minutes && words)
  metaBits.push(
    { text: `${minutes} ${labels.read}` },
    { text: `${words.toLocaleString(labels.locale)} ${labels.words}` },
  );
if (updated) metaBits.push({ text: site.license });
---

<header class="chapter-header">
  <div class="ch-band" data-layer={layer}>
    <h1 data-pagefind-meta="title">{title}</h1>
    {summary && <p class="lede">{summary}</p>}
    {
      metaBits.length > 0 && (
        <ul class="ch-meta">
          {metaBits.map((bit) => (
            <li>
              {/* The <li> is a flex container, so the label and the <time> are
                  kept in one inline wrapper: as two bare flex items the space
                  between them would be dropped. */}
              {bit.author ? (
                <span class="ch-byline">
                  {bit.text && `${bit.text} `}
                  <a rel="author" href="/about">{site.authors[0]}</a>
                </span>
              ) : bit.datetime ? (
                <span>
                  {bit.text} <time datetime={bit.datetime}>{bit.datetime}</time>
                </span>
              ) : (
                bit.text
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</header>

<style>
  .chapter-header {
    margin-bottom: var(--s-6);
  }

  /* Register band. A soft radial glow lives in an inert pseudo-element behind
     the text (negative z-index inside an isolated stacking context). Neutral by
     default; the data-layer rules below swap in the layer's tint and glow, and
     only a chapter about one stack layer gets one (SL-06). No dot texture
     (SL-18). */
  .ch-band {
    --ch-tint: color-mix(in srgb, var(--ink) 4%, var(--bg));
    --ch-glow: transparent;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--s-6) var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--ch-tint);
  }

  /* From tablet up the band gets even padding on all four sides. */
  @media (min-width: 840px) {
    .ch-band {
      padding: var(--s-6);
    }
  }

  /* In a chapter, break out to the reading well, exactly like .prose > .glance /
     .diagram: the prose stays at 72ch but .doc-main is a container, so the band
     widens to the whole well and lines up with the crumbs and the At a glance
     box. Off a container the cq units resolve to the column and nothing moves,
     and the band never exceeds .doc-main, so no page-level scroll. The Thesis
     and the meta pages have no crumbs or glance box: there the band keeps the
     prose column, so the header, the lede and the text share one left edge. */
  :global([data-mode='chapter'] .prose) > .chapter-header .ch-band {
    width: 100cqw;
    margin-inline: calc(50% - 50cqw);
  }

  .ch-band[data-layer='l1'] {
    --ch-tint: color-mix(in srgb, var(--l1) 22%, var(--bg));
    --ch-glow: var(--glow-1);
  }
  .ch-band[data-layer='l2'] {
    --ch-tint: color-mix(in srgb, var(--l2) 22%, var(--bg));
    --ch-glow: var(--glow-2);
  }
  .ch-band[data-layer='l3'] {
    --ch-tint: color-mix(in srgb, var(--l3) 22%, var(--bg));
    --ch-glow: var(--glow-3);
  }
  .ch-band[data-layer='l4'] {
    --ch-tint: color-mix(in srgb, var(--l4) 22%, var(--bg));
    --ch-glow: var(--glow-4);
  }
  .ch-band[data-layer='l5'] {
    --ch-tint: color-mix(in srgb, var(--l5) 22%, var(--bg));
    --ch-glow: var(--glow-5);
  }

  /* Radial glow, anchored top-right. */
  .ch-band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(70% 90% at 88% 12%, var(--ch-glow), transparent 72%);
    pointer-events: none;
  }

  .chapter-header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: 1.1;
    color: var(--ink);
  }

  .lede {
    margin-top: var(--s-4);
    max-width: 60ch;
    font-size: var(--fs-h3);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .ch-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-2);
  }

  .ch-meta li {
    display: flex;
    align-items: center;
    margin: 0;
  }

  /* The author link: --ink on the band, underlined, never dimmed. */
  .ch-byline a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.18em;
  }

  .ch-byline a:hover {
    text-decoration-color: currentColor;
  }

  /* Middot separators between the meta bits (kept at --ink-2 so the tinted band
     never carries dimmed text). */
  .ch-meta li + li::before {
    content: '·';
    margin-right: var(--s-3);
    color: var(--ink-2);
  }
</style>
