---
// EditOnGitHub: deep link to edit the source Markdown on GitHub. `path` is the
// file's repo-relative path, e.g. "bok/04-the-stack.md".
import { site } from '../data/site';

interface Props {
  path: string;
}

const { path } = Astro.props;
const href = `${site.github}/edit/main/${path}`;
---

<a class="edit-link" href={href} target="_blank" rel="noopener noreferrer">
  Edit this page on GitHub
</a>

<style>
  .edit-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    text-decoration: none;
  }

  .edit-link:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
