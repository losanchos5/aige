---
// EditOnGitHub: deep link to edit the source Markdown on GitHub. `path` is the
// file's repo-relative path, e.g. "bok/04-the-stack.md".
import { site } from '../data/site';

interface Props {
  path: string;
}

const { path } = Astro.props;
const href = `${site.github}/edit/main/${path}`;
---

<a class="edit-link" href={href} target="_blank" rel="noopener noreferrer">
  <svg
    class="edit-icon"
    viewBox="0 0 24 24"
    width="14"
    height="14"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M4 20h4L18.5 9.5a2.121 2.121 0 0 0-3-3L5 17v3z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
    <path
      d="m13.5 6.5 3 3"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"></path>
  </svg>
  Edit this page on GitHub
</a>

<style>
  .edit-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: 32px;
    padding: 0 var(--s-3);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .edit-link:hover {
    border-color: var(--ink-2);
    color: var(--ink);
  }

  .edit-icon {
    flex: none;
  }
</style>
