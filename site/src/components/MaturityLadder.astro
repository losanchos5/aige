---
/**
 * MaturityLadder — the five maturity levels as an ascending ladder, left to
 * right on wide screens and stacked on narrow ones. Each step carries a mono
 * index, a rising n-of-5 meter, the level name, a summary and its typical
 * signals. The overall level is the weakest layer, so the ladder reads as a
 * climb from paper (Documented) to production (Continuous).
 */
import type { MaturityLevel } from '../data/maturity';

interface Props {
  levels: readonly MaturityLevel[];
}

const { levels } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class="ladder">
  {
    levels.map((level) => (
      <li class="maturity-step">
        <div class="step-head">
          <span class="index" aria-hidden="true">
            {pad(level.n)}
          </span>
          <span class="meter" aria-hidden="true">
            {[1, 2, 3, 4, 5].map((n) => (
              <span class:list={['seg', n <= level.n && 'seg-on']} />
            ))}
          </span>
        </div>
        <h3 class="name">{level.name}</h3>
        <p class="summary">{level.summary}</p>
        <ul class="signals">
          {level.signals.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>

<style>
  .ladder {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
  }

  .maturity-step {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
  }

  .step-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .index {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--muted);
  }

  .meter {
    display: inline-flex;
    gap: 3px;
    align-items: flex-end;
  }

  .seg {
    width: 5px;
    height: 14px;
    border-radius: 1px;
    border: 1px solid var(--line);
    background: transparent;
  }

  .seg-on {
    background: var(--ink);
    border-color: var(--ink);
  }

  .name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
  }

  .summary {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--fs-small);
    text-wrap: pretty;
  }

  .signals {
    margin: var(--s-1) 0 0;
    padding-left: 1.1em;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .signals li {
    color: var(--muted);
    font-size: var(--fs-small);
    text-wrap: pretty;
  }

  @media (min-width: 640px) {
    .ladder {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .ladder {
      grid-template-columns: repeat(5, 1fr);
      align-items: stretch;
    }
  }
</style>
