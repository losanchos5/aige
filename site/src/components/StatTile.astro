---
/**
 * StatTile — a bordered figure card: a large value, a label, and a required
 * source line rendered small underneath. Flat, 1px border, no shadow.
 */
interface Props {
  value: string;
  label: string;
  /** Provenance for the figure. Required: no unsourced numbers. */
  source: string;
  href?: string;
  class?: string;
}

const { value, label, source, href, class: className } = Astro.props;
const Tag = href ? 'a' : 'div';

// Parse the first numeric token so public/countup.js can count up to it. The
// rendered text stays the final value (SEO, no layout shift); non-numeric values
// carry no data-countup and are left untouched.
const match = value.match(/\d[\d,]*(?:\.\d+)?/);
const countup = match
  ? {
      number: match[0].replace(/,/g, ''),
      prefix: value.slice(0, match.index),
      suffix: value.slice((match.index ?? 0) + match[0].length),
    }
  : null;
---

<Tag
  class:list={['tile', 'card-lum', 'lift', className]}
  {...(href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <span
    class="value"
    {...(countup
      ? {
          'data-countup': countup.number,
          'data-cu-prefix': countup.prefix,
          'data-cu-suffix': countup.suffix,
        }
      : {})}>{value}</span
  >
  <span class="label">{label}</span>
  <span class="source">{source}</span>
</Tag>

<style>
  /* Surface (border, radius, background, shadow) comes from .card-lum in
     effects.css; this rule keeps only the tile's layout and ink colour. */
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    color: var(--ink);
    text-decoration: none;
  }

  .value {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    font-size: var(--fs-h1);
    /* Tabular figures so the counting number keeps a steady width. */
    font-variant-numeric: tabular-nums;
    /* Fallback: solid ink. The gradient below only applies where the text can
       be clipped to it, so contrast never depends on the gradient. */
    color: var(--ink);
  }

  /* Gradient value text, ink-derived so it stays high-contrast in both themes.
     Guarded by @supports and paired with the --ink fallback above. */
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .value {
      background-image: var(--grad-cta);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
  }

  .label {
    font-weight: 500;
    color: var(--ink-2);
  }

  .source {
    font-size: var(--fs-small);
    /* --ink-2, not --muted: the tile also sits on mesh and tinted bands, where
       --muted can drop below AA. Colour only, never opacity. */
    color: var(--ink-2);
    text-wrap: pretty;
  }

  a.tile:hover {
    border-color: var(--ink-2);
  }
</style>
