---
/**
 * StatTile — a bordered figure card: a large value, a label, and a required
 * source line rendered small underneath. Flat, 1px border, no shadow.
 */
interface Props {
  value: string;
  label: string;
  /** Provenance for the figure. Required: no unsourced numbers. */
  source: string;
  href?: string;
  class?: string;
}

const { value, label, source, href, class: className } = Astro.props;
const Tag = href ? 'a' : 'div';

// Parse the first numeric token so public/countup.js can count up to it. The
// rendered text stays the final value (SEO, no layout shift); non-numeric values
// carry no data-countup and are left untouched.
const match = value.match(/\d[\d,]*(?:\.\d+)?/);
const countup = match
  ? {
      number: match[0].replace(/,/g, ''),
      prefix: value.slice(0, match.index),
      suffix: value.slice((match.index ?? 0) + match[0].length),
    }
  : null;
---

<Tag
  class:list={['tile', className]}
  {...(href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <span
    class="value"
    {...(countup
      ? {
          'data-countup': countup.number,
          'data-cu-prefix': countup.prefix,
          'data-cu-suffix': countup.suffix,
        }
      : {})}>{value}</span
  >
  <span class="label">{label}</span>
  <span class="source">{source}</span>
</Tag>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
    color: var(--ink);
    text-decoration: none;
  }

  .value {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    font-size: var(--fs-h1);
    /* Tabular figures so the counting number keeps a steady width. */
    font-variant-numeric: tabular-nums;
  }

  .label {
    font-weight: 500;
    color: var(--ink-2);
  }

  .source {
    font-size: var(--fs-small);
    color: var(--muted);
    text-wrap: pretty;
  }

  a.tile:hover {
    border-color: var(--ink-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    a.tile {
      transition: border-color var(--dur) var(--ease);
    }
  }
</style>
