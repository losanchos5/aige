---
// Citation: a "Cite this …" disclosure with a ready-to-copy APA-ish reference
// and a BibTeX entry, plus a small share row (LinkedIn + copy link). The copy
// buttons are wired by ui-doc.js on chapter pages and by cite.js elsewhere
// (CSP-safe, no inline JS); the share link and copy button work without it (the
// copy button is a harmless no-op if the clipboard API is unavailable).
//
// Props: `title` plus either `slug` (a Body of Knowledge chapter, the original
// usage: <Citation title slug />) or `url` (any page, absolute or site-relative).
// `kind` sets the default label ("Cite this obligation") and the BibTeX shape;
// it defaults to `chapter` when a slug is given and `page` otherwise. `label`
// overrides the summary text.
import { site } from '../data/site';

type CitationKind = 'chapter' | 'obligation' | 'figure' | 'dataset' | 'page';

interface Props {
  title: string;
  slug?: string;
  url?: string;
  kind?: CitationKind;
  label?: string;
}

const { title, slug, url: urlProp, kind: kindProp, label: labelProp } = Astro.props;
const kind: CitationKind = kindProp ?? (slug ? 'chapter' : 'page');

const defaultLabels: Record<CitationKind, string> = {
  chapter: 'Cite this chapter',
  obligation: 'Cite this obligation',
  figure: 'Cite this figure',
  dataset: 'Cite this dataset',
  page: 'Cite this page',
};
const label = labelProp ?? defaultLabels[kind];

const resolved = urlProp ?? (slug ? `/bok/${slug}` : undefined);
if (!resolved) throw new Error(`Citation "${title}": pass a slug or a url`);
const url = new URL(resolved, site.url).href;

// Chapter titles carry their number ("04. The stack"); the citation drops it.
const cleanTitle = kind === 'chapter' ? title.replace(/^\d+\.\s*/, '') : title;
// APA marks a data set in square brackets after the title.
const typeNote = kind === 'dataset' ? ' [Data set]' : '';
const work = 'AI Governance Engineering: The Thesis & Body of Knowledge';
const reference = `García Aibar, J. (2026). ${cleanTitle}${typeNote}. In ${work} (v${site.bokVersion}). https://doi.org/${site.doi}. ${url}. ${site.license}`;

// BibTeX for the whole work. A chapter keeps the original entry (the chapter
// field names it); any other page is cited as its own titled item published in
// the work. The literal backslash escapes the ampersand for BibTeX.
const bibtex =
  kind === 'chapter'
    ? `@misc{aige2026bok,
  author  = {${site.authors.join(' and ')}},
  title   = {{AI Governance Engineering: The Thesis \\& Body of Knowledge}},
  chapter = {${cleanTitle}},
  year    = {2026},
  version = {${site.bokVersion}},
  doi     = {${site.doi}},
  url     = {${url}},
  note    = {Version ${site.bokVersion}}
}`
    : `@misc{aige2026${kind},
  author       = {${site.authors.join(' and ')}},
  title        = {{${cleanTitle}}},
  howpublished = {In AI Governance Engineering: The Thesis \\& Body of Knowledge},
  year         = {2026},
  version      = {${site.bokVersion}},
  doi          = {${site.doi}},
  url          = {${url}},
  note         = {Version ${site.bokVersion}}
}`;

const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---

<div class="cite-wrap">
  <details class="cite-box">
    <summary>{label}</summary>
    <div class="cite-body">
      <p class="cite-apa" data-cite-text>
        García Aibar, J. (2026). <em>{cleanTitle}</em>{typeNote}. In <em>AI Governance
        Engineering: The Thesis &amp; Body of Knowledge</em> (v{site.bokVersion}).{' '}
        <a href={`https://doi.org/${site.doi}`}>https://doi.org/{site.doi}</a>. {url}. {site.license}
      </p>
      <button
        type="button"
        class="cite-copy"
        data-copy-cite={reference}
        data-umami-event="cite-copy"
        data-umami-event-kind="reference"
        data-umami-event-type={kind}
        data-umami-event-chapter={slug}
      >
        Copy
      </button>

      <p class="cite-label">BibTeX</p>
      <pre class="cite-bibtex"><code>{bibtex}</code></pre>
      <button
        type="button"
        class="cite-copy bibtex-copy"
        data-copy-cite={bibtex}
        data-umami-event="cite-copy"
        data-umami-event-kind="bibtex"
        data-umami-event-type={kind}
        data-umami-event-chapter={slug}
      >
        Copy BibTeX
      </button>
    </div>
  </details>

  <div class="share-row">
    <a class="share-link" href={linkedInUrl} target="_blank" rel="noopener">Share on LinkedIn</a>
    <button
      type="button"
      class="share-copy"
      data-copy-cite={url}
      data-umami-event="cite-copy"
      data-umami-event-kind="link"
      data-umami-event-type={kind}
      data-umami-event-chapter={slug}
    >
      Copy link
    </button>
  </div>
</div>

<style>
  /* A flex item of Doc's footer row: without min-width: 0 it grows to the
     BibTeX block's unwrapped width once the disclosure opens, and the whole
     page scrolls sideways on a phone. */
  .cite-wrap {
    min-width: 0;
    max-width: 100%;
  }

  .cite-box {
    font-size: 0.9375rem;
  }

  .cite-box > summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    list-style: none;
  }

  .cite-box > summary::-webkit-details-marker {
    display: none;
  }

  .cite-box > summary::before {
    content: '+ ';
  }

  .cite-box[open] > summary::before {
    content: '– ';
  }

  .cite-box > summary:hover {
    color: var(--ink);
  }

  .cite-body {
    margin-top: var(--s-3);
    padding: var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  /* The DOI and page URLs have no break points of their own. */
  .cite-apa {
    color: var(--ink-2);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .cite-label {
    margin-top: var(--s-4);
    margin-bottom: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  .cite-bibtex {
    max-width: 100%;
    margin: var(--s-2) 0 0;
    padding: var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .cite-bibtex code {
    font-family: inherit;
  }

  .cite-copy {
    margin-top: var(--s-3);
    padding: var(--s-1) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }

  .cite-copy:hover {
    border-color: var(--ink-2);
  }

  .share-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .share-link,
  .share-copy {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: var(--s-1) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }

  .share-link:hover,
  .share-copy:hover {
    border-color: var(--ink-2);
  }

  .cite-copy:focus-visible,
  .share-link:focus-visible,
  .share-copy:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
</style>
