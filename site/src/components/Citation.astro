---
// Citation: a "Cite this …" disclosure with a ready-to-copy APA-ish reference
// and a BibTeX entry, plus a small share row (LinkedIn + copy link). The copy
// buttons are wired by ui-doc.js on chapter pages and by cite.js elsewhere
// (CSP-safe, no inline JS); the share link and copy button work without it (the
// copy button is a harmless no-op if the clipboard API is unavailable).
//
// Props: `title` plus either `slug` (a Body of Knowledge chapter, the original
// usage: <Citation title slug />) or `url` (any page, absolute or site-relative).
// `kind` sets the default label ("Cite this obligation") and the BibTeX shape;
// it defaults to `chapter` when a slug is given and `page` otherwise. `label`
// overrides the summary text. `version` and `doi` cite an item with its own
// version (a research note) and a DOI other than this release's version DOI;
// without them the reference carries the Body of Knowledge version and DOI.
// `card` draws the box as the reading layout's cite card: a painting clear at
// the top and veiled in the band colour under the text.
import { site } from '../data/site';
import { translator } from '../i18n/ui';
import Painting from './Painting.astro';

type CitationKind = 'chapter' | 'obligation' | 'figure' | 'dataset' | 'page';

interface Props {
  title: string;
  slug?: string;
  url?: string;
  kind?: CitationKind;
  label?: string;
  /** Page language: translates the box's labels (the reference stays as cited). */
  lang?: string;
  /** The cited item's own version (e.g. a research note's 0.1.0); default: the Body of Knowledge version. */
  version?: string;
  /** DOI to cite (e.g. the concept DOI); default: this release's version DOI (site.doi). */
  doi?: string;
  /** The painted cite card of the reading layout's right column. */
  card?: boolean;
}

const {
  title,
  slug,
  url: urlProp,
  kind: kindProp,
  label: labelProp,
  lang = 'en',
  version: itemVersion,
  doi: doiProp,
  card = false,
} = Astro.props;
const doi = doiProp ?? site.doi;
// An item with its own version carries it after its title; the work is then
// cited without the Body of Knowledge version, which would read as the item's.
const version = itemVersion ?? site.bokVersion;
const itemNote = itemVersion ? ` (v${itemVersion})` : '';
const workNote = itemVersion ? '' : ` (v${site.bokVersion})`;
const kind: CitationKind = kindProp ?? (slug ? 'chapter' : 'page');
const t = translator(lang);
// The copy buttons say "Copied" in the page language (ui-doc.js, cite.js); an
// English page keeps the scripts' default and no extra attribute.
const copied = lang === 'en' ? {} : { 'data-copied': t('cite.copied') };

const defaultLabels: Record<CitationKind, string> = {
  chapter: 'Cite this chapter',
  obligation: 'Cite this obligation',
  figure: 'Cite this figure',
  dataset: 'Cite this dataset',
  page: 'Cite this page',
};
const label =
  labelProp ??
  (lang === 'en' ? defaultLabels[kind] : kind === 'chapter' ? t('cite.chapter') : t('cite.page'));

const resolved = urlProp ?? (slug ? `/bok/${slug}` : undefined);
if (!resolved) throw new Error(`Citation "${title}": pass a slug or a url`);
const url = new URL(resolved, site.url).href;

// Chapter titles carry their number ("04. The stack"); the citation drops it.
const cleanTitle = kind === 'chapter' ? title.replace(/^\d+\.\s*/, '') : title;
// APA marks a data set in square brackets after the title.
const typeNote = kind === 'dataset' ? ' [Data set]' : '';
const work = 'AI Governance Engineering: The Thesis & Body of Knowledge';
const reference = `García Aibar, J. (2026). ${cleanTitle}${itemNote}${typeNote}. In ${work}${workNote}. https://doi.org/${doi}. ${url}. ${site.license}`;

// BibTeX for the whole work. A chapter keeps the original entry (the chapter
// field names it); any other page is cited as its own titled item published in
// the work. The literal backslash escapes the ampersand for BibTeX.
const bibtex =
  kind === 'chapter'
    ? `@misc{aige2026bok,
  author  = {${site.authors.join(' and ')}},
  title   = {{AI Governance Engineering: The Thesis \\& Body of Knowledge}},
  chapter = {${cleanTitle}},
  year    = {2026},
  version = {${version}},
  doi     = {${doi}},
  url     = {${url}},
  note    = {Version ${version}}
}`
    : `@misc{aige2026${kind},
  author       = {${site.authors.join(' and ')}},
  title        = {{${cleanTitle}}},
  howpublished = {In AI Governance Engineering: The Thesis \\& Body of Knowledge},
  year         = {2026},
  version      = {${version}},
  doi          = {${doi}},
  url          = {${url}},
  note         = {Version ${version}}
}`;

const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---

<div class:list={['cite-wrap', { 'cite-card': card }]}>
  {card && <Painting id="morning-seine-giverny" crop="cite" sizes="(max-width: 1279px) 92vw, 208px" class="cite-art" />}
  <details class="cite-box">
    <summary>{label}</summary>
    <div class="cite-body">
      <p class="cite-apa" data-cite-text>
        García Aibar, J. (2026). <em>{cleanTitle}</em>{itemNote}{typeNote}. In <em>AI Governance
        Engineering: The Thesis &amp; Body of Knowledge</em>{workNote}.{' '}
        <a href={`https://doi.org/${doi}`}>https://doi.org/{doi}</a>. {url}. {site.license}
      </p>
      <button
        type="button"
        class="cite-copy"
        data-copy-cite={reference}
        data-umami-event="cite-copy"
        data-umami-event-kind="reference"
        data-umami-event-type={kind}
        data-umami-event-chapter={slug}
        {...copied}
      >
        {t('cite.copy')}
      </button>

      <p class="cite-label">BibTeX</p>
      <pre class="cite-bibtex"><code>{bibtex}</code></pre>
      <button
        type="button"
        class="cite-copy bibtex-copy"
        data-copy-cite={bibtex}
        data-umami-event="cite-copy"
        data-umami-event-kind="bibtex"
        data-umami-event-type={kind}
        data-umami-event-chapter={slug}
        {...copied}
      >
        {t('cite.copyBibtex')}
      </button>
    </div>
  </details>

  <div class="share-row">
    <a class="share-link" href={linkedInUrl} target="_blank" rel="noopener">{t('cite.shareLinkedIn')}</a>
    <button
      type="button"
      class="share-copy"
      data-copy-cite={url}
      data-umami-event="cite-copy"
      data-umami-event-kind="link"
      data-umami-event-type={kind}
      data-umami-event-chapter={slug}
      {...copied}
    >
      {t('cite.copyLink')}
    </button>
  </div>
</div>

<style>
  /* A flex item of Doc's footer row: without min-width: 0 it grows to the
     BibTeX block's unwrapped width once the disclosure opens, and the whole
     page scrolls sideways on a phone. */
  .cite-wrap {
    min-width: 0;
    max-width: 100%;
  }

  .cite-box {
    font-size: 0.9375rem;
  }

  .cite-box > summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    list-style: none;
  }

  .cite-box > summary::-webkit-details-marker {
    display: none;
  }

  .cite-box > summary::before {
    content: '+ ';
  }

  .cite-box[open] > summary::before {
    content: '– ';
  }

  .cite-box > summary:hover {
    color: var(--ink);
  }

  .cite-body {
    margin-top: var(--s-3);
    padding: var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  /* The DOI and page URLs have no break points of their own. */
  .cite-apa {
    color: var(--ink-2);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .cite-label {
    margin-top: var(--s-4);
    margin-bottom: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  .cite-bibtex {
    max-width: 100%;
    margin: var(--s-2) 0 0;
    padding: var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .cite-bibtex code {
    font-family: inherit;
  }

  .cite-copy {
    margin-top: var(--s-3);
    padding: var(--s-1) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }

  .cite-copy:hover {
    border-color: var(--ink-2);
  }

  .share-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .share-link,
  .share-copy {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: var(--s-1) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }

  .share-link:hover,
  .share-copy:hover {
    border-color: var(--ink-2);
  }

  .cite-copy:focus-visible,
  .share-link:focus-visible,
  .share-copy:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  /* The cite card: the band colour over the painting, which shows clear in
     the top 32px and is veiled before the text starts, so the label keeps
     its contrast. The text and controls take the
     band inks. */
  .cite-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 64px 18px 18px;
    border-radius: var(--r-blk);
    background: var(--band);
    color: var(--band-ink);
  }

  .cite-card :global(.cite-art) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .cite-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--band) calc(var(--veil) * 50%), transparent) 0,
      color-mix(in srgb, var(--band) calc(var(--veil) * 50%), transparent) 32px,
      color-mix(in srgb, var(--band) 88%, transparent) 60px,
      color-mix(in srgb, var(--band) 90%, transparent) 100%
    );
  }

  .cite-card .cite-box > summary {
    font-weight: 500;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--band-ink-2);
  }

  .cite-card .cite-box > summary:hover {
    color: var(--band-ink);
  }

  .cite-card .cite-body {
    padding: 0;
    border: 0;
    background: none;
  }

  .cite-card :is(.cite-apa, .cite-label, .cite-bibtex) {
    color: var(--band-ink);
  }

  .cite-card .cite-apa {
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .cite-card .cite-apa a {
    color: inherit;
  }

  .cite-card .cite-bibtex {
    border-color: var(--band-line);
    background: var(--band);
  }

  .cite-card :is(.cite-copy, .share-link, .share-copy) {
    border-color: var(--band-line);
    background: transparent;
    color: var(--band-ink);
  }

  .cite-card :is(.cite-copy, .share-link, .share-copy):hover {
    border-color: var(--band-ink-2);
  }

  .cite-card :is(.cite-copy, .share-link, .share-copy, summary):focus-visible {
    outline-color: var(--band-ink);
  }
</style>
