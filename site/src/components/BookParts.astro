---
/**
 * BookParts: the Body of Knowledge as its five parts, for the home, set as an
 * index. Each part has a head (mono part number, its title linking to that
 * part on the /bok index, the chapter range) over a 1px ink rule, then one
 * hairline row per chapter (number + short title). Everything comes from
 * data/parts.ts, so a new chapter or part shows up here with no edit.
 *
 * Layout: three columns from 1100px (the first part alone, then the rest two
 * by two, which balances the chapter counts), two from 640px, one on phones.
 */
import { bookParts, chapterNum } from '../data/parts';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const columns = [bookParts.slice(0, 1), bookParts.slice(1, 3), bookParts.slice(3)].filter((c) => c.length);
---

<div class:list={['bok-index', className]}>
  {
    columns.map((parts) => (
      <div class="bok-col">
        {parts.map((part) => (
          <section class="part" data-part={part.id} data-testid="book-part" aria-labelledby={`bp-${part.id}`}>
            <h3 class="part-head" id={`bp-${part.id}`}>
              <span class="part-n" aria-hidden="true">
                {chapterNum(bookParts.indexOf(part) + 1)}
              </span>
              <a class="part-t" href={`/bok#part-${part.id}`}>
                {part.title}
              </a>
              <span class="part-r">{part.range}</span>
            </h3>
            <ol class="ch-list" aria-label={`${part.title}: chapters`}>
              {part.chapters.map((chapter) => (
                <li>
                  <a href={`/bok/${chapter.slug}`} data-testid="chapter-link">
                    <span class="n" aria-hidden="true">
                      {chapterNum(chapter.order)}
                    </span>
                    <span>{chapter.shortTitle}</span>
                    <span class="arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    ))
  }
</div>

<style>
  .bok-index {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px var(--col-gap);
    align-items: start;
  }

  @media (min-width: 640px) {
    .bok-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .bok-index {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .bok-col {
    display: grid;
    gap: 40px;
  }

  .part-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--s-3);
    margin: 0;
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--ink);
  }

  .part-n {
    font-family: var(--font-mono);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1;
    color: var(--accent);
  }

  .part-t,
  .part-r {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .part-t {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .part-t:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .part-r {
    font-weight: 400;
    color: var(--muted);
  }

  .ch-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ch-list a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--s-2);
    padding: 10px 4px 10px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .n {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
  }

  .arrow {
    font-family: var(--font-mono);
    color: var(--accent);
    visibility: hidden;
  }

  .ch-list a:is(:hover, :focus-visible),
  .ch-list a:is(:hover, :focus-visible) .n {
    color: var(--accent);
  }

  .ch-list a:is(:hover, :focus-visible) .arrow {
    visibility: visible;
  }
</style>
