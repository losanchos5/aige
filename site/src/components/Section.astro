---
/**
 * Section: the editorial section shell shared across the landing pages. It
 * renders `<section class="section sec sec--{tone}">` on the plain paper
 * ground, an optional head (mono numbered label, Newsreader title, lede) and
 * the page content. `tone="dark"` re-scopes the dark token set in effects.css
 * so children render with audited dark contrast (the closing band); `tone=
 * "deep"` is the same set on the L1 navy.
 *
 * Slots: default (body) and "foot" (a trailing row, e.g. a .sec-link).
 */
interface Props {
  /** Background treatment. */
  tone?: 'plain' | 'dark' | 'deep';
  /** id for in-page anchors. */
  id?: string;
  /** Extra class(es) on the <section>. */
  class?: string;
  /** Two-digit section number for the mono label (e.g. "01"). */
  num?: string;
  /** Mono label text beside the number (e.g. "The discipline"). */
  label?: string;
  /** Section title (H2). */
  title?: string;
  /** One word of the title to set in italic (its first occurrence), as the hero sets "run". */
  titleEm?: string;
  /** Lede paragraph under the title. */
  lede?: string;
  /** Title scale: `md` (H2, default) or `xl` (H1 scale). */
  headSize?: 'md' | 'xl';
  /** Let the head span the full width instead of the 62ch measure. */
  rule?: boolean;
  /** Widen the inner container past the default max. */
  wide?: boolean;
}

const {
  tone = 'plain',
  id,
  class: className,
  num,
  label,
  title,
  titleEm,
  lede,
  headSize = 'md',
  rule = false,
  wide = false,
} = Astro.props;

const hasLabel = Boolean(num || label);
const emAt = title && titleEm ? title.indexOf(titleEm) : -1;
const hasHead = Boolean(hasLabel || title || lede);
---

<section id={id} class:list={['section', 'sec', `sec--${tone}`, className]}>
  <div class:list={['container', 'sec-inner', wide && 'sec-inner--wide']}>
    {
      hasHead && (
        <div
          class:list={[
            'sec-head',
            hasLabel && 'sec-head--labelled',
            rule && 'sec-head--rule',
            headSize === 'xl' && 'sec-head--xl',
          ]}
        >
          {hasLabel && (
            <p class="label">
              {num && <span class="num">{num}</span>}
              {label}
            </p>
          )}
          {title && (
            <h2 class="sec-title display">
              {emAt < 0 ? title : <>{title.slice(0, emAt)}<em>{titleEm}</em>{title.slice(emAt + titleEm!.length)}</>}
            </h2>
          )}
          {lede && <p class="sec-lede lede">{lede}</p>}
        </div>
      )
    }
    <slot />
    <slot name="foot" />
  </div>
</section>
