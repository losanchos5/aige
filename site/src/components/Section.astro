---
/**
 * Section — the editorial section shell shared across the landing pages. It
 * renders `<section class="section sec sec--{tone}">` with an inert gradient
 * mesh when `tone="mesh"` (aria-hidden, pointer-events:none via effects.css),
 * an optional head (title + lede) and the page content. `mesh` picks the
 * mesh's composition (a, the default, drifts on a mesh band; b and c are
 * still) and also lays a still mesh over a `tone="tint"` band; `meshK` scales its strength. `tone="dark"`
 * re-scopes the dark token set in effects.css so children render with audited
 * dark contrast. No eyebrow above the title and no dot/grid texture: the audit
 * (SL-04, SL-18) retired both.
 *
 * Slots: default (body) and "foot" (a trailing row, e.g. a .sec-link).
 */
interface Props {
  /** Background treatment. */
  tone?: 'plain' | 'tint' | 'dark' | 'mesh';
  /** id for in-page anchors. */
  id?: string;
  /** Extra class(es) on the <section>. */
  class?: string;
  /** Section title (H2). */
  title?: string;
  /** Lede paragraph under the title. */
  lede?: string;
  /** Title scale: `md` (H2, default) or `xl` (H1 scale). */
  headSize?: 'md' | 'xl';
  /** Let the head span the full width instead of the 62ch measure. */
  rule?: boolean;
  /** Widen the inner container past the default max. */
  wide?: boolean;
  /** Mesh composition; on a tint band it also adds the mesh. */
  mesh?: 'a' | 'b' | 'c';
  /** Mesh strength, a factor on --mesh-alpha (default 1). */
  meshK?: number;
}

const {
  tone = 'plain',
  id,
  class: className,
  title,
  lede,
  headSize = 'md',
  rule = false,
  wide = false,
  mesh,
  meshK,
} = Astro.props;

const hasHead = Boolean(title || lede);
const hasMesh = tone === 'mesh' || (tone === 'tint' && mesh !== undefined);
---

<section id={id} class:list={['section', 'sec', `sec--${tone}`, className]}>
  {
    hasMesh && (
      <div
        class:list={['bg-mesh', mesh && mesh !== 'a' && `bg-mesh--${mesh}`]}
        style={meshK === undefined ? undefined : `--mesh-k:${meshK}`}
        aria-hidden="true"
      />
    )
  }

  <div class:list={['container', 'sec-inner', wide && 'sec-inner--wide']}>
    {
      hasHead && (
        <div
          class:list={[
            'sec-head',
            rule && 'sec-head--rule',
            headSize === 'xl' && 'sec-head--xl',
          ]}
        >
          {title && <h2 class="sec-title display">{title}</h2>}
          {lede && <p class="sec-lede lede">{lede}</p>}
        </div>
      )
    }
    <slot />
    <slot name="foot" />
  </div>
</section>
