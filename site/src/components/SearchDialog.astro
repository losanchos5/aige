---
// SearchDialog: a native <dialog> wrapping a Pagefind-backed search. Opened by
// any [data-search-open] element and by Ctrl/Cmd+K, closed by Esc. Pagefind is
// loaded lazily on first open (see /search.js). Not indexed itself.
---

<dialog class="search-dialog" id="search-dialog" aria-label="Search" data-pagefind-ignore>
  <form method="dialog" class="search-form">
    <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2"></line>
    </svg>
    <input
      type="search"
      id="search-input"
      class="search-input"
      placeholder="Search the Body of Knowledge…"
      aria-label="Search the Body of Knowledge"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
    />
    <button type="submit" value="close" class="search-esc" aria-label="Close search">Esc</button>
  </form>
  <div class="search-status" id="search-status" role="status" aria-live="polite" hidden></div>
  <ul class="search-results" id="search-results" aria-label="Search results"></ul>
</dialog>

<script is:inline src="/search.js" type="module"></script>

<style>
  .search-dialog {
    width: min(640px, calc(100vw - 2 * var(--s-4)));
    max-height: 70vh;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
    overflow: hidden;
  }

  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--line);
  }

  .search-icon {
    flex: none;
    color: var(--muted);
  }

  .search-input {
    flex: 1;
    border: 0;
    background: none;
    font-size: 1.0625rem;
    outline: none;
  }

  .search-esc {
    flex: none;
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    cursor: pointer;
  }

  .search-status {
    padding: var(--s-4);
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: var(--s-2);
    overflow-y: auto;
    max-height: calc(70vh - 60px);
  }

  .search-results:empty {
    display: none;
  }

  .search-result a {
    display: block;
    padding: var(--s-3);
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--ink);
  }

  .search-result a:hover,
  .search-result[aria-selected='true'] a {
    background: var(--surface);
  }

  .search-result-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
  }

  .search-result-excerpt {
    margin-top: var(--s-1);
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .search-result-excerpt mark {
    background: var(--l4);
    color: var(--l4-ink);
    padding: 0 2px;
    border-radius: 2px;
  }
</style>
