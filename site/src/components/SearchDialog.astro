---
// SearchDialog: a native <dialog> wrapping a Pagefind-backed search. Opened by
// any [data-search-open] element and by Ctrl/Cmd+K, closed by Esc. Pagefind is
// loaded lazily on first open (see /search.js). Not indexed itself.
---

<dialog class="search-dialog" id="search-dialog" aria-label="Search" data-pagefind-ignore>
  <form method="dialog" class="search-form">
    <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2"></line>
    </svg>
    <input
      type="search"
      id="search-input"
      class="search-input"
      placeholder="Search the Body of Knowledge…"
      aria-label="Search the Body of Knowledge"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
    />
    <button type="submit" value="close" class="search-esc" aria-label="Close search">Esc</button>
  </form>
  <div class="search-status" id="search-status" role="status" aria-live="polite" hidden></div>
  <ul class="search-results" id="search-results" role="listbox" aria-label="Search results"></ul>
</dialog>

<script is:inline src="/search.js" type="module"></script>

<style>
  .search-dialog {
    width: min(640px, calc(100vw - 2 * var(--s-4)));
    max-height: 70vh;
    /* The global `* { margin: 0 }` reset (base.css) drops the UA `margin: auto`
       that places a modal dialog, pinning it to the top-left corner. Centre it
       horizontally and anchor it near the top so the input stays put while the
       result list grows below it. */
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
    overflow: hidden;
  }

  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }

  /* Entry/exit: the panel rises and settles (transform only, its text is never
     faded); only the text-free scrim fades. @starting-style gives the
     first-frame state on showModal(); allow-discrete keeps display/overlay
     alive through the exit so close() animates too. No motion: instant. */
  @media (prefers-reduced-motion: no-preference) {
    .search-dialog,
    .search-dialog::backdrop {
      transition-duration: var(--dur);
      transition-timing-function: var(--ease);
      transition-behavior: allow-discrete;
    }

    .search-dialog {
      transition-property: transform, display, overlay;
      transform: translateY(8px) scale(0.98);
    }

    .search-dialog[open] {
      transform: none;
    }

    .search-dialog::backdrop {
      transition-property: opacity, display, overlay;
      opacity: 0;
    }

    .search-dialog[open]::backdrop {
      opacity: 1;
    }

    @starting-style {
      .search-dialog[open] {
        transform: translateY(8px) scale(0.98);
      }

      .search-dialog[open]::backdrop {
        opacity: 0;
      }
    }
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--line);
  }

  .search-icon {
    flex: none;
    color: var(--muted);
  }

  .search-input {
    flex: 1;
    border: 0;
    background: none;
    font-size: 1.0625rem;
    outline: none;
  }

  .search-esc {
    flex: none;
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    cursor: pointer;
  }

  .search-status {
    padding: var(--s-4);
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: var(--s-2);
    overflow-y: auto;
    max-height: calc(70vh - 60px);
  }

  .search-results:empty {
    display: none;
  }

  /* The result rows are built by /search.js at runtime, so they never carry
     this component's scope attribute: every rule below them goes through
     :global(), anchored on the (scoped) list so it stays local to the dialog. */
  .search-results :global(.search-result a) {
    display: block;
    padding: var(--s-3);
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--ink);
  }

  .search-results :global(.search-result a:hover),
  .search-results :global(.search-result[aria-selected='true'] a) {
    background: var(--surface);
  }

  .search-results :global(.search-result-title) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
  }

  .search-results :global(.search-result-excerpt) {
    margin-top: var(--s-1);
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  /* The matched term: the neutral tint (never a layer hue, which would read as
     a stack layer) and full --ink over the --ink-2 excerpt, weighted so the
     match still stands out where the tint is faint. */
  .search-results :global(.search-result-excerpt mark) {
    background: var(--tint-bg);
    color: var(--ink);
    font-weight: 600;
    padding: 0 2px;
    border-radius: 2px;
  }
</style>
