---
// /role/competencies: the competency matrix of the AI governance engineer, the
// seven workflows of /role by the first four rungs of the career ladder in
// chapter 06, plus a function-level band for rung five. Content comes from
// src/data/competencies.ts (OpenSpec change competency-matrix). It is the
// author's model: no score, no form, no stored state, and no client script, so
// everything is in the HTML without JavaScript. Every workflow is an
// <article id="<workflow id>"> and every cell a <section id="<workflow id>-r<n>">:
// stable permalinks. The page throws at build time when the data is incoherent.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Callout from '../../components/Callout.astro';
import Citation from '../../components/Citation.astro';
import SkillsTable from '../../components/SkillsTable.astro';
import Painting from '../../components/Painting.astro';
import { paintings } from '../../data/paintings';
import { site } from '../../data/site';
import { workflows } from '../../data/role';
import {
  COMPETENCIES_PATH,
  competenciesDisclaimer,
  competencyCellId,
  competencyCells,
  competencyProblems,
  functionLabel,
  functionStatements,
  rungs,
  skillsFor,
} from '../../data/competencies';
import { breadcrumbId, breadcrumbJsonLd } from '../../lib/breadcrumbs';
import { authorNodes, authorRefs, lastModified, ORG_ID, WEBSITE_ID } from '../../lib/jsonld';
import { fitsSiteSuffix } from '../../lib/seo-title';
import '../../styles/reading.css';
import '../../styles/resources.css';
import '../../styles/pages.css';

const problems = competencyProblems();
if (problems.length > 0) {
  throw new Error(`competencies.ts invariants failed:\n${problems.join('\n')}`);
}

const seoTitle = 'Competency matrix for the AI governance engineer';
const description =
  'A competency matrix for the AI governance engineer: seven workflows by four rungs of the career ladder, each cell with the evidence that shows it.';
const crumbs = [{ label: 'The role', href: '/role' }, { label: 'Competency matrix' }];
const pageUrl = new URL(COMPETENCIES_PATH, site.url).href;
const updated = lastModified(
  'src/pages/role/competencies.astro',
  'src/data/competencies.ts',
  'src/data/role.ts',
);

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${pageUrl}#page`,
    name: seoTitle,
    description,
    url: pageUrl,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    publisher: { '@id': ORG_ID },
    author: [...authorRefs],
    dateModified: updated,
    breadcrumb: { '@id': breadcrumbId(pageUrl) },
  },
  ...authorNodes,
  breadcrumbJsonLd(crumbs, pageUrl),
];

const cellOf = (workflow: string, rung: number) => {
  const cell = competencyCells.find((c) => c.workflow === workflow && c.rung === rung);
  if (!cell) throw new Error(`competencies page: no cell for ${workflow} rung ${rung}`);
  return cell;
};
const layerLabel = (n: number | 'all') => (n === 'all' ? 'All layers' : `Layer ${n}`);
const swatch = (n: number | 'all') => (n === 'all' ? 'sw sw-none' : `sw sw-${n}`);
const mat = paintings['pourville-misty-morning'];
const matCredit = `${mat.artist}, ${mat.title}, ${mat.year}`;
const matrixRungs = rungs.filter((r) => r.n <= 4);
const top = rungs[rungs.length - 1];
---

<Base
  title={seoTitle}
  titleSuffix={fitsSiteSuffix(seoTitle)}
  description={description}
  image="/og/role-competencies.png"
  jsonLd={jsonLd}
>
  <PageHero
    variant="res"
    crumbs={crumbs}
    title="What an AI governance engineer can own, rung by rung"
    lede="Seven workflows by four rungs of the career ladder: for each cell, what a person can take on end to end and the artefact in the systems that shows it."
  />

  <div class="container res-page">
    <section class="res-section prose" aria-labelledby="cm-short-heading">
      <h2 id="cm-short-heading">In short</h2>
      <p>
        The matrix crosses the seven workflows of the AI governance engineer role with the first four
        rungs of the career ladder in chapter 06 of the Body of Knowledge: associate, AI governance
        engineer, senior, and staff or principal. Each of the 28 cells says what a person can own end to
        end at that rung and which artefact, visible in the systems and not in a title, shows it. A fifth
        band describes the head of the function. It is the author's model, not an industry standard.
      </p>
    </section>

    <section class="res-section" aria-labelledby="cm-table-heading">
      <div class="res-section-head">
        <h2 id="cm-table-heading">The roadmap</h2>
        <p>
          Each track is one workflow. Read it from left to right across the four rungs, and see the seven
          tracks meet at rung 5, the function. Select a node for its cell: what the person can own, the
          evidence, and where to learn it.
        </p>
      </div>
      <div class="mat cm-mat">
        <Painting id="pourville-misty-morning" sizes="(min-width: 1200px) 1168px, calc(100vw - 32px)" />
        <div class="cm-panel">
          <ul class="cm-legend" aria-label="Layer key">
            {
              [1, 2, 3, 4, 5, 'all' as const].map((n) => (
                <li>
                  <span class={swatch(n)} aria-hidden="true" />
                  <span class="label">{layerLabel(n)}</span>
                </li>
              ))
            }
          </ul>
          <table class="cm-table" role="table">
            <caption class="visually-hidden">
              Competency roadmap: what a person can own, by workflow and rung
            </caption>
            <thead role="rowgroup">
              <tr role="row">
                <th scope="col" role="columnheader">Workflow</th>
                {
                  matrixRungs.map((r) => (
                    <th scope="col" role="columnheader">
                      <span class="label cm-rung">Rung {r.n}</span>
                      {r.name}
                    </th>
                  ))
                }
                <th scope="col" role="columnheader" class="cm-col-end">
                  <span class="label cm-rung">Rung {top.n}</span>
                  {top.name}
                </th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {
                workflows.map((w, i) => (
                  <tr role="row">
                    <th scope="row" role="rowheader">
                      <span class="cm-rowname">
                        <span class={swatch(w.layerN)} aria-hidden="true" />
                        <a href={`#${w.id}`}>{w.name}</a><span class="visually-hidden">, {layerLabel(w.layerN)}</span>
                      </span>
                    </th>
                    {matrixRungs.map((r) => {
                      const cell = cellOf(w.id, r.n);
                      return (
                        <td role="cell">
                          <a class="cm-node" href={`#${competencyCellId(w.id, r.n)}`}>
                            <span class="label cm-node-rung" aria-hidden="true">
                              Rung {r.n} · {r.name}
                            </span>
                            <span class="cm-node-label">
                              <span class={swatch(w.layerN)} aria-hidden="true" />
                              <span class="visually-hidden">Rung {r.n}: </span>{cell.label}<span class="visually-hidden">, {w.name}</span>
                            </span>
                          </a>
                        </td>
                      );
                    })}
                    {i === 0 && (
                      <td role="cell" class="cm-end" rowspan={workflows.length} aria-rowspan={workflows.length}>
                        <a class="cm-node cm-node--end" href="#function">
                          <span class="label cm-node-rung">Rung {top.n}</span>
                          <span class="cm-node-name">{top.name}</span>
                          <span class="cm-node-label">{functionLabel}</span>
                        </a>
                      </td>
                    )}
                  </tr>
                ))
              }
            </tbody>
          </table>
          {/* Below 60rem the rowspan cell is not rendered and this copy follows the last track, so focus order equals visual order. */}
          <div class="cm-end-after">
            <a class="cm-node cm-node--end" href="#function">
              <span class="label cm-node-rung">Rung {top.n}</span>
              <span class="cm-node-name">{top.name}</span>
              <span class="cm-node-label">{functionLabel}</span>
            </a>
          </div>
        </div>
      </div>
      <p class="credit">Mat: {matCredit}</p>
    </section>

    <section class="res-section" aria-labelledby="cm-detail-heading">
      <div class="res-section-head">
        <h2 id="cm-detail-heading">Detail by workflow</h2>
        <p>
          Each workflow with the skills <a href="/role">the role page</a> assigns it, then its four cells in
          full: what the person can own, the evidence, and where to learn it.
        </p>
      </div>
      {
        workflows.map((w) => (
          <article id={w.id} class="cm-wf" aria-labelledby={`${w.id}-h`}>
            <div class="cm-wf-head">
              <h3 id={`${w.id}-h`}>{w.name}</h3>
              <span class="cm-wf-layer">
                <span class={swatch(w.layerN)} aria-hidden="true" />
                <span class="cm-note">{layerLabel(w.layerN)}</span>
              </span>
              <a class="cm-back" href="#cm-table-heading">Back to the roadmap</a>
            </div>
            <SkillsTable skills={[skillsFor(w.id)]} />
            <div class="cm-steps">
            {matrixRungs.map((r) => {
              const cell = cellOf(w.id, r.n);
              return (
                <section id={competencyCellId(w.id, r.n)} class="cm-cell" aria-labelledby={`${competencyCellId(w.id, r.n)}-h`}>
                  <h4 id={`${competencyCellId(w.id, r.n)}-h`}>
                    <span class="visually-hidden">{w.name}, </span>
                    <span class="label cm-step-n">Rung {r.n}</span>
                    <span class="visually-hidden">: </span>
                    <span class="cm-step-name">{r.name}</span>
                  </h4>
                  <p>{cell.can}</p>
                  <p>
                    <span class="cm-label mono">Evidence</span>
                    {cell.evidence}
                  </p>
                  <p>
                    <span class="cm-label mono">Learn it</span>
                    {cell.links.map((l, i) => (
                      <>
                        {i > 0 && ' · '}
                        <a href={l.href}>{l.label}</a>
                      </>
                    ))}
                  </p>
                </section>
              );
            })}
            </div>
          </article>
        ))
      }
    </section>

    <section id="function" class="res-section" aria-labelledby="cm-function-heading">
      <div class="res-section-head">
        <h2 id="cm-function-heading">Rung 5: {top.name}</h2>
        <p>{top.scope} This rung is described for the function as a whole, not workflow by workflow.</p>
      </div>
      <ol class="cm-function" role="list">
        {
          functionStatements.map((s, i) => (
            <li id={`function-${i + 1}`} class="cm-cell">
              <p>{s.can}</p>
              <p>
                <span class="cm-label mono">Evidence</span>
                {s.evidence}
              </p>
            </li>
          ))
        }
      </ol>
      <p><a class="cm-back" href="#cm-table-heading">Back to the roadmap</a></p>
    </section>

    <section class="res-section prose" aria-labelledby="cm-use-heading">
      <h2 id="cm-use-heading">How to use it</h2>
      <h3>To hire</h3>
      <p>
        Pick the one or two workflows the first hire will own and the rung you need. Ask the candidate to
        show the evidence in the cell, such as a gate they built or a record they kept, and look at the
        artefact itself. The three ways people come into the role, and what each brings, are on the{' '}
        <a href="/role#ways-in">role page</a>.
      </p>
      <h3>To prepare for the role</h3>
      <p>
        Choose a workflow and read its rung 1 and rung 2 cells. Each links to the pattern, tool or path
        node where you do the work, and the rung 2 evidence is a good target for a first project. The
        <a href="/path">learning path</a> orders the same material in four stages.
      </p>
    </section>

    <section class="res-section prose" aria-labelledby="cm-method-heading">
      <h2 id="cm-method-heading">Method and limits</h2>
      <p>
        The rows are the seven workflows that <a href="/role">the role page</a> publishes. The columns are the
        career ladder of <a href="/bok/the-role">chapter 06</a>. Each cell was written from what this site
        already teaches, and each links to it.
      </p>
      <ul>
        <li>{competenciesDisclaimer}</li>
        <li>There is no score, no form and no stored state. The page does not tell you your level.</li>
        <li>
          Evidence is an artefact you can show in the systems. A certificate is not evidence of a
          competency, and neither is a title.
        </li>
        <li>The matrix is not mapped to any certification or to any third-party competency framework.</li>
        <li>Rungs 1 to 4 are split by workflow. Rung 5 describes the function and is not.</li>
      </ul>
      <Callout kind="note" title="A model, not a standard">
        <p>
          It is a published professional position of the author, open to correction.
          <a href={`${site.github}/issues/new?template=report-an-error.yml`} rel="noopener">Report a problem on GitHub</a>.
        </p>
      </Callout>
    </section>

    <div class="cm-cite">
      <Citation title="Competency matrix for the AI governance engineer" url={COMPETENCIES_PATH} kind="page" />
    </div>
  </div>

  <script is:inline defer src="/cite.js"></script>
</Base>

<style>
  .cm-cite {
    margin-top: var(--s-6);
  }
  .cm-note {
    display: block;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  /* ---------------------------------------------------- Roadmap on a painting */
  .cm-mat {
    /* border of anything that carries meaning (node, connector, step line): 3:1 on the panel */
    --cm-edge: color-mix(in srgb, var(--ink) 52%, var(--panel));
    padding: clamp(12px, 2.4vw, 32px);
  }
  .cm-wf {
    --cm-edge: color-mix(in srgb, var(--ink) 52%, var(--panel));
  }
  .cm-panel {
    margin-inline: auto;
    padding: var(--s-4) var(--s-4) var(--s-5);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-blk);
  }
  .cm-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    margin: 0 0 var(--s-5);
    padding: 0 0 var(--s-4);
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .cm-legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .cm-legend .label {
    color: var(--ink-2);
  }

  .cm-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }
  .cm-table th,
  .cm-table td {
    padding: 0;
    text-align: left;
    font-weight: 400;
  }
  .cm-table thead th {
    padding: 0 var(--s-3) var(--s-3);
    vertical-align: bottom;
    overflow-wrap: anywhere;
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }
  .cm-table thead th:first-child {
    width: 9rem;
    padding-left: 0;
  }
  .cm-table thead th.cm-col-end {
    width: 11rem;
  }
  .cm-rung {
    display: block;
    margin-bottom: 3px;
    color: var(--accent);
  }
  .cm-table tbody th {
    padding: var(--s-2) var(--s-3) var(--s-2) 0;
    vertical-align: middle;
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }
  .cm-rowname {
    display: flex;
    align-items: flex-start;
    gap: var(--s-2);
  }
  .cm-rowname .sw {
    margin-top: 5px;
  }
  .cm-rowname a {
    color: var(--ink);
    text-decoration: none;
  }
  .cm-rowname a:hover {
    color: var(--accent);
  }
  /* the connector runs behind the nodes, through the padding of the cell */
  .cm-table tbody td {
    position: relative;
    padding: var(--s-2);
    vertical-align: middle;
  }
  .cm-table tbody td:not(.cm-end)::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--cm-edge);
  }
  .cm-node {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    box-sizing: border-box;
    height: 100%;
    min-height: 4.5rem;
    padding: var(--s-2) var(--s-3);
    background: var(--panel);
    border: 1px solid var(--cm-edge);
    border-radius: var(--r-ctl);
    color: var(--ink);
    text-decoration: none;
    transition: transform var(--dur) var(--ease);
  }
  .cm-node:hover {
    box-shadow: var(--lift);
    transform: translateY(-1px);
  }
  .cm-node-label {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    overflow-wrap: anywhere;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
  }
  /* the rung is named by the column header on a wide table, and by the node on a narrow one */
  .cm-node-rung {
    display: none;
    color: var(--ink-2);
  }

  /* the seven tracks meet in one bar, then one connector into the fifth rung */
  .cm-table td.cm-end {
    padding: 0 0 0 30px;
  }
  /* the bar: one segment per row at the right edge of its last station, so it follows any row height */
  .cm-table tbody td:nth-child(5)::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 1px;
    background: var(--cm-edge);
  }
  .cm-table tbody tr:first-child td:nth-child(5)::after {
    top: 50%;
  }
  .cm-table tbody tr:last-child td:nth-child(5)::after {
    bottom: 50%;
  }
  .cm-end-after {
    display: none;
  }
  .cm-node--end {
    height: auto;
    padding: var(--s-3) var(--s-4) var(--s-4);
    gap: 4px;
  }
  .cm-node--end::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 100%;
    width: 30px;
    height: 1px;
    background: var(--cm-edge);
  }
  .cm-node--end .cm-node-rung {
    display: block;
    color: var(--accent);
  }
  .cm-node-name {
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.3;
  }

  /* ---------------------------------------------------- Detail by workflow */
  .cm-wf {
    margin-block: var(--s-6);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
  }
  .cm-wf-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-4);
  }
  .cm-wf-head h3 {
    margin: 0;
  }
  .cm-wf-layer {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .cm-back {
    font-size: var(--fs-small);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-underline-offset: 0.22em;
  }
  .cm-back:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .cm-wf-head .cm-back {
    margin-left: auto;
  }
  .cm-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .cm-cell {
    position: relative;
    margin-block: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-blk);
    background: var(--panel);
  }
  .cm-steps > .cm-cell {
    margin-block: var(--s-4) 0;
  }
  .cm-cell:target {
    border-left: 3px solid var(--accent);
    padding-left: calc(var(--s-4) - 2px);
  }
  .cm-cell h4 {
    margin: 0 0 var(--s-2);
  }
  /* "Rung n" and the rung name on separate lines, so the node dots and connectors line up */
  .cm-step-n {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--accent);
  }
  .cm-step-n::before {
    content: '';
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: var(--r-pill);
    background: var(--panel);
    border: 2px solid var(--accent);
  }
  .cm-step-name {
    display: block;
    margin-top: 4px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .cm-cell p {
    margin: var(--s-2) 0 0;
    overflow-wrap: anywhere;
  }
  /* the stepper line: a hairline between neighbouring steps */
  .cm-steps > .cm-cell:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 24px;
    left: 100%;
    width: var(--s-4);
    height: 1px;
    background: var(--cm-edge);
  }
  .cm-function {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
  }
  .cm-label {
    font-size: var(--fs-label);
    text-transform: uppercase;
    color: var(--ink-2);
    margin-right: var(--s-2);
  }

  /* ---------------------------------------------------- Narrow */
  @media (max-width: 60rem) {
    .cm-panel {
      padding: var(--s-4) var(--s-3) var(--s-4);
    }
    /* each track becomes its own vertical path under the workflow name */
    .cm-table,
    .cm-table tbody,
    .cm-table tr,
    .cm-table th,
    .cm-table td {
      display: block;
    }
    .cm-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    /* the row is the spine (its left border) */
    .cm-table tbody tr {
      margin: 0 0 var(--s-5) 7px;
      padding-left: 21px;
      border-left: 1px solid var(--cm-edge);
    }
    .cm-table tbody th {
      position: relative;
      margin-bottom: var(--s-3);
      padding: 0;
    }
    .cm-table tbody th::before {
      content: '';
      position: absolute;
      left: -27px;
      top: 5px;
      width: 11px;
      height: 11px;
      border-radius: var(--r-pill);
      background: var(--panel);
      border: 2px solid var(--accent);
    }
    .cm-table tbody td {
      margin-top: var(--s-2);
      padding: 0;
    }
    .cm-table tbody td:nth-child(5)::after,
    .cm-table thead th.cm-col-end {
      display: none;
    }
    .cm-table tbody td:not(.cm-end)::before {
      top: 50%;
      left: -21px;
      right: auto;
      width: 21px;
    }
    .cm-node {
      height: auto;
      min-height: 0;
      padding: var(--s-2) var(--s-3);
    }
    .cm-node-rung {
      display: block;
    }
    .cm-node--end {
      padding: var(--s-3) var(--s-4) var(--s-4);
    }
    .cm-table tbody td.cm-end {
      display: none;
    }
