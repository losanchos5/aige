---
// /frontier: the audience route for frontier labs and evaluators (OpenSpec
// change open-reference-project, block orp-frontier). It shows where the
// controls, patterns and evidence formats of this site apply to frontier AI
// evaluation, runtime safeguards, assurance and incidents, and names the
// existing certification schemes with public facts only. Frontier work is one
// application domain of the discipline, not an axis of the site, so the page
// follows the audience hub template (src/components/AudienceHub.astro).
//
// Copy, link lists and sources live in src/data/frontier.ts; the build throws
// on any problem frontierProblems() reports. No script. Every tinted band goes
// through <Section tone="tint">, so --muted stays AA there (DESIGN.md hard
// constraint 3). The anchors other pages link to are fixed: who,
// evaluation-environments, runtime-safeguards, assurance, incidents,
// stack-map, open-questions and sources. Three chart-kit figures (OpenSpec
// page-visuals-2, design D8): EvalBoundary at the head of
// #evaluation-environments, the case x control matrix in #incidents and the
// AIUC-1 waffle in #ecosystem.
import Marketing from '../layouts/Marketing.astro';
import '../styles/reading.css';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import RegisterList from '../components/RegisterList.astro';
import CitedText from '../components/CitedText.astro';
import SourceList from '../components/SourceList.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import ContributeCta from '../components/ContributeCta.astro';
import CtaBand from '../components/CtaBand.astro';
import Chart from '../components/Chart.astro';
import EvalBoundary from '../components/EvalBoundary.astro';
import { site } from '../data/site';
import { layers } from '../data/stack';
import {
  frontierBlocks,
  frontierChain,
  frontierHero,
  frontierNot,
  frontierOpening,
  frontierOpenQuestions,
  frontierProblems,
  frontierRoles,
  frontierSources,
  frontierStackMap,
  LAB_NAMES,
  type FrontierLink,
} from '../data/frontier';
import { cases } from '../data/cases';
import { CONTROLS_AS_OF, controlAnchorPath, controlsIn } from '../data/controls';
import { AIUC1_INDEX, aiuc1Domains, aiuc1Requirements, type Aiuc1Domain } from '../data/aiuc1';
import { casesForControl } from '../lib/cross-links';
import { NARROW_WIDTH, dotMatrix } from '../lib/charts';
import { breadcrumbJsonLd } from '../lib/breadcrumbs';
import { authorRefs, lastModified, ORG_ID, WEBSITE_ID } from '../lib/jsonld';
import { fitsSiteSuffix } from '../lib/seo-title';
import '../styles/pages.css';
import '../styles/resources.css';

const problems = frontierProblems();
if (problems.length) throw new Error(`frontier.ts:\n${problems.join('\n')}`);

const seoTitle = 'Frontier AI evaluation assurance';
const description =
  'Engineering assurance for frontier AI: evaluation environment controls, runtime safeguards and machine-verifiable evidence on the five-layer stack.';
const crumbs = [{ label: 'For you', href: '/for' }, { label: 'Frontier labs & evaluators' }];
const pageUrl = new URL('/frontier', site.url).href;

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${pageUrl}#page`,
    name: seoTitle,
    description,
    url: pageUrl,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    publisher: { '@id': ORG_ID },
    author: [...authorRefs],
    // The same sources as the sitemap's lastmod (astro.config.ts SOURCE_BY_PATH).
    dateModified: lastModified('src/pages/frontier.astro', 'src/data/frontier.ts'),
    audience: { '@type': 'Audience', audienceType: frontierRoles.join(', ') },
  },
  breadcrumbJsonLd(crumbs),
];

// Umami attributes (declarative) on the rows that lead to the open data API and the MCP server.
const docsEvent = (href: string): Record<string, string> | undefined =>
  href === '/mcp'
    ? { 'data-umami-event': 'mcp-docs-click', 'data-umami-event-from': '/frontier' }
    : href === '/resources/data' || href.startsWith('/api/v1')
      ? { 'data-umami-event': 'api-docs-click', 'data-umami-event-from': '/frontier' }
      : undefined;

const toRows = (links: readonly FrontierLink[]) =>
  links.map((l) => ({
    title: l.title,
    description: l.description,
    href: l.href,
    ...(l.layer ? { swatch: `var(--l${l.layer})` } : {}),
    ...(docsEvent(l.href) ? { attrs: docsEvent(l.href) } : {}),
  }));

// Plain and tinted bands alternate: #who is plain, so the blocks start tinted.
const blockTone = (i: number): 'plain' | 'tint' => (i % 2 === 0 ? 'tint' : 'plain');
const stackTone = blockTone(frontierBlocks.length);
const questionsTone = blockTone(frontierBlocks.length + 1);
const sourcesTone = blockTone(frontierBlocks.length + 2);

const stackRows = layers.map((layer) => ({
  title: `Layer ${String(layer.n).padStart(2, '0')}: ${layer.name}`,
  description: frontierStackMap[layer.n],
  href: `/bok/the-stack#${layer.chapterAnchor}`,
  swatch: `var(${layer.colorVar})`,
}));

// #incidents: which public cases name which evaluation environment control
// (casesForControl, from each case's relatedControls). One row per control,
// one square per case that names it, the cases always in the order of
// data/cases.ts; each square links
// to its case, named as #incidents lists it (the page's neutral labels, no
// lab named) or else neutrally (caseLabel). The controls are linked in the key
// under the chart. A HeatGrid of every case x control cell would pass the
// 12 KB budget of one SVG (a tooltip per cell), so the waffle draws only the
// named pairs.
const evalControls = controlsIn('evaluation-environment');
const shortId = (id: string) => id.replace(/^AIGE-CTL-/, '');
const casesOf = new Map(evalControls.map((c) => [c.id, new Set(casesForControl(c.id).map((k) => k.id))]));
const matrixCases = cases.filter((k) => evalControls.some((c) => casesOf.get(c.id)!.has(k.id)));
const incidentTitles = new Map(
  (frontierBlocks.find((b) => b.id === 'incidents')?.links ?? []).map((l) => [l.href, l.title]),
);
// A case the block does not list keeps its short label, unless that names a
// lab (LAB_NAMES, the page's rule): then the part of its title after the
// colon, which describes the failure.
const caseLabel = (k: (typeof cases)[number]) => {
  const listed = incidentTitles.get(`/cases/${k.id}`);
  if (listed) return listed;
  if (!LAB_NAMES.test(k.short)) return k.short;
  const rest = k.title.split(': ').slice(1).join(': ');
  const label = rest.charAt(0).toUpperCase() + rest.slice(1);
  if (!rest || LAB_NAMES.test(label)) throw new Error(`frontier: no neutral label for case ${k.id}`);
  return label;
};
const caseBase = {
  title: 'Public cases by the evaluation control they name',
  desc: `The ${evalControls.length} evaluation environment controls, each with one square per incident case that names it among its related controls; ${matrixCases.length} cases name at least one.`,
  source: 'incident cases; Evaluation Environment Control Profile',
  asOf: CONTROLS_AS_OF,
  mode: 'figc' as const,
  groups: evalControls.map((c) => ({
    label: shortId(c.id),
    items: matrixCases
      .filter((k) => casesOf.get(c.id)!.has(k.id))
      .map((k) => ({ label: caseLabel(k), status: 'Names the control', href: `/cases/${k.id}` })),
  })),
  groupHeader: 'Control',
  unit: 'cases',
  tableCaption: 'Each evaluation environment control with the incident cases that name it',
};
const caseWide = dotMatrix({ ...caseBase, id: 'fr-cases-w', width: 480 });
// Narrow, the SVG scales a little under 1 on a 320 px screen, so the default
// 24-unit pitch lands under the 24 px of WCAG 2.5.8: a 28-unit pitch keeps
// the squares' centres 24 px apart down to 0.86 scale.
const caseNarrow = dotMatrix({ ...caseBase, id: 'fr-cases-n', width: NARROW_WIDTH, cell: 20, gap: 8 });
const busiest = [...evalControls].sort((a, b) => casesOf.get(b.id)!.size - casesOf.get(a.id)!.size)[0];

// #ecosystem: the AIUC-1 requirements by domain, one square each, the
// retired ones in outline, as the public index listed them when it was read.
// The squares do not link: 53 links to the requirements' public pages pass
// the 12 KB budget of one SVG, so the index itself is linked under the chart.
const domainKeys = Object.keys(aiuc1Domains) as Aiuc1Domain[];
const aiucRetired = aiuc1Requirements.filter((r) => r.retired).length;
const aiucBase = {
  title: 'AIUC-1 requirements by domain',
  desc: `The ${aiuc1Requirements.length} requirements of the AIUC-1 public index in its ${domainKeys.length} domains, ${aiucRetired} marked retired.`,
  source: 'AIUC-1 public index',
  asOf: AIUC1_INDEX.read,
  mode: 'figc' as const,
  groups: domainKeys.map((d) => ({
    label: `${d} ${aiuc1Domains[d]}`,
    items: aiuc1Requirements
      .filter((r) => r.domain === d)
      .map((r) => ({
        label: `${r.id} ${r.title}`,
        state: r.retired ? ('outline' as const) : ('filled' as const),
        status: r.retired ? 'Retired' : 'Listed',
      })),
  })),
  unit: 'requirements',
  groupHeader: 'Domain',
  legendTitles: { state: 'One square per requirement, drawn by its status in the index' },
  tableCaption: 'Each AIUC-1 requirement by domain, listed or retired',
};
const aiucWide = dotMatrix({ ...aiucBase, id: 'fr-aiuc-w', width: 640 });
const aiucNarrow = dotMatrix({ ...aiucBase, id: 'fr-aiuc-n', width: NARROW_WIDTH });
---

<Marketing
  title={seoTitle}
  titleSuffix={fitsSiteSuffix(seoTitle)}
  description={description}
  image="/og/frontier.png"
  jsonLd={jsonLd}
>
  <PageHero variant="res" crumbs={crumbs} title={frontierHero.title} lede={frontierHero.lede} />

  <Section tone="plain" id="who" title="Who this route is for.">
    <div class="well fr-who" data-pagefind-body>
      {frontierOpening.map((p) => <p>{p}</p>)}
      <ul class="chips" aria-label="Written for">
        {frontierRoles.map((role) => <li class="chip">{role}</li>)}
      </ul>
      <p class="fr-note">{frontierNot}</p>
      <p class="fr-note">
        New to the field? Read <a href="/ai-governance">AI governance explained</a>: the
        definition, the frameworks and where engineering fits.
      </p>
    </div>
    <div class="fr-chain">
      <FlowDiagram
        id="frontier-chain"
        title="From the model to the assurance record"
        desc="Each step links to where this site treats it; the swatch marks its layer on the stack."
        steps={frontierChain}
      />
    </div>
  </Section>

  {
    frontierBlocks.map((block, i) => (
      <Section tone={blockTone(i)} id={block.id} title={block.title} lede={block.lede}>
        {block.id === 'evaluation-environments' && (
          <div class="fr-figure fr-figure-head">
            <EvalBoundary id="fr-eval-boundary" />
          </div>
        )}
        <div class="prose fr-prose" data-pagefind-body>
          {block.paragraphs.map((p) => (
            <p>
              <CitedText text={p} />
            </p>
          ))}
        </div>
        {block.id === 'incidents' && (
          <div class="fr-figure">
            <Chart
              id="fr-cases"
              title="Which case names which control"
              caption={`One row per evaluation environment control, one square per public incident case that names it; the number is how many cases name the control. ${shortId(busiest.id)} ${busiest.title} is named by ${casesOf.get(busiest.id)!.size} of the ${matrixCases.length} cases; select a square to open the case.`}
              chart={caseWide}
              narrow={caseNarrow}
            />
            <p class="fr-key">
              The controls:{' '}
              {evalControls.map((c, k) => (
                <>
                  <a href={controlAnchorPath(c)}>
                    {shortId(c.id)} {c.title}
                  </a>
                  {k < evalControls.length - 1 ? '; ' : '.'}
                </>
              ))}
            </p>
          </div>
        )}
        {block.id === 'ecosystem' && (
          <div class="fr-figure">
            <Chart
              id="fr-aiuc"
              title="AIUC-1 at a glance"
              caption={`One square per requirement of the public index, by domain; the ${aiucRetired} retired ones in outline. Where the standard is thick and where it is thin, as its own index lists it.`}
              chart={aiucWide}
              narrow={aiucNarrow}
            />
            <p class="fr-key">
              Each requirement's own page is listed in the{' '}
              <a href={AIUC1_INDEX.url}>AIUC-1 public index</a>, read on {AIUC1_INDEX.read}.
            </p>
          </div>
        )}
        <div class="well fr-links">
          <RegisterList items={toRows(block.links)} />
        </div>
      </Section>
    ))
  }

  <Section
    tone={stackTone}
    id="stack-map"
    title="Where it sits on the stack."
    lede="The same five layers as every other route, read for frontier evaluation and deployment."
  >
    <div class="well"><RegisterList items={stackRows} /></div>
  </Section>

  <Section tone={questionsTone} id="open-questions" title="Open questions.">
    <div class="well fr-questions" data-pagefind-body>
      <ol class="fr-qlist">
        {frontierOpenQuestions.map((q) => <li>{q}</li>)}
      </ol>
      <p class="fr-note">
        Each one is a candidate for a <a href="/research">research note</a>. If you work on one of
        them, or think this route gets the engineering wrong, <a href="/contribute">contribute</a>:
        corrections are reviewed in the open.
      </p>
      <ContributeCta kind="assumption" title="Frontier route" />
    </div>
  </Section>

  <Section tone={sourcesTone} id="sources" title="Sources">
    <div class="prose fr-sources">
      <SourceList sources={frontierSources} />
    </div>
  </Section>

  <CtaBand
    title="Start with the evaluation environment profile."
    sub="Nine draft controls for the environment a model is evaluated in, each with its enforcement point and evidence."
    primary={{ label: 'Open the profile', href: '/controls/evaluation-environment' }}
    secondary={{ label: 'All routes', href: '/for' }}
  />
</Marketing>

<style>
  .fr-who > * + * {
    margin-top: var(--s-5);
  }

  .fr-who > p:first-child {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .fr-note {
    color: var(--ink-2);
  }

  .fr-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .fr-chain {
    margin-top: var(--s-7);
  }

  /* .prose carries the citation chip styles; drop the outer margin a
     Section body does not need. */
  .fr-prose {
    margin: 0;
  }

  .fr-links {
    margin-top: var(--s-6);
  }

  .fr-figure {
    margin-top: var(--s-6);
  }

  .fr-figure-head {
    margin: 0 0 var(--s-6);
  }

  .fr-figure > :global(figure) {
    margin: 0;
  }

  .fr-key {
    max-width: var(--prose);
    margin: var(--s-3) 0 0;
    color: var(--ink-2);
  }

  .fr-key a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .fr-questions > * + * {
    margin-top: var(--s-5);
  }

  .fr-qlist {
    margin: 0;
    padding-left: 1.25em;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    color: var(--ink);
    line-height: 1.5;
  }

  .fr-sources {
    margin: 0;
  }
</style>
