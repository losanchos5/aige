---
// /<lang>/bok/<slug>: a machine-translated chapter (I18N_DIR/<lang>/bok/<id>.md),
// rendered with the English chapter's reading layout. Only the chapters that
// have a translation get a route. The page carries the English page's heading
// ids (lib/rehype-i18n.ts), so every #anchor, figure and diagram placement of
// the English chapter lands on the same section here; it opens with the
// translation notice, links its sibling translations in the rail and the
// pager, and names every language it exists in (hreflang, the switcher).
import { getEntry, render } from 'astro:content';
import Doc from '../../../layouts/Doc.astro';
import AtAGlance from '../../../components/AtAGlance.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import { site } from '../../../data/site';
import { chapterNum } from '../../../data/parts';
import { getGlossaryEntry } from '../../../lib/glossary';
import { authorNodes, authorRefs, ORG_ID, WEBSITE_ID } from '../../../lib/jsonld';
import { alternatesFor, pathIn, translationFilePath } from '../../../lib/i18n-content';
import {
  allTranslations,
  assertSameAnchors,
  chapterLinks,
  shortTitleOf,
  translatedShortTitle,
  type TranslatedChapter,
} from '../../../lib/i18n-pages';
import { gitCreated, gitDate } from '../../../lib/reading';
import { translator } from '../../../i18n/ui';

export async function getStaticPaths() {
  const { chapters } = await allTranslations();
  return chapters.map((item) => {
    // The pager stays in the page's language: its neighbours are the other
    // chapters translated into it, in reading order.
    const siblings = chapters.filter((other) => other.lang === item.lang);
    const i = siblings.indexOf(item);
    return {
      params: { lang: item.lang, slug: item.chapter.slug },
      props: { item, prev: siblings[i - 1], next: siblings[i + 1] },
    };
  });
}

interface Props {
  item: TranslatedChapter;
  prev?: TranslatedChapter;
  next?: TranslatedChapter;
}

const { item, prev, next } = Astro.props;
const { entry, chapter, lang } = item;
const t = translator(lang);
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

// The anchors must be the English page's, position by position.
const english = await getEntry('bok', chapter.id);
if (!english) throw new Error(`i18n: no English chapter "${chapter.id}"`);
assertSameAnchors((await render(english)).headings, headings, item.filePath);

const title = (remarkPluginFrontmatter.title as string | undefined) ?? chapter.title;
const summary = (remarkPluginFrontmatter.summary as string | undefined) ?? chapter.summary;
const path = `/${lang}/bok/${chapter.slug}`;
const englishPath = `/bok/${chapter.slug}`;
const file = translationFilePath(item.file);
const updated = gitDate(file);
const published = gitCreated(file);
const ogPath = `/og/bok-${chapter.slug}.png`;

// The chapter's key terms link to the English glossary pages, so their names
// stay English (and are marked so).
const keyTerms = (chapter.keyTerms ?? []).map((slug) => {
  const term = getGlossaryEntry(slug);
  if (!term) throw new Error(`chapters.ts: "${chapter.id}" lists key term "${slug}", not in the glossary`);
  return { term: term.term, url: term.url, id: term.id };
});
// "At a glance" is editorial data (chapters.ts), not part of the Markdown; a
// translation shows it only when its frontmatter carries its own `glance`.
const glance = entry.data.glance;

const adjacent = (other?: TranslatedChapter) =>
  other ? { slug: other.chapter.slug, shortTitle: translatedShortTitle(other) } : undefined;
// The rail links every chapter translated into this language to its translation.
const sidebarLinks = await chapterLinks(lang);

const crumbs = [
  { label: t('breadcrumb.bok'), href: `/${lang}/bok` },
  { label: `${chapterNum(chapter.order)} · ${shortTitleOf(title)}` },
];

const pageUrl = new URL(path, site.url).href;
const englishUrl = new URL(englishPath, site.url).href;
const bokUrl = new URL('/bok', site.url).href;
const bookId = `${bokUrl}#book`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Book',
      '@id': bookId,
      name: 'AI Governance Engineering: The Thesis and Body of Knowledge',
      url: bokUrl,
      version: site.bokVersion,
      inLanguage: 'en',
      author: [...authorRefs],
      publisher: { '@id': ORG_ID },
      isPartOf: { '@id': WEBSITE_ID },
      ...(site.licenseUrl ? { license: site.licenseUrl } : {}),
    },
    {
      '@type': 'TechArticle',
      '@id': `${pageUrl}#article`,
      headline: title,
      url: pageUrl,
      inLanguage: lang,
      datePublished: published,
      dateModified: updated,
      image: new URL(ogPath, site.url).href,
      isPartOf: { '@id': bookId },
      author: [...authorRefs],
      translationOfWork: { '@id': `${englishUrl}#article` },
    },
    ...authorNodes,
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: new URL('/', site.url).href },
        {
          '@type': 'ListItem',
          position: 2,
          name: t('breadcrumb.bok'),
          item: new URL(`/${lang}/bok`, site.url).href,
        },
        { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
      ],
    },
  ],
};
---

<Doc
  title={title}
  summary={summary}
  description={summary}
  crumbs={crumbs}
  crumbsJsonLd={false}
  headings={headings}
  prev={adjacent(prev)}
  next={adjacent(next)}
  slug={chapter.slug}
  updated={updated}
  activeSlug={chapter.slug}
  image={ogPath}
  cite={true}
  jsonLd={jsonLd}
  article={{ publishedTime: `${published}T00:00:00Z`, modifiedTime: `${updated}T00:00:00Z` }}
  lang={lang}
  alternates={alternatesFor(path)}
  markdown={entry.body}
  pagerBase={`/${lang}/bok`}
  citeUrl={path}
  sidebarLinks={sidebarLinks}
  thesisHref={pathIn('/thesis', lang) ?? '/thesis'}
>
  <TranslationNotice
    lang={lang}
    model={item.model}
    englishHref={englishPath}
    path={path}
    file={item.filePath}
    stale={item.stale}
  />
  <AtAGlance items={glance} terms={keyTerms} lang={lang} termsLang="en" />
  <Content />
</Doc>
