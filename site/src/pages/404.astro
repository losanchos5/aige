---
import Base from '../layouts/Base.astro';
import Kicker from '../components/Kicker.astro';
import VerdictStamp from '../components/VerdictStamp.astro';
---

<Base title="Verdict: BLOCK" description="This route is not registered." noindex>
  <section class="section container notfound">
    <Kicker swatch="var(--l3)">Error 404</Kicker>
    <h1 class="display heading">
      Verdict: <VerdictStamp verdict="block" />
    </h1>
    <p class="lede">Route not registered.</p>
    <div class="cta">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-secondary" href="/bok">Body of Knowledge</a>
    </div>
  </section>

  <style>
    .notfound {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-4);
      min-height: 52vh;
      justify-content: center;
    }

    .heading {
      display: flex;
      align-items: center;
      gap: var(--s-3);
      flex-wrap: wrap;
      font-size: var(--fs-h1);
      margin: 0;
    }

    .lede {
      margin: 0;
      color: var(--ink-2);
    }

    .cta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-3);
      margin-top: var(--s-2);
    }
  </style>
</Base>
