---
/**
 * Home — placeholder that exercises the shell (Kicker, RegisterMark, RegisterList,
 * CtaBand). The real home page is built in a later block; keep this clean.
 */
import Marketing from '../layouts/Marketing.astro';
import Kicker from '../components/Kicker.astro';
import RegisterMark from '../components/RegisterMark.astro';
import RegisterList from '../components/RegisterList.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const layers = [
  {
    title: 'Govern-as-Code',
    description: 'Governance rules as executable policy, evaluated in CI/CD and at runtime.',
    swatch: 'var(--l1)',
    href: '/bok/the-stack',
  },
  {
    title: 'Inventory & Transparency',
    description: 'A runtime-aware registry of every model, service and agent.',
    swatch: 'var(--l2)',
    href: '/bok/the-stack',
  },
  {
    title: 'Evals & Red Teaming as Evidence',
    description: 'Tests that can fail the build, not reviews that can only recommend.',
    swatch: 'var(--l3)',
    href: '/bok/the-stack',
  },
  {
    title: 'Runtime Controls & Observability',
    description: 'Guardrails that keep the answers true as the system changes underneath them.',
    swatch: 'var(--l4)',
    href: '/bok/the-stack',
  },
  {
    title: 'Assurance & Continuous Compliance',
    description: 'Signed, queryable, audit-ready evidence emitted as a by-product of the build.',
    swatch: 'var(--l5)',
    href: '/bok/the-stack',
  },
];
---

<Marketing title={site.name}>
  <section class="hero section">
    <div class="container hero-inner reveal">
      <Kicker swatch="var(--l1)" rule
        >Manifesto &amp; Body of Knowledge · v{site.bokVersion}</Kicker
      >
      <RegisterMark size="lg" label={site.name} />
      <h1 class="display">The engineering discipline for governing AI systems.</h1>
      <p class="lede">
        AI governance engineering is the application of engineering practice —
        systems thinking, product thinking and code — to the governance of AI
        systems. Governance you can run, test and prove, not a document you sign.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="/bok">Read the Body of Knowledge</a>
        <a class="btn btn-secondary" href="/manifesto">Read the Manifesto</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <Kicker swatch="var(--l3)">The stack · five layers</Kicker>
      <h2 class="section-title display">A build order, from policy to proof.</h2>
      <div class="well"><RegisterList items={layers} /></div>
    </div>
  </section>

  <CtaBand
    title="Build governance you can run."
    sub="An open Body of Knowledge for the discipline, curated in the open."
    primary={{ label: 'Read the Body of Knowledge', href: '/bok' }}
    secondary={{ label: 'Read the Manifesto', href: '/manifesto' }}
  />
</Marketing>

<style>
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-5);
  }

  .hero h1 {
    font-size: var(--fs-display);
    max-width: 18ch;
    margin: 0;
  }

  .lede {
    max-width: 60ch;
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .section-title {
    font-size: var(--fs-h2);
    max-width: 20ch;
    margin: var(--s-3) 0 var(--s-6);
  }

  .well {
    max-width: 72ch;
  }
</style>
