---
/**
 * Home — the discipline, defined. Hero, the three questions, the five-layer
 * stack, the eight values, the role, a verdict beat, the Body of Knowledge, the
 * resources and a closing CTA. All copy and every figure come from the typed
 * content modules; no number appears here that a primary source does not carry.
 *
 * The body sections are built on <Section>, which supplies the tinted/mesh/dark
 * bands, the textures and the shared heads. The hero keeps its own scoped layout
 * (the governance-loop art and the panel) — see the <style>.
 */
import Marketing from '../layouts/Marketing.astro';
import Section from '../components/Section.astro';
import RegisterList from '../components/RegisterList.astro';
import StatTile from '../components/StatTile.astro';
import VerdictStamp from '../components/VerdictStamp.astro';
import CtaBand from '../components/CtaBand.astro';
import StackDiagram from '../components/StackDiagram.astro';
import Diagram from '../components/Diagram.astro';
import VerdictTicker from '../components/VerdictTicker.astro';
import DefinitionCards from '../components/DefinitionCards.astro';
import ValuePair from '../components/ValuePair.astro';
import ChapterGrid from '../components/ChapterGrid.astro';
import ResourceTiles from '../components/ResourceTiles.astro';
import { site } from '../data/site';
import { WEBSITE_ID } from '../lib/jsonld';
import { definition, values } from '../data/values';
import { capabilityStatement, workflows, market } from '../data/role';
import { chaptersOrdered } from '../data/chapters';

// The home title already names the site, so Seo appends no ` · {site.name}`
// suffix (titleSuffix={false} on <Marketing> below).
const seoTitle = 'AI Governance Engineer — the discipline, defined';
const seoDesc =
  'AI governance engineering turns governance into policy-as-code, eval gates and machine-readable evidence you can run, not just read.';

// The WebSite node describes the site; this WebPage describes the landing page
// itself, so a consumer reading the graph can tell the two apart. Seo.astro
// merges it into the page's single ld+json block.
const homeUrl = new URL('/', site.url).href;
const jsonLd = {
  '@type': 'WebPage',
  '@id': `${homeUrl}#webpage`,
  name: seoTitle,
  description: seoDesc,
  url: homeUrl,
  inLanguage: 'en',
  isPartOf: { '@id': WEBSITE_ID },
};

// The three questions that define the discipline. Stated verbatim in
// role.capabilityStatement and as the stack layers' `question` fields; the
// bodies paraphrase the corresponding stack layers (inventory, govern-as-code,
// evals/assurance).
const questions = [
  {
    index: '01',
    title: 'What AI is running?',
    body: 'A runtime-aware registry of every model, service and agent — each with an owner, a scope and a status — written by the deployment pipeline, not typed into a spreadsheet.',
    swatch: 'var(--l2)',
  },
  {
    index: '02',
    title: 'What is it allowed to do?',
    body: 'Governance rules expressed as executable policy that evaluates in CI/CD and at runtime, so a bad release is blocked at the earliest point it can be — not discouraged in a review.',
    swatch: 'var(--l1)',
  },
  {
    index: '03',
    title: 'What evidence proves it?',
    body: 'Structured eval results and machine-readable evidence emitted as the build runs, so assurance is a live query rather than a point-in-time attestation assembled by hand.',
    swatch: 'var(--l3)',
  },
];

// Seven workflows as a register list: index (auto), name and the layer tick
// colour. 'all' (regulatory translation) carries the neutral ink tick.
const workflowItems = workflows.map((workflow) => ({
  title: workflow.name,
  swatch: workflow.layerN === 'all' ? 'var(--ink)' : `var(--l${workflow.layerN})`,
}));

// Only primary-sourced figures are tile-safe (the +150% demand signal is not).
const primaryStats = market.filter((stat) => stat.primary);

const resources = [
  {
    label: 'Frameworks',
    href: '/resources/frameworks',
    desc: 'The obligations — EU AI Act, ISO/IEC 42001, NIST AI RMF — mapped to the artefacts that satisfy them.',
  },
  {
    label: 'Tools',
    href: '/resources/tools',
    desc: 'Reference tool categories per layer, from policy engines to eval harnesses and evidence formats.',
  },
  {
    label: 'Reading list',
    href: '/resources/reading-list',
    desc: 'The sources that formed the discipline, each with a verified link and a one-line note.',
  },
  {
    label: 'Glossary',
    href: '/resources/glossary',
    desc: 'Every term defined once, cross-referenced to the chapter that treats it in full.',
  },
];
---

<Marketing
  title={seoTitle}
  description={seoDesc}
  image="/og/default.png"
  titleSuffix={false}
  jsonLd={jsonLd}
>
  <section class="hero section hero--loop">
    <div class="bg-mesh hero-mesh" aria-hidden="true"></div>
    <div class="hero-tex bg-grid bg-fade" aria-hidden="true"></div>

    <div class="container hero-grid">
      <div class="hero-copy hero-in">
        <h1 class="display hero-h1" style="--i:0">Governance you can run, not just read.</h1>
        <p class="lede" style="--i:1">{definition}</p>
        <div class="hero-cta" style="--i:2">
          <a class="btn btn-primary btn-glow" href="/thesis">Read the Thesis</a>
          <a class="btn btn-secondary" href="/bok">Open the Body of Knowledge</a>
        </div>
      </div>

      <div
        class="hero-art"
        data-hero-loop
        data-hero-sequence="obligation,policy,inventory,eval,runtime,evidence,auditor"
      >
        <div class="hero-panel card-lum">
          <div class="hero-panel-bar">
            <span class="meta"><span class="meta-dot" aria-hidden="true"></span>governance-loop · run #4821</span>
            <span class="meta hero-live"><span class="meta-dot" aria-hidden="true"></span>live</span>
          </div>
          <div class="hero-art-wide"><Diagram id="hero-loop" bare /></div>
          <div class="hero-art-tall"><Diagram id="hero-loop-tall" bare /></div>
        </div>
        <div class="hero-stamp">
          <VerdictStamp verdict="pass" class="hero-stamp-badge" />
          <span class="hero-attn mono">attestation #4821</span>
        </div>
      </div>
    </div>

    <script is:inline defer src="/hero.js"></script>
    <script is:inline defer src="/countup.js"></script>
  </section>

  <Section
    tone="plain"
    texture="dots"
    rule
    kicker="The three questions"
    kickerSwatch="var(--l2)"
    title="Three questions define the discipline."
    lede="Legacy AI governance leaves them unanswered because nothing is connected to production. The engineer answers all three from the running system."
  >
    <DefinitionCards items={questions} class="reveal-stagger" />
  </Section>

  <Section
    tone="tint"
    headSize="xl"
    kicker="The stack · five layers"
    kickerSwatch="var(--l3)"
    title="A build order, from policy to proof."
    lede="Five layers that answer the three questions. Evidence is produced at the bottom and flows up; three layers are established engineering practice, two are new to AI."
  >
    <div class="story" data-story>
      <div class="story-pin stack-pin">
        <p class="meta"><span class="meta-dot" aria-hidden="true"></span>Build order</p>
        <StackDiagram mode="static" data-story-mark class="stack-mark" />
      </div>
      <div class="stack-rows reveal-stagger">
        <StackDiagram mode="interactive" />
      </div>
    </div>
    <p class="sec-link" slot="foot"><a href="/stack">Explore the stack →</a></p>
  </Section>
  <script is:inline defer src="/story.js"></script>

  <Section
    tone="plain"
    kicker="Values"
    kickerSwatch="var(--l4)"
    title="Eight values, each a commitment made on purpose."
  >
    <div class="bento reveal-stagger">
      {
        values.map((value) => (
          <ValuePair
            value={value}
            variant="bento"
            class={value.n === 1 ? 'bento-2x bento-2y' : value.n === 6 ? 'bento-2x' : undefined}
          />
        ))
      }
    </div>
    <p class="sec-link" slot="foot"><a href="/thesis#principles">Read the principles →</a></p>
  </Section>

  <Section
    tone="mesh"
    class="role-sec"
    kicker="The role"
    kickerSwatch="var(--l5)"
    title="A capability first, a job title second."
  >
    <blockquote class="pullquote display">{capabilityStatement}</blockquote>
    <div class="role-flows">
      <p class="role-eyebrow meta"><span class="meta-dot" aria-hidden="true"></span>Seven workflows</p>
      <RegisterList items={workflowItems} />
    </div>
    <div class="stats-row">
      {
        primaryStats.map((stat) => (
          <StatTile
            value={stat.value}
            label={stat.label}
            source={stat.source}
            href={stat.sourceUrl}
            class="card-lum lift"
          />
        ))
      }
    </div>
    <p class="sec-link" slot="foot">
      <a href="/role">What the role does →</a>
      <span class="sec-link-sep" aria-hidden="true">·</span>
      <a href="/path">Start the learning path →</a>
      <span class="sec-link-sep" aria-hidden="true">·</span>
      <a href="/map">See the whole map →</a>
    </p>
  </Section>

  <Section tone="dark" class="verdict-beat">
    <div class="vb-inner">
      <p class="vb-line display">A policy is not a control. An eval that can fail the build is.</p>
      <div class="vb-stamps">
        <VerdictStamp verdict="block" />
        <VerdictStamp verdict="pass" />
      </div>
    </div>
    <div class="full-bleed vb-ticker">
      <VerdictTicker size="lg" />
    </div>
  </Section>

  <Section
    tone="plain"
    texture="grid"
    kicker={`Body of Knowledge · v${site.bokVersion} · ${site.license}`}
    kickerSwatch="var(--l1)"
    title="Eleven chapters, versioned and open."
  >
    <ChapterGrid chapters={chaptersOrdered} class="reveal-stagger" />
  </Section>

  <Section
    tone="tint"
    kicker="Resources"
    kickerSwatch="var(--l4)"
    title="Curated, cross-referenced, in the open."
  >
    <ResourceTiles tiles={resources} class="reveal-stagger" />
  </Section>

  <CtaBand
    title="Open, versioned, contributable."
    sub="The Thesis and Body of Knowledge are CC BY 4.0. Read them, use them, send a pull request."
    primary={{ label: 'Contribute on GitHub', href: site.github }}
    secondary={{ label: 'Follow on LinkedIn', href: site.linkedin }}
  />
</Marketing>

<style>
  /* Hero — the archify "governance loop". The copy sits left; the diagram is
     the art, wrapped in a luminous panel. One diagram renders per breakpoint
     (the other is display:none so the observer/hover never touch it): portrait
     on phones, landscape above. */
  .hero--loop {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    contain: paint;
  }

  /* Soft gradient mesh + a faint grid, faded toward the panel, replace the old
     dot backdrop. Both are inert decorative layers behind the content. */
  .hero-mesh {
    z-index: 0;
  }

  .hero-tex {
    z-index: 0;
    -webkit-mask-image: radial-gradient(62% 62% at 72% 45%, #000 40%, transparent 82%);
    mask-image: radial-gradient(62% 62% at 72% 45%, #000 40%, transparent 82%);
  }

  /* The hero runs on a wider well than the body sections so the diagram sits
     next to the copy instead of bleeding to the viewport edge. Its container
     sits above the backdrop. */
  .hero--loop > .container {
    position: relative;
    z-index: 1;
    max-width: min(1440px, 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-5);
  }

  .hero-h1 {
    font-size: var(--fs-display);
    max-width: 16ch;
    margin: 0;
  }

  .hero-copy .lede {
    max-width: 54ch;
    margin: 0;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  /* Weight contrast: the primary is the glowing fill (.btn-glow); the
     secondary steps down to a quiet outline — hairline --line border on a
     transparent ground, --ink-2 on hover — at the same .btn height. */
  .hero-cta .btn-secondary {
    border-color: var(--line);
    background: transparent;
  }

  .hero-cta .btn-secondary:hover {
    border-color: var(--ink-2);
  }

  /* position: relative makes .hero-art the containing block for the diagram's
     hover note (rule in diagrams.css under .hero--loop). */
  .hero-art {
    position: relative;
    width: 100%;
  }

  /* The luminous panel wraps both diagram variants. Its gradient border ring is
     kept always-on here (card-lum shows it on hover only), with a deep shadow
     and a soft glow. No overflow:hidden — the hover note overlays the foot. */
  .hero-panel {
    padding: var(--s-3);
    box-shadow: var(--shadow-3), 0 0 40px var(--glow-1);
  }

  .hero-panel::before {
    opacity: 1;
  }

  .hero-panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: 0 var(--s-1) var(--s-3);
    margin-bottom: var(--s-1);
    border-bottom: 1px solid var(--line);
  }

  /* The "live" pip reads green from the L5 ink. */
  .hero-live .meta-dot {
    background: var(--l5-ink);
  }

  /* Reserve the diagram's box so the inline SVG never shifts layout (CLS). */
  .hero-art-wide {
    display: none;
    aspect-ratio: 864 / 508;
  }

  .hero-art-tall {
    display: block;
    aspect-ratio: 436 / 612;
    max-width: 420px;
    margin-inline: auto;
  }

  /* The verdict flourish, pinned to the art's lower-right and cocked slightly.
     Server-rendered, so no-JS and reduced-motion users see it at rest. */
  .hero-stamp {
    position: absolute;
    right: var(--s-3);
    bottom: var(--s-3);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-1);
    transform: rotate(-6deg);
    transform-origin: bottom right;
    pointer-events: none;
  }

  .hero-attn {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }

  /* Tablet: single column, the landscape variant full width. */
  @media (min-width: 640px) {
    .hero-art-tall {
      display: none;
    }

    .hero-art-wide {
      display: block;
    }
  }

  /* Desktop: two columns, copy left, art right, both inside the wider hero
     well. The art fills its grid track (no viewport bleed). */
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 4.5fr) minmax(0, 7.5fr);
      gap: var(--s-8);
      align-items: center;
      min-height: min(72vh, 680px);
    }

    /* Scale the headline down so its longest line fits the copy column. */
    .hero-h1 {
      font-size: calc(var(--fs-display) * 0.76);
      max-width: 15ch;
      text-wrap: balance;
    }
  }

  /* Hero entrance: a short, staggered rise on load (not scroll-driven), motion
     only. Reduced-motion users get the resting state. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in > * {
      animation: hero-up 0.6s var(--ease) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }

    @keyframes hero-up {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    /* The pop when the loop closes on the auditor. */
    .hero-stamp.is-pop {
      animation: hero-stamp-pop 260ms var(--ease);
    }

    @keyframes hero-stamp-pop {
      from {
        transform: rotate(-6deg) scale(1.18);
      }
      to {
        transform: rotate(-6deg) scale(1);
      }
    }
  }

  /* Stack story: the static mark and its caption pin on the left; the
     interactive rows scroll on the right. Grid + sticky live in effects.css. */
  .stack-pin {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .stack-mark {
    width: 100%;
    max-width: 460px;
  }

  /* Values live in the bento grid (effects.css); the reveal cascades by index. */

  /* Role — a mesh band. The mesh reads at 60% of the section default so the
     pullquote leads (the mesh div belongs to Section, so target it globally). */
  :global(.role-sec > .bg-mesh) {
    opacity: calc(var(--mesh-alpha) * 0.6);
  }

  .pullquote {
    position: relative;
    margin: 0 0 var(--s-6);
    padding-left: var(--s-5);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
    color: var(--ink);
    max-width: 46ch;
    text-wrap: pretty;
  }

  /* Gradient rule down the quote, from the L5 ink to the L5 pastel. */
  .pullquote::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--l5-ink), var(--l5));
  }

  .role-eyebrow {
    margin: 0 0 var(--s-3);
  }

  .role-flows {
    max-width: 72ch;
    margin-bottom: var(--s-6);
  }

  .stats-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }

  @media (min-width: 720px) {
    .stats-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Verdict beat — a dark band (tone="dark" re-scopes the dark tokens). The
     sentence and stamps sit in the container; the ticker breaks full-bleed. */
  .vb-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5) var(--s-6);
    padding-bottom: var(--s-6);
  }

  .vb-line {
    margin: 0;
    font-size: var(--fs-h2);
    max-width: 24ch;
  }

  .vb-stamps {
    display: flex;
    gap: var(--s-3);
  }
</style>
