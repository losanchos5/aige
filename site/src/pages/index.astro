---
/**
 * Home — the discipline, defined. Hero, the three questions, the five-layer
 * stack, the eight values, the role, a verdict beat, the Body of Knowledge, the
 * resources and a closing CTA. All copy and every figure come from the typed
 * content modules; no number appears here that a primary source does not carry.
 *
 * The body sections are built on <Section>, which supplies the tinted/mesh/dark
 * bands and the shared heads. The hero keeps its own scoped layout (the
 * governance-loop art and the panel) — see the <style>.
 */
import Marketing from '../layouts/Marketing.astro';
import Section from '../components/Section.astro';
import RegisterList from '../components/RegisterList.astro';
import StatTile from '../components/StatTile.astro';
import VerdictStamp from '../components/VerdictStamp.astro';
import CtaBand from '../components/CtaBand.astro';
import StackDiagram from '../components/StackDiagram.astro';
import Diagram from '../components/Diagram.astro';
import VerdictTicker from '../components/VerdictTicker.astro';
import DefinitionCards from '../components/DefinitionCards.astro';
import ValuePair from '../components/ValuePair.astro';
import ChapterGrid from '../components/ChapterGrid.astro';
import ResourceTiles from '../components/ResourceTiles.astro';
import { site } from '../data/site';
import { WEBSITE_ID } from '../lib/jsonld';
import { definition, values } from '../data/values';
import { capabilityStatement, workflows, market } from '../data/role';
import { chaptersOrdered } from '../data/chapters';

// The home title already names the site, so Seo appends no ` · {site.name}`
// suffix (titleSuffix={false} on <Marketing> below).
const seoTitle = 'AI Governance Engineer — the discipline, defined';
const seoDesc =
  'AI governance engineering turns governance into policy-as-code, eval gates and machine-readable evidence you can run, not just read.';

// The WebSite node describes the site; this WebPage describes the landing page
// itself, so a consumer reading the graph can tell the two apart. Seo.astro
// merges it into the page's single ld+json block.
const homeUrl = new URL('/', site.url).href;
const jsonLd = {
  '@type': 'WebPage',
  '@id': `${homeUrl}#webpage`,
  name: seoTitle,
  description: seoDesc,
  url: homeUrl,
  inLanguage: 'en',
  isPartOf: { '@id': WEBSITE_ID },
};

// The three questions that define the discipline. Stated verbatim in
// role.capabilityStatement and as the stack layers' `question` fields; the
// bodies paraphrase the corresponding stack layers (inventory, govern-as-code,
// evals/assurance).
const questions = [
  {
    index: '01',
    title: 'What AI is running?',
    body: 'A runtime-aware registry of every model, service and agent — each with an owner, a scope and a status — written by the deployment pipeline, not typed into a spreadsheet.',
    swatch: 'var(--l2)',
  },
  {
    index: '02',
    title: 'What is it allowed to do?',
    body: 'Governance rules expressed as executable policy that evaluates in CI/CD and at runtime, so a bad release is blocked at the earliest point it can be — not discouraged in a review.',
    swatch: 'var(--l1)',
  },
  {
    index: '03',
    title: 'What evidence proves it?',
    body: 'Structured eval results and machine-readable evidence emitted as the build runs, so assurance is a live query rather than a point-in-time attestation assembled by hand.',
    swatch: 'var(--l3)',
  },
];

// Seven workflows as a register list: index (auto), name and the layer tick
// colour. 'all' (regulatory translation) carries the neutral ink tick.
const workflowItems = workflows.map((workflow) => ({
  title: workflow.name,
  swatch: workflow.layerN === 'all' ? 'var(--ink)' : `var(--l${workflow.layerN})`,
}));

// Only primary-sourced figures are tile-safe (the +150% demand signal is not).
const primaryStats = market.filter((stat) => stat.primary);

const resources = [
  {
    label: 'Frameworks',
    href: '/resources/frameworks',
    desc: 'The obligations — EU AI Act, ISO/IEC 42001, NIST AI RMF — mapped to the artefacts that satisfy them.',
  },
  {
    label: 'Tools',
    href: '/resources/tools',
    desc: 'Reference tool categories per layer, from policy engines to eval harnesses and evidence formats.',
  },
  {
    label: 'Reading list',
    href: '/resources/reading-list',
    desc: 'The sources that formed the discipline, each with a verified link and a one-line note.',
  },
  {
    label: 'Glossary',
    href: '/resources/glossary',
    desc: 'Every term defined once, cross-referenced to the chapter that treats it in full.',
  },
];
---

<Marketing
  title={seoTitle}
  description={seoDesc}
  image="/og/default.png"
  titleSuffix={false}
  jsonLd={jsonLd}
>
  <section class="hero section hero--loop">
    <div class="bg-mesh hero-mesh" aria-hidden="true"></div>

    <div class="container hero-grid">
      <div class="hero-copy hero-in">
        <h1 class="display display-xl hero-h1" style="--i:0">Governance you can run, not just read.</h1>
        <p class="lede" style="--i:1">{definition}</p>
        <div class="hero-cta" style="--i:2">
          <a class="btn btn-primary btn-glow" href="/thesis">Read the Thesis</a>
          <a class="btn btn-secondary" href="/bok">Open the Body of Knowledge</a>
        </div>
      </div>

      <figure
        class="hero-art"
        data-hero-loop
        data-hero-sequence="obligation,policy,inventory,eval,runtime,evidence,auditor"
      >
        <div class="hero-panel card-lum">
          <div class="hero-art-wide"><Diagram id="hero-loop" bare /></div>
          <div class="hero-art-tall"><Diagram id="hero-loop-tall" bare /></div>
        </div>
        <figcaption class="hero-caption">
          Seven steps, from obligation to auditor.
          <a href="/bok/the-stack#how-to-read-the-stack">Read how the governance loop works</a>
        </figcaption>
      </figure>
    </div>

    <script is:inline defer src="/hero.js"></script>
    <script is:inline defer src="/countup.js"></script>
  </section>

  <Section
    tone="plain"
    title="Three questions define the discipline."
    lede="Legacy AI governance leaves them unanswered because nothing is connected to production. The engineer answers all three from the running system."
  >
    <DefinitionCards items={questions} class="reveal-stagger" />
  </Section>

  <Section
    tone="tint"
    headSize="xl"
    title="A build order, from policy to proof."
    lede="The stack is five layers that answer the three questions. Evidence is produced at the bottom and flows up; three layers are established engineering practice, two are new to AI."
  >
    <div class="story" data-story>
      <div class="story-pin stack-pin">
        <p class="mono-label">Build order</p>
        <StackDiagram mode="static" data-story-mark class="stack-mark" />
      </div>
      <div class="stack-rows reveal-stagger">
        <StackDiagram mode="interactive" />
      </div>
    </div>
    <p class="sec-link" slot="foot"><a href="/stack">Explore the stack →</a></p>
  </Section>
  <script is:inline defer src="/story.js"></script>

  <Section tone="plain" title="Eight values, each a commitment made on purpose.">
    <div class="bento reveal-stagger">
      {
        values.map((value) => (
          <ValuePair
            value={value}
            variant="bento"
            class={value.n === 1 ? 'bento-2x bento-2y' : value.n === 6 ? 'bento-2x' : undefined}
          />
        ))
      }
    </div>
    <p class="sec-link" slot="foot"><a href="/thesis#principles">Read the principles →</a></p>
  </Section>

  <Section
    tone="mesh"
    class="role-sec"
    title="The role is a capability first, a job title second."
  >
    <blockquote class="pullquote display">{capabilityStatement}</blockquote>
    <div class="role-flows">
      <p class="mono-label flows-label">Seven workflows</p>
      <RegisterList items={workflowItems} />
    </div>
    <div class="stats-row">
      {
        primaryStats.map((stat) => (
          <StatTile
            value={stat.value}
            label={stat.label}
            source={stat.source}
            href={stat.sourceUrl}
          />
        ))
      }
    </div>
    <p class="sec-link" slot="foot">
      <a href="/role">What the role does →</a>
      <span class="sec-link-sep" aria-hidden="true">·</span>
      <a href="/path">Start the learning path →</a>
      <span class="sec-link-sep" aria-hidden="true">·</span>
      <a href="/map">See the whole map →</a>
    </p>
  </Section>

  <Section tone="dark" class="verdict-beat">
    <div class="vb-inner">
      <p class="vb-line display">
        Every control on this site can fail a build, block a release, or sign an attestation.
      </p>
      <div class="vb-stamps">
        <VerdictStamp verdict="block" />
        <VerdictStamp verdict="pass" />
      </div>
    </div>
    <div class="full-bleed vb-ticker">
      <VerdictTicker size="lg" />
    </div>
  </Section>

  <Section
    tone="plain"
    title="Eleven chapters, versioned and open."
    lede={`The Body of Knowledge is at v${site.bokVersion} and published under ${site.license}.`}
  >
    <ChapterGrid chapters={chaptersOrdered} class="reveal-stagger" />
  </Section>

  <Section tone="tint" title="Curated resources, cross-referenced, in the open.">
    <ResourceTiles tiles={resources} class="reveal-stagger" />
  </Section>

  <CtaBand
    title="Open, versioned, contributable."
    sub="The Thesis and Body of Knowledge are CC BY 4.0. Read them, use them, send a pull request."
    primary={{ label: 'Contribute on GitHub', href: site.github }}
    secondary={{ label: 'Follow on LinkedIn', href: site.linkedin }}
  />
</Marketing>

<style>
  /* Hero — the archify "governance loop". The copy sits left; the diagram is
     an editorial figure, wrapped in a luminous panel and captioned with a link
     to the chapter that explains it. One diagram renders per breakpoint (the
     other is display:none so the observer/hover never touch it): portrait
     below 720px, landscape above. The hero sits on the site grid (the default
     --container). Below 1280 its height follows its content; from 1280 it
     claims most of the first viewport (see the two-column block). Block
     padding comes from the spacing scale. */
  .hero--loop {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    contain: paint;
    padding-block: var(--s-7);
  }

  /* Soft gradient mesh on the page ground: an inert decorative layer behind
     the content (no grid or dot texture). */
  .hero-mesh {
    z-index: 0;
  }

  /* The container sits above the backdrop. */
  .hero--loop > .container {
    position: relative;
    z-index: 1;
  }

  /* One column until 1280: the copy, then the figure under it at a width
     where its labels stay legible. --fs-display-xl, the hero's display size
     (69px at 320, 72 at 390, 89 at 834, 105 at 1280, 111 at 1440, 112 cap), is
     shared by the headline and the figure's cap-line offset in the two-column
     layout. */
  .hero-grid {
    --fs-display-xl: clamp(4rem, 3.6rem + 3.7vw, 7rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-5);
  }

  /* .display-xl, a modifier on .display: the display voice at hero scale.
     Tall, narrow and light: Bricolage's condensed width (wdth 80) at weight
     350, with the display optical size (auto: opsz follows the font size, so
     it reaches the 96 master here) in place of the text master the rest of the
     site pins in fonts.css. A tight leading, and near-neutral tracking: the
     condensed cut needs far less than the old 700 weight did. */
  .display-xl {
    font-size: var(--fs-display-xl);
    font-weight: 350;
    font-stretch: 80%;
    font-optical-sizing: auto;
    font-variation-settings: normal;
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* The headline breaks the same way at every width, one phrase per line
     ("Governance / you can run, / not just read."): its longest line is about
     3.6em, and a 4.2em measure is too short for any line to take the next
     word. */
  .hero-h1 {
    max-width: 4.2em;
    margin: 0;
  }

  /* The lede keeps the body leading it inherits; the measure is capped and
     its lines are balanced (no one-word last line, no line opening on a
     dash). */
  .hero-copy .lede {
    max-width: 52ch;
    margin: 0;
    text-wrap: balance;
  }

  /* Both CTAs on one baseline; they stack full-width on narrow phones. */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  /* A --s-4 side padding (the .btn default is --s-5) keeps the pair on one
     line in the 5/12 copy column at 1280+ and from 480 up. */
  .hero-cta .btn {
    padding-inline: var(--s-4);
  }

  /* Weight contrast: the primary is the gradient fill (.btn-glow); the
     secondary steps down to an outline at the same .btn height. Over the mesh
     it needs a visible edge: an ink-derived border (>= 3:1 against the ground
     and the layer tones in both themes) on a translucent --bg plate that keeps
     the mesh from running through the label. --ink-2 border and a solid
     plate on hover. */
  .hero-cta .btn-secondary {
    border-color: color-mix(in srgb, var(--ink) 60%, var(--bg));
    background: color-mix(in srgb, var(--bg) 72%, transparent);
  }

  .hero-cta .btn-secondary:hover {
    border-color: var(--ink-2);
    background: var(--bg);
  }

  /* The figure never grows past the diagram's natural size (1 user unit =
     1px): --art-w is the cropped viewBox width of the visible variant, plus the
     panel's padding and 1px border on each side. */
  .hero-art {
    --art-w: 390px;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    width: 100%;
    max-width: calc(var(--art-w) + 2 * var(--s-3) + 2px);
    margin: 0;
  }

  /* The luminous panel wraps both diagram variants. Its gradient border ring is
     kept always-on here (card-lum shows it on hover only), with a deep shadow
     and no coloured halo. No overflow:hidden — the hover note overlays the
     foot. */
  .hero-panel {
    padding: var(--s-3);
    box-shadow: var(--shadow-3);
  }

  .hero-panel::before {
    opacity: 1;
  }

  /* Crop the empty margin archify leaves around the lanes (the viewBox runs
     74 units past them at the foot, 46 above them and 35 to the right on the
     landscape variant). The SVG is drawn wider than its box and pulled up and
     left by the cropped amounts (percent margins resolve against the box
     width), and .diagram-canvas clips the rest. The wrapper's aspect ratio is
     the cropped box, so the inline SVG still never shifts layout (CLS).
       landscape: viewBox 864 x 508 -> x 15..830, y 45..435 (815 x 390)
       portrait:  viewBox 436 x 612 -> x 15..405, y 45..539 (390 x 494) */
  .hero-art-wide {
    display: none;
    aspect-ratio: 815 / 390;
  }

  .hero-art-wide :global(svg) {
    width: calc(864 / 815 * 100%);
    max-width: none;
    margin: calc(-45 / 815 * 100%) 0 calc(-73 / 815 * 100%) calc(-15 / 815 * 100%);
  }

  .hero-art-tall {
    display: block;
    aspect-ratio: 390 / 494;
  }

  .hero-art-tall :global(svg) {
    width: calc(436 / 390 * 100%);
    max-width: none;
    margin: calc(-45 / 390 * 100%) 0 calc(-73 / 390 * 100%) calc(-15 / 390 * 100%);
  }

  /* The figure's caption: plain small text in --ink-2, and a link to the
     chapter that documents the loop (the global link colour and focus ring).
     A wrapping flex row: sentence and link share a line wherever both fit
     (834 and up); on phones the link drops whole onto its own line. */
  .hero-caption {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.3em;
    margin: 0;
    font-size: var(--fs-small);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* Narrow phones: the CTAs stack full-width. */
  @media (max-width: 479px) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
      align-self: stretch;
    }
  }

  /* From 720 the landscape variant fits at a legible scale (labels >= 12px). */
  @media (min-width: 720px) {
    .hero-grid {
      gap: var(--s-7);
    }

    .hero-art {
      --art-w: 815px;
    }

    .hero-art-tall {
      display: none;
    }

    .hero-art-wide {
      display: block;
    }
  }

  /* Wide desktop: two columns on the site grid, copy 5/12 and figure 7/12, the
     page's two-column gap between them. The hero claims most of the first
     viewport: a min(75vh, 720px) floor and --s-8 block padding, so the
     headline starts one --s-8 under the header. Top-aligned, not centred: the
     copy column is the taller one, and the figure panel starts on the
     headline's cap line (0.16em below the line box at a 0.98 leading, from
     Bricolage's metrics: ascent 0.93, descent 0.27, cap height 0.66). */
  @media (min-width: 1280px) {
    .hero--loop {
      min-height: min(75vh, 720px);
      padding-block: var(--s-8) var(--s-7);
    }

    .hero-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .hero-art {
      margin-top: calc(var(--fs-display-xl) * 0.16);
    }
  }

  /* Hero entrance: a short, staggered rise on load (not scroll-driven). A lift
     only, transform and no opacity: the copy sits in the first viewport, where
     axe and Lighthouse blend a fractional opacity into the contrast ratio.
     Reduced-motion users get the resting state. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in > * {
      animation: hero-up 0.6s var(--ease) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }

    @keyframes hero-up {
      from {
        transform: translateY(12px);
      }
      to {
        transform: none;
      }
    }
  }

  /* The two in-section captions ("Build order", "Seven workflows"): plain mono
     at the small size, sentence case, no dot. --ink-2 holds AA on the tint and
     over the role section's mesh. */
  .mono-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--ink-2);
  }

  /* Stack story: the static mark and its caption pin on the left; the
     interactive rows scroll on the right. Grid + sticky live in effects.css. */
  .stack-pin {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .stack-mark {
    width: 100%;
    max-width: 460px;
  }

  /* Values live in the bento grid (effects.css); the reveal cascades by index. */

  /* Role — a mesh band. The mesh reads at 60% of the section default so the
     pullquote leads (the mesh div belongs to Section, so target it globally). */
  :global(.role-sec > .bg-mesh) {
    opacity: calc(var(--mesh-alpha) * 0.6);
  }

  /* The capability statement, set as a display-weight quote on the content
     edge. No side stripe: the type carries the emphasis. */
  .pullquote {
    margin: 0 0 var(--s-6);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
    color: var(--ink);
    max-width: 46ch;
    text-wrap: pretty;
  }

  .flows-label {
    margin-bottom: var(--s-3);
  }

  .role-flows {
    max-width: 72ch;
    margin-bottom: var(--s-6);
  }

  .stats-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }

  @media (min-width: 720px) {
    .stats-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Verdict beat — a dark band (tone="dark" re-scopes the dark tokens). The
     sentence and stamps sit in the container; the ticker breaks full-bleed.
     In the dark theme the default --band-bg (#0b0d10) all but vanishes on the
     #121417 page, so the band takes the L1 layer's deep tone instead (the same
     ground as the dark CtaBand); every text token on it stays >= 4.5:1. The
     class sits on Section's root, hence :global. */
  :global(:root[data-theme='dark'] .verdict-beat) {
    background: var(--l1);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light']) .verdict-beat) {
      background: var(--l1);
    }
  }
  .vb-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5) var(--s-6);
    padding-bottom: var(--s-6);
  }

  .vb-line {
    margin: 0;
    font-size: var(--fs-h2);
    max-width: 24ch;
  }

  .vb-stamps {
    display: flex;
    gap: var(--s-3);
  }
</style>
