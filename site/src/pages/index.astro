---
/**
 * Home: the discipline, defined. A full-viewport hero (the headline on a
 * moving gradient field, one CTA, a strip of figures), the definition with the
 * governance loop, the three questions, the five-layer stack, the eight values,
 * the role, a verdict beat, the Body of Knowledge by part, the resources, the
 * newsletter and a closing CTA. All copy and every figure come from the typed
 * content modules; no number appears here that a primary source does not carry,
 * and every count is computed from the data.
 *
 * The body sections are built on <Section>, which supplies the tinted/mesh/dark
 * bands and the shared heads; no body section sits on the bare page ground
 * (each mesh takes its own composition and strength, so neighbours differ).
 * The hero keeps its own scoped layout (the field, the centred headline and the
 * figures strip; see the <style>) and the loop is <GovernanceLoop>.
 */
import Marketing from '../layouts/Marketing.astro';
import Section from '../components/Section.astro';
import RegisterList from '../components/RegisterList.astro';
import StatTile from '../components/StatTile.astro';
import VerdictStamp from '../components/VerdictStamp.astro';
import CtaBand from '../components/CtaBand.astro';
import StackDiagram from '../components/StackDiagram.astro';
import GovernanceLoop from '../components/GovernanceLoop.astro';
import VerdictTicker from '../components/VerdictTicker.astro';
import DefinitionCards from '../components/DefinitionCards.astro';
import ValuePair from '../components/ValuePair.astro';
import BookParts from '../components/BookParts.astro';
import ResourceTiles from '../components/ResourceTiles.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import WhatAppliesNow from '../components/WhatAppliesNow.astro';
import { site } from '../data/site';
import { WEBSITE_ID } from '../lib/jsonld';
import { definition, values } from '../data/values';
import { capabilityStatement, workflows, market } from '../data/role';
import { chaptersOrdered } from '../data/chapters';
import { bookParts, countWord } from '../data/parts';
import { layers } from '../data/stack';
import { frameworks } from '../data/frameworks';
import { patterns } from '../data/patterns';

// The home title already names the site, so Seo appends no ` · {site.name}`
// suffix (titleSuffix={false} on <Marketing> below); it uses the same ` · `
// separator as every other page title, not a dash.
const seoTitle = 'AI Governance Engineer · The discipline, defined';
const seoDesc =
  'AI governance engineering turns governance into policy-as-code, eval gates and machine-readable evidence you can run, not just read.';

// The WebSite node describes the site; this WebPage describes the landing page
// itself, so a consumer reading the graph can tell the two apart. Seo.astro
// merges it into the page's single ld+json block.
const homeUrl = new URL('/', site.url).href;
const jsonLd = {
  '@type': 'WebPage',
  '@id': `${homeUrl}#webpage`,
  name: seoTitle,
  description: seoDesc,
  url: homeUrl,
  inLanguage: 'en',
  isPartOf: { '@id': WEBSITE_ID },
};

// The three questions that define the discipline. Stated verbatim in
// role.capabilityStatement and as the stack layers' `question` fields; the
// bodies paraphrase the layers that answer each one, the single model of
// chapters 01 and 04 and the three-questions figure: 02 answers the first,
// 01 and 04 the second, 03 and 05 the third. The swatch is the lead layer.
const questions = [
  {
    index: '01',
    title: 'What AI is running?',
    body: 'A runtime-aware registry of every model, service and agent (each with an owner, a scope and a status), written by the deployment pipeline, not typed into a spreadsheet.',
    swatch: 'var(--l2)',
  },
  {
    index: '02',
    title: 'What is it allowed to do?',
    body: "Governance rules written as executable policy and enforced at runtime, under each agent's own identity and scope, so a bad release or an out-of-scope call is blocked at the earliest point it can be, not discouraged in a review.",
    swatch: 'var(--l1)',
  },
  {
    index: '03',
    title: 'What evidence proves it?',
    body: 'Structured eval results and machine-readable evidence emitted as the build runs, so assurance is a live query rather than a point-in-time attestation assembled by hand.',
    swatch: 'var(--l3)',
  },
];

// Seven workflows as a register list: index (auto), name and the layer tick
// colour. 'all' (regulatory translation) carries the neutral ink tick.
const workflowItems = workflows.map((workflow) => ({
  title: workflow.name,
  swatch: workflow.layerN === 'all' ? 'var(--ink)' : `var(--l${workflow.layerN})`,
}));

// Only primary-sourced figures are tile-safe (the +150% demand signal is not).
const primaryStats = market.filter((stat) => stat.primary);

// The hero's figures strip: label | value pairs, every value counted from (or
// read off) the content modules, so the strip can never drift from the site.
const facts = [
  { label: 'Stack layers', value: String(layers.length) },
  { label: 'Workflows', value: String(workflows.length) },
  { label: 'Chapters', value: String(chaptersOrdered.length) },
  { label: 'Values', value: String(values.length) },
  { label: 'Frameworks mapped', value: String(frameworks.length) },
  { label: 'Patterns', value: String(patterns.length) },
  { label: 'Body of Knowledge', value: `v${site.bokVersion}` },
  { label: 'License', value: site.license },
];

// The Newsreader display cuts set the hero headline only; the home preloads
// them (public/_headers carries the same pair for "/").
const heroFonts = [
  '/fonts/newsreader-latin-display-normal.woff2',
  '/fonts/newsreader-latin-display-italic.woff2',
];

// Local test of a painting background instead of the gradient field.
const HERO_ART = true;

// The chapters section: its title counts chapters and parts from the data, and
// its lede names the three parts that carry the discipline from what an AI
// system is to the law (their titles from chapterParts, never retyped here).
const partTitle = (id: string) => bookParts.find((part) => part.id === id)?.title ?? id;
const chaptersTitle = `${chaptersOrdered.length} chapters in ${countWord(bookParts.length)} parts, versioned and open.`;
const chaptersLede = `The Body of Knowledge is at v${site.bokVersion} and published under ${site.license}. ${partTitle('foundations')}, ${partTitle('lifecycle')}, and ${partTitle('law')} carry the discipline from what an AI system is, through its life, to the law that binds it.`;

// Eight tiles, two full rows of the four-column bento: the references a reader
// reaches for first. The hub (/resources) lists every one.
const resources = [
  {
    label: 'Frameworks',
    href: '/resources/frameworks',
    desc: 'The obligations (EU AI Act, ISO/IEC 42001, NIST AI RMF) mapped to the artefacts that satisfy them.',
  },
  {
    label: 'Topic crosswalk',
    href: '/resources/crosswalk',
    desc: 'One governance topic per row, read across the instruments that bind it, down to the article or clause.',
  },
  {
    label: 'The map',
    href: '/map',
    desc: 'The whole discipline on one canvas: chapters, layers, patterns and obligations as a navigable map.',
  },
  {
    label: 'Templates & schemas',
    href: '/resources/templates',
    desc: 'JSON Schemas, filled examples and templates for governance records, tagged by obligation.',
  },
  {
    label: 'Harms atlas',
    href: '/resources/harms',
    desc: 'AI harms by level, each with its failure mode, the control that catches it and real incidents.',
  },
  {
    label: 'Obligation register',
    href: '/obligations',
    desc: 'Every obligation with a stable id, its duty holder, date, status, artefact and stack layer.',
  },
  {
    label: 'Reading list',
    href: '/resources/reading-list',
    desc: 'The sources that formed the discipline, each with a verified link and a one-line note.',
  },
  {
    label: 'Glossary',
    href: '/bok/glossary',
    desc: 'Every term defined once, each with its own page, cross-referenced to its chapter.',
  },
];
---

<Marketing
  title={seoTitle}
  description={seoDesc}
  image="/og/default.png"
  titleSuffix={false}
  jsonLd={jsonLd}
  overlayHeader
  preloadFonts={heroFonts}
>
  <section
    class:list={['hero', 'hero--field', { 'hero--art': HERO_ART }]}
    data-hero-field={HERO_ART ? undefined : ''}
  >
    {
      HERO_ART ? (
        <div class="hero-art" aria-hidden="true">
          <!-- Claude Monet, The Seine at Giverny, 1897. National Gallery of Art, Washington, open access (public domain). -->
          <img
            class="hero-art-img"
            src="/hero/monet-seine-giverny-1897-2400.webp"
            srcset="/hero/monet-seine-giverny-1897-1200.webp 1200w, /hero/monet-seine-giverny-1897-2400.webp 2400w"
            sizes="100vw"
            alt=""
            decoding="async"
            fetchpriority="high"
          />
          <div class="hero-art-wash"></div>
        </div>
      ) : (
        <div class="hero-field" aria-hidden="true">
          <canvas class="hero-canvas"></canvas>
        </div>
      )
    }

    <div class="container hero-center hero-in">
      <h1 class="hero-title" style="--i:0">
        <span class="hero-line">Governance you can <em>run</em>,</span>
        <span class="hero-line">not just read.</span>
      </h1>
      <a class="btn btn-primary btn-glow" style="--i:1" href="/thesis">Read the Thesis</a>
    </div>

    <div class="hero-facts">
      <div class="facts-window">
        <div class="facts-track">
          <ul class="facts" aria-label="The discipline in figures">
            {
              facts.map((fact) => (
                <li class="fact">
                  <span class="fact-label">{fact.label}</span>
                  <span class="fact-value">{fact.value}</span>
                </li>
              ))
            }
          </ul>
          <ul class="facts facts-copy" aria-hidden="true" inert>
            {
              facts.map((fact) => (
                <li class="fact">
                  <span class="fact-label">{fact.label}</span>
                  <span class="fact-value">{fact.value}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false" hidden>
        Pause motion
      </button>
    </div>

    {!HERO_ART && <script is:inline defer src="/hero-field.js"></script>}
  </section>

  <Section
    tone="mesh"
    mesh="b"
    meshK={0.5}
    class="loop-sec"
    title="The discipline, defined."
    lede={definition}
  >
    <GovernanceLoop>
      Seven steps, from obligation to auditor.
      <a href="/bok/the-stack#how-to-read-the-stack">Read how the governance loop works</a>
    </GovernanceLoop>
    <p class="sec-link" slot="foot"><a href="/bok">Open the Body of Knowledge →</a></p>
    <script is:inline defer src="/countup.js"></script>
  </Section>

  <Section
    tone="mesh"
    mesh="c"
    meshK={0.5}
    title="Three questions define the discipline."
    lede="Legacy AI governance leaves them unanswered because nothing is connected to production. The engineer answers all three from the running system."
  >
    <DefinitionCards items={questions} class="reveal-stagger" />
  </Section>

  <Section
    tone="tint"
    mesh="a"
    meshK={0.35}
    headSize="xl"
    title="A build order, from policy to proof."
    lede="The stack is five layers that answer the three questions. Evidence is produced at the bottom and flows up; three layers are established engineering practice, two are new to AI."
  >
    <div class="story" data-story>
      <div class="story-pin stack-pin">
        <p class="mono-label">Build order</p>
        <StackDiagram mode="static" data-story-mark class="stack-mark" />
      </div>
      <div class="stack-rows reveal-stagger">
        <StackDiagram mode="interactive" />
      </div>
    </div>
    <p class="sec-link" slot="foot"><a href="/stack">Explore the stack →</a></p>
  </Section>
  <script is:inline defer src="/story.js"></script>

  <Section
    tone="mesh"
    mesh="b"
    meshK={0.45}
    title="Eight values, each a commitment made on purpose."
  >
    <div class="bento reveal-stagger">
      {
        values.map((value) => (
          <ValuePair
            value={value}
            variant="bento"
            class={value.n === 1 ? 'bento-2x bento-2y' : value.n === 6 ? 'bento-2x' : undefined}
          />
        ))
      }
    </div>
    <p class="sec-link" slot="foot"><a href="/thesis#principles">Read the principles →</a></p>
  </Section>

  <Section
    tone="mesh"
    meshK={0.6}
    class="role-sec"
    title="The role is a capability first, a job title second."
  >
    <blockquote class="pullquote display">{capabilityStatement}</blockquote>
    <div class="role-flows">
      <p class="mono-label flows-label">Seven workflows</p>
      <RegisterList items={workflowItems} />
    </div>
    <div class="stats-row">
      {
        primaryStats.map((stat) => (
          <StatTile
            value={stat.value}
            label={stat.label}
            source={stat.source}
            href={stat.sourceUrl}
          />
        ))
      }
    </div>
    <p class="sec-link" slot="foot">
      <a href="/role">What the role does →</a>
      <span class="sec-link-sep" aria-hidden="true">·</span>
      <a href="/path">Start the learning path →</a>
      <span class="sec-link-sep" aria-hidden="true">·</span>
      <a href="/map">See the whole map →</a>
    </p>
  </Section>

  <Section tone="dark" class="verdict-beat">
    <div class="vb-inner">
      <p class="vb-line display">
        Every control on this site can fail a build, block a release, or sign an attestation.
      </p>
      <div class="vb-stamps">
        <VerdictStamp verdict="block" />
        <VerdictStamp verdict="pass" />
      </div>
    </div>
    <div class="full-bleed vb-ticker">
      <VerdictTicker size="lg" />
    </div>
  </Section>

  <Section
    tone="mesh"
    mesh="c"
    meshK={0.45}
    class="parts-sec"
    title={chaptersTitle}
    lede={chaptersLede}
  >
    <BookParts class="reveal-stagger" />
    <p class="sec-link" slot="foot"><a href="/bok">Browse the chapters by part →</a></p>
  </Section>

  <Section
    tone="tint"
    mesh="b"
    meshK={0.35}
    title="Curated resources, cross-referenced, in the open."
  >
    <ResourceTiles tiles={resources} class="reveal-stagger" />
    <p class="sec-link" slot="foot"><a href="/resources">All resources →</a></p>
  </Section>

  <WhatAppliesNow />

  <Section
    tone="mesh"
    mesh="c"
    meshK={0.35}
    class="nl-sec"
    title="Follow the changes."
    lede="Every chapter shows the date it last changed, and every release is written up in the changelog. Get an email when a chapter changes, or follow the feed."
  >
    <NewsletterForm location="home" />
    <p class="sec-link" slot="foot">
      <a href="/rss.xml">RSS feed →</a>
      <span class="sec-link-sep" aria-hidden="true">·</span>
      <a href="/about/changelog">Changelog →</a>
    </p>
  </Section>

  <CtaBand
    title="Open, versioned, contributable."
    sub="The Thesis and Body of Knowledge are CC BY 4.0. Read them, use them, send a pull request."
    primary={{ label: 'Contribute on GitHub', href: site.github }}
    secondary={{ label: 'Follow on LinkedIn', href: site.linkedin }}
  />
</Marketing>

<style>
  /* Hero: the whole first viewport. A moving gradient field (hero-field.js
     paints it on the canvas; the div's own background is the static fallback
     for no JS, no WebGL and the first paint), the headline centred on it in
     the serif display cut, one CTA, and a strip of figures along the foot.
     The header floats over it (Base overlayHeader), so the hero starts at the
     top of the viewport and its top padding clears the bar. */
  .hero--field {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    contain: paint;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 100vh;
    min-height: 100svh;
  }

  /* The field: an inert layer under everything. The fallback follows the
     shader's layout with the same three tokens (the peach low on the left,
     the blue on the right, the navy inside the blue), kept low and off the
     bar so the text holds AA without the shader's legibility veil. */
  .hero-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(34% 44% at 94% 84%, var(--field-1), transparent 72%),
      radial-gradient(44% 54% at 80% 62%, var(--field-2), transparent 72%),
      radial-gradient(48% 56% at 8% 74%, var(--field-3), transparent 72%),
      var(--bg);
  }

  /* The canvas is drawn at a fraction of the CSS size and scaled up (the field
     has no edges to blur). It stays hidden until its first frame is painted,
     a visibility switch rather than an opacity ramp. */
  .hero-canvas {
    display: block;
    width: 100%;
    height: 100%;
    visibility: hidden;
  }

  .hero-field[data-ready] .hero-canvas {
    visibility: visible;
  }

  /* Forced colours: no canvas (hero-field.js does not start there either). */
  @media (forced-colors: active) {
    .hero-canvas {
      display: none;
    }
  }

  /* Painting test (HERO_ART): the painting fills the hero under a veil of the
     page ground (--bg, so it turns into a dark veil in the dark theme). The
     custom properties let the variants be switched at runtime. */
  .hero--art {
    --hero-art-x: 68%; /* horizontal focal point: >50% shows more of the right side of the painting */
    --hero-art-y: 50%;
    --hero-wash: 0.72; /* cream veil opacity */
    --hero-art-scale: 1; /* optional gentle zoom; 1.04 crops edges softly */
  }

  .hero-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: var(--bg);
  }

  .hero-art-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-art-x) var(--hero-art-y);
    transform: scale(var(--hero-art-scale));
    transform-origin: var(--hero-art-x) var(--hero-art-y);
  }

  .hero-art-wash {
    position: absolute;
    inset: 0;
    background: var(--bg);
    opacity: var(--hero-wash);
  }

  /* Forced colours: no painting, the plain system ground. */
  @media (forced-colors: active) {
    .hero-art {
      display: none;
    }
  }

  /* Headline and CTA, centred in the space above the strip. The top padding
     clears the floating header (about 65px, in rem so it grows with text
     zoom as the bar does) and the bottom one keeps the CTA off the strip. */
  .hero-center {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-6);
    padding-block: calc(4.5rem + var(--s-6)) var(--s-7);
    text-align: center;
  }

  /* The headline: Newsreader at its display optical size (a static cut, so no
     axes to set). One phrase per line from the tablet up ("Governance you can
     run, / not just read."): each phrase is its own block, balanced on its own
     when a phone narrows it. The size follows the viewport and is also capped
     at 15vw, so text zoomed to 200% still fits the width (WCAG 1.4.4/1.4.10). */
  .hero-title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: min(clamp(3rem, 1rem + 4.6vw, 6.5rem), 15vw);
    font-variation-settings: normal;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--hero-ink);
  }

  .hero-line {
    display: block;
    text-wrap: balance;
  }

  .hero-title em {
    font-style: italic;
  }

  /* The figures strip: label | value pairs on translucent plates, in a row
     that scrolls sideways while motion is on (hero-field.js adds .is-live;
     reduced motion and no JS keep it a static, centred, wrapping list), and
     the keyboard pause control that stops both the strip and the field (WCAG
     2.2.2). */
  .hero-facts {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: 0 var(--s-4) var(--s-5);
  }

  .facts-window {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts-copy {
    display: none;
  }

  /* Static, a pill may wrap inside the strip (text zoomed to 200% on a phone
     makes "Body of Knowledge v0.5.0" wider than the window); live, each stays
     on one line in the moving row. */
  .fact {
    display: inline-flex;
    flex-wrap: wrap;
    max-width: 100%;
    border: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  .fact-label,
  .fact-value {
    padding: var(--s-2) var(--s-3);
  }

  .fact-label {
    color: var(--ink-2);
  }

  .fact-value {
    border-left: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--ink);
  }

  /* The pause control has no visible chrome in the strip: like the skip
     link it stays off screen until keyboard focus reaches it, then shows as a
     small plate at the strip's right end. Mouse users pause the strip by
     hovering it; reduced motion keeps everything still from the first frame. */
  .motion-toggle {
    position: absolute;
    right: var(--s-4);
    bottom: var(--s-5);
    z-index: 2;
    padding: var(--s-2) var(--s-3);
    border: 1px solid color-mix(in srgb, var(--ink) 60%, var(--bg));
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-small);
    cursor: pointer;
    transform: translateY(calc(100% + var(--s-6)));
  }

  .motion-toggle:focus-visible {
    transform: none;
  }

  .motion-toggle[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
  }

  .motion-toggle[hidden] {
    display: none;
  }

  /* Motion on: the list runs twice in one track (the copy is aria-hidden and
     inert) that slides left by half its width and loops seamlessly, each list
     carrying a trailing gap. Hover pauses it; a click or tap on the strip, or
     the keyboard toggle, pauses it and the field. Transform only. */
  @media (prefers-reduced-motion: no-preference) {
    .hero--field.is-live .facts-track {
      display: flex;
      width: max-content;
      animation: facts-scroll 60s linear infinite;
    }

    /* Each list is at least as wide as the strip, so the half-width slide
       never shows an empty tail on wide screens; the spare room spreads
       evenly between the plates (padding-right stands in for the gap between
       the two lists). */
    .hero--field.is-live .facts {
      flex-wrap: nowrap;
      justify-content: space-around;
      min-width: calc(100vw - 2 * var(--s-4));
      padding-right: var(--s-3);
    }

    .hero--field.is-live .fact {
      flex-wrap: nowrap;
      max-width: none;
      white-space: nowrap;
    }

    .hero--field.is-live .facts-window {
      cursor: pointer;
    }

    .hero--field.is-live .facts-copy {
      display: flex;
    }

    .hero--field[data-paused] .facts-track,
    .facts-window:hover .facts-track {
      animation-play-state: paused;
    }

    @keyframes facts-scroll {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }
  }

  /* Hero entrance: a short, staggered rise on load (not scroll-driven). A lift
     only, transform and no opacity: the copy sits in the first viewport, where
     axe and Lighthouse blend a fractional opacity into the contrast ratio.
     Reduced-motion users get the resting state. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in > * {
      animation: hero-up 0.6s var(--ease) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }

    @keyframes hero-up {
      from {
        transform: translateY(12px);
      }
      to {
        transform: none;
      }
    }
  }

