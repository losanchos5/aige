---
/**
 * Home: the discipline, defined. A full-viewport hero (the headline over a
 * painting, one supporting sentence, two CTAs to the Stack and the open
 * controls, two text links to the Thesis and the frontier route, a strip of
 * frameworks and figures), then six numbered sections, a feature and a
 * closing band, in the editorial-restraint system (one 12-column grid, paper
 * ground, hairline rows, Monet paintings as the only decorative colour):
 *
 *   01 The discipline: the definition, the governance loop as a paper panel
 *      on a painting mat, then the three questions as hairline rows.
 *   02 The stack: four real artefacts on one painting mat, the five layer
 *      rows, then where the discipline operates (evals, runtime, assurance).
 *   03 Body of Knowledge: a wide painting strip over the chapters by part.
 *   The verdict: a painting beside the verdict sentence and the role links.
 *   04 What applies now: the AI Act dates from the obligation register.
 *   05 Resources: four painting cards, then the other references as rows.
 *   06 Follow the changes: the newsletter beside the open work.
 *   The closing band, with the hero painting veiled behind it.
 *
 * Sections with a picture alternate with rows: after a full-width picture the
 * next block puts its sub heading in columns 1 to 4 and its rows in 5 to 12.
 * All copy and every figure come from the typed content modules; no number
 * appears here that a primary source does not carry, and every count is
 * computed from the data. The hero keeps its own scoped layout (the painting
 * or the field, the centred headline and the strip; see the <style>).
 */
import Marketing from '../layouts/Marketing.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import GovernanceLoop from '../components/GovernanceLoop.astro';
import BookParts from '../components/BookParts.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import WhatAppliesNow from '../components/WhatAppliesNow.astro';
import HeroStrip from '../components/HeroStrip.astro';
import OpenWork from '../components/OpenWork.astro';
import Painting from '../components/Painting.astro';
import { site } from '../data/site';
import { WEBSITE_ID } from '../lib/jsonld';
import { chip } from '../lib/artefact-chip';
import { definition, values } from '../data/values';
import { workflows } from '../data/role';
import { chaptersOrdered } from '../data/chapters';
import { bookParts, countWord } from '../data/parts';
import { layers } from '../data/stack';
import { frameworks } from '../data/frameworks';
import { patterns } from '../data/patterns';
import { paintings, type PaintingId } from '../data/paintings';

// The home title already names the site, so Seo appends no ` · {site.name}`
// suffix (titleSuffix={false} on <Marketing> below); it uses the same ` · `
// separator as every other page title, not a dash.
const seoTitle = 'AI Governance Engineer · The discipline, defined';
const seoDesc =
  'AI governance engineering turns governance into policy-as-code, eval gates and machine-readable evidence you can run, not just read.';

// The WebSite node describes the site; this WebPage describes the landing page
// itself, so a consumer reading the graph can tell the two apart. Seo.astro
// merges it into the page's single ld+json block.
const homeUrl = new URL('/', site.url).href;
const jsonLd = {
  '@type': 'WebPage',
  '@id': `${homeUrl}#webpage`,
  name: seoTitle,
  description: seoDesc,
  url: homeUrl,
  inLanguage: 'en',
  isPartOf: { '@id': WEBSITE_ID },
};

// The three questions that define the discipline. Stated verbatim in
// role.capabilityStatement and as the stack layers' `question` fields; the
// bodies paraphrase the layers that answer each one, the single model of
// chapters 01 and 04 and the three-questions figure: 02 answers the first,
// 01 and 04 the second, 03 and 05 the third. The swatch is the lead layer.
const questions = [
  {
    index: '01',
    title: 'What AI is running?',
    body: 'A runtime-aware registry of every model, service and agent (each with an owner, a scope and a status), written by the deployment pipeline, not typed into a spreadsheet.',
    layer: 2,
  },
  {
    index: '02',
    title: 'What is it allowed to do?',
    body: "Governance rules written as executable policy and enforced at runtime, under each agent's own identity and scope, so a bad release or an out-of-scope call is blocked at the earliest point it can be, not discouraged in a review.",
    layer: 1,
  },
  {
    index: '03',
    title: 'What evidence proves it?',
    body: 'Structured eval results and machine-readable evidence emitted as the build runs, so assurance is a live query rather than a point-in-time attestation assembled by hand.',
    layer: 3,
  },
];

// The three surfaces where a governance claim becomes something that runs:
// layers 03, 04 and 05 of the stack, each with its swatch, one sentence and
// the pages that carry it (the control profile or pattern, then the layer in
// chapter 04). The anchors are the chapter's own heading ids.
const surfaces = [
  {
    index: 'L03',
    title: 'Evals',
    body: 'Evaluation results become evidence when the metrics and thresholds are fixed before the run and a failure blocks the release.',
    layer: 3,
    links: [
      { label: 'Evaluation environment controls', href: '/controls/evaluation-environment' },
      { label: 'Pattern: Eval Gate in CI', href: '/patterns/eval-gate-in-ci' },
      { label: 'Layer 03 in the stack', href: '/bok/the-stack#layer-03-evals--red-teaming-as-evidence' },
    ],
  },
  {
    index: 'L04',
    title: 'Runtime',
    body: 'Every model, tool call and agent runs under an identity, a scope and a stop handle, enforced at the point where it acts.',
    layer: 4,
    links: [
      { label: 'Agent runtime controls', href: '/controls/agent-runtime' },
      { label: 'Pattern: Kill Switch / Circuit Breaker', href: '/patterns/kill-switch-circuit-breaker' },
      { label: 'Layer 04 in the stack', href: '/bok/the-stack#layer-04-runtime-controls--observability' },
    ],
  },
  {
    index: 'L05',
    title: 'Assurance',
    body: 'Controls emit structured records as they run, so conformity is a query over evidence rather than a document assembled by hand.',
    layer: 5,
    links: [
      { label: 'Pattern: Machine-Readable Evidence', href: '/patterns/machine-readable-evidence-oscal' },
      { label: 'Open data and schemas', href: '/resources/data' },
      { label: 'Layer 05 in the stack', href: '/bok/the-stack#layer-05-assurance--continuous-compliance' },
    ],
  },
];

const pad = (n: number) => String(n).padStart(2, '0');

// The mono credit printed beside each painting: artist, title, year.
const credit = (id: PaintingId) => {
  const p = paintings[id];
  return `${p.artist}, ${p.title}, ${p.year}`;
};

// The hero's figures strip: label | value pairs, every value counted from (or
// read off) the content modules, so the strip can never drift from the site.
const facts = [
  { label: 'Stack layers', value: String(layers.length) },
  { label: 'Workflows', value: String(workflows.length) },
  { label: 'Chapters', value: String(chaptersOrdered.length) },
  { label: 'Values', value: String(values.length) },
  { label: 'Frameworks mapped', value: String(frameworks.length) },
  { label: 'Patterns', value: String(patterns.length) },
  { label: 'Body of Knowledge', value: `v${site.bokVersion}` },
  { label: 'License', value: site.license },
];

// The Newsreader display cuts set the hero headline only; the home preloads
// them (public/_headers carries the same pair for "/").
const heroFonts = [
  '/fonts/newsreader-latin-display-normal.woff2',
  '/fonts/newsreader-latin-display-italic.woff2',
];

// The hero's ground: the painting (true) or the WebGL gradient field of
// public/hero-field.js (false).
const HERO_ART = true;

// The painting at four widths (a 1440px viewport at DPR 1 takes the 1600, a
// 1920px one the 1920 at 241 KB instead of the 2400 at 518 KB), preloaded from
// the head so it starts with the fonts. On a high-density desktop screen the
// sizes claim half the viewport, so a 1200 to 1600 px wide window at DPR 2
// takes the 1600 (177 KB) and a 1920 px one the 1920: the painting sits under
// the wash, the fade and the halo, where the extra detail does not show. Only
// a slot wider than 1920 device pixels takes the 2400. The 1920 was encoded
// once with sharp (webp q78, effort 6) from the 2400 px JPEG master kept in
// commit 7c38c4e; no build step touches these files.
const heroArt = {
  // The plain src (and the preload href) only serve a browser without srcset:
  // the 1600, not the 2400 at 518 KB (audit ONPAGE R4).
  href: '/hero/monet-seine-giverny-1897-1600.webp',
  srcset:
    '/hero/monet-seine-giverny-1897-1200.webp 1200w, /hero/monet-seine-giverny-1897-1600.webp 1600w, /hero/monet-seine-giverny-1897-1920.webp 1920w, /hero/monet-seine-giverny-1897-2400.webp 2400w',
  sizes: '(min-width: 1200px) and (min-resolution: 2dppx) 50vw, 100vw',
  // Intrinsic size of the 2400w file (all four share its 1.24 ratio); the
  // CSS sizes the image, so these are for validators and the aspect ratio.
  width: 2400,
  height: 1937,
};

// First-paint placeholder under the painting: sharp, 24px wide, webp q45,
// base64 (150 bytes). Generated once from the original, not at build time.
const HERO_LQIP =
  'data:image/webp;base64,UklGRo4AAABXRUJQVlA4IIIAAABQBQCdASoYABMAPt1grE8opSSiKAqpEBuJYwCdABESxiiKM5K4GrqF079X3VsoyOKMQgAA/ucYZcdQIZ8gekDbR1k7VvcRFIQ/ZIQYi+x9ea0U0cIbGZDEOt8DambczfYpv6oAY/f8GquG9A8BTdvMuIXzdeLpWyfUssgFbKUsoAAA';


// The chapters section: its title counts chapters and parts from the data, and
// its lede names the three parts that carry the discipline from what an AI
// system is to the law (their titles from chapterParts, never retyped here).
const partTitle = (id: string) => bookParts.find((part) => part.id === id)?.title ?? id;
const chaptersTitle = `${chaptersOrdered.length} chapters in ${countWord(bookParts.length)} parts, versioned and open.`;
const chaptersLede = `The Body of Knowledge is at v${site.bokVersion} and published under ${site.license}. ${partTitle('foundations')}, ${partTitle('lifecycle')}, and ${partTitle('law')} carry the discipline from what an AI system is, through its life, to the law that binds it.`;

// Resources: four cards with a painting on top (the references a reader
// reaches for first, the open controls second), then the rest as numbered
// rows. Together they keep the twelve the home has always linked; the hub
// (/resources) lists every one.
const resourceCards: { label: string; href: string; kicker: string; desc: string; painting: PaintingId }[] = [
  {
    label: 'Frameworks',
    href: '/resources/frameworks',
    kicker: `Reference · ${frameworks.length} frameworks`,
    desc: 'The obligations (EU AI Act, ISO/IEC 42001, NIST AI RMF) mapped to the artefacts that satisfy them.',
    painting: 'vetheuil-fog',
  },
  {
    label: 'Open controls',
    href: '/controls',
    kicker: 'Practice · control profiles',
    desc: 'Control profiles with the evidence each control leaves, versioned and reviewed in the open.',
    painting: 'vernon-church-fog',
  },
  {
    label: 'Obligation register',
    href: '/obligations',
    kicker: 'Reference · stable ids',
    desc: 'Every obligation with a stable id, its duty holder, date, status, artefact and stack layer.',
    painting: 'morning-seine-giverny',
  },
  {
    label: 'MCP server',
    href: '/mcp',
    kicker: 'Tool · MCP',
    desc: 'Ask Claude or any MCP client and get answers read from this Body of Knowledge, each with its source page.',
    painting: 'antibes-morning',
  },
];

const resourceRows = [
  {
    label: 'Topic crosswalk',
    href: '/resources/crosswalk',
    desc: 'One governance topic per row, read across the instruments that bind it, down to the article or clause.',
  },
  {
    label: 'Frontier safety crosswalk',
    href: '/resources/frontier-safety-crosswalk',
    desc: 'Three frontier safety frameworks mapped to NIST AI RMF and ISO/IEC 42001, dimension by dimension.',
  },
  {
    label: 'The map',
    href: '/map',
    desc: 'The whole discipline on one canvas: chapters, layers, patterns and obligations as a navigable map.',
  },
  {
    label: 'Templates & schemas',
    href: '/resources/templates',
    desc: 'JSON Schemas, filled examples and templates for governance records, tagged by obligation.',
  },
  {
    label: 'Harms atlas',
    href: '/resources/harms',
    desc: 'AI harms by level, each with its failure mode, the control that catches it and real incidents.',
  },
  {
    label: 'AI Act deadlines',
    href: '/resources/ai-act-deadlines',
    desc: 'What applies when under the EU AI Act after the Digital Omnibus, in English and Spanish, updated by milestone.',
  },
  {
    label: 'Look up an article',
    href: '/obligations#lookup',
    desc: 'What does Article X require, and what else covers it? Type "AI Act 14" or "GDPR 35" and land on the answer.',
  },
  {
    label: 'Research notes',
    href: '/research',
    desc: 'Technical notes on the open questions: what is assumed, what the evidence shows, what would settle it.',
  },
];
const moreRefsTitle = `${countWord(resourceRows.length).replace(/^./, (c) => c.toUpperCase())} more references.`;

// Painting slots: the width each image is drawn at, for the srcset pick.
const SIZES_WIDE = '(min-width: 1200px) 1168px, calc(100vw - 32px)';
const SIZES_BODY = '(min-width: 1200px) 870px, (min-width: 900px) 72vw, calc(100vw - 32px)';
const SIZES_HALF = '(min-width: 1200px) 572px, (min-width: 720px) 48vw, calc(100vw - 32px)';
---

<Marketing
  title={seoTitle}
  description={seoDesc}
  image="/og/default.png"
  titleSuffix={false}
  jsonLd={jsonLd}
  overlayHeader
  preloadFonts={heroFonts}
  preloadImage={HERO_ART ? heroArt : undefined}
>
  <section
    class:list={['hero', 'hero--field', { 'hero--art': HERO_ART }]}
    data-hero-field={HERO_ART ? undefined : ''}
  >
    {
      HERO_ART ? (
        <div class="hero-art" aria-hidden="true" style={`--hero-lqip: url(${HERO_LQIP})`}>
          <!-- Claude Monet, The Seine at Giverny, 1897. National Gallery of Art, Washington, open access (public domain). -->
          <img
            class="hero-art-img"
            src={heroArt.href}
            srcset={heroArt.srcset}
            sizes={heroArt.sizes}
            width={heroArt.width}
            height={heroArt.height}
            alt=""
            decoding="async"
            fetchpriority="high"
          />
          <div class="hero-art-wash"></div>
          <div class="hero-art-fade"></div>
          <div class="hero-art-halo"></div>
          <div class="hero-art-band"></div>
        </div>
      ) : (
        <div class="hero-field" aria-hidden="true">
          <canvas class="hero-canvas"></canvas>
        </div>
      )
    }

    <div class="container hero-center hero-in">
      <h1 class="hero-title" style="--i:0">
        <span class="hero-line">Governance you can <em>run</em>,</span>
        <span class="hero-line">not just read.</span>
      </h1>
      <p class="hero-lede" style="--i:1">
        An open reference architecture for turning AI safety, risk and policy claims into eval
        gates, runtime controls and machine-verifiable evidence.
      </p>
      <div class="hero-ctas" style="--i:2">
        <a class="btn btn-primary btn-glow" href="/stack">Explore the Stack</a>
        <a class="btn hero-btn-quiet" href="/controls">Open controls</a>
      </div>
      <p class="hero-links" style="--i:3">
        <a href="/thesis">Read the Thesis<span aria-hidden="true"> →</span></a>
        <a href="/frontier">Frontier labs &amp; evaluators<span aria-hidden="true"> →</span></a>
      </p>
    </div>

    <HeroStrip variant="frameworks" facts={facts} />

    {!HERO_ART && <script is:inline defer src="/hero-field.js"></script>}
    {HERO_ART && <script is:inline async src="/hero-art.js"></script>}
  </section>

  <Section
    class="home-sec loop-sec"
    num="01"
    label="The discipline"
    title="The discipline, defined."
    lede={definition}
  >
    <div class="sec-wide">
      <GovernanceLoop>
        <Painting slot="mat" id="charing-cross-bridge" sizes={SIZES_WIDE} />
        <div class="fig-cap">
          <div>
            <p class="label fig-n">Fig. 01</p>
            <p class="fig-title">The governance loop</p>
            <p class="fig-desc">
              Seven steps, from obligation to auditor, in four lanes: the obligation, the rules as
              code, the running system and the proof.
            </p>
          </div>
          <p class="fig-actions">
            <a class="tlink" href="/bok/the-stack#how-to-read-the-stack">Read how the governance loop works</a>
          </p>
          <p class="credit">Mat: {credit('charing-cross-bridge')}</p>
        </div>
      </GovernanceLoop>
    </div>

    <div class="split">
      <div class="split-head">
        <h3 class="subhead">Three questions define the discipline.</h3>
        <p class="subhead-lede">
          Legacy AI governance leaves them unanswered because nothing is connected to production.
          The engineer answers all three from the running system.
        </p>
        <p class="split-links">
          <a class="tlink" href="/ai-governance">What is AI governance?</a>
          <a class="tlink" href="/bok">Open the Body of Knowledge</a>
          <a class="tlink" href="/controls">See the open controls</a>
        </p>
      </div>
      <ol class="split-body rows">
        {
          questions.map((q) => (
            <li class="row">
              <span class="row-n">{q.index}</span>
              <p class="row-t">
                <span class={`sw sw-${q.layer}`} aria-hidden="true" />
                {q.title}
              </p>
              <p class="row-b">{q.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section
    id="stack"
    class="home-sec stack-sec"
    num="02"
    label="The stack"
    title="A build order, from policy to proof."
    lede="The stack is five layers that answer the three questions. Evidence is produced at the bottom and flows up; three layers are established engineering practice, two are new to AI."
  >
    <div class="sec-wide artifacts">
      <div class="mat mat--art">
        <Painting id="pourville-misty-morning" sizes={SIZES_WIDE} />
        <div class="art-grid">
          {/* bok/12-governance-program.md (package aip07), the AIP-07 injection floor; the exception call's arguments are elided. */}
          <div class="art-panel" role="group" aria-labelledby="art-rule">
            <p class="art-head"><span class="sw sw-1" aria-hidden="true" />aip07.rego</p>
            <pre class="art-code"><span class="k">package</span> aip07

<span class="k">import</span> rego.v1

<span class="k">deny</span> contains msg <span class="k">if</span> {"{"}
  input.system.tier in {"{"}2, 3{"}"}
  r := input.evals[
    "injection-resistance.v4"]
  r.score &lt; <span class="v">0.95</span>
  <span class="k">not</span> exception_active(…)
{"}"}</pre>
          </div>
          {/* bok/04-the-stack.md (layer 03 eval-gate result) and bok/patterns/continuous-assurance-telemetry.md (pii_leak_rate 0.004, threshold 0.0, decision alert). */}
          <div class="art-panel" role="group" aria-labelledby="art-gate">
            <p class="art-head"><span class="sw sw-3" aria-hidden="true" />eval gate · csa-01</p>
            <table class="art-table">
              <tbody>
                <tr><td>injection-resistance.v4</td><td>0.982</td><td><span class="vd vd-pass">Pass</span></td></tr>
                <tr><td>guardrail.output.<wbr />pii.v2</td><td>0.004</td><td><span class="vd vd-block">Alert</span></td></tr>
              </tbody>
            </table>
            <p class="art-foot">threshold ≥ 0.95 · pii = 0</p>
          </div>
          {/* bok/patterns/continuous-assurance-telemetry.md, the evidence record (signature as the chapter elides it). */}
          <div class="art-panel" role="group" aria-labelledby="art-record">
            <p class="art-head"><span class="sw sw-5" aria-hidden="true" />evidence-record.v1</p>
            <dl class="art-kv">
              <dt>control_id</dt><dd>guardrail.output.<wbr />pii.v2</dd>
              <dt>subject</dt><dd>csa-01@2026-09-18</dd>
              <dt>decision</dt><dd>alert</dd>
              <dt>obligation</dt><dd>EU AI Act Art. 15</dd>
              <dt>timestamp</dt><dd>2026-09-18T14:31:52Z</dd>
              <dt>signature</dt><dd>ed25519:5a…</dd>
            </dl>
          </div>
          {/* src/data/crosswalk.ts: risk-management, logging-traceability and human-oversight, core or related refs. */}
          <div class="art-panel" role="group" aria-labelledby="art-map">
            <p class="art-head"><span class="sw sw-1" aria-hidden="true" />crosswalk · 3 topics</p>
            <table class="art-table art-matrix">
              <thead><tr><th><span class="visually-hidden">Topic</span></th><th>AI Act</th><th>42001</th><th>RMF</th></tr></thead>
              <tbody>
                <tr><td>Risk</td><td>Art. 9</td><td>6.1.2</td><td>MAP 1</td></tr>
                <tr><td>Logging</td><td>Art. 12</td><td>A.6</td><td>MANAGE 4</td></tr>
                <tr><td>Oversight</td><td>Art. 14</td><td>A.9</td><td>MANAGE 2.4</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <ul class="art-caps">
        <li><p class="label">Layer 01 · Rule</p><p class="art-t" id="art-rule">Policy as code</p><p class="art-d">An obligation compiled into a check the pipeline runs: AIP-07, the injection floor.</p></li>
        <li><p class="label">Layer 03 · Gate</p><p class="art-t" id="art-gate">Eval gate result</p><p class="art-d">Thresholds fixed before the run; a failure blocks the release.</p></li>
        <li><p class="label">Layer 05 · Record</p><p class="art-t" id="art-record">Evidence record</p><p class="art-d">The signed record every control writes to the assurance store.</p></li>
        <li><p class="label">Layer 01 · Map</p><p class="art-t" id="art-map">Topic crosswalk</p><p class="art-d">One topic per row, read across the instruments that bind it.</p></li>
      </ul>
      <p class="credit">Mat: {credit('pourville-misty-morning')}</p>
    </div>

    <div class="split">
      <div class="split-head">
        <h3 class="subhead">Build order.</h3>
        <p class="subhead-lede">
          Evidence flows up: three layers are established engineering practice, two are new to AI.
        </p>
        <p class="split-links"><a class="tlink" href="/stack">Explore the stack</a></p>
      </div>
      <ol class="split-body rows">
        {
          layers.map((layer) => (
            <li class="row layer-row" data-testid="stack-row">
              <span class="row-n">{pad(layer.n)}</span>
              <p class="row-t">
                <span class={`sw sw-${layer.n}`} aria-hidden="true" />
                {layer.name}
              </p>
              <p class="row-b">
                {layer.tagline}
                <small>{layer.artefacts.map(chip).join(' · ')}</small>
              </p>
              <span class:list={['pill', 'row-tag', { 'pill-accent': !layer.inherited }]}>
                {layer.inherited ? 'Established' : 'New'}
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="split" id="where-it-operates">
      <div class="split-head">
        <h3 class="subhead">Where AI Governance Engineering operates.</h3>
        <p class="subhead-lede">
          Three surfaces where a governance claim becomes something that runs: the evaluation gate,
          the runtime control and the assurance record.
        </p>
        <p class="split-links">
          <a class="tlink" href="/controls">Browse the open controls</a>
          <a class="tlink" href="/frontier">For frontier labs and evaluators</a>
        </p>
      </div>
      <ol class="split-body rows">
        {
          surfaces.map((s) => (
            <li class="row surface-row">
              <span class="row-n">{s.index}</span>
              <p class="row-t">
                <span class={`sw sw-${s.layer}`} aria-hidden="true" />
                {s.title}
              </p>
              <div class="row-b">
                <p>{s.body}</p>
                <ul class="link-list">
                  {s.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section
    class="home-sec parts-sec"
    num="03"
    label="Body of Knowledge"
    title={chaptersTitle}
