</Marketing>

<style>
  /* Hero: the whole first viewport. A moving gradient field (hero-field.js
     paints it on the canvas; the div's own background is the static fallback
     for no JS, no WebGL and the first paint), the headline centred on it in
     the serif display cut, its lede, CTAs and links, and a strip of figures
     along the foot.
     The header floats over it (Base overlayHeader), so the hero starts at the
     top of the viewport and its top padding clears the bar. */
  .hero--field {
    --hero-copy: var(--ink); /* the lede and the links: full ink, white over the painting in dark */
    position: relative;
    isolation: isolate;
    overflow: hidden;
    contain: paint;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 100vh;
    min-height: 100svh;
  }

  /* The field: an inert layer under everything. The fallback follows the
     shader's layout with the same three tokens (the peach low on the left,
     the blue on the right, the navy inside the blue), kept low and off the
     bar so the text holds AA without the shader's legibility veil. */
  .hero-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(34% 44% at 94% 84%, var(--field-1), transparent 72%),
      radial-gradient(44% 54% at 80% 62%, var(--field-2), transparent 72%),
      radial-gradient(48% 56% at 8% 74%, var(--field-3), transparent 72%),
      var(--bg);
  }

  /* The canvas is drawn at a fraction of the CSS size and scaled up (the field
     has no edges to blur). It stays hidden until its first frame is painted,
     a visibility switch rather than an opacity ramp. */
  .hero-canvas {
    display: block;
    width: 100%;
    height: 100%;
    visibility: hidden;
  }

  .hero-field[data-ready] .hero-canvas {
    visibility: visible;
  }

  /* Forced colours: no canvas (hero-field.js does not start there either). */
  @media (forced-colors: active) {
    .hero-canvas {
      display: none;
    }
  }

  /* The painting (HERO_ART) fills the hero under four veils of the page
     ground (--bg, so each turns dark in the dark theme): a uniform wash, a
     vertical fade, a halo behind the headline and a band under the floating
     header. The custom properties hold the design's settings. */
  .hero--art {
    --hero-art-x: 68%; /* horizontal focal point: >50% shows more of the right side of the painting */
    --hero-art-y: 30%; /* keeps the sky above the trees on wide windows */
    --hero-wash: 0.3; /* cream veil opacity (the user picked 0.30 for both themes) */
    --hero-art-scale: 1; /* optional gentle zoom; 1.04 crops edges softly */
    --hero-fade: 0; /* foot fade into the page (0..1), mikeoss.com's stops: clear to 60% */
    --hero-fade-top: 0; /* free vertical fade stops (0..1) at the top, 55% and the foot */
    --hero-fade-mid: 0;
    --hero-fade-bot: 0;
    --hero-halo: 0.5; /* cream ellipse behind the headline and its copy (0..1), both themes */
    --hero-halo-w: 90%; /* wide enough that the lede's line ends hold 4.3:1 in the dark theme */
    --hero-halo-h: 60%;
    --hero-halo-y: 44%; /* the centre of the headline-to-links block at 1440x900 (400px of 900) */
    --hero-band: 0; /* veil under the floating header (0..1); 0.45 in the dark theme */
  }

  /* 2:1 and wider (1920x900): lower the frame, or the tree tops sit under the header. */
  @media (min-aspect-ratio: 2/1) {
    .hero--art {
      --hero-art-y: 22%;
    }
  }

  /* Phones: the headline wraps to three lines, fills the width and sits
     higher, so the halo widens past the edges, centres on the lede (34% of
     the hero at 390x844) and reaches down over the CTAs and the links. */
  @media (max-width: 719px) {
    .hero--art {
      --hero-halo-w: 160%;
      --hero-halo-h: 56%;
      --hero-halo-y: 34%;
    }
  }

  /* The ground carries the 24px placeholder (--hero-lqip, set inline from
     the frontmatter), framed like the image, so the painting's colours are
     there on the first paint. */
  .hero-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background-color: var(--bg);
    background-image: var(--hero-lqip, none);
    background-position: var(--hero-art-x) var(--hero-art-y);
    background-repeat: no-repeat;
    background-size: cover;
  }

  .hero-art-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-art-x) var(--hero-art-y);
    transform: scale(var(--hero-art-scale));
    transform-origin: var(--hero-art-x) var(--hero-art-y);
  }

  /* The painting fades in over the placeholder once hero-art.js has seen it
     load. Only while scripting runs: without it the image is never hidden.
     If the script never arrives, the image shows after 3s anyway. */
  @media (scripting: enabled) {
    .hero-art-img:not([data-loaded]) {
      opacity: 0;
      animation: hero-art-failsafe 0s 3s forwards;
    }
  }

  @keyframes hero-art-failsafe {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-art-img {
      transition: opacity 350ms ease-out;
    }
  }

  .hero-art-wash,
  .hero-art-fade,
  .hero-art-halo,
  .hero-art-band {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-art-wash {
    background: var(--bg);
    opacity: var(--hero-wash);
  }

  /* Two fades in one layer: the foot fade (--hero-fade scales mikeoss.com's
     stops: clear for the top 60%, 70% of the ground at 86%, all of it at the
     foot) and a free three-stop fade. */
  .hero-art-fade {
    background:
      linear-gradient(
        to bottom,
        transparent 60%,
        color-mix(in srgb, var(--bg) calc(var(--hero-fade) * 70%), transparent) 86%,
        color-mix(in srgb, var(--bg) calc(var(--hero-fade) * 100%), transparent) 100%
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg) calc(var(--hero-fade-top) * 100%), transparent) 0%,
        color-mix(in srgb, var(--bg) calc(var(--hero-fade-mid) * 100%), transparent) 55%,
        color-mix(in srgb, var(--bg) calc(var(--hero-fade-bot) * 100%), transparent) 100%
      );
  }

  .hero-art-halo {
    background: radial-gradient(
      ellipse var(--hero-halo-w, 62%) var(--hero-halo-h, 40%) at var(--hero-halo-x, 50%) var(--hero-halo-y, 45%),
      color-mix(in srgb, var(--bg) calc(var(--hero-halo) * 100%), transparent) 0%,
      transparent 72%
    );
  }

  .hero-art-band {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) calc(var(--hero-band) * 100%), transparent) 0,
      transparent 9rem
    );
  }

  /* Forced colours: no painting, the plain system ground. */
  @media (forced-colors: active) {
    .hero-art {
      display: none;
    }
  }

  /* Text over the painting. The headline keeps its navy in the light theme
     and turns pure white in the dark one; the floating header (only while it
     floats over this hero, unscrolled) sets its links in full --ink (light)
     or white (dark) instead of the muted --ink-2. The nav ink lives on
     <body> because the header sits outside the hero. */
  :global(body:has(.hero--art)) {
    --hero-nav-ink: var(--ink);
  }

  :global(:root[data-theme='dark'] body:has(.hero--art)) {
    --hero-nav-ink: #ffffff;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light']) body:has(.hero--art)) {
      --hero-nav-ink: #ffffff;
    }
  }

  /* Dark theme: the headline's white, scoped to the hero (the header's menus
     use --hero-ink too and keep theirs), and the band under the floating
     header that keeps its white links at 4.5:1 over the painting's sky. */
  :global(:root[data-theme='dark']) .hero--art {
    --hero-ink: #ffffff;
    --hero-copy: #ffffff;
    --hero-band: 0.45;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .hero--art {
      --hero-ink: #ffffff;
      --hero-copy: #ffffff;
      --hero-band: 0.45;
    }
  }

  :global(body:has(.hero--art) .site-header[data-overlay]:not(.is-scrolled) :is(.wordmark, .nav-link, .nav-trigger, .chev, .icon-btn)) {
    color: var(--hero-nav-ink);
  }

  /* Headline, lede, CTAs and links, centred in the space above the strip.
     The top padding clears the floating header (about 65px, in rem so it
     grows with text zoom as the bar does) and the bottom one keeps the links
     off the strip. */
  .hero-center {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-6);
    padding-block: calc(4.5rem + var(--s-6)) var(--s-7);
    text-align: center;
  }

  /* The headline: Newsreader at its display optical size (a static cut, so no
     axes to set). One phrase per line from the tablet up ("Governance you can
     run, / not just read."): each phrase is its own block, balanced on its own
     when a phone narrows it. The size follows the viewport and is also capped
     at 15vw, so text zoomed to 200% still fits the width (WCAG 1.4.4/1.4.10). */
  .hero-title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: min(clamp(3rem, 1rem + 4.6vw, 6.5rem), 15vw);
    font-variation-settings: normal;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--hero-ink);
  }

  .hero-line {
    display: block;
    text-wrap: balance;
  }

  .hero-title em {
    font-style: italic;
  }

  /* The supporting sentence: body face at a step above body size, weight 500
     and the full ink (--hero-copy), never dimmed: it sits over the painting,
     where only the halo and the wash hold its contrast. */
  .hero-lede {
    max-width: 56ch;
    margin: 0;
    font-size: clamp(1.0625rem, 0.98rem + 0.35vw, 1.25rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--hero-copy);
    text-wrap: balance;
  }

  /* Two buttons: the gradient primary (the Stack) and a quiet one (the open
     controls) on an opaque plate of the page ground, so its label never
     depends on the painting behind it. */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
  }

  .hero-btn-quiet {
    background: var(--bg);
    border-color: var(--ink);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-btn-quiet:hover {
      background: color-mix(in srgb, var(--ink) 8%, var(--bg));
    }
  }

  /* Two text links under the buttons (the Thesis, the frontier route): mono
     at the small size, underlined, in the full ink. */
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2) var(--s-5);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.5;
  }

  .hero-links a {
    color: var(--hero-copy);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .hero-links a:hover {
    text-decoration-thickness: 2px;
  }

  /* Phones: the four blocks close up a step, the padding tightens (the
     header still clears by about 20px) and the two buttons share a row, so
     the strip stays in the first viewport at 390x844. */
  @media (max-width: 719px) {
    .hero-center {
      gap: var(--s-5);
      padding-block: calc(4.5rem + var(--s-4)) var(--s-5);
    }

    .hero-ctas .btn {
      padding-inline: var(--s-4);
    }
  }

  /* Hero entrance: a short, staggered rise on load (not scroll-driven). A lift
     only, transform and no opacity: the copy sits in the first viewport, where
     axe and Lighthouse blend a fractional opacity into the contrast ratio.
     Reduced-motion users get the resting state. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in > * {
      animation: hero-up 0.6s var(--ease) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }

    @keyframes hero-up {
      from {
        transform: translateY(12px);
      }
      to {
        transform: none;
      }
    }
  }

  /* ------------------------------------------------ Sections under the hero
     One rhythm for every section: a 1px rule over the numbered mono label,
     the same padding below each. The heads are Section's own (a 12-column
     grid from 900px, the label in columns 1 to 3, the title from column 4).
     Section's root and inner box are its own elements, hence :global. */
  :global(.section.home-sec) {
    --sec-pad: clamp(72px, 9vw, 112px);
    padding-block: 0 var(--sec-pad);
  }

  :global(.hero--field + .section.home-sec) {
    padding-top: var(--sec-pad);
  }

  /* The rule spans the content width, not the window: it replaces the
     full-bleed one Marketing draws between sections. */
  :global(.marketing > section.home-sec.section) {
    border-top: 0;
  }

  :global(.home-sec > .sec-inner::before) {
    content: '';
    display: block;
    height: 1px;
    margin-bottom: 22px;
    background: var(--line);
  }

  :global(.home-sec .sec-head) {
    margin-bottom: 0;
  }

  /* Full-width blocks (figures, the artefacts, the cards). */
  .sec-wide {
    margin-top: 64px;
    min-width: 0;
  }

  @media (max-width: 899px) {
    .sec-wide {
      margin-top: 40px;
    }
  }

  /* ----------------------------------------------------- Figure caption */
  .fig-cap {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 6px 32px;
  }

  @media (min-width: 720px) {
    .fig-cap {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .fig-cap p {
    margin: 0;
  }

  .fig-n {
    color: var(--accent);
  }

  .fig-title {
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }

  .fig-desc {
    max-width: 68ch;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .fig-cap .credit {
    grid-column: 1 / -1;
  }

  /* ------------------------------------------------------- Split blocks
     After a full-width block the next one shares the left edge: sub heading,
     lede and links in columns 1 to 4, the rows in 5 to 12. */
  .split {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    margin-top: 88px;
    min-width: 0;
  }

  .split-head {
    grid-column: 1 / 5;
    min-width: 0;
  }

  .split-body {
    grid-column: 5 / -1;
    min-width: 0;
  }

  .split + .split {
    margin-top: 80px;
  }

  @media (max-width: 899px) {
    .split {
      margin-top: 64px;
    }

    .split-head,
    .split-body {
      grid-column: 1 / -1;
    }

    .split-body {
      margin-top: var(--s-5);
    }
  }

  .subhead {
    margin: 0 0 var(--s-2);
    padding-top: 18px;
    font-family: var(--font-body);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--ink);
  }

  .subhead-lede {
    max-width: 34ch;
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .split-links {
    display: grid;
    justify-items: start;
    gap: var(--s-3);
    margin: var(--s-5) 0 0;
  }

  /* --------------------------------------------------- Hairline rows */
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--s-2) var(--s-5);
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .row > :nth-child(n + 3) {
    grid-column: 2;
  }

  @media (min-width: 720px) {
    .row {
      grid-template-columns: 2.75rem minmax(0, 15rem) minmax(0, 1fr);
    }

    .row > :nth-child(n + 3) {
      grid-column: auto;
    }

    .layer-row {
      grid-template-columns: 2.75rem minmax(0, 15rem) minmax(0, 1fr) auto;
    }

    .row-tag {
      justify-self: end;
    }
  }

  .row-tag {
    justify-self: start;
  }

  .row-n {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--accent);
  }

  .row-t {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }

  .row-b,
  .row-b p {
    margin: 0;
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .row-b small {
    display: block;
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .link-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
  }

  .link-list a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
  }

  .link-list a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  /* ------------------------------------------- 02: artefacts on one mat */
  .mat--art {
    padding: clamp(16px, 3vw, 40px);
  }

  .art-grid,
  .art-caps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
  }

  @media (min-width: 640px) {
    .art-grid,
    .art-caps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .art-grid,
    .art-caps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .art-panel {
    min-width: 0;
