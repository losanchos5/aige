---
/**
 * Home — the discipline, defined. Hero, the three questions, the five-layer
 * stack, the eight values, the role, a verdict beat, the Body of Knowledge, the
 * resources and a closing CTA. All copy and every figure come from the typed
 * content modules; no number appears here that a primary source does not carry.
 */
import Marketing from '../layouts/Marketing.astro';
import Kicker from '../components/Kicker.astro';
import RegisterList from '../components/RegisterList.astro';
import StatTile from '../components/StatTile.astro';
import VerdictStamp from '../components/VerdictStamp.astro';
import CtaBand from '../components/CtaBand.astro';
import StackDiagram from '../components/StackDiagram.astro';
import Diagram from '../components/Diagram.astro';
import VerdictTicker from '../components/VerdictTicker.astro';
import DefinitionCards from '../components/DefinitionCards.astro';
import ValuePair from '../components/ValuePair.astro';
import ChapterGrid from '../components/ChapterGrid.astro';
import ResourceTiles from '../components/ResourceTiles.astro';
import { site } from '../data/site';
import { definition, values } from '../data/values';
import { capabilityStatement, workflows, market } from '../data/role';
import { chaptersOrdered } from '../data/chapters';

const seoTitle = 'AI Governance Engineer — the discipline, defined';
const seoDesc =
  'AI governance engineering turns governance into policy-as-code, eval gates and machine-readable evidence you can run, not just read.';

// The three questions that define the discipline. Stated verbatim in
// role.capabilityStatement and as the stack layers' `question` fields; the
// bodies paraphrase the corresponding stack layers (inventory, govern-as-code,
// evals/assurance).
const questions = [
  {
    index: '01',
    title: 'What AI is running?',
    body: 'A runtime-aware registry of every model, service and agent — each with an owner, a scope and a status — written by the deployment pipeline, not typed into a spreadsheet.',
    swatch: 'var(--l2)',
  },
  {
    index: '02',
    title: 'What is it allowed to do?',
    body: 'Governance rules expressed as executable policy that evaluates in CI/CD and at runtime, so a bad release is blocked at the earliest point it can be — not discouraged in a review.',
    swatch: 'var(--l1)',
  },
  {
    index: '03',
    title: 'What evidence proves it?',
    body: 'Structured eval results and machine-readable evidence emitted as the build runs, so assurance is a live query rather than a point-in-time attestation assembled by hand.',
    swatch: 'var(--l3)',
  },
];

// Seven workflows as a register list: index (auto), name and the layer tick
// colour. 'all' (regulatory translation) carries the neutral ink tick.
const workflowItems = workflows.map((workflow) => ({
  title: workflow.name,
  swatch: workflow.layerN === 'all' ? 'var(--ink)' : `var(--l${workflow.layerN})`,
}));

// Only primary-sourced figures are tile-safe (the +150% demand signal is not).
const primaryStats = market.filter((stat) => stat.primary);

const resources = [
  {
    label: 'Frameworks',
    href: '/resources/frameworks',
    desc: 'The obligations — EU AI Act, ISO/IEC 42001, NIST AI RMF — mapped to the artefacts that satisfy them.',
  },
  {
    label: 'Tools',
    href: '/resources/tools',
    desc: 'Reference tool categories per layer, from policy engines to eval harnesses and evidence formats.',
  },
  {
    label: 'Reading list',
    href: '/resources/reading-list',
    desc: 'The sources that formed the discipline, each with a verified link and a one-line note.',
  },
  {
    label: 'Glossary',
    href: '/resources/glossary',
    desc: 'Every term defined once, cross-referenced to the chapter that treats it in full.',
  },
];
---

<Marketing title={seoTitle} description={seoDesc} image="/og/default.png">
  <section class="hero section hero--loop">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <h1 class="display hero-h1">Governance you can run, not just read.</h1>
        <p class="lede">{definition}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/thesis">Read the Thesis</a>
          <a class="btn btn-secondary" href="/bok">Open the Body of Knowledge</a>
        </div>
      </div>
      <div
        class="hero-art reveal"
        data-hero-loop
        data-hero-sequence="obligation,policy,inventory,eval,runtime,evidence,auditor"
      >
        <div class="hero-art-wide"><Diagram id="hero-loop" bare /></div>
        <div class="hero-art-tall"><Diagram id="hero-loop-tall" bare /></div>
        <div class="hero-stamp">
          <VerdictStamp verdict="pass" class="hero-stamp-badge" />
          <span class="hero-attn mono">attestation #4821</span>
        </div>
      </div>
    </div>
    <script is:inline defer src="/hero.js"></script>
    <script is:inline defer src="/countup.js"></script>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="sec-head">
        <Kicker swatch="var(--l2)">The three questions</Kicker>
        <h2 class="sec-title display">Three questions define the discipline.</h2>
        <p class="sec-lede lede">
          Legacy AI governance leaves them unanswered because nothing is
          connected to production. The engineer answers all three from the
          running system.
        </p>
      </div>
      <DefinitionCards items={questions} />
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="sec-head">
        <Kicker swatch="var(--l3)">The stack · five layers</Kicker>
        <h2 class="sec-title display">A build order, from policy to proof.</h2>
        <p class="sec-lede lede">
          Five layers that answer the three questions. Evidence is produced at
          the bottom and flows up; three layers are established engineering
          practice, two are new to AI.
        </p>
      </div>
      <StackDiagram mode="interactive" />
      <p class="sec-link"><a href="/stack">Explore the stack →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="sec-head">
        <Kicker swatch="var(--l4)">Values</Kicker>
        <h2 class="sec-title display">Eight values, each a commitment made on purpose.</h2>
      </div>
      <div class="values-grid">
        {values.map((value) => <ValuePair value={value} />)}
      </div>
      <p class="sec-link"><a href="/thesis#principles">Read the principles →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="sec-head">
        <Kicker swatch="var(--l5)">The role</Kicker>
        <h2 class="sec-title display">A capability first, a job title second.</h2>
      </div>
      <blockquote class="pullquote display">{capabilityStatement}</blockquote>
      <div class="role-flows">
        <p class="role-eyebrow mono muted">Seven workflows</p>
        <RegisterList items={workflowItems} />
      </div>
      <div class="stats-row">
        {
          primaryStats.map((stat) => (
            <StatTile value={stat.value} label={stat.label} source={stat.source} href={stat.sourceUrl} />
          ))
        }
      </div>
      <p class="sec-link"><a href="/role">What the role does →</a></p>
    </div>
  </section>

  <section class="verdict-beat">
    <div class="container vb-inner reveal">
      <p class="vb-line display">A policy is not a control. An eval that can fail the build is.</p>
      <div class="vb-stamps">
        <VerdictStamp verdict="block" />
        <VerdictStamp verdict="pass" />
      </div>
    </div>
    <VerdictTicker />
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="sec-head">
        <Kicker swatch="var(--l1)">Body of Knowledge · v{site.bokVersion} · {site.license}</Kicker>
        <h2 class="sec-title display">Eleven chapters, versioned and open.</h2>
      </div>
      <ChapterGrid chapters={chaptersOrdered} />
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="sec-head">
        <Kicker swatch="var(--l4)">Resources</Kicker>
        <h2 class="sec-title display">Curated, cross-referenced, in the open.</h2>
      </div>
      <ResourceTiles tiles={resources} />
    </div>
  </section>

  <CtaBand
    title="Open, versioned, contributable."
    sub="The Thesis and Body of Knowledge are CC BY 4.0. Read them, use them, send a pull request."
    primary={{ label: 'Contribute on GitHub', href: site.github }}
    secondary={{ label: 'Follow on LinkedIn', href: site.linkedin }}
  />
</Marketing>

<style>
  /* Hero — the archify "governance loop". The copy sits left; the diagram is
     the art. One diagram renders per breakpoint (the other is display:none so
     the observer/hover never touch it): portrait on phones, landscape above. */
  .hero--loop {
    position: relative;
    overflow-x: hidden;
  }

  /* Dot-grid backdrop, faded toward the edges with a radial mask so it never
     fights the copy. Behind the content; tokens keep it right in dark mode. */
  .hero--loop::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(ellipse at 70% 50%, #000 40%, transparent 80%);
    mask-image: radial-gradient(ellipse at 70% 50%, #000 40%, transparent 80%);
    pointer-events: none;
  }

  /* The hero runs on a wider well than the body sections so the diagram sits
     next to the copy instead of bleeding to the viewport edge. Capped, centred
     and gutter-padded like any container; the body's 1200px is unchanged. */
  .hero--loop > .container {
    position: relative;
    z-index: 1;
    max-width: min(1440px, 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-5);
  }

  .hero-h1 {
    font-size: var(--fs-display);
    max-width: 16ch;
    margin: 0;
  }

  .hero-copy .lede {
    max-width: 54ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  /* position: relative makes this the containing block for the hover note,
     which is taken out of flow and overlaid on the foot of the diagram (rule in
     diagrams.css under .hero--loop, since the note is injected via set:html and
     carries no scoped cid, so a scoped selector here would never match it). */
  .hero-art {
    position: relative;
    width: 100%;
  }

  /* Phones: the portrait variant, capped and centred; hide the landscape one. */
  .hero-art-wide {
    display: none;
  }

  .hero-art-tall {
    display: block;
    max-width: 420px;
    margin-inline: auto;
  }

  /* The verdict flourish, pinned to the art's lower-right and cocked slightly.
     Server-rendered, so no-JS and reduced-motion users see it at rest. */
  .hero-stamp {
    position: absolute;
    right: var(--s-3);
    bottom: var(--s-3);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-1);
    transform: rotate(-6deg);
    transform-origin: bottom right;
    pointer-events: none;
  }

  .hero-attn {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }

  /* Tablet: single column, the landscape variant full width. */
  @media (min-width: 640px) {
    .hero-art-tall {
      display: none;
    }

    .hero-art-wide {
      display: block;
    }
  }

  /* Desktop: two columns, copy left, art right, both inside the wider hero
     well. The art fills its grid track (no viewport bleed), so it sits beside
     the copy at every width rather than pinned to the screen edge. */
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 4.5fr) minmax(0, 7.5fr);
      gap: var(--s-8);
      align-items: center;
      min-height: min(72vh, 680px);
    }

    /* Scale the headline down so its longest line fits the copy column, and
       balance it to three lines ("Governance / you can run, / not just read."). */
    .hero-h1 {
      font-size: calc(var(--fs-display) * 0.76);
      max-width: 15ch;
      text-wrap: balance;
    }
  }

  /* Motion-only polish: the pop when the loop closes on the auditor. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-stamp.is-pop {
      animation: hero-stamp-pop 260ms var(--ease);
    }

    @keyframes hero-stamp-pop {
      from {
        transform: rotate(-6deg) scale(1.18);
      }
      to {
        transform: rotate(-6deg) scale(1);
      }
    }
  }

  /* Section heads */
  .sec-head {
    max-width: 62ch;
    margin-bottom: var(--s-6);
  }

  .sec-title {
    font-size: var(--fs-h2);
    max-width: 22ch;
    margin: var(--s-3) 0 0;
  }

  .sec-lede {
    margin-top: var(--s-4);
  }

  .sec-link {
    margin-top: var(--s-6);
  }

  .sec-link a {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  .sec-link a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* Values */
  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--s-7);
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 720px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Role */
  .pullquote {
    margin: 0 0 var(--s-6);
    padding-left: var(--s-5);
    border-left: 3px solid var(--ink);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
    color: var(--ink);
    max-width: 46ch;
    text-wrap: pretty;
  }

  .role-eyebrow {
    margin: 0 0 var(--s-3);
  }

  .role-flows {
    max-width: 72ch;
    margin-bottom: var(--s-6);
  }

  .stats-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }

  @media (min-width: 720px) {
    .stats-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Verdict beat */
  .verdict-beat {
    background: color-mix(in srgb, var(--ink) 3.5%, var(--bg));
  }

  .vb-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5) var(--s-6);
    padding-block: clamp(48px, 7vw, 88px);
  }

  .vb-line {
    margin: 0;
    font-size: var(--fs-h2);
    max-width: 24ch;
  }

  .vb-stamps {
    display: flex;
    gap: var(--s-3);
  }
</style>
