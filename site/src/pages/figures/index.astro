---
// /figures: every figure in the Body of Knowledge in one place, grouped by the
// part and chapter it belongs to. Infographics link to their permalink pages
// (/figures/<id>: downloads, embed snippets, citation); the interactive archify
// diagrams link to their full viewers (/diagrams/<id>) and to their chapter.
// A figure with no chapter placement (the discipline map poster) opens the page.
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Callout from '../../components/Callout.astro';
import { site } from '../../data/site';
import { chapterParts, chaptersOrdered, type Chapter } from '../../data/chapters';
import { diagrams, type DiagramDef } from '../../data/diagrams';
import { figures, figureKind, type FigureDef } from '../../data/figures';
import {
  figurePlaces,
  figureUrl,
  hasFigureArt,
  placementPlace,
  thumbnailSvg,
} from '../../lib/figure-reuse';
import { breadcrumbJsonLd } from '../../lib/breadcrumbs';
import { authorNodes, authorRefs, ORG_ID, WEBSITE_ID } from '../../lib/jsonld';
import '../../styles/resources.css';
import '../../styles/figures-gallery.css';

const built = figures.filter((figure) => hasFigureArt(figure.id));
// The viewer pages are generated by scripts/diagrams-build.mjs; link only the
// ones present in this build.
const viewerExists = (id: string) =>
  existsSync(resolve(process.cwd(), 'public', 'diagrams', `${id}.html`));

const firstChapter = (placements: readonly { chapter: string }[]) => placements[0]?.chapter;

interface ChapterGroup {
  chapter: Chapter;
  figures: FigureDef[];
  diagrams: DiagramDef[];
}

const acrossBook = built.filter((figure) => !firstChapter(figure.placements));
const parts = chapterParts
  .map((part) => ({
    ...part,
    chapters: chaptersOrdered
      .filter((chapter) => chapter.part === part.id)
      .map(
        (chapter): ChapterGroup => ({
          chapter,
          figures: built.filter((figure) => firstChapter(figure.placements) === chapter.slug),
          diagrams: diagrams.filter((diagram) => firstChapter(diagram.placements) === chapter.slug),
        }),
      )
      .filter((group) => group.figures.length || group.diagrams.length),
  }))
  .filter((part) => part.chapters.length);

const diagramCount = parts.reduce(
  (n, part) => n + part.chapters.reduce((m, group) => m + group.diagrams.length, 0),
  0,
);
const kindLabel = { infographic: 'Infographic', 'data-viz': 'Data visualisation', poster: 'Poster' };

const description =
  'Every figure in the AI governance Body of Knowledge, with a permalink, text alternative, SVG and PNG downloads and a ready-made CC BY credit.';
const crumbs = [{ label: 'Figures' }];
const pageUrl = new URL('/figures', site.url).href;

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#page`,
    name: `Figures · ${site.name}`,
    description,
    url: pageUrl,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    publisher: { '@id': ORG_ID },
    author: [...authorRefs],
    license: site.licenseUrl,
    hasPart: built.map((figure) => ({ '@id': `${figureUrl(figure.id)}#figure` })),
  },
  ...authorNodes,
  breadcrumbJsonLd(crumbs),
];
---

<Base title="Figures" description={description} image="/og/figures.png" jsonLd={jsonLd}>
  <PageHero
    variant="res"
    crumbs={crumbs}
    title="Figures you can cite and reuse"
    lede={`The ${built.length} infographics and ${diagramCount} interactive diagrams of the Body of Knowledge, grouped by where they appear. Each infographic has its own page with a text alternative, SVG and PNG downloads, embed snippets and a citation.`}
  />

  <div class="container res-page fg-page" data-pagefind-body>
    <div class="res-section">
      <Callout kind="note" title={`Free to reuse under ${site.license}`}>
        <p>
          Copy, share and adapt any figure, commercially too, with credit to {site.authors[0]},
          aigovernanceengineer.com, a link to the <a href={site.licenseUrl} rel="noopener">licence</a>
          and a note of any change. Every download carries that credit inside the image, and each
          figure page gives a credit line and embed snippets ready to paste.
        </p>
      </Callout>
    </div>

    {
      acrossBook.length > 0 && (
        <section class="res-section" aria-labelledby="fg-across">
          <div class="res-section-head">
            <h2 id="fg-across">Across the book</h2>
            <p>Figures that index the whole discipline rather than one chapter.</p>
          </div>
          <ul class="fg-cards">
            {acrossBook.map((figure) => (
              <li>
                <article class="fg-card" aria-labelledby={`fg-t-${figure.id}`}>
                  <a class="fg-thumb" href={`/figures/${figure.id}`} tabindex="-1" aria-hidden="true">
                    <Fragment set:html={thumbnailSvg(figure)} />
                  </a>
                  <ul class="fg-tags" aria-label="Figure facts">
                    <li class="type-tag">{kindLabel[figureKind(figure)]}</li>
                    {figure.asOf && <li class="type-tag">As of {figure.asOf}</li>}
                  </ul>
                  <h3 id={`fg-t-${figure.id}`} class="fg-card-title">
                    <a href={`/figures/${figure.id}`}>{figure.title}</a>
                  </h3>
                  <p>{figure.caption}</p>
                  <p class="fg-card-foot">
                    {figurePlaces(figure).map((place, i) => (
                      <>
                        {i > 0 && ' · '}
                        <a href={place.href}>{place.label}</a>
                      </>
                    ))}
                  </p>
                </article>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      parts.map((part) => (
        <section class="res-section" aria-labelledby={`fg-part-${part.id}`}>
          <div class="res-section-head">
            <h2 id={`fg-part-${part.id}`}>{part.title}</h2>
          </div>
          {part.chapters.map((group) => (
            <div class="fg-chapter">
              <h3 class="fg-chapter-title">
                <a href={`/bok/${group.chapter.slug}`}>{group.chapter.title}</a>
              </h3>
              <ul class="fg-cards">
                {group.figures.map((figure) => (
                  <li>
                    <article class="fg-card" aria-labelledby={`fg-t-${figure.id}`}>
                      <a class="fg-thumb" href={`/figures/${figure.id}`} tabindex="-1" aria-hidden="true">
                        <Fragment set:html={thumbnailSvg(figure)} />
                      </a>
                      <ul class="fg-tags" aria-label="Figure facts">
                        <li class="type-tag">{kindLabel[figureKind(figure)]}</li>
                        {figure.asOf && <li class="type-tag">As of {figure.asOf}</li>}
                      </ul>
                      <h4 id={`fg-t-${figure.id}`} class="fg-card-title">
                        <a href={`/figures/${figure.id}`}>{figure.title}</a>
                      </h4>
                      <p>{figure.caption}</p>
                      <p class="fg-card-foot">
                        <a href={`/figures/${figure.id}#downloads`}>Downloads</a> ·{' '}
                        <a href={`/figures/${figure.id}#reuse`}>Embed and credit</a>
                      </p>
                    </article>
                  </li>
                ))}
                {group.diagrams.map((diagram) => {
                  const place = placementPlace(diagram.placements[0]);
                  return (
                    <li>
                      <article class="fg-card fg-card--diagram" aria-labelledby={`fg-d-${diagram.id}`}>
                        <ul class="fg-tags" aria-label="Diagram facts">
                          <li class="type-tag">Interactive diagram</li>
                          <li class="type-tag">{diagram.type}</li>
                        </ul>
                        <h4 id={`fg-d-${diagram.id}`} class="fg-card-title">
                          {viewerExists(diagram.id) ? (
                            <a href={`/diagrams/${diagram.id}`}>{diagram.title}</a>
                          ) : (
                            diagram.title
                          )}
                        </h4>
                        <p>{diagram.caption}</p>
                        <p class="fg-card-foot">
                          {viewerExists(diagram.id) && (
                            <>
                              <a href={`/diagrams/${diagram.id}`}>Open the viewer</a> ·{' '}
                            </>
                          )}
                          {place && <a href={place.href}>In the chapter</a>}
                        </p>
                      </article>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
  </div>
</Base>
