---
import fs from 'node:fs';
import { resolve } from 'node:path';
import Doc from '../../layouts/Doc.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import OpenWork from '../../components/OpenWork.astro';
import { breadcrumbJsonLd } from '../../lib/breadcrumbs';
import {
  authorRefs,
  lastModified,
  ORG_ID,
  PROFILE_PAGE_ID,
  WEBSITE_ID,
} from '../../lib/jsonld';
import { site } from '../../data/site';
import { people } from '../../data/people';
import { openQuestions } from '../../data/open-questions';

// Link the built Body-of-Knowledge PDF only when it exists at build time, so a
// checkout without the generated file (build/build_pdf.py not run) still builds.
// The file lives at site/public/downloads; the build runs from the site dir
// (like reading.ts, which reads git and the sources relative to process.cwd()).
const pdfName = `aige-bok-v${site.bokVersion}.pdf`;
const pdfHref = `/downloads/${pdfName}`;
const pdfPath = resolve(process.cwd(), 'public', 'downloads', pdfName);
let pdfSize = '';
try {
  const bytes = fs.statSync(pdfPath).size;
  pdfSize =
    bytes >= 1024 * 1024
      ? `${(bytes / (1024 * 1024)).toFixed(1)} MB`
      : `${Math.round(bytes / 1024)} KB`;
} catch {
  // No PDF in this environment; the download link is omitted below.
}

const description =
  'What this site is, who maintains it and how to contribute: the founding text and working reference for engineering the governance of AI systems.';

// The author as the preface states him (bok/00-preface.md, "Who wrote it, and
// from what"): the role from data/site.ts and the experience sentence, nothing
// beyond it.
const author = site.authorDetails[0];
const experience =
  'Two and a half years designing and operating an AI governance framework inside a large telco, sitting between Legal, Security and Engineering, and covering the governance, security, compliance, business and model-performance dimensions of AI risk.';
const githubProfile = author.sameAs?.find((url) => url.startsWith('https://github.com/'));
// The subjects the author works on, as data/people.ts states them.
const researchInterests = people[0].researchInterests ?? [];

// /about is the author's profile page: its main entity is the Person node
// (lib/jsonld.ts), which Seo.astro adds to the graph because it is referenced.
const jsonLd = [
  {
    '@type': 'ProfilePage',
    '@id': PROFILE_PAGE_ID,
    name: 'About this site',
    description,
    url: new URL('/about', site.url).href,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    publisher: { '@id': ORG_ID },
    mainEntity: authorRefs[0],
    dateModified: lastModified(
      'src/pages/about/index.astro',
      'src/data/site.ts',
      'src/data/people.ts',
      'src/data/open-questions.ts',
      'src/data/work.ts',
    ),
  },
  breadcrumbJsonLd([{ label: 'About' }]),
];
---

<Doc
  title="About this site"
  summary="What this is, who maintains it, and how to contribute."
  description={description}
  sidebar={false}
  wide={true}
  image="/og/about.png"
  jsonLd={jsonLd}
>
  <p>
    <strong>{site.name}</strong> is the home of <em>AI Governance Engineering: The Thesis &amp; Body
    of Knowledge</em>, a founding text and working reference for turning AI governance obligations
    into policy-as-code, eval gates, agent registries and machine-readable evidence. It treats
    governance as a system to be built, run and measured, not a document to be signed. If you are
    new to the field, start with <a href="/ai-governance">what AI governance is</a>.
  </p>

  <h2>Who maintains it</h2>
  <p>
    Written and maintained by {site.author}, {author.jobTitle}, sole author of the Body of
    Knowledge, website, datasets and project materials. The Thesis is the sole exception and is
    co-authored by Jorge García Aibar and Aurélie Pols. This is a public draft and invites
    practitioners who build governance for AI systems to propose improvements.
  </p>

  <h2 id="author">About the author</h2>
  <dl class="about-facts">
    <dt>Name</dt>
    <dd>{author.name}</dd>
    <dt>Role</dt>
    <dd>{author.jobTitle}</dd>
    <dt>Experience</dt>
    <dd>{experience}</dd>
    <dt>Profiles</dt>
    <dd>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      {
        githubProfile && (
          <Fragment>
            {' · '}
            <a href={githubProfile} target="_blank" rel="noopener noreferrer">GitHub</a>
          </Fragment>
        )
      }
    </dd>
  </dl>

  <h2 id="research-interests">Research interests</h2>
  <ul>
    {researchInterests.map((interest) => <li>{interest}</li>)}
  </ul>

  <h2 id="open-questions">Current open questions</h2>
  <p>
    The questions I am working on and have not settled. Each links to where the work on it lives;
    a question leaves this list when a reviewed note or control answers it.
  </p>
  <ol>
    {
      openQuestions.map((q) => (
        <li>{q.href ? <a href={q.href}>{q.question}</a> : q.question}</li>
      ))
    }
  </ol>

  <h2 id="open-work">Open work</h2>
  <p>
    What is in progress, with its real state. Nothing here is marked reviewed until a named
    reviewer is credited; until then each item is open for technical review.
  </p>
  <OpenWork />

  <h2 id="work-together">Let’s work together</h2>
  <p>
    I’m {site.author}. I am particularly interested in collaborations around independent assessment
    methodology, evaluation-environment controls, agent runtime safeguards, machine-readable
    evidence, open control profiles and reference implementations. If you are building or assessing
    any of these, compare notes with me.
  </p>
  <p>
    Email me at <a href={`mailto:${site.email}`}>{site.email}</a> or{' '}
    <a href={site.linkedin} target="_blank" rel="noopener noreferrer">contact me on LinkedIn</a>.
    For public questions or proposals about the Body of Knowledge, start a{' '}
    <a href={`${site.github}/discussions`} target="_blank" rel="noopener noreferrer">GitHub discussion</a>.
  </p>

  <h2>How to contribute</h2>
  <p>
    Everything here lives in a public repository. Propose a change, add a pattern, sharpen an
    argument or fix a fact by opening a pull request. Every factual claim needs a sourced, verified
    citation, following the style guide. Accepted substantive contributions are credited by name;
    they do not change the stated authorship unless expressly agreed.
  </p>
  <ul>
    <li>
      <a href="/about/methodology">Methodology</a>: how sources are chosen and tagged, how dates are
      kept current, and how corrections, reviews and releases work.
    </li>
    <li>
      <a href="/about/contributors">Contributors and signatories</a>: who has written, revised or
      signed.
    </li>
    <li>
      <a href="/about/changelog">Changelog</a>: what changed in each version.
    </li>
    <li>
      <a href={`${site.github}`} target="_blank" rel="noopener noreferrer">Source repository on
      GitHub</a>: open an issue or a pull request.
    </li>
  </ul>

  {
    pdfSize && (
      <Fragment>
        <h2>Download</h2>
        <p>
          The Body of Knowledge as released in v{site.bokVersion} (the Thesis, every chapter of that
          release, contributors and changelog) is available as a single PDF.{' '}
          <a
            href={pdfHref}
            data-umami-event="download"
            data-umami-event-file={pdfHref}
            data-umami-event-location="about"
          >Download the PDF (v{site.bokVersion}, {pdfSize})</a>.
        </p>
      </Fragment>
    )
  }

  <h2>Stay updated</h2>
  <p>
    New and updated chapters, and each released version, are announced in the{' '}
    <a href="/rss.xml">RSS feed</a>.
  </p>
  <NewsletterForm location="about" />

  <h2>Cite</h2>
  <p>
    {site.doi !== site.conceptDoi ? (
      <>
        Each release is archived on Zenodo. This version (v{site.bokVersion}) has the DOI{' '}
        <a href={`https://doi.org/${site.doi}`}>{site.doi}</a>; the concept DOI{' '}
        <a href={`https://doi.org/${site.conceptDoi}`}>{site.conceptDoi}</a> always resolves to the
        latest one.
      </>
    ) : (
      <>
        Each release is archived on Zenodo. Until this version (v{site.bokVersion}) has its own DOI,
        cite the concept DOI <a href={`https://doi.org/${site.conceptDoi}`}>{site.conceptDoi}</a>,
        which always resolves to the latest one.
      </>
    )}{' '}
    Machine-readable metadata lives in{' '}
    <a href={`${site.github}/blob/main/CITATION.cff`}>CITATION.cff</a>; every chapter offers a
    ready-made citation and BibTeX entry.
  </p>

  <h2>Licence</h2>
  <p>
    Except where otherwise noted, this work is licensed under <strong>{site.license}</strong>. You may
    share and adapt it with appropriate credit, a link to the licence and an indication of changes.
    Attribute the Body of Knowledge, website, datasets and project materials to {site.authors[0]}.
    Attribute the Thesis to Jorge García Aibar and Aurélie Pols.
  </p>

  <h2>Contact</h2>
  <p>
    Email: <a href={`mailto:${site.email}`}>{site.email}</a>.{' '}
    Discuss the discipline on{' '}
    <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>, or on{' '}
    <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>.
  </p>
</Doc>

<style>
  /* About reads as a run of short sections: gaps, rules, heading scale and
     secondary text pinned to tokens. The h2/p/ul are authored here, so these
     scoped rules reach them inside Doc's .prose well; :global(.prose) lifts
     them over prose.css. */
  :global(.prose) > h2 {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    font-size: var(--fs-h2);
  }

  :global(.prose) > p,
  :global(.prose) > ul {
    color: var(--ink-2);
  }

  /* The author facts: label and value on one row where there is room. */
  .about-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-2) var(--s-5);
    margin: 0;
    color: var(--ink-2);
  }

  .about-facts dt {
    font-weight: 600;
    color: var(--ink);
  }

  .about-facts dd {
    margin: 0;
  }

  @media (min-width: 560px) {
    .about-facts {
      grid-template-columns: max-content minmax(0, 1fr);
    }
  }
</style>
