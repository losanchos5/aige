---
import { getEntry, render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import { gitDate } from '../../lib/reading';

const entry = await getEntry('meta', 'contributors');
if (!entry) {
  throw new Error('meta collection entry "contributors" not found');
}
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const title = (remarkPluginFrontmatter.title as string | undefined) ?? 'Contributors and signatories';
const summary = (remarkPluginFrontmatter.summary as string | undefined) ?? undefined;
const editPath = 'bok/CONTRIBUTORS.md';
const updated = gitDate(`../${editPath}`);
// CONTRIBUTORS.md opens with an H2, not a blockquote, so remark-lead yields no
// summary and the page fell back to the site-wide description. State its own.
const description =
  'Who wrote the Body of Knowledge, who co-authored the Thesis, and who has signed it: the authorship, contributions and signatories of the project.';
---

<Doc
  title={title}
  summary={summary}
  description={description}
  kicker="About"
  crumbs={[{ label: 'About', href: '/about' }, { label: title }]}
  headings={headings}
  editPath={editPath}
  updated={updated}
  sidebar={false}
  image="/og/about.png"
>
  <Content />
</Doc>
