---
import { getEntry, render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import { gitDate } from '../../lib/reading';

const entry = await getEntry('meta', 'contributors');
if (!entry) {
  throw new Error('meta collection entry "contributors" not found');
}
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const title = (remarkPluginFrontmatter.title as string | undefined) ?? 'Contributors and signatories';
const summary = (remarkPluginFrontmatter.summary as string | undefined) ?? undefined;
const editPath = 'bok/CONTRIBUTORS.md';
const updated = gitDate(`../${editPath}`);
---

<Doc
  title={title}
  summary={summary}
  kicker="About"
  crumbs={[{ label: 'About', href: '/about' }, { label: title }]}
  headings={headings}
  editPath={editPath}
  updated={updated}
  sidebar={false}
  image="/og/about.png"
>
  <Content />
</Doc>

<style>
  /* Rendered Markdown carries no scope attribute, so these rules are global
     (page styles ship with this page only); .doc .prose outranks prose.css.
     prose.css already draws the section gap and --line rule over each h2;
     these pin the headings to the --fs-* scale. */
  :global(.doc .prose > h2) {
    font-size: var(--fs-h2);
  }

  :global(.doc .prose > h3) {
    margin-top: var(--s-6);
    font-size: var(--fs-h3);
  }
</style>
