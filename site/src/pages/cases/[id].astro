---
import Base from '../../layouts/Base.astro';
import '../../styles/reading.css';
import PageHero from '../../components/PageHero.astro';
import Callout from '../../components/Callout.astro';
import CitedText from '../../components/CitedText.astro';
import SourceList from '../../components/SourceList.astro';
import Byline from '../../components/Byline.astro';
import PillarLink from '../../components/PillarLink.astro';
import ContributeCta from '../../components/ContributeCta.astro';
import { site } from '../../data/site';
import { obligationPath } from '../../data/frameworks';
import { layers } from '../../data/stack';
import { harms, incidentDbLabel } from '../../data/harms';
import {
  cases,
  caseEvidenceLabel,
  casesDisclaimer,
  caseNoteProblems,
  hasIncidentNote,
  type IncidentCase,
} from '../../data/cases';
import { controlById, controlHref } from '../../data/controls';
import type { ControlRef } from '../../data/harms';
import { citedNumbers } from '../../lib/sources';
import { gitDate, gitCreated } from '../../lib/reading';
import { breadcrumbJsonLd } from '../../lib/breadcrumbs';
import { patternById } from '../../lib/cross-links';
import { patternPath } from '../../data/patterns';
import { authorNodes, authorRefs, ORG_ID, WEBSITE_ID } from '../../lib/jsonld';
import '../../styles/resources.css';
import '../../styles/pages.css';
import '../../styles/harms.css';

export function getStaticPaths() {
  return cases.map((c, i) => ({
    params: { id: c.id },
    props: {
      entry: c,
      prev: i > 0 ? cases[i - 1] : undefined,
      next: i < cases.length - 1 ? cases[i + 1] : undefined,
    },
  }));
}

interface Props {
  entry: IncidentCase;
  prev?: IncidentCase;
  next?: IncidentCase;
}

const { entry, prev, next } = Astro.props;

// Build-time integrity of the incident notes (control ids, pattern ids, no
// empty lists), as /resources/threats does for its rows.
const noteProblems = caseNoteProblems();
if (noteProblems.length > 0) {
  throw new Error(`cases.ts incident notes:\n${noteProblems.join('\n')}`);
}

// Build-time integrity: every [n] must have a source row, every source row must
// be cited, and every harm id must exist in the atlas.
const prose = [
  ...entry.happened,
  ...entry.failureMode,
  ...entry.control.text,
  ...entry.obligations.map((o) => o.why),
  ...(entry.systemBoundary ? [entry.systemBoundary] : []),
  ...(entry.controlAssumptions ?? []),
  ...(entry.evidenceRequirements ?? []),
  ...(entry.openQuestions ?? []),
];
const cited = citedNumbers(prose);
for (const n of cited) {
  if (n < 1 || n > entry.sources.length) {
    throw new Error(`cases.ts: "${entry.id}" cites [${n}] but has ${entry.sources.length} sources`);
  }
}
entry.sources.forEach((_, i) => {
  if (!cited.has(i + 1)) {
    throw new Error(`cases.ts: "${entry.id}" source [${i + 1}] is never cited`);
  }
});
const relatedHarms = entry.harms.map((id) => {
  const harm = harms.find((h) => h.id === id);
  if (!harm) throw new Error(`cases.ts: "${entry.id}" names unknown harm "${id}"`);
  return harm;
});

const layerName = (n: number) => layers.find((layer) => layer.n === n)?.name ?? `Layer ${n}`;
const pageUrl = new URL(`/cases/${entry.id}`, site.url).href;
const updated = gitDate('src/data/cases.ts');
const published = gitCreated('src/data/cases.ts');
const crumbs = [{ label: 'Incidents', href: '/cases' }, { label: entry.short }];
// <title>: the case's short name and what the page is (audit F5): the full
// headline stays the H1. A "(reported)" tag stays on the page, not in the title.
const pageTitle = `${entry.short.replace(/\s*\([^)]*\)$/, '')}: AI incident case study`;
// Each named control that is a catalogued pattern links its own page.
const controls = entry.control.controls.map((ctl) => {
  if (!ctl.patternId) return { name: ctl.name };
  const pattern = patternById(ctl.patternId);
  if (!pattern) throw new Error(`cases.ts: "${entry.id}" names unknown pattern "${ctl.patternId}"`);
  return { name: ctl.name, href: patternPath(pattern) };
});

// The incident note (optional fields of cases.ts), rendered only where written.
const linkRef = (ctl: ControlRef) => {
  const pattern = ctl.patternId ? patternById(ctl.patternId) : undefined;
  return { name: ctl.name, href: pattern ? patternPath(pattern) : undefined };
};
const moments = [
  {
    id: 'controls-preventive',
    label: 'Preventive',
    lede: 'Before the failure: design choices and release gates.',
    refs: entry.preventiveControls,
  },
  {
    id: 'controls-detective',
    label: 'Detective',
    lede: 'While it happens: what notices it.',
    refs: entry.detectiveControls,
  },
  {
    id: 'controls-responsive',
    label: 'Responsive',
    lede: 'After it: what contains it and feeds the fix back.',
    refs: entry.responsiveControls,
  },
]
  .filter((m) => m.refs !== undefined)
  .map((m) => ({ ...m, links: (m.refs ?? []).map(linkRef) }));
const relatedControls = (entry.relatedControls ?? []).map((id) => {
  const control = controlById(id);
  if (!control) throw new Error(`cases.ts: "${entry.id}" names unknown control "${id}"`);
  return { id: control.id, title: control.title, href: controlHref(control.id) };
});
const hasNote = hasIncidentNote(entry);
// "On this page": every H2 the case renders, in order (cases with a note only).
const toc = [
  { id: 'what-happened', text: 'What happened' },
  { id: 'failure-mode', text: 'Failure mode' },
  { id: 'control', text: 'Which control would have caught it' },
  { id: 'evidence', text: 'The evidence that would have existed' },
  { id: 'obligations', text: 'Obligations it touches today' },
  ...(entry.systemBoundary ? [{ id: 'system-boundary', text: 'System boundary' }] : []),
  ...(entry.controlAssumptions ? [{ id: 'control-assumptions', text: 'Control assumptions' }] : []),
  ...(moments.length > 0 ? [{ id: 'controls-by-moment', text: 'Controls by moment' }] : []),
  ...(entry.evidenceRequirements ? [{ id: 'evidence-requirements', text: 'Evidence requirements' }] : []),
  ...(relatedControls.length > 0 ? [{ id: 'related-controls', text: 'Related open controls' }] : []),
  ...(entry.openQuestions ? [{ id: 'open-questions', text: 'Open questions' }] : []),
  { id: 'sources', text: 'Sources' },
];

const jsonLd = [
  {
    '@type': 'Article',
    '@id': `${pageUrl}#article`,
    headline: entry.title,
    description: entry.summary,
    url: pageUrl,
    inLanguage: 'en',
    datePublished: published,
    dateModified: updated,
    author: [...authorRefs],
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': WEBSITE_ID },
    ...(site.licenseUrl ? { license: site.licenseUrl } : {}),
    citation: entry.sources.map((s) => s.url),
    // The card the page shares (og:image below), which Google lists as an
    // Article property for rich results (audit SCHEMA N1).
    image: new URL('/og/resources.png', site.url).href,
  },
  ...authorNodes,
  breadcrumbJsonLd(crumbs),
];
---

<Base
  title={pageTitle}
  description={entry.summary}
  image="/og/resources.png"
  jsonLd={jsonLd}
  article={{ publishedTime: `${published}T00:00:00Z`, modifiedTime: `${updated}T00:00:00Z` }}
>
  <PageHero variant="res" crumbs={crumbs} title={entry.title} lede={entry.summary}>
    <Byline slot="lede" date={updated} />
  </PageHero>

  <div class="container res-page">
    <div class="cs-body" data-pagefind-body>
      {/* "In short": the self-contained answer passage (GEO N4), in the chapters'
          summary callout styling (prose.css data-kind="summary"). */}
      <div class="prose cs-in-short">
        <aside class="callout" data-kind="summary">
          <p class="callout-title">In short</p>
          <p>{entry.inShort}</p>
        </aside>
      </div>
      {/* Hub and spoke (SXO-R2-06): each case points at the /ai-governance pillar. */}
      <PillarLink lead="One incident read against the controls of" anchor="AI governance and its frameworks" />

      <dl class="cs-facts">
        <dt>Year</dt>
        <dd>{entry.year}</dd>
        <dt>Jurisdiction</dt>
        <dd>{entry.jurisdiction}</dd>
        <dt>Sector</dt>
        <dd>{entry.sector}</dd>
        <dt>Evidence base</dt>
        <dd>
          <span class:list={['type-tag', entry.evidence === 'reported' && 'cs-tag-reported']}>
            {caseEvidenceLabel[entry.evidence]}
          </span>
        </dd>
        <dt>Incident record</dt>
        <dd>
          {
            entry.incidents.map((ref, i) => (
              <>
                {i > 0 && ' · '}
                <a href={ref.url} rel="noopener">
                  {ref.db === 'AIID' ? `AIID ${ref.id}` : incidentDbLabel[ref.db]}
                </a>
              </>
            ))
          }
        </dd>
        <dt>Harm</dt>
        <dd>
          {
            relatedHarms.map((harm, i) => (
              <>
                {i > 0 && ' · '}
                <a href={`/resources/harms#harm-${harm.id}`}>{harm.harmType}</a>
              </>
            ))
          }
        </dd>
      </dl>

      {
        hasNote && (
          <nav class="cs-toc" aria-label="On this page">
            <p class="cs-toc-title">On this page</p>
            <ol>
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`}>{item.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="prose">
        <h2 id="what-happened">What happened</h2>
        {
          entry.happened.map((p) => (
            <p>
              <CitedText text={p} />
            </p>
          ))
        }

        <h2 id="failure-mode">Failure mode</h2>
        {
          entry.failureMode.map((p) => (
            <p>
              <CitedText text={p} />
            </p>
          ))
        }

        <h2 id="control">Which control would have caught it</h2>
        {
          entry.control.text.map((p) => (
            <p>
              <CitedText text={p} />
            </p>
          ))
        }
        <p>
          Patterns:{' '}
          {
            controls.map((ctl, i) => (
              <>
                {i > 0 && ' · '}
                {ctl.href ? <a href={ctl.href}>{ctl.name}</a> : ctl.name}
              </>
            ))
          }
        </p>

        <h2 id="evidence">The evidence that would have existed</h2>
        <p>What an auditor could have read, and the stack layer that produces it.</p>
      </div>

      <ul class="cs-evidence">
        {
          entry.evidenceArtefacts.map((item) => (
            <li>
              <span
                class="ticks ticks--coded"
                role="img"
                aria-label={`Layer ${item.layerN}, ${layerName(item.layerN)}`}
              >
                <span class="tk-key">
                  <span class="tk" data-l={item.layerN} aria-hidden="true" />L{item.layerN}
                </span>
              </span>
              <span>{item.artefact}</span>
            </li>
          ))
        }
      </ul>

      <div class="prose">
        <h2 id="obligations">Obligations it touches today</h2>
        <p>As of 2026-09-24. Mappings are illustrative, not a claim of conformity.</p>
      </div>
      <ul class="cs-oblig prose">
        {
          entry.obligations.map((o) => (
            <li>
              <span class="cs-oblig-ref">
                <span>{o.instrument}</span>
                {o.obligationId ? (
                  <a href={obligationPath({ id: o.obligationId })}>{o.ref}</a>
                ) : (
                  o.ref
                )}
              </span>
              <CitedText text={o.why} />
            </li>
          ))
        }
      </ul>

      {
        hasNote && (
          <div class="prose cs-note">
            {entry.systemBoundary && (
              <>
                <h2 id="system-boundary">System boundary</h2>
                <p>
                  <CitedText text={entry.systemBoundary} />
                </p>
              </>
            )}
            {entry.controlAssumptions && (
              <>
                <h2 id="control-assumptions">Control assumptions</h2>
                <p>What the controls below take for granted. Challenge any of them.</p>
                <ul>
                  {entry.controlAssumptions.map((a) => (
                    <li>
                      <CitedText text={a} />
                    </li>
                  ))}
                </ul>
              </>
            )}
            {moments.length > 0 && (
              <>
                <h2 id="controls-by-moment">Controls by moment</h2>
                {moments.map((m) => (
                  <>
                    <h3 id={m.id}>{m.label}</h3>
                    <p>{m.lede}</p>
                    <ul>
                      {m.links.map((ctl) => (
                        <li>{ctl.href ? <a href={ctl.href}>{ctl.name}</a> : ctl.name}</li>
                      ))}
                    </ul>
                  </>
                ))}
              </>
            )}
            {entry.evidenceRequirements && (
              <>
                <h2 id="evidence-requirements">Evidence requirements</h2>
                <p>The evidence each control must leave, written as acceptance criteria.</p>
                <ul>
                  {entry.evidenceRequirements.map((r) => (
                    <li>
                      <CitedText text={r} />
                    </li>
                  ))}
                </ul>
              </>
            )}
            {relatedControls.length > 0 && (
              <>
                <h2 id="related-controls">Related open controls</h2>
                <p>
                  Draft control specifications from the <a href="/controls">open control profiles</a>,
                  open for technical review.
                </p>
                <ul>
                  {relatedControls.map((c) => (
                    <li>
                      <a href={c.href}>{c.id}</a> {c.title}
                    </li>
                  ))}
                </ul>
              </>
            )}
            {entry.openQuestions && (
              <>
                <h2 id="open-questions">Open questions</h2>
                <ul>
                  {entry.openQuestions.map((q) => (
                    <li>
                      <CitedText text={q} />
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        )
      }

      <div class="res-section">
        <Callout kind="note" title="How to read this case">
          <p>{casesDisclaimer}</p>
        </Callout>
      </div>

      <div class="prose cs-sources-wrap">
        <h2 id="sources">Sources</h2>
        <SourceList sources={entry.sources} />
      </div>

      <ContributeCta kind="incident" title={entry.title} landmark={false} />

      <nav class="cs-nav" aria-label="More cases">
        {prev ? <a href={`/cases/${prev.id}`}>← {prev.short}</a> : <span />}
        <a href="/cases">All cases</a>
        {next ? <a href={`/cases/${next.id}`}>{next.short} →</a> : <span />}
      </nav>
    </div>
  </div>
</Base>

<style>
  /* The In short callout opens the case body: flush at the top, one rhythm
     step above the facts box. */
  .cs-in-short {
    margin-bottom: var(--s-5);
  }
  .cs-in-short .callout {
    margin-top: 0;
  }
  /* "On this page" on cases with an incident note: a quiet numbered list under
     the facts box, headed in the facts box's label type. */
  .cs-toc {
    margin: 0 0 var(--s-6);
    font-size: var(--fs-small);
  }
  .cs-toc-title {
    margin: 0 0 var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .cs-toc ol {
    margin: 0;
    padding-left: var(--s-5);
  }
  .cs-toc li {
    margin: 0 0 var(--s-1);
  }
  .cs-note h3 {
    scroll-margin-top: var(--anchor-offset);
  }
</style>
