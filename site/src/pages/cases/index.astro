---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Callout from '../../components/Callout.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import ContributeCta from '../../components/ContributeCta.astro';
import { site } from '../../data/site';
import { cases, caseEvidenceLabel, casesDisclaimer } from '../../data/cases';
import { breadcrumbJsonLd } from '../../lib/breadcrumbs';
import { authorNodes, authorRefs, lastModified, ORG_ID, WEBSITE_ID } from '../../lib/jsonld';
import { fitsSiteSuffix } from '../../lib/seo-title';
import '../../styles/resources.css';
import '../../styles/pages.css';
import '../../styles/harms.css';

// Search title and description (SXO-R2-07, 2026-09-25 round 2): the query
// first; the H1 stays.
const seoTitle = 'AI incident case studies: what failed, which control';
const description =
  'Public AI incidents as engineering post-mortems: what happened, the failure mode, the control that would have caught it and the evidence it would have left.';
const crumbs = [{ label: 'Incidents' }];
const pageUrl = new URL('/cases', site.url).href;

// "From incident to control": the five steps a post-mortem goes through to
// become a control requirement and an evidence requirement. Each step links
// the place on the site that develops it (anchors: the H2 slugs of chapter 17,
// and the schema rows of /resources/templates).
const incidentToControl = [
  {
    label: 'Incident',
    sub: 'The record: what happened, when, to whom',
    href: '/bok/incidents#the-incident-record',
    layer: 5,
  },
  {
    label: 'Failure mode',
    sub: 'Why the system let it happen',
    href: '/bok/incidents#ai-specific-failure-modes',
  },
  {
    label: 'Control gap',
    sub: 'The control that was missing or did not hold',
    href: '/patterns/incident-pipeline',
    layer: 4,
  },
  {
    label: 'Control requirement',
    sub: 'The control, stated so it can be verified',
    href: '/controls',
    layer: 1,
  },
  {
    label: 'Evidence requirement',
    sub: 'The record the control must leave',
    href: '/resources/templates#schema-incident-record',
    layer: 5,
  },
] as const;

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#page`,
    name: `AI incident cases · ${site.name}`,
    description,
    url: pageUrl,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    publisher: { '@id': ORG_ID },
    author: [...authorRefs],
    dateModified: lastModified('src/pages/cases/index.astro', 'src/data/cases.ts'),
    hasPart: cases.map((c) => ({ '@id': `${new URL(`/cases/${c.id}`, site.url).href}#article` })),
  },
  ...authorNodes,
  breadcrumbJsonLd(crumbs),
];
---

<Base
  title={seoTitle}
  titleSuffix={fitsSiteSuffix(seoTitle)}
  description={description}
  image="/og/resources.png"
  jsonLd={jsonLd}
>
  <PageHero
    variant="res"
    crumbs={crumbs}
    title="Which control would have caught this?"
    lede="Public AI incidents, read as engineering post-mortems. Each case sets out what happened from the court, regulator or original record, the failure mode behind it, the control that would have caught it, the evidence that control would have left, and the obligations the case touches today."
  />

  <div class="container res-page">
    <div class="res-section">
      <Callout kind="note" title="Illustrative, not a legal determination">
        <p>{casesDisclaimer}</p>
        <p>Every figure on this page is sourced on the case page it links to. Cases marked
        "Reported" rest on press reports only.</p>
      </Callout>
    </div>

    <section class="res-section" aria-labelledby="cs-heading">
      <div class="res-section-head">
        <h2 id="cs-heading">{cases.length} cases</h2>
        <p>Each links to its incident record and to the harm it illustrates in the <a
        href="/resources/harms">harms atlas</a>. The controls are patterns from <a
        href="/bok/patterns">the catalogue</a>, the engineering side of <a
        href="/ai-governance">AI governance in practice</a>.</p>
      </div>

      <ul class="cs-cards">
        {
          cases.map((c) => (
            <li>
              <article class="cs-card" aria-labelledby={`cs-${c.id}`}>
                <ul class="cs-meta" aria-label="Case facts">
                  <li class="type-tag">{c.year}</li>
                  <li class="type-tag">{c.jurisdiction}</li>
                  <li class:list={['type-tag', c.evidence === 'reported' && 'cs-tag-reported']}>
                    {caseEvidenceLabel[c.evidence]}
                  </li>
                </ul>
                <h3 id={`cs-${c.id}`}>
                  <a href={`/cases/${c.id}`}>{c.title}</a>
                </h3>
                <p>{c.summary}</p>
                <p class="cs-controls">
                  <strong>Would have caught it:</strong>{' '}
                  {c.control.controls.map((ctl) => ctl.name).join(' · ')}
                </p>
              </article>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="res-section" id="from-incident-to-control" aria-labelledby="cs-method">
      <div class="res-section-head">
        <h2 id="cs-method">From incident to control</h2>
        <p>A post-mortem is useful to an engineering function when it ends in a requirement, not a
        lesson. Each case here is read the same way: the incident record fixes what happened, the
        failure mode says why the system let it happen, and the gap between that failure and the
        controls in place names the control that was missing. That control is then written as a
        requirement someone can verify, and paired with the evidence it must leave, so the next
        review checks a record instead of a promise. Cases with an incident note carry the full
        chain: system boundary, control assumptions, controls by moment, evidence requirements and
        the <a href="/controls">open controls</a> they relate to.</p>
      </div>
      <FlowDiagram
        id="incident-to-control"
        title="From incident to control"
        desc="Five steps from a public incident to a control requirement and the evidence it must leave."
        steps={incidentToControl}
      />
      <p class="cs-method-work">Put it to work: run the reporting deadlines of an incident in the <a
      href="/toolkit/incident-clock">incident clock</a>, and turn the fix into a risk-register entry
      and an eval case with <a href="/bok/incidents#capa-from-incident-to-risk-register-and-eval-suite">corrective
      and preventive action</a>.</p>
      <ContributeCta kind="incident" title="A failure mode from a public incident" />
    </section>
  </div>
</Base>

<style>
  .cs-method-work {
    max-width: var(--prose);
    margin: var(--s-5) 0;
  }
</style>
