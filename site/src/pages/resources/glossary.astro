---
// /resources/glossary: the interactive A-Z index of the glossary. Since v0.5.0
// every term has its own canonical page (/glossary/<slug>) and the book index is
// /bok/glossary; public/_redirects sends this path to /bok/glossary with a 301
// on the host, and the page is still built so the local preview, the content
// lint and the tests keep an A-Z index with the same `t-…` anchors.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import GlossaryIndex from '../../components/GlossaryIndex.astro';
import ContrastCards from '../../components/ContrastCards.astro';
import { getGlossary, getGlossaryLetters, getContrastPairs } from '../../lib/glossary';
import { breadcrumbJsonLd } from '../../lib/breadcrumbs';
import { site } from '../../data/site';
import { WEBSITE_ID } from '../../lib/jsonld';
import '../../styles/resources.css';
import '../../styles/pages.css';

const entries = getGlossary();
const letters = getGlossaryLetters();
const pairs = getContrastPairs();
const crumbs = [{ label: 'Resources', href: '/resources' }, { label: 'Glossary' }];

// The glossary is genuinely structured, so it is stated as a DefinedTermSet.
// The set's identity is the book index (/bok/glossary#glossary) and each term's
// is its own page (/glossary/<slug>#term), the same @ids the term pages carry.
const glossaryUrl = new URL('/bok/glossary', site.url).href;
const termSetId = `${glossaryUrl}#glossary`;
const jsonLd = [
  {
    '@type': 'DefinedTermSet',
    '@id': termSetId,
    name: `Glossary · ${site.name}`,
    url: glossaryUrl,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    hasDefinedTerm: entries.map((entry) => {
      const termUrl = new URL(entry.url, site.url).href;
      return {
        '@type': 'DefinedTerm',
        '@id': `${termUrl}#term`,
        name: entry.term,
        description: entry.definition,
        url: termUrl,
        inDefinedTermSet: { '@id': termSetId },
      };
    }),
  },
  breadcrumbJsonLd(crumbs),
];
---

<Base
  title="Glossary"
  description="The canonical glossary for AI governance engineering: every term defined once, alphabetically, with its own page, its source and the chapter that treats it in full."
  image="/og/resources.png"
  jsonLd={jsonLd}
>
  {/* Glossary is a Lighthouse route: keep it light, the dot texture only, no
      animated gradient mesh (mesh={false}). */}
  <PageHero
    variant="res"
    mesh={false}
    crumbs={crumbs}
    title="Every term, defined once."
    lede={`${entries.length} terms, alphabetical, each at most 60 words, sourced and cross-referenced to the chapter that develops it. Every term has its own page with its sources, the chapters that use it and a citation.`}
  />

  <div class="container res-page">
    <div class="res-section">
      <h2 class="gl-pairs-head">Commonly confused pairs</h2>
      <ContrastCards pairs={pairs} level={3} />
    </div>
    <div class="res-section">
      <GlossaryIndex entries={entries} letters={letters} />
    </div>
  </div>
</Base>

<style>
  .gl-pairs-head {
    margin: 0 0 var(--s-4);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
  }
</style>
