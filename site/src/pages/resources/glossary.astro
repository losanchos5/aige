---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import GlossaryIndex from '../../components/GlossaryIndex.astro';
import { getGlossary, getGlossaryLetters, termId } from '../../lib/glossary';
import { breadcrumbJsonLd } from '../../lib/breadcrumbs';
import { site } from '../../data/site';
import { WEBSITE_ID } from '../../lib/jsonld';
import '../../styles/resources.css';
import '../../styles/pages.css';

const entries = getGlossary();
const letters = getGlossaryLetters();
const crumbs = [{ label: 'Resources', href: '/resources' }, { label: 'Glossary' }];

// The glossary is genuinely structured — term, definition and an on-page anchor
// per entry (GlossaryIndex renders each <dt id={termId(term)}>) — so it is stated
// as a DefinedTermSet whose terms @id the anchors a reader can actually follow.
const glossaryUrl = new URL('/resources/glossary', site.url).href;
const termSetId = `${glossaryUrl}#glossary`;
const jsonLd = [
  {
    '@type': 'DefinedTermSet',
    '@id': termSetId,
    name: `Glossary — ${site.name}`,
    url: glossaryUrl,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    hasDefinedTerm: entries.map((entry) => ({
      '@type': 'DefinedTerm',
      '@id': `${glossaryUrl}#${termId(entry.term)}`,
      name: entry.term,
      description: entry.definition,
      inDefinedTermSet: { '@id': termSetId },
    })),
  },
  breadcrumbJsonLd(crumbs),
];
---

<Base
  title="Glossary"
  description="The canonical glossary for AI governance engineering: every term defined once, alphabetically, and cross-referenced to the chapter that treats it in full."
  image="/og/resources.png"
  jsonLd={jsonLd}
>
  {/* Glossary is a Lighthouse route: keep it light — the dot texture only, no
      animated gradient mesh (mesh={false}). */}
  <PageHero
    variant="res"
    mesh={false}
    swatch="var(--l3)"
    crumbs={[{ label: 'Resources', href: '/resources' }, { label: 'Glossary' }]}
    title="Every term, defined once."
    lede={`${entries.length} terms, alphabetical, each one to three sentences and cross-referenced to the chapter that develops it. Where a term has a canonical spelling in the style guide, that spelling is used here and everywhere in the book.`}
  />

  <div class="container res-page">
    <div class="res-section">
      <GlossaryIndex entries={entries} letters={letters} />
    </div>
  </div>
</Base>
