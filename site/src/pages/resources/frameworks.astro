---
import Base from '../../layouts/Base.astro';
import '../../styles/reading.css';
import PageHero from '../../components/PageHero.astro';
import Callout from '../../components/Callout.astro';
import FrameworkTable from '../../components/FrameworkTable.astro';
import ObligationMatrix from '../../components/ObligationMatrix.astro';
import ObligationTable from '../../components/ObligationTable.astro';
import Diagram from '../../components/Diagram.astro';
import Figure from '../../components/Figure.astro';
import { getFigure } from '../../data/figures';
import lineageSvg from '../../figures/instrument-lineage.svg?raw';
import { frameworks, obligations, disclaimer } from '../../data/frameworks';
import { breadcrumbJsonLd } from '../../lib/breadcrumbs';
import { collectionPage, lastModified } from '../../lib/jsonld';
import { compareLinks } from '../../lib/compare-links';
import '../../styles/resources.css';
import '../../styles/pages.css';

const crumbs = [{ label: 'Resources', href: '/resources' }, { label: 'Frameworks' }];
// Block w2-fig-concepts: how the instruments relate, above the table.
const lineage = getFigure('instrument-lineage')!;
const description =
  'The laws, standards, codes and control sets AI governance engineering maps against, with the obligation → artefact → stack-layer index from chapter 08.';

// The page as a CollectionPage of the frameworks in its table, each at its row
// anchor, dated like the sitemap's lastmod.
const jsonLd = [
  collectionPage({
    path: '/resources/frameworks',
    name: 'Frameworks',
    description,
    dateModified: lastModified(
      'src/pages/resources/frameworks.astro',
      'src/data/frameworks.ts',
      'src/figures/instrument-lineage.svg',
    ),
    items: frameworks.map((fw) => ({ name: fw.name, url: `/resources/frameworks#fw-${fw.id}` })),
  }),
  breadcrumbJsonLd(crumbs),
];
---

<Base
  title="Frameworks"
  description={description}
  image="/og/resources.png"
  jsonLd={jsonLd}
>
  <PageHero
    variant="res"
    crumbs={crumbs}
    title="The instruments, and what answers them."
    lede="The horizontal law, the management standards, the voluntary codes and the control sets the discipline is built against, then the reverse index that names, for each obligation, the engineering artefact that evidences it and the layer it lives in."
  />

  <div class="container res-page">
    <div class="res-section">
      <Callout kind="note" title="Illustrative mapping, not a conformity assessment">
        <p>{disclaimer} No artefact named here guarantees compliance, and no standard cited confers a
        presumption of conformity. An artefact supports and evidences an obligation; the legal
        judgement of conformity stays with lawyers, notified bodies and authorities.</p>
      </Callout>
    </div>

    <section class="res-section" aria-labelledby="fw-heading">
      <div class="res-section-head">
        <h2 id="fw-heading">Frameworks</h2>
        <p>{frameworks.length} instruments: laws, standards, codes and control sets. External links
        open the canonical source.</p>
        <p class="ob-xref">
          Compared side by side, clause by clause:
          {compareLinks.map((link, i) => (
            <>{i > 0 && ' · '}<a href={link.href}>{link.label}</a></>
          ))}.
        </p>
      </div>
      <Figure
        id="instrument-lineage"
        title={lineage.title}
        caption={lineage.caption}
        description={lineage.description}
      >
        <Fragment set:html={lineageSvg} />
      </Figure>
      <FrameworkTable frameworks={frameworks} />
    </section>

    <section class="res-section" aria-labelledby="ob-heading">
      <div class="res-section-head">
        <h2 id="ob-heading">Obligation → artefact → layer</h2>
        <p>{obligations.length} rows, grouped by framework. Read each as a sentence: this obligation
        is answered by this artefact, which lives in this layer. Filter by the layer you are
        building, or by EU AI Act duty holder.</p>
        <p class="ob-xref">
          Cross-reference: <a href="/obligations">the obligation register</a> (one page per row,
          with a stable id) · <a href="/resources/tools">tools by layer</a> ·
          <a href="/patterns">the patterns</a> ·
          <a href="/resources/crosswalk">topic crosswalk</a>.
        </p>
        <p class="ob-export">
          <a
            class="ob-dl"
            href="/resources/obligations.csv"
            download
            target="_blank"
            rel="noopener"
            data-umami-event="download"
            data-umami-event-file="/resources/obligations.csv"
            data-umami-event-location="frameworks">Download CSV</a>
          <a
            class="ob-dl"
            href="/resources/obligations.json"
            download
            target="_blank"
            rel="noopener"
            data-umami-event="download"
            data-umami-event-file="/resources/obligations.json"
            data-umami-event-location="frameworks">Download JSON</a>
          <a class="ob-dl" href="/api/v1/obligations.json">API</a>
          <a class="ob-dl" href="/resources/data">About the data</a>
        </p>
      </div>
      <Diagram id="obligation-to-evidence" />
      <ObligationMatrix frameworks={frameworks} obligations={obligations} />
      <ObligationTable obligations={obligations} />
    </section>
  </div>

  <script is:inline defer src="/matrix.js"></script>
</Base>
