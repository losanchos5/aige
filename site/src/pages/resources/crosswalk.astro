---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Callout from '../../components/Callout.astro';
import CrosswalkMatrix from '../../components/CrosswalkMatrix.astro';
import CrosswalkDrawer from '../../components/CrosswalkDrawer.astro';
import { site } from '../../data/site';
import { disclaimer } from '../../data/frameworks';
import {
  topics,
  columns,
  refs,
  topicMatrix,
  chipLabel,
  frameworkById,
  crosswalkAsOf,
  refObligation,
  refsByTopic,
  type CrosswalkRef,
} from '../../data/crosswalk';
import { obligationPath } from '../../data/frameworks';
import { breadcrumbJsonLd } from '../../lib/breadcrumbs';
import { authorNodes, authorRefs, ORG_ID, WEBSITE_ID } from '../../lib/jsonld';
import { fitsSiteSuffix } from '../../lib/seo-title';
import { comparisons, comparisonPath } from '../../data/comparisons';
import '../../styles/resources.css';
import '../../styles/pages.css';
import '../../styles/crosswalk.css';
import '../../styles/crosswalk-explorer.css';

const matrix = topicMatrix();
const frameworkCount = matrix.columns.reduce((n, c) => n + c.fws.length, 0);
const unverifiedCount = refs.filter((r) => r.verified === false).length;
// Title and description answer the comparison query ("EU AI Act vs ISO 42001
// vs NIST AI RMF", SXO-04 of the 2026-09-25 audit); the H1 stays.
const seoTitle = 'AI governance crosswalk: EU AI Act, ISO 42001, NIST AI RMF';
const description = `Compare the EU AI Act, ISO/IEC 42001, the NIST AI RMF and more across ${topics.length} AI governance topics, clause by clause, with a gap explorer and OSCAL export.`;
const crumbs = [{ label: 'Resources', href: '/resources' }, { label: 'Crosswalk' }];

// The answer-first overlap of the three instruments most readers compare, read
// from the same references the matrix renders (so it cannot drift from it):
// per topic, the clauses each of the three files there, core ones first.
const OVERLAP_IDS = ['eu-ai-act', 'iso-42001', 'nist-ai-rmf'];
const overlapFws = OVERLAP_IDS.map((id) => {
  const fw = frameworkById(id);
  if (!fw) throw new Error(`crosswalk overlap: no framework "${id}"`);
  return fw;
});
const coreFirst = (list: CrosswalkRef[]) =>
  [...list].sort((a, b) => Number(a.strength !== 'core') - Number(b.strength !== 'core'));
const overlapRows = topics.map((topic) => {
  const byFw = refsByTopic(topic.id);
  return { topic, cells: overlapFws.map((fw) => coreFirst(byFw.get(fw.id) ?? [])) };
});
const [euCells, isoCells, nistCells] = [0, 1, 2].map((i) => overlapRows.map((row) => row.cells[i]));
const inAllThree = overlapRows.filter((row) => row.cells.every((cell) => cell.length > 0)).length;
const actWithoutIso = overlapRows.filter((_, i) => euCells[i].length > 0 && isoCells[i].length === 0).length;
const actWithoutNist = overlapRows.filter((_, i) => euCells[i].length > 0 && nistCells[i].length === 0).length;
const OVERLAP_SHOWN = 2;

// The explorer's defaults, mirrored in public/crosswalk-explorer.js.
const DEFAULT_SOURCE = 'eu-ai-act';
const DEFAULT_TARGET = 'iso-42001';

// The crosswalk is a dataset, not just a page: the two download endpoints next to
// it (crosswalk.csv.ts / crosswalk.json.ts) are its distributions.
const crosswalkUrl = new URL('/resources/crosswalk', site.url).href;
const jsonLd = [
  {
    '@type': 'Dataset',
    '@id': `${crosswalkUrl}#dataset`,
    name: `Topic × framework crosswalk · ${site.name}`,
    description,
    url: crosswalkUrl,
    inLanguage: 'en',
    version: site.bokVersion,
    dateModified: crosswalkAsOf,
    keywords: [
      'AI governance',
      'EU AI Act',
      'GPAI Code of Practice',
      'GDPR',
      'ISO/IEC 42001',
      'ISO/IEC 42005',
      'ISO/IEC 23894',
      'NIST AI RMF',
      'CSA AICM',
      'OWASP',
      'Korea AI Basic Act',
      'Singapore',
      'China',
      'TC260',
      'OSCAL',
      'crosswalk',
    ],
    creator: [...authorRefs],
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': WEBSITE_ID },
    // URL, not the "CC BY 4.0" label: schema.org types `license` as URL|CreativeWork.
    ...(site.licenseUrl ? { license: site.licenseUrl } : {}),
    distribution: [
      {
        '@type': 'DataDownload',
        name: 'Crosswalk (CSV)',
        encodingFormat: 'text/csv',
        contentUrl: new URL('/resources/crosswalk.csv', site.url).href,
      },
      {
        '@type': 'DataDownload',
        name: 'Crosswalk (JSON)',
        encodingFormat: 'application/json',
        contentUrl: new URL('/resources/crosswalk.json', site.url).href,
      },
    ],
  },
  ...authorNodes,
  breadcrumbJsonLd(crumbs),
];
---

<Base
  title={seoTitle}
  titleSuffix={fitsSiteSuffix(seoTitle)}
  description={description}
  image="/og/resources.png"
  jsonLd={jsonLd}
>
  <PageHero
    variant="res"
    crumbs={crumbs}
    title="AI governance crosswalk: one topic, every framework."
    lede="Start from a governance topic, read across to the instrument that governs it, and land on the exact article, clause or control. Or start from one framework and see where another covers it, and where it does not."
  />

  <div class="container res-page">
    <section class="res-section cw-overlap" aria-labelledby="cw-overlap-heading">
      <div class="res-section-head">
        <h2 id="cw-overlap-heading">EU AI Act, ISO/IEC 42001 and NIST AI RMF: where they overlap</h2>
        <p>
          The three overlap on {inAllThree} of the {topics.length} topics in this crosswalk: each
          files at least one clause there. They differ in force. The EU AI Act is binding law;
          ISO/IEC 42001 is a certifiable AI management-system standard whose European adoption
          confers no presumption of conformity with the Act; the NIST AI RMF is a voluntary
          framework in four functions (Govern, Map, Measure, Manage). Of the topics the Act
          reaches, {actWithoutIso} have no ISO/IEC 42001 clause here and {actWithoutNist} no NIST
          AI RMF one. A shared topic means the instruments deal with the same thing, not that
          meeting one meets the other. How the three fit into the wider field is set out in
          <a href="/ai-governance">AI governance and its main frameworks</a>.
        </p>
      </div>
      <div class="res-tablewrap">
        <table class="res-table cw-overlap-table">
          <caption class="visually-hidden">
            Clauses of the EU AI Act, ISO/IEC 42001 and the NIST AI RMF per crosswalk topic, core
            references first
          </caption>
          <thead>
            <tr>
              <th scope="col">Topic</th>
              {overlapFws.map((fw) => <th scope="col">{fw.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              overlapRows.map((row) => (
                <tr>
                  <td class="c-name" data-label="Topic">
                    <a href={`#topic-${row.topic.id}`}>{row.topic.name}</a>
                  </td>
                  {row.cells.map((cell, i) => (
                    <td data-label={overlapFws[i].short}>
                      {cell.length === 0
                        ? 'Not mapped'
                        : cell.slice(0, OVERLAP_SHOWN).map(chipLabel).join(', ') +
                          (cell.length > OVERLAP_SHOWN ? ` (+${cell.length - OVERLAP_SHOWN})` : '')}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="res-section cw-compare" aria-labelledby="cw-compare-heading" data-cw-compare>
      <div class="res-section-head">
        <h2 id="cw-compare-heading">Compare two frameworks</h2>
        <p>One page per pair readers compare most: legal force, scope and certification side by
        side, then a topic-by-topic clause mapping generated from this crosswalk.</p>
      </div>
      <ul>
        {
          comparisons.map((c) => (
            <li>
              <a href={comparisonPath(c)}>{`${c.aName} vs ${c.bName}`}</a>: differences, overlap
              and mapping
            </li>
          ))
        }
      </ul>
    </section>

    <div class="res-section">
      <Callout kind="note" title="Illustrative mapping, not a conformity assessment">
        <p>{disclaimer}</p>
        <p>A mapping cell is not evidence; see the <a href="/bok/patterns#pattern-framework-crosswalk"
        >Framework Crosswalk pattern</a> for what turns a crosswalk into an auditable control.</p>
        <p>The Chinese references were checked against the CAC texts on 2026-09-20 and the
        references added in v0.5.0 on {crosswalkAsOf}. Any chip marked “?” is not yet verified
        against its source ({unverifiedCount} of {refs.length}), mostly ISO/IEC clauses whose text
        could not be opened and draft European standards.</p>
      </Callout>
    </div>

    <section class="res-section" aria-labelledby="cw-heading">
      <div class="res-section-head">
        <h2 id="cw-heading">Topic × framework</h2>
        <p>{topics.length} topics · {columns.length} columns ({frameworkCount} instruments) ·
        {refs.length} references. Read each row across: this topic is governed here, and there,
        down to the clause. Four columns show at first; add the others with the column chooser.</p>
        <p class="ob-xref">
          Cross-reference: <a href="/resources/frameworks">the obligation index</a> ·
          <a href="/bok/patterns#pattern-framework-crosswalk">the Framework Crosswalk pattern</a> ·
          <a href="#explore">the clause-to-clause explorer</a>.
        </p>
        <p class="ob-export">
          <a
            class="ob-dl"
            href="/resources/crosswalk.csv"
            download
            target="_blank"
            rel="noopener"
            data-umami-event="download"
            data-umami-event-file="/resources/crosswalk.csv"
            data-umami-event-location="crosswalk">Download CSV</a>
          <a
            class="ob-dl"
            href="/resources/crosswalk.json"
            download
            target="_blank"
            rel="noopener"
            data-umami-event="download"
            data-umami-event-file="/resources/crosswalk.json"
            data-umami-event-location="crosswalk">Download JSON</a>
        </p>
      </div>
      <CrosswalkMatrix matrix={matrix} />
    </section>

    <section
      id="explore"
      class="res-section cwx"
      aria-labelledby="cwx-heading"
      data-cwx-src="/resources/crosswalk.json"
      data-cwx-nojs
    >
      <div class="res-section-head">
        <h2 id="cwx-heading">Clause-to-clause explorer</h2>
        <p>Pick one or more source frameworks and a target. Two clauses are paired when the
        crosswalk files them under the same topic, so a pair says "these deal with the same thing"
        (OSCAL <code>intersects-with</code>), never "meeting one meets the other". The gap view
        lists the target clauses in this crosswalk that no chosen source reaches; it is not a list
        of every clause the target contains.</p>
      </div>

      <noscript>
        <p class="cwx-nojs">The explorer needs JavaScript. The matrix above and the topic sections
        below carry the same references, and the CSV and JSON downloads carry all of them.</p>
      </noscript>

      <form class="cwx-form" data-cwx-form data-cwx-js hidden>
        <details class="cwx-src" open>
          <summary class="cwx-src-sum">
            Source frameworks <span class="mono cwx-src-count" data-cwx-src-count>1 selected</span>
          </summary>
          <div class="cwx-src-grid">
            {
              matrix.columns.map((col) => (
                <fieldset class="cwx-src-group">
                  <legend>{col.label}</legend>
                  {col.fws.map((f) => (
                    <label class="cwx-check">
                      <input
                        type="checkbox"
                        name="cwx-src"
                        value={f.id}
                        checked={f.id === DEFAULT_SOURCE}
                        disabled={f.id === DEFAULT_TARGET}
                      />
                      <span>{f.short}</span>
                    </label>
                  ))}
                </fieldset>
              ))
            }
          </div>
        </details>

        <div class="cwx-fields">
          <label class="cwx-field">
            <span class="cwx-field-label">Target framework</span>
            <select name="cwx-tgt">
              {
                matrix.columns.map((col) => (
                  <optgroup label={col.label}>
                    {col.fws.map((f) => (
                      <option value={f.id} selected={f.id === DEFAULT_TARGET}>
                        {f.short}
                      </option>
                    ))}
                  </optgroup>
                ))
              }
            </select>
          </label>
          <label class="cwx-field">
            <span class="cwx-field-label">Topic</span>
            <select name="cwx-topic">
              <option value="all" selected>All topics</option>
              {topics.map((t) => <option value={t.id}>{t.name}</option>)}
            </select>
          </label>
          <label class="cwx-toggle">
            <input type="checkbox" name="cwx-verified" />
            <span>Verified references only</span>
          </label>
          <fieldset class="cwx-view">
            <legend class="cwx-field-label">View</legend>
            <label class="cwx-seg">
              <input type="radio" name="cwx-view" value="pairs" checked />
              <span>Side by side</span>
            </label>
            <label class="cwx-seg">
              <input type="radio" name="cwx-view" value="gaps" />
              <span>Gaps</span>
            </label>
          </fieldset>
        </div>
      </form>

      <div class="cwx-actions" data-cwx-js hidden>
        <button type="button" class="cwx-btn" data-cwx-action="link" disabled>Copy link</button>
        <button type="button" class="cwx-btn" data-cwx-action="csv" disabled>Download CSV</button>
        <button type="button" class="cwx-btn" data-cwx-action="json" disabled>Download JSON</button>
        <button type="button" class="cwx-btn" data-cwx-action="oscal" disabled>Download OSCAL</button>
      </div>

      <p class="cwx-status" role="status" data-cwx-status data-cwx-js hidden></p>
      <div class="cwx-out" data-cwx-out data-cwx-js hidden></div>

      <p class="cwx-fine">
        Every export says “illustrative, not a claim of conformity” inside the file. The OSCAL
        export is a mapping collection in the NIST OSCAL 1.2.3 Control Mapping model: one mapping
        per source framework, relationship <code>intersects-with</code>, with gap summaries. Its
        id-refs are the crosswalk clause ids (CSA’s own control ids for the AICM), because most of
        these instruments publish no OSCAL catalog to resolve against.
      </p>
    </section>

    <section class="res-section" aria-labelledby="cw-topics-heading">
      <div class="res-section-head">
        <h2 id="cw-topics-heading">By topic</h2>
        <p>Each topic, its summary and stack layers, then every mapped reference in full.</p>
      </div>
      {
        matrix.rows.map(({ topic, cells }) => (
          <article id={`topic-${topic.id}`} class="cw-topic" data-cw-topic>
            <h3>{topic.name}</h3>
            <p>{topic.summary}</p>
            {topic.layerN && topic.layerN.length > 0 && (
              <span
                class="ticks ticks--coded"
                role="img"
                aria-label={`Layers ${topic.layerN.join(', ')}`}
              >
                {topic.layerN.map((n) => (
                  <span class="tk-key">
                    <span class="tk" data-l={n} aria-hidden="true" />L{n}
                  </span>
                ))}
              </span>
            )}
            {topic.read && topic.read.length > 0 && (
              <p class="cw-read">
                In the Body of Knowledge:{' '}
                {topic.read.map((r, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={r.href}>{r.label}</a>
                  </>
                ))}
              </p>
            )}
            <ul class="cw-refs">
              {cells.flat().map((r) => (
                <li data-fw={r.framework}>
                  <span
                    class:list={[
                      'cw-chip',
                      r.strength === 'related' && 'is-related',
                      r.verified === false && 'is-unverified',
                    ]}
                    data-strength={r.strength}
                    data-type={frameworkById(r.framework)?.type}
                    title={r.verified === false ? 'Not yet verified against the source' : undefined}
                  >
                    {chipLabel(r)}
                    {r.verified === false ? ' ?' : ''}
                  </span>
                  {r.strength === 'related' && <span class="visually-hidden"> related</span>}
                  {r.verified === false && (
                    <span class="visually-hidden"> not yet verified against the source</span>
                  )}
                  <span class="cw-ref-fw">{frameworkById(r.framework)?.short ?? r.framework}</span>
                  <span class="cw-ref-title">{r.title}</span>
                  {r.note && <span class="cw-ref-note">{r.note}</span>}
                  {r.url && (
                    <a class="cw-ref-link" href={r.url} rel="noopener">
                      Source ↗
                    </a>
                  )}
                  {refObligation(r) && (
                    <a class="cw-ref-oblig" href={obligationPath(refObligation(r)!)}>
                      Obligation page →
                    </a>
                  )}
                  {r.see && (
                    <a class="cw-ref-see" href={r.see}>
                      In the BoK →
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>
  </div>

  <CrosswalkDrawer />

  <script is:inline defer src="/inert.js"></script>
  <script is:inline defer src="/crosswalk.js"></script>
  <script is:inline defer src="/crosswalk-explorer.js"></script>
</Base>

<style>
  /* The topic sections carry over half the page's elements (about 3,500 of
     6,200) and all sit below the fold: the browser skips their style, layout
     and paint until one nears the viewport, which takes the long first layout
     off the load. Each section has a top border and padding, so no margin
     collapses through the containment; the placeholder height is about a
     section's on a desktop (they run 800 to 3,200 px, more on a phone) and
     `auto` keeps the real one once a section has been rendered. Anchors
     (#topic-<id>), find in page and the drawer's clone still reach them. */
  .cw-topic {
    content-visibility: auto;
    contain-intrinsic-size: auto 2000px;
  }
</style>
