---
import Marketing from '../../layouts/Marketing.astro';
import PageHero from '../../components/PageHero.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { site } from '../../data/site';
import { frameworks, obligations } from '../../data/frameworks';
import { topics, columns } from '../../data/crosswalk';
import { toolsByCategory } from '../../data/stack';
import { getReadingList } from '../../lib/reading-list';
import { getGlossary } from '../../lib/glossary';
import { WEBSITE_ID } from '../../lib/jsonld';
import '../../styles/resources.css';
import '../../styles/pages.css';

const tools = toolsByCategory();
const toolCount = tools.reduce((n, group) => n + group.examples.length, 0);
const reading = getReadingList();
const readingCount = reading.reduce((n, group) => n + group.items.length, 0);
const glossaryCount = getGlossary().length;

const cards = [
  {
    index: '01',
    title: 'Frameworks',
    href: '/resources/frameworks',
    swatch: 'var(--l1)',
    description:
      'The laws, standards, codes and control sets the Body of Knowledge maps against, with the obligation → artefact → layer index.',
    count: `${frameworks.length} frameworks · ${obligations.length} obligations`,
  },
  {
    index: '02',
    title: 'Tools',
    href: '/resources/tools',
    swatch: 'var(--l4)',
    description:
      'Reference tool categories for each layer of the stack, with illustrative examples — the substance, not an endorsement of any brand.',
    count: `${toolCount} tools · ${tools.length} categories`,
  },
  {
    index: '03',
    title: 'Reading list',
    href: '/resources/reading-list',
    swatch: 'var(--l5)',
    description:
      'The annotated bibliography that formed the discipline — grouped by theme, each source with a verified URL and a one-line note.',
    count: `${readingCount} sources · ${reading.length} groups`,
  },
  {
    index: '04',
    title: 'Glossary',
    href: '/resources/glossary',
    swatch: 'var(--l3)',
    description:
      'Every term defined once, alphabetically, and cross-referenced to the chapter that treats it in full.',
    count: `${glossaryCount} terms`,
  },
  {
    index: '05',
    title: 'Crosswalk',
    href: '/resources/crosswalk',
    swatch: 'var(--l2)',
    description:
      'One governance topic per row, read across to the EU, ISO, NIST and Chinese instruments that bind it — down to the article, clause or control.',
    count: `${topics.length} topics · ${columns.length} columns`,
  },
  {
    index: '06',
    title: 'The map',
    href: '/map',
    swatch: 'var(--l1)',
    description:
      'The whole discipline on one canvas — every chapter, layer, pattern, obligation and learning stage as a navigable mind map, with the same map as a linked index.',
    count: '8 branches · one page',
  },
];

// The landing is a collection of the six reference pages above; Seo.astro merges
// this node into the page's single ld+json graph.
const resourcesUrl = new URL('/resources', site.url).href;
const jsonLd = {
  '@type': 'CollectionPage',
  '@id': `${resourcesUrl}#page`,
  name: `Resources — ${site.name}`,
  url: resourcesUrl,
  inLanguage: 'en',
  isPartOf: { '@id': WEBSITE_ID },
  hasPart: cards.map((card) => ({
    '@type': 'WebPage',
    name: card.title,
    url: new URL(card.href, site.url).href,
    description: card.description,
  })),
};
---

<Marketing
  title="Resources"
  description="Curated, sourced and versioned resources for AI governance engineering: frameworks, tools, a reading list and a glossary, all from the Body of Knowledge."
  image="/og/resources.png"
  jsonLd={jsonLd}
>
  <PageHero
    variant="res"
    kicker="Resources"
    title="Curated, sourced, versioned."
    lede="Five references drawn straight from the Body of Knowledge: the frameworks the discipline maps against, the tool categories that fill each layer, the sources that formed it, the terms it uses and the crosswalk that maps each topic to every framework."
  >
    <p slot="note">
      Everything here is extracted from the Body of Knowledge v{site.bokVersion} and stays in sync
      with it.
    </p>
  </PageHero>

  <section class="section">
    <div class="container">
      <ul class="bento reveal-stagger rc-bento">
        {
          cards.map((card) => (
            <ResourceCard
              title={card.title}
              href={card.href}
              description={card.description}
              count={card.count}
              index={card.index}
              swatch={card.swatch}
            />
          ))
        }
      </ul>
    </div>
  </section>
</Marketing>

<style>
  /* The hub cards as a bento: the first card (Frameworks) spans two columns,
     and each card enters on its own beat. --i drives .reveal-stagger; the span
     and stagger live here (not on ResourceCard) so they hold whatever markup
     the card renders. */
  .rc-bento > :global(li:nth-child(1)) {
    --i: 0;
  }
  .rc-bento > :global(li:nth-child(2)) {
    --i: 1;
  }
  .rc-bento > :global(li:nth-child(3)) {
    --i: 2;
  }
  .rc-bento > :global(li:nth-child(4)) {
    --i: 3;
  }
  .rc-bento > :global(li:nth-child(5)) {
    --i: 4;
  }
  .rc-bento > :global(li:nth-child(6)) {
    --i: 5;
  }

  @media (min-width: 600px) {
    /* Two columns: the first card and the last (the map) each span both (a full
       row), so the four references between them tile a clean 2×2 — no orphan. */
    .rc-bento > :global(li:first-child),
    .rc-bento > :global(li:nth-child(6)) {
      grid-column: span 2;
    }
  }
</style>
