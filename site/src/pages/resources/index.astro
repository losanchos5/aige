---
import Marketing from '../../layouts/Marketing.astro';
import PageHero from '../../components/PageHero.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { site } from '../../data/site';
import { frameworks, obligations } from '../../data/frameworks';
import { topics, columns } from '../../data/crosswalk';
import { allTools, toolCatalogue } from '../../data/stack';
import { getReadingList } from '../../lib/reading-list';
import { getGlossary } from '../../lib/glossary';
import { harms, levelOrder } from '../../data/harms';
import { cases } from '../../data/cases';
import { clauses, licenceTypes } from '../../data/contracts';
import { kit } from '../../data/templates';
import { getSchemas } from '../../lib/schemas-library';
import { datasets } from '../../lib/api';
import { figures } from '../../data/figures';
import { diagrams } from '../../data/diagrams';
import { tools as toolkitTools } from '../../data/toolkit';
import { countWord } from '../../data/parts';
import { authorRefs, lastModified, ORG_ID, WEBSITE_ID } from '../../lib/jsonld';
import { fitsSiteSuffix } from '../../lib/seo-title';
import '../../styles/resources.css';
import '../../styles/pages.css';

// The catalogue counts every tool once, the curated indexes included, so the
// card matches the lede of /resources/tools.
const toolCount = allTools().length;
const liveToolkit = toolkitTools.filter((tool) => tool.status === 'live').length;
const instrumentCount = new Set(obligations.map((row) => row.frameworkId)).size;
const reading = getReadingList();
const readingCount = reading.reduce((n, group) => n + group.items.length, 0);
const glossaryCount = getGlossary().length;
const schemaCount = getSchemas().length;

// The hub's cards, in reading order: the mapping references first (frameworks,
// the obligation register, the crosswalk), then the harms and the cases that
// test them, the contract and record templates, the figures, the tools and the
// toolkit, the reading list and glossary, the open data behind all of it and
// the map. Every count is computed from the data the page links to; the index
// labels are assigned below from the order.
const entries = [
  {
    title: 'Frameworks',
    href: '/resources/frameworks',
    swatch: 'var(--l1)',
    description:
      'The laws, standards, codes and control sets the Body of Knowledge maps against, with the obligation → artefact → layer index.',
    count: `${frameworks.length} frameworks · ${obligations.length} obligations`,
  },
  {
    title: 'Obligation register',
    href: '/obligations',
    swatch: 'var(--l2)',
    description:
      'Every obligation the book maps, one page each: a stable id, the duty holder, the date it applies from, its status, the artefact that evidences it and its stack layer.',
    count: `${obligations.length} obligation pages · ${instrumentCount} instruments`,
  },
  {
    title: 'Crosswalk',
    href: '/resources/crosswalk',
    swatch: 'var(--l3)',
    description:
      'One governance topic per row, read across to the EU, ISO, NIST and Chinese instruments that bind it, down to the article, clause or control.',
    count: `${topics.length} topics · ${columns.length} columns`,
  },
  {
    title: 'Harms atlas',
    href: '/resources/harms',
    swatch: 'var(--l4)',
    description:
      'AI harms by level, each with its failure mode, the control and layer that catch it, the evidence it leaves and real incident records.',
    count: `${harms.length} harms · ${levelOrder.length} levels`,
  },
  {
    title: 'Cases',
    href: '/cases',
    swatch: 'var(--l5)',
    description:
      'Public AI incidents written as engineering post-mortems: what failed, which control would have caught it and what evidence it would have left.',
    count: `${cases.length} cases`,
  },
  {
    title: 'Contracts',
    href: '/resources/contracts',
    swatch: 'var(--l1)',
    description:
      'AI contract and licence clauses for buyers and deployers: the red flags, the fallback wording to ask for and the evidence to keep.',
    count: `${clauses.length} clauses · ${licenceTypes.length} licence families`,
  },
  {
    title: 'Templates & schemas',
    href: '/resources/templates',
    swatch: 'var(--l5)',
    description:
      'JSON Schemas, filled examples and human templates for the records AI governance produces, each field tagged with the obligations it helps evidence.',
    count: `${schemaCount} schemas · ${kit.length} kit templates`,
  },
  {
    title: 'Figures',
    href: '/figures',
    swatch: 'var(--l2)',
    description:
      'Every infographic and diagram in the book, each with a text alternative, SVG and PNG downloads, an embed snippet and a citation.',
    count: `${figures.length} infographics · ${diagrams.length} diagrams`,
  },
  {
    title: 'Tools',
    href: '/resources/tools',
    swatch: 'var(--l3)',
    description:
      'Tool categories for each layer of the stack, every tool with its licence and access model: examples of the substance, not endorsements of any brand.',
    count: `${toolCount} tools · ${toolCatalogue.length} categories`,
  },
  {
    title: 'Toolkit',
    href: '/toolkit',
    swatch: 'var(--l4)',
    description:
      'Browser tools built from the book that produce documents you keep; nothing you enter leaves your browser. Indicative, not legal advice and not a conformity claim.',
    count: `${liveToolkit} live ${liveToolkit === 1 ? 'tool' : 'tools'} · ${toolkitTools.length} in the registry`,
  },
  {
    title: 'Reading list',
    // The canonical chapter, not /resources/reading-list (its filtered view,
    // which declares the chapter as rel=canonical).
    href: '/bok/reading-list',
    swatch: 'var(--l5)',
    description:
      'The annotated bibliography that formed the discipline, grouped by theme, each source with a verified URL and a one-line note.',
    count: `${readingCount} sources · ${reading.length} groups`,
  },
  {
    title: 'Glossary',
    href: '/bok/glossary',
    swatch: 'var(--l1)',
    description:
      'Every term defined once, each with its own page, and cross-referenced to the chapter that treats it in full.',
    count: `${glossaryCount} terms`,
  },
  {
    title: 'Open data & API',
    href: '/resources/data',
    swatch: 'var(--l2)',
    description:
      'The registers behind these pages as static JSON under /api/v1, each with a JSON Schema, an OpenAPI description and stable ids, free to reuse under CC BY 4.0.',
    count: `${datasets.length} datasets · JSON Schema`,
  },
  {
    title: 'MCP server',
    href: '/mcp',
    swatch: 'var(--l4)',
    description:
      'The same registers inside your AI assistant: a public, read-only Model Context Protocol server that Claude and other clients query directly, every answer with its source page.',
    count: '10 tools · no account',
  },
  {
    title: 'The map',
    href: '/map',
    swatch: 'var(--l3)',
    description:
      'The whole discipline on one canvas: every chapter, layer, pattern, obligation and learning stage as a navigable mind map, with the same map as a linked index.',
    count: '8 branches · one page',
  },
];

// Search title (SXO-R2-07, 2026-09-25 round 2): the query first; the H1 stays.
const seoTitle = 'AI governance resources: frameworks, data, templates';

const cards = entries.map((entry, i) => ({ ...entry, index: String(i + 1).padStart(2, '0') }));
const cardCount = countWord(cards.length);

// The landing is a collection of the reference pages above; Seo.astro merges
// this node into the page's single ld+json graph.
const resourcesUrl = new URL('/resources', site.url).href;
const jsonLd = {
  '@type': 'CollectionPage',
  '@id': `${resourcesUrl}#page`,
  name: `Resources · ${site.name}`,
  url: resourcesUrl,
  inLanguage: 'en',
  isPartOf: { '@id': WEBSITE_ID },
  author: [...authorRefs],
  publisher: { '@id': ORG_ID },
  // The same sources as the sitemap's lastmod (astro.config.ts SOURCE_BY_PATH).
  dateModified: lastModified(
    'src/pages/resources/index.astro',
    'src/data/frameworks.ts',
    'src/data/crosswalk.ts',
    'src/data/harms.ts',
    'src/data/cases.ts',
    'src/data/contracts.ts',
    'src/data/templates.ts',
    'src/data/figures.ts',
    'src/data/stack.ts',
    'src/data/toolkit.ts',
    'src/lib/api.ts',
    'public/schemas',
  ),
  hasPart: cards.map((card) => ({
    '@type': 'WebPage',
    name: card.title,
    url: new URL(card.href, site.url).href,
    description: card.description,
  })),
};
---

<Marketing
  title={seoTitle}
  titleSuffix={fitsSiteSuffix(seoTitle)}
  description="AI governance resources, sourced and versioned: frameworks, the obligation register, crosswalk, harms, cases, templates, figures, tools and open data."
  image="/og/resources.png"
  jsonLd={jsonLd}
>
  <PageHero
    variant="res"
    title="Curated, sourced, versioned."
    lede={`${cardCount[0].toUpperCase()}${cardCount.slice(1)} references drawn straight from the Body of Knowledge: the frameworks the discipline maps against, the obligation register and the crosswalk that reads each topic across them, the harms atlas and the incident cases, contract clauses, templates and schemas for governance records, the figures, the tool categories that fill each layer and the browser toolkit, the sources that formed it, the terms it uses, the open data behind every page and the map that lays the whole discipline on one canvas.`}
  >
    <p slot="note">
      Everything here is extracted from the Body of Knowledge v{site.bokVersion} and stays in sync
      with it. For the field these references serve, start with <a href="/ai-governance"
        >AI governance: definition and frameworks</a
      >.
    </p>
  </PageHero>

  <section class="section">
    <div class="container">
      <ul class="bento reveal-stagger rc-bento">
        {
          cards.map((card) => (
            <ResourceCard
              title={card.title}
              href={card.href}
              description={card.description}
              count={card.count}
              index={card.index}
              swatch={card.swatch}
            />
          ))
        }
      </ul>
    </div>
  </section>
</Marketing>

<style>
  /* The hub cards as a bento: the first card (Frameworks) spans two columns,
     and each card enters on its own beat. --i drives .reveal-stagger; the span
     and stagger live here (not on ResourceCard) so they hold whatever markup
     the card renders. The <ul> drops its bullets and indent (RES-1). */
  .rc-bento {
    list-style: none;
    padding: 0;
  }

  .rc-bento > :global(li:nth-child(1)) {
    --i: 0;
  }
  .rc-bento > :global(li:nth-child(2)) {
    --i: 1;
  }
  .rc-bento > :global(li:nth-child(3)) {
    --i: 2;
  }
  .rc-bento > :global(li:nth-child(4)) {
    --i: 3;
  }
  .rc-bento > :global(li:nth-child(5)) {
    --i: 4;
  }
  .rc-bento > :global(li:nth-child(6)) {
    --i: 5;
  }
  .rc-bento > :global(li:nth-child(7)) {
    --i: 6;
  }
  .rc-bento > :global(li:nth-child(8)) {
    --i: 7;
  }
  .rc-bento > :global(li:nth-child(9)) {
    --i: 8;
  }
  .rc-bento > :global(li:nth-child(10)) {
    --i: 9;
  }
  .rc-bento > :global(li:nth-child(11)) {
    --i: 10;
  }
  .rc-bento > :global(li:nth-child(12)) {
    --i: 11;
  }
  .rc-bento > :global(li:nth-child(13)) {
    --i: 12;
  }
  .rc-bento > :global(li:nth-child(14)) {
    --i: 13;
  }

  @media (min-width: 600px) {
    /* The first card (Frameworks) and the last (the map) each span two tracks.
       With fourteen cards that tiles with no orphan: at two columns they take
       full rows around six pairs; at four columns, 2 + 12 × 1 + 2 = four full
       rows. Keep the card count even when adding one. */
    .rc-bento > :global(li:first-child),
    .rc-bento > :global(li:last-child) {
      grid-column: span 2;
    }
  }
</style>
