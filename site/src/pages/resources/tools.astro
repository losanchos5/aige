---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Callout from '../../components/Callout.astro';
import Diagram from '../../components/Diagram.astro';
import { site } from '../../data/site';
import { layers, toolsByCategory } from '../../data/stack';
import { slugify } from '../../lib/md-parse';
import '../../styles/resources.css';
import '../../styles/pages.css';

const groups = toolsByCategory();

// The representative chapter-05 pattern for each layer, used for the "Patterns
// for this layer" cross-link. The anchor is computed with the same slugger
// rehype-slug uses, so it always matches the built /bok/patterns page.
const layerPattern: Record<number, string> = {
  1: 'Policy Card',
  2: 'Agent Registry',
  3: 'Eval Gate in CI',
  4: 'Kill Switch / Circuit Breaker',
  5: 'Continuous Assurance Telemetry',
};
const patternHref = (name: string) => `/bok/patterns#${slugify(`Pattern: ${name}`)}`;
---

<Base
  title={`Tools · ${site.name}`}
  description="Reference tool categories for each layer of the AI governance engineering stack, with illustrative examples — the substance, not an endorsement of any brand."
  image="/og/resources.png"
>
  <PageHero
    variant="res"
    swatch="var(--l4)"
    crumbs={[{ label: 'Resources', href: '/resources' }, { label: 'Tools' }]}
    title="Tool categories, by layer."
  >
    <p class="lede" slot="lede">
      The reference tool categories that fill each layer of the stack, with the examples the Body
      of Knowledge names. The category is the substance; the brands are illustrative. See how they
      fit together in <a href="/stack">the stack</a>.
    </p>
  </PageHero>

  <div class="container res-page">
    <div class="res-section">
      <Callout kind="note" title="Illustrative, not an endorsement">
        <p>Tools are named as category examples to make the substance concrete. Naming a tool is not
        a recommendation, and the list is neither exhaustive nor current — treat it as a map of the
        category, not a shortlist.</p>
        <p>Tool examples reviewed as of 2026-09-19.</p>
      </Callout>
    </div>

    <section class="res-section" aria-labelledby="tl-heading">
      <div class="res-section-head">
        <h2 id="tl-heading">The five layers</h2>
        <p>Each category is keyed to the layer it serves. The colour ticks throughout follow this
        legend.</p>
      </div>

      <ul class="tl-legend" aria-label="Stack layers">
        {
          layers.map((layer) => (
            <li>
              <span class="tk tk-lg" data-l={layer.n} aria-hidden="true" />
              <span class="tl-ln">L{layer.n}</span>
              <span>{layer.name}</span>
            </li>
          ))
        }
      </ul>

      <Diagram id="reference-toolchain" />

      <ul class="tl-groups">
        {
          groups.map((group) => (
            <li class="tl-group">
              <div class="tl-group-head">
                <h3>{group.category}</h3>
                <span class="ticks" role="img" aria-label={`Layers ${group.layers.join(', ')}`}>
                  {group.layers.map((n) => (
                    <span class="tk" data-l={n} aria-hidden="true" />
                  ))}
                </span>
              </div>
              <ul class="tl-tools">
                {group.examples.map((example) => (
                  <li class="tl-tool" data-tool>
                    <span class="tl-name">{example}</span>
                    <span class="ticks" role="img" aria-label={`Layers ${group.layers.join(', ')}`}>
                      {group.layers.map((n) => (
                        <span class="tk" data-l={n} aria-hidden="true" />
                      ))}
                    </span>
                  </li>
                ))}
              </ul>
              <p class="tl-xref">
                <a href={`/resources/frameworks#ob-layer-${group.layers[0]}`}>
                  Obligations this answers →
                </a>
                <a href={patternHref(layerPattern[group.layers[0]])}>
                  Patterns for this layer →
                </a>
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  /* Reciprocal cross-links in each category card: to the obligations that layer
     answers and to the layer's patterns. */
  .tl-xref {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    margin: var(--s-4) 0 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
  }

  .tl-xref a {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.02em;
    color: var(--ink-2);
    text-decoration: none;
  }

  .tl-xref a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
