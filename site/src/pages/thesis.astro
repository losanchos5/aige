---
import { getEntry, render } from 'astro:content';
import Doc from '../layouts/Doc.astro';
import Diagram from '../components/Diagram.astro';
import SignNote from '../components/SignNote.astro';
import { site } from '../data/site';
import { gitCreated, gitDate } from '../lib/reading';
import { authorNodes, authorRefs, ORG_ID, WEBSITE_ID } from '../lib/jsonld';

const entry = await getEntry('thesis', 'thesis');
if (!entry) {
  throw new Error('thesis collection entry not found');
}
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const title = (remarkPluginFrontmatter.title as string | undefined) ?? 'The AI Governance Engineering Thesis';
const summary =
  (remarkPluginFrontmatter.summary as string | undefined) ??
  'Governance as a system to be built, run and measured — not a document to be signed.';
const editPath = 'THESIS.md';
const updated = gitDate('../THESIS.md');
const signUrl = `${site.github}/edit/main/bok/CONTRIBUTORS.md`;
const issueUrl = `${site.github}/issues/new?template=sign-the-thesis.yml`;

// The Thesis as a TechArticle, dated from the git history of THESIS.md. The
// Person nodes and the Organization / WebSite ids come from lib/jsonld.ts, which
// merges this into the page's single ld+json graph.
const thesisUrl = new URL('/thesis', site.url).href;
const jsonLd = [
  {
    '@type': 'TechArticle',
    '@id': `${thesisUrl}#article`,
    headline: title,
    description: summary,
    url: thesisUrl,
    inLanguage: 'en',
    datePublished: gitCreated('../THESIS.md'),
    dateModified: updated,
    author: [...authorRefs],
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': WEBSITE_ID },
    ...(site.license ? { license: site.license } : {}),
  },
  ...authorNodes,
];
---

<Doc
  title={title}
  summary={summary}
  kicker="The Thesis"
  headings={headings}
  editPath={editPath}
  updated={updated}
  sidebar={false}
  wide={true}
  activeThesis={true}
  image="/og/thesis.png"
  jsonLd={jsonLd}
  alternates={[
    { hreflang: 'en', href: `${site.url}/thesis` },
    { hreflang: 'es', href: `${site.url}/es/thesis` },
    { hreflang: 'x-default', href: `${site.url}/thesis` },
  ]}
>
  <p class="lang-switch"><a href="/es/thesis" hreflang="es" lang="es">Leer en español</a></p>
  <SignNote signUrl={signUrl} issueUrl={issueUrl} />
  <Diagram id="aige-in-the-org" />
  <Content />
</Doc>

<style>
  .lang-switch {
    margin-bottom: var(--s-4);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .lang-switch a {
    color: var(--ink-2);
    font-weight: 600;
  }

  .lang-switch a:hover {
    color: var(--ink);
  }
</style>
