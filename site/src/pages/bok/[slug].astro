---
import { getCollection, render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import AtAGlance from '../../components/AtAGlance.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import PillarLink from '../../components/PillarLink.astro';
import { chaptersOrdered } from '../../data/chapters';
import { site } from '../../data/site';
import { gitCreated, gitDate } from '../../lib/reading';
import {
  authorNodes,
  authorRefs,
  glossaryTermSet,
  ORG_ID,
  WEBSITE_ID,
  workDoi,
} from '../../lib/jsonld';
import { getGlossary, getGlossaryEntry } from '../../lib/glossary';
import { alternatesFor } from '../../lib/i18n-content';

export async function getStaticPaths() {
  const entries = await getCollection('bok');

  // The manifest and the collection must line up 1:1, or the build fails.
  const entryIds = entries.map((entry) => entry.id).sort();
  const manifestIds = chaptersOrdered.map((chapter) => chapter.id).sort();
  const mismatch =
    entryIds.length !== manifestIds.length ||
    entryIds.some((id, i) => id !== manifestIds[i]);
  if (mismatch) {
    throw new Error(
      `bok manifest/collection mismatch.\n  collection: ${entryIds.join(', ')}\n  manifest:   ${manifestIds.join(', ')}`,
    );
  }

  const byId = new Map(entries.map((entry) => [entry.id, entry]));

  return chaptersOrdered.map((chapter, i) => {
    const entry = byId.get(chapter.id);
    if (!entry) {
      throw new Error(`No collection entry for chapter id "${chapter.id}"`);
    }
    return {
      params: { slug: chapter.slug },
      props: {
        entry,
        chapter,
        prev: i > 0 ? chaptersOrdered[i - 1] : undefined,
        next: i < chaptersOrdered.length - 1 ? chaptersOrdered[i + 1] : undefined,
      },
    };
  });
}

const { entry, chapter, prev, next } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const title = (remarkPluginFrontmatter.title as string | undefined) ?? chapter.title;
const summary = (remarkPluginFrontmatter.summary as string | undefined) ?? chapter.summary;
// Search metadata from the chapter's frontmatter (content.config.ts): the query-
// phrased title for <title>, og:title and the article headline, and the meta
// description where the manifest summary misses the query. The H1 keeps `title`.
const seoTitle: string | undefined = entry.data.seoTitle;
const metaDescription = entry.data.seoDescription ?? chapter.summary;
const editPath = `bok/${chapter.id}.md`;
const updated = gitDate(`../${editPath}`);
const published = gitCreated(`../${editPath}`);
// The chapter's own Open Graph card, built by src/pages/og/[...slug].png.ts.
const ogPath = `/og/bok-${chapter.slug}.png`;

// "Key terms in this chapter": each slug in chapters.ts `keyTerms` resolves to
// its glossary entry here, so a typo or a renamed term fails the build instead
// of shipping a link to a missing /glossary page.
const keyTerms = (chapter.keyTerms ?? []).map((slug) => {
  const entry = getGlossaryEntry(slug);
  if (!entry) {
    throw new Error(`chapters.ts: "${chapter.id}" lists key term "${slug}", not in the glossary`);
  }
  return { term: entry.term, url: entry.url, id: entry.id };
});

// Visible breadcrumb: Body of Knowledge › NN · Short title. The full title
// already opens with "NN.", so the crumb uses the short navigation label to
// avoid repeating the number and to stay on one line on a phone. The
// BreadcrumbList JSON-LD is already carried in this page's @graph below, so the
// crumb suppresses its own.
const crumbs = [
  { label: 'Body of Knowledge', href: '/bok' },
  { label: `${String(chapter.order).padStart(2, '0')} · ${chapter.shortTitle}` },
];

// JSON-LD @graph for the chapter. Absolute URLs are built on the site's canonical
// origin with the same technique as Seo.astro (new URL(path, site.url)), using the
// clean, extensionless paths the sitemap and every internal link use (/bok,
// /bok/<slug>) so the graph is internally consistent. The Body of Knowledge landing
// lives at /bok (trailingSlash: 'never'). The Person nodes come from lib/jsonld.ts,
// which keeps them minimal: name plus any known url / sameAs, never jobTitle or
// worksFor. Seo.astro merges this graph with the site-wide Organization / WebSite.
const chapterUrl = new URL(`/bok/${chapter.slug}`, site.url).href;
const bokUrl = new URL('/bok', site.url).href;
const homeUrl = new URL('/', site.url).href;
const bookId = `${bokUrl}#book`;

const book = {
  '@type': 'Book',
  '@id': bookId,
  name: 'AI Governance Engineering: The Thesis and Body of Knowledge',
  url: bokUrl,
  version: site.bokVersion,
  inLanguage: 'en',
  author: [...authorRefs],
  publisher: { '@id': ORG_ID },
  isPartOf: { '@id': WEBSITE_ID },
  // schema.org types `license` as URL|CreativeWork, so link the deed rather than
  // repeating the human-readable "CC BY 4.0" label the page chrome carries.
  ...(site.licenseUrl ? { license: site.licenseUrl } : {}),
  // The Zenodo DOIs (version and concept) and their record pages.
  ...workDoi,
};

const article = {
  '@type': 'TechArticle',
  '@id': `${chapterUrl}#article`,
  headline: seoTitle ?? title,
  url: chapterUrl,
  inLanguage: 'en',
  datePublished: published,
  dateModified: updated,
  image: new URL(ogPath, site.url).href,
  isPartOf: { '@id': bookId },
  author: [...authorRefs],
  // On the article itself too, as the pillar, the comparisons and the cases do.
  publisher: { '@id': ORG_ID },
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  '@id': `${chapterUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Body of Knowledge', item: bokUrl },
    { '@type': 'ListItem', position: 3, name: title, item: chapterUrl },
  ],
};

// The glossary chapter is the book's A-Z index: its graph also states the
// DefinedTermSet that every /glossary/<slug> term page points at (lib/jsonld.ts).
const glossarySet = chapter.slug === 'glossary' ? [glossaryTermSet(getGlossary(), updated)] : [];

// Hub and spoke (SXO-N2): every chapter points at the /ai-governance pillar in
// one line under its header, the anchor varied by part. The definition and the
// glossary already link the pillar from their own text.
const pillarAnchor: Record<string, string> = {
  discipline: 'what AI governance is',
  reference: 'AI governance explained',
  foundations: 'AI governance: definition and frameworks',
  lifecycle: 'the definition of AI governance',
  law: 'what AI governance is and which frameworks shape it',
};
const showPillar = chapter.slug !== 'definition' && chapter.slug !== 'glossary';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [book, article, ...authorNodes, breadcrumb, ...glossarySet],
};
---

<Doc
  title={title}
  seoTitle={seoTitle}
  summary={summary}
  description={metaDescription}
  crumbs={crumbs}
  crumbsJsonLd={false}
  headings={headings}
  prev={prev}
  next={next}
  editPath={editPath}
  slug={chapter.slug}
  updated={updated}
  activeSlug={chapter.slug}
  image={ogPath}
  cite={true}
  jsonLd={jsonLd}
  article={{ publishedTime: `${published}T00:00:00Z`, modifiedTime: `${updated}T00:00:00Z` }}
  alternates={alternatesFor(`/bok/${chapter.slug}`)}
>
  {showPillar && <PillarLink lead="New to the field? Start with" anchor={pillarAnchor[chapter.part]} />}
  <AtAGlance items={chapter.glance} terms={keyTerms} />
  <Content />
  {/* After the sources: the sign-up, out of the search index and of snippets so
      it never shows up as chapter text. Renders nothing without an endpoint. */}
  <div class="chapter-newsletter" data-pagefind-ignore data-nosnippet>
    <NewsletterForm location="chapter" />
  </div>
</Doc>

<style>
  /* A hairline and one --s-7 step set the sign-up apart from the sources list;
     an empty wrapper (no endpoint configured) collapses to nothing. */
  .chapter-newsletter:not(:empty) {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
</style>
