---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { chaptersOrdered } from '../../data/chapters';

export async function getStaticPaths() {
  const entries = await getCollection('bok');

  // The manifest and the collection must line up 1:1, or the build fails.
  const entryIds = entries.map((entry) => entry.id).sort();
  const manifestIds = chaptersOrdered.map((chapter) => chapter.id).sort();
  const mismatch =
    entryIds.length !== manifestIds.length ||
    entryIds.some((id, i) => id !== manifestIds[i]);
  if (mismatch) {
    throw new Error(
      `bok manifest/collection mismatch.\n  collection: ${entryIds.join(', ')}\n  manifest:   ${manifestIds.join(', ')}`,
    );
  }

  const byId = new Map(entries.map((entry) => [entry.id, entry]));

  return chaptersOrdered.map((chapter, i) => {
    const entry = byId.get(chapter.id);
    if (!entry) {
      throw new Error(`No collection entry for chapter id "${chapter.id}"`);
    }
    return {
      params: { slug: chapter.slug },
      props: {
        entry,
        chapter,
        prev: i > 0 ? chaptersOrdered[i - 1] : undefined,
        next: i < chaptersOrdered.length - 1 ? chaptersOrdered[i + 1] : undefined,
      },
    };
  });
}

const { entry, chapter, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${chapter.title} · ${site.name}`} description={chapter.summary}>
  <article class="container chapter">
    <p class="eyebrow">Body of Knowledge · Chapter {String(chapter.order).padStart(2, '0')}</p>
    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="Chapter navigation">
      {
        prev ? (
          <a class="pager-link prev" href={`/bok/${prev.slug}`}>
            <span class="dir">Previous</span>
            <span class="name">{prev.shortTitle}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="pager-link next" href={`/bok/${next.slug}`}>
            <span class="dir">Next</span>
            <span class="name">{next.shortTitle}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  <style>
    .chapter {
      padding-block: var(--s-6) var(--s-8);
    }

    .eyebrow {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      color: var(--muted);
      margin-bottom: var(--s-4);
    }

    .pager {
      display: flex;
      justify-content: space-between;
      gap: var(--s-4);
      margin-top: var(--s-8);
      padding-top: var(--s-5);
      border-top: 1px solid var(--line);
    }

    .pager-link {
      display: flex;
      flex-direction: column;
      gap: var(--s-1);
      padding: var(--s-3) var(--s-4);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      text-decoration: none;
      color: var(--ink);
      transition: border-color var(--dur) var(--ease);
    }

    .pager-link:hover {
      border-color: var(--ink-2);
    }

    .pager-link.next {
      text-align: right;
      margin-left: auto;
    }

    .dir {
      font-size: 0.8125rem;
      color: var(--muted);
    }

    .name {
      font-family: var(--font-display);
      font-weight: 600;
    }
  </style>
</Base>
