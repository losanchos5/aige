---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import SignNote from '../../components/SignNote.astro';
import { site } from '../../data/site';
import { chaptersOrdered, getChapter } from '../../data/chapters';
import { bookParts, chapterNum, countWord } from '../../data/parts';
import { readingTime } from '../../lib/reading';
import { breadcrumbJsonLd } from '../../lib/breadcrumbs';
import { alternatesFor } from '../../lib/i18n-content';

const entries = await getCollection('bok');
const minutes = new Map(entries.map((entry) => [entry.id, readingTime(entry.body ?? '')]));

const preface = getChapter('00-preface');
const intro =
  preface?.summary ??
  'The founding text and working reference for engineering the governance of AI systems.';

const signUrl = `${site.github}/edit/main/bok/CONTRIBUTORS.md`;
const issueUrl = `${site.github}/issues/new?template=sign-the-thesis.yml`;

// Counts and part names come from the data (chapters.ts via parts.ts), never
// typed here, so a new chapter or part updates the copy with no edit.
const chapterCount = chaptersOrdered.length;
const partsWord = countWord(bookParts.length);

// Its own meta description: without one the landing fell back to the site-wide
// default, which every other page already carries. Restates the sub-lede below.
const description = `The Body of Knowledge for AI governance engineering: ${chapterCount} chapters in ${partsWord} parts, from the definition to the law. Read them in order or start from a part.`;

// Reading paths by reader (VISUAL-GUIDE §2.3 reading-paths): three routes through
// the book as real links, each reaching into the foundations, lifecycle and law
// parts. Chapter titles come from chapters.ts, looked up by slug so a
// renumbering cannot point a node at the wrong chapter; the newcomer route ends
// in the learning path. Headings and subtitles use the preface's own framing of
// who the book is for.
const bySlug = new Map(chaptersOrdered.map((chapter) => [chapter.slug, chapter]));
const node = (slug: string) => {
  const chapter = bySlug.get(slug);
  if (!chapter) throw new Error(`reading path: no chapter with slug "${slug}"`);
  return {
    href: `/bok/${chapter.slug}`,
    num: chapterNum(chapter.order),
    title: chapter.shortTitle,
  };
};
const readingPaths = [
  {
    heading: 'Building this month',
    sub: 'stop shipping documents, start shipping controls',
    nodes: [
      node('the-stack'),
      node('patterns'),
      node('governing-development'),
      node('governing-deployment'),
      node('incidents'),
    ],
  },
  {
    heading: 'Assuring & advising',
    sub: 'extend the threat model to models and agents',
    nodes: [
      node('risk-management'),
      node('fairness-and-explainability'),
      node('eu-ai-act'),
      node('regulatory-map'),
      node('maturity-model'),
    ],
  },
  {
    heading: 'New to the discipline',
    sub: 'the founding text, in order',
    nodes: [
      node('preface'),
      node('definition'),
      node('ai-defined'),
      node('governance-program'),
      node('the-role'),
    ],
    tail: { href: '/path', title: 'The learning path' },
  },
];
---

<Base
  title="Body of Knowledge"
  description={description}
  image="/og/bok.png"
  jsonLd={breadcrumbJsonLd([{ label: 'Body of Knowledge' }])}
  alternates={alternatesFor('/bok')}
>
  <div class="container bok-index">
    <header class="bok-head">
      <h1>The Body of Knowledge</h1>
      <p class="lede">{intro}</p>
      <p class="sub">
        Version {site.bokVersion}: {chapterCount} chapters in {partsWord} parts, from the
        definition to the law. Read them in order or start from the part you need.
      </p>
      <nav class="part-jump" aria-label="Parts of the book">
        <ol>
          {
            bookParts.map((part) => (
              <li>
                <a href={`#part-${part.id}`}>
                  <span class="pj-title">{part.title}</span>
                  <span class="pj-range">{part.range}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </header>

    {
      bookParts.map((part) => (
        <section class="bok-part" aria-labelledby={`part-${part.id}`}>
          <header class="part-head">
            <h2 id={`part-${part.id}`}>{part.title}</h2>
            <p class="part-range">Chapters {part.range}</p>
            <p class="part-intro">{part.intro}</p>
          </header>
          <ol class="chapter-grid">
            {part.chapters.map((chapter) => (
              <li>
                <a
                  class="chapter-card"
                  href={`/bok/${chapter.slug}`}
                  data-testid="bok-chapter-card"
                >
                  <span class="card-top">
                    <span class="num">{chapterNum(chapter.order)}</span>
                    <span class="time">{minutes.get(chapter.id) ?? 1} min</span>
                  </span>
                  <span class="title">{chapter.shortTitle}</span>
                  <span class="summary">{chapter.summary}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <Figure
      class="reading-paths"
      title="Reading paths"
      caption="Three routes through the Body of Knowledge, one per reader, each reaching into the foundations, the lifecycle and the law. Pick your column and start at its first node. Drawn from chapter 00."
    >
      <div class="rp-cols">
        {
          readingPaths.map((path) => (
            <div class="rp-col">
              <p class="rp-persona">{path.heading}</p>
              <p class="rp-sub">{path.sub}</p>
              <ol class="rp-list">
                {path.nodes.map((n) => (
                  <li>
                    <a href={n.href}>
                      <span class="rp-num">{n.num}</span>
                      <span class="rp-node-title">{n.title}</span>
                    </a>
                  </li>
                ))}
                {path.tail && (
                  <li>
                    <a class="rp-path" href={path.tail.href}>
                      <span class="rp-num">→</span>
                      <span class="rp-node-title">{path.tail.title}</span>
                    </a>
                  </li>
                )}
              </ol>
            </div>
          ))
        }
      </div>
    </Figure>

    <SignNote signUrl={signUrl} issueUrl={issueUrl} />
  </div>

  <style>
    /* The page closes on the sign note's framed box, and the footer opens with
       its own rule, so the two need only one --s-7 between them (the index's
       bottom padding and the footer's 64–128px top margin stacked to ~280px). */
    .bok-index {
      padding-block: var(--s-7) 0;
    }

    .bok-index > :global(:last-child) {
      margin-bottom: 0;
    }

    :global(#main:has(.bok-index) + .site-footer) {
      margin-top: var(--s-7);
    }


    /* Type on this page stays on the token scale, in steps at least 1.25x
       apart: --fs-label for the mono chips, --fs-body for running text,
       --fs-h3 for the lede and card titles, --fs-h1 for the title. */
    /* A long word breaks rather than overflow a phone at 200% text. */
    .bok-head h1 {
      font-family: var(--font-display);
      font-size: var(--fs-h1);
      overflow-wrap: anywhere;
    }

    .lede {
      margin-top: var(--s-4);
      max-width: 60ch;
      font-size: var(--fs-h3);
      color: var(--ink-2);
    }

    .sub {
      margin-top: var(--s-3);
      max-width: 60ch;
      color: var(--muted);
    }

    /* Jump list: one link per part under the header, each with its range. */
    .part-jump ol {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2) var(--s-3);
      margin: var(--s-5) 0 0;
      padding: 0;
    }

    .part-jump a {
      display: inline-flex;
      align-items: center;
      gap: var(--s-2);
      min-height: 44px;
      padding: var(--s-2) var(--s-3);
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      color: var(--ink);
      text-decoration: none;
      font-size: var(--fs-small);
    }

    .part-jump a:hover {
      border-color: var(--ink-2);
    }

    .pj-range {
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      color: var(--ink-2);
    }

    /* One section per part: its heading, range and introduction over the
       part's chapter cards. The heading clears the sticky header on a jump. */
    .bok-part {
      margin-top: var(--s-7);
    }

    .part-head h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: var(--fs-h2);
      scroll-margin-top: var(--anchor-offset);
    }

    .part-range {
      margin-top: var(--s-2);
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      color: var(--ink-2);
    }

    .part-intro {
      margin-top: var(--s-2);
      max-width: 60ch;
      color: var(--ink-2);
    }

    .chapter-grid {
      list-style: none;
      margin: var(--s-5) 0 0;
      padding: 0;
      display: grid;
      gap: var(--s-4);
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    }

    .chapter-card {
      display: flex;
      flex-direction: column;
      gap: var(--s-2);
      height: 100%;
      padding: var(--s-4);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      text-decoration: none;
      color: var(--ink);
      background: var(--surface);
      transition:
        border-color var(--dur) var(--ease),
        transform var(--dur) var(--ease);
    }

    .chapter-card:hover {
      border-color: var(--ink-2);
      transform: translateY(-2px);
    }

    .card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* The chapter number is a neutral chip: a chapter is not a stack layer,
       so it takes no layer colour (audit SL-06). */
    .num {
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      font-weight: 600;
      padding: var(--s-1) var(--s-2);
      border-radius: var(--r-sm);
      background: var(--tint-bg);
      color: var(--ink-2);
    }

    .time {
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      color: var(--muted);
    }

    .title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: var(--fs-h3);
      line-height: 1.2;
      margin-top: var(--s-1);
    }

    .summary {
      color: var(--ink-2);
      font-size: var(--fs-body);
      line-height: 1.5;
    }
  </style>
</Base>
