    publisher: 'ISACA',
    date: CHECKED,
    url: 'https://www.isaca.org/credentialing/aaism',
    verified: 'primary',
  },
  {
    title: 'Advanced in AI Audit (AAIA)',
    gloss:
      'candidates must hold an active CISA or a qualified designation from a published list (including CIA and several national CPA credentials); three domains: AI governance and risk, AI operations, AI auditing tools and techniques',
    publisher: 'ISACA',
    date: CHECKED,
    url: 'https://www.isaca.org/credentialing/aaia',
    verified: 'primary',
  },
  {
    title: 'Regulation (EU) 2024/1689 (Artificial Intelligence Act), Art. 4, consolidated text as amended by Regulation (EU) 2026/1744',
