---
/**
 * /for/certifications: a neutral overview of the personal certifications that
 * bear on AI governance work (AIGP, ISO/IEC 42001 Lead Implementer and Lead
 * Auditor, ISACA AAISM and AAIA): who owns each scheme, what the owner says it
 * assesses, and how this body of knowledge relates to each. Only facts read on
 * the scheme owners' own pages, the standards bodies and EUR-Lex on 2026-09-24,
 * each with a numbered source. No ranking, no recommendation, no study
 * material. It follows chapter 06's critique of certifications as a proxy for
 * capability and chapter 07's account of what an organisation's ISO/IEC 42001
 * certificate proves.
 */
import Doc from '../../layouts/Doc.astro';
import SourceList from '../../components/SourceList.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import { aigpBok, aigpDomains, aigpIndicators, rangeText } from '../../data/aigp';
import { gitDate } from '../../lib/reading';
import type { Source } from '../../lib/sources';
import '../../styles/resources.css';
import '../../styles/aigp.css';

const CHECKED = '2026-09-24';

// Numbered sources in the house format; [n] in the text links #src-n.
const sources: Source[] = [
  {
    title: 'AIGP Body of Knowledge and Exam Blueprint, version 2.1',
    gloss:
      'Certified AI Governance Professional; four domains with minimum and maximum exam questions; competencies and performance indicators; questions mostly at the remember/understand and apply/analyse levels of Bloom\'s taxonomy; the EU AI Act and the South Korean AI Basic Law named as examples; approved 9 Sep 2025, effective 2 Feb 2026, supersedes 2.0.1',
    publisher: 'IAPP',
    date: aigpBok.effective,
