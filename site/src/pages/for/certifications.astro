const cite = (n: number) => `#src-${n}`;

// "Two kinds of certificate" as two parallel lanes, one per object certified,
// with the standard each certifying body works to. Only what the page states,
// with its source numbers: a person's certificate (scheme owner, assessment,
// ISO/IEC 17024 [4]) against an organisation's AIMS certificate (external
// certification body [3], ISO/IEC 42006 on ISO/IEC 17021-1 [5], audit against
// ISO/IEC 42001 [6], no presumption of AI Act conformity, chapter 07).
const certificateLanes = [
  {
    key: 'person',
    object: 'The person',
    title: 'Certificate of a person',
    // An option, not a rule: a person-certifying body can work to 17024, and
    // not every scheme is accredited under it (AIGP is not [2]).
    standardsLabel: 'Standard a body can work to',
    standards: [{ name: 'ISO/IEC 17024', source: 4 }],
    steps: [
      { label: 'Scheme owner', sub: 'sets the assessment against a blueprint it revises' },
      { label: 'Assessment', sub: 'a person passes it' },
      { label: 'Personal certificate', sub: 'knowledge at a point in time, not a working control' },
    ],
  },
  {
    key: 'organisation',
    object: 'The organisation',
    title: 'Certificate of a management system',
    standardsLabel: 'Standard for the body',
    standards: [
      { name: 'ISO/IEC 42006', source: 5 },
      { name: 'ISO/IEC 17021-1', source: 5 },
    ],
    steps: [
      { label: 'Certification body', sub: 'external: ISO issues no certificates' },
      { label: 'AIMS audit', sub: "against ISO/IEC 42001, of the organisation's AI management system" },
      { label: 'AIMS certificate', sub: 'evidences a management system; no presumption of AI Act conformity' },
    ],
  },
];

const headings = [
  { depth: 2, slug: 'how-to-read-this-page', text: 'How to read this page' },
  { depth: 2, slug: 'two-kinds-of-certificate', text: 'Two kinds of certificate' },
  { depth: 2, slug: 'at-a-glance', text: 'At a glance' },
  { depth: 2, slug: 'aigp', text: 'AIGP (IAPP)' },
  {
    depth: 2,
    slug: 'isoiec-42001-lead-implementer-and-lead-auditor',
    text: 'ISO/IEC 42001 Lead Implementer and Lead Auditor',
  },
  { depth: 2, slug: 'aaism', text: 'AAISM (ISACA)' },
  { depth: 2, slug: 'aaia', text: 'AAIA (ISACA)' },
  {
    depth: 2,
    slug: 'what-a-certificate-shows',
    text: 'What a certificate shows, and what it does not',
  },
  { depth: 2, slug: 'sources', text: 'Sources' },
];

const indicatorCount = aigpIndicators().length;
const competencyCount = aigpDomains.reduce((n, d) => n + d.competencies.length, 0);

const title = 'Certifications, neutrally';
const summary =
  'Who owns each AI governance certification, what the owner says it assesses, and how this open body of knowledge relates to it: facts checked on 24 Sep 2026, no ranking.';
// The search title answers the comparison query (SXO-05, 2026-09-25 audit);
// the H1 keeps the page's own title.
const seoTitle = 'AI governance certifications compared: AIGP, ISO 42001';
const description =
  'AI governance certifications compared: AIGP, ISO/IEC 42001 Lead Implementer and Auditor, ISACA AAISM and AAIA, and what each owner says it assesses.';
const updated = gitDate('src/pages/for/certifications.astro');
---

<Doc
  title={title}
  seoTitle={seoTitle}
  summary={summary}
  description={description}
  crumbs={[{ label: 'For you', href: '/for' }, { label: 'Certifications' }]}
  headings={headings}
  updated={updated}
  sidebar={false}
  image="/og/resources.png"
>
  <h2 id="how-to-read-this-page">How to read this page</h2>
  <p>
    Five personal certifications bear on AI governance work. This page says who owns each scheme,
    what the owner says it assesses, and how this body of knowledge relates to it. Every fact comes
    from the scheme owner's own material, a standards body or EUR-Lex, read on 24 Sep 2026, and
    carries a numbered source. The page does not rank the schemes, recommend one, or offer study
    material. Schemes change (the AIGP blueprint, for one, is reviewed every year<sup
      ><a class="cite" href={cite(1)}>1</a></sup
    >), so check the owner's page before you rely on a detail. For the field these schemes assess,
    see <a href="/ai-governance">AI governance, defined</a>.
  </p>
  <p>
    <strong
      >AIGP is a registered trademark of the IAPP. AAISM and AAIA are trademarks of ISACA. This site
      is not affiliated with or endorsed by the IAPP, ISACA, ISO, IEC or any certification body named
      here.</strong
    >
  </p>

  <h2 id="two-kinds-of-certificate">Two kinds of certificate</h2>
  <figure class="cert-lanes" id="certificate-lanes">
    <div class="cert-grid">
      {
        certificateLanes.map((lane) => (
          <div class="cert-lane" data-lane={lane.key}>
            <p class="cert-object">
              <svg class="cert-glyph" viewBox="0 0 24 24" aria-hidden="true">
                {lane.key === 'person' ? (
                  <>
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 21a8 7 0 0 1 16 0" />
                  </>
                ) : (
                  <>
                    <path d="M4 21V5l8-3 8 3v16" />
                    <path d="M9 21v-5h6v5M8 9h2M14 9h2M8 13h2M14 13h2" />
                  </>
                )}
              </svg>
              {lane.object}
            </p>
            <FlowDiagram steps={lane.steps} title={lane.title} />
            <p class="cert-standards">
              <span class="cert-standards-label">{lane.standardsLabel}</span>
              {lane.standards.map((standard) => (
                <span class="cert-standard">
                  {standard.name}
                  <sup><a class="cite" href={cite(standard.source)}>{standard.source}</a></sup>
                </span>
              ))}
            </p>
          </div>
        ))
      }
    </div>
    <p class="cert-trap">
      <span class="cert-trap-label">Easy to confuse</span>
      Some personal schemes carry the standard's name: an ISO/IEC 42001 Lead Implementer or Lead
      Auditor certificate is a certificate of a person, not of a management system.
    </p>
    <figcaption class="cert-cap">
      <span class="cert-cap-title">Two kinds of certificate</span>
      <span class="cert-cap-desc">
        Who certifies what, and to which standard: a person passes a scheme owner's assessment, while
        a certification body audits an organisation's AI management system against ISO/IEC 42001.
        Check which of the two a certificate names before you rely on it.
      </span>
    </figcaption>
  </figure>
  <p>
    A <strong>certificate of a person</strong> says that someone passed an assessment set by a
    scheme owner. A <strong>certificate of a management system</strong> says that a certification
    body audited an organisation's AI management system (AIMS) against ISO/IEC 42001<sup
      ><a class="cite" href={cite(6)}>6</a></sup
    >. The two are easy to confuse, because some personal schemes carry the standard's name.
  </p>
  <p>
    ISO does not perform certification or issue certificates; external certification bodies
    do<sup><a class="cite" href={cite(3)}>3</a></sup>. Bodies that certify persons can work to ISO/IEC
    17024, whose 2026 edition replaced the 2012 one<sup><a class="cite" href={cite(4)}>4</a></sup>;
    bodies that audit and certify an AIMS against ISO/IEC 42001 work to ISO/IEC 42006:2025, which
    builds on ISO/IEC 17021-1<sup><a class="cite" href={cite(5)}>5</a></sup>. What an organisation's
    42001 certificate proves, and what it does not, is set out in <a
      href="/bok/maturity-model#how-this-relates-to-certification-and-other-assessments"
      >chapter 07</a
    >: it evidences a management system and confers no presumption of conformity with the EU AI
    Act.
  </p>

  <h2 id="at-a-glance">At a glance</h2>
  <div class="res-tablewrap">
    <table class="res-table ag-cert-table">
      <caption class="visually-hidden">
        Five personal certifications: owner, what the owner says each assesses, and the closest part
        of this body of knowledge
      </caption>
      <thead>
        <tr>
          <th scope="col">Scheme</th>
          <th scope="col">Owner</th>
          <th scope="col">What the owner says it assesses</th>
          <th scope="col">Closest part of this body of knowledge</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Scheme"><a href="#aigp">AIGP</a></td>
          <td data-label="Owner">IAPP</td>
          <td data-label="Assesses">
            Knowledge across four domains: foundations of AI governance; laws, standards and
            frameworks; governing development; governing deployment and use<sup
              ><a class="cite" href={cite(1)}>1</a></sup
            >
          </td>
          <td data-label="Closest part">
            All four parts; indicator by indicator in the <a href="/for/aigp">AIGP coverage map</a>
          </td>
        </tr>
        <tr>
          <td data-label="Scheme">
            <a href="#isoiec-42001-lead-implementer-and-lead-auditor"
              >ISO/IEC 42001 Lead Implementer</a
            >
          </td>
          <td data-label="Owner">The issuing body (for example, PECB)</td>
          <td data-label="Assesses">
            Planning, implementing and improving an AIMS based on ISO/IEC 42001, after a course and
            an exam<sup
              ><a class="cite" href={cite(7)}>7</a></sup
            >
          </td>
          <td data-label="Closest part">
            <a href="/bok/governance-program">Chapter 12</a> and the management-system trio in <a
              href="/bok/principles-and-standards#the-management-system-trio">chapter 22</a
            >
          </td>
        </tr>
        <tr>
          <td data-label="Scheme">
            <a href="#isoiec-42001-lead-implementer-and-lead-auditor">ISO/IEC 42001 Lead Auditor</a
            >
          </td>
          <td data-label="Owner">The issuing body (for example, PECB)</td>
          <td data-label="Assesses">
            Auditing organisations against ISO/IEC 42001, after a course and an exam<sup
              ><a class="cite" href={cite(8)}>8</a></sup
            >
          </td>
          <td data-label="Closest part">
            <a href="/bok/governance-program#what-internal-audit-tests">What internal audit tests</a
            > and <a href="/bok/governing-deployment#an-audit-programme-not-an-audit"
              >an audit programme</a
            >
          </td>
        </tr>
        <tr>
          <td data-label="Scheme"><a href="#aaism">AAISM</a></td>
          <td data-label="Owner">ISACA</td>
          <td data-label="Assesses">
            AI security management: governance and program management, risk management, and AI
            technologies and controls<sup><a class="cite" href={cite(9)}>9</a></sup>
          </td>
          <td data-label="Closest part">
            Layers 03 and 04 of <a href="/bok/the-stack">the stack</a> and <a
              href="/bok/governing-agents">governing agents</a
            >
          </td>
        </tr>
        <tr>
          <td data-label="Scheme"><a href="#aaia">AAIA</a></td>
          <td data-label="Owner">ISACA</td>
          <td data-label="Assesses">
            AI audit: governance and risk, AI operations, and auditing tools and techniques<sup
              ><a class="cite" href={cite(10)}>10</a></sup
            >
          </td>
          <td data-label="Closest part">
            Layer 05 of <a href="/bok/the-stack">the stack</a> and <a href="/bok/incidents"
              >incidents</a
            >
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    Mappings are illustrative, not a claim of conformity or of equivalence: reading a chapter does
    not earn a credential, and a credential does not cover the chapter.
  </p>

  <h2 id="aigp">AIGP (IAPP)</h2>
  <p>
    The IAPP's Certified AI Governance Professional is examined against the AIGP Body of Knowledge
    and Exam Blueprint. Version {aigpBok.version} was approved on 9 Sep 2025, took effect on 2 Feb
    2026 and replaced version {aigpBok.supersedes}. It has four domains, each with a minimum and
    maximum number of exam questions ({
      aigpDomains.map((d) => `Domain ${d.code}, ${rangeText(d.questions)}`).join('; ')
    }), and {competencyCount} competencies; by our count it lists {indicatorCount} performance
    indicators. It says its questions mostly sit at the remember and understand, and apply and
    analyse, levels of Bloom's taxonomy, and names the EU AI Act and the South Korean AI Basic Law
    among the AI laws it covers<sup><a class="cite" href={cite(1)}>1</a></sup>.
  </p>
  <p>
    The IAPP's candidate handbook says its exams are multiple choice, with one or more correct
    answers and some questions set on a scenario; that its core exams are scored from 100 to 500,
    with 300 to pass; that about 10% to 15% of exam content changes each year, with changes to a
    body of knowledge announced at least 90 days ahead; and that a certification is in good standing only
    with IAPP membership or a maintenance fee. It lists CIPP/E, CIPP/US, CIPM and CIPT as accredited
    by ANAB under ISO/IEC 17024:2012, and says AIGP is not accredited by ANAB<sup
      ><a class="cite" href={cite(2)}>2</a></sup
    >.
  </p>
  <p>
    <strong>How this body of knowledge relates.</strong> The two overlap heavily in topic and differ
    in purpose. The blueprint states what is examined; this book is built around what a governance
    function runs and the evidence it leaves, so its chapters end in artefacts: a registry entry, a
    gate, a template, a record. The <a href="/for/aigp">AIGP coverage map</a> lays the blueprint's
    indicators over the chapters, one by one, and says where the book is only partly there. It is
    a coverage map of an open body of knowledge, not exam preparation.
  </p>

  <h2 id="isoiec-42001-lead-implementer-and-lead-auditor">
    ISO/IEC 42001 Lead Implementer and Lead Auditor
  </h2>
  <p>
    These titles name personal certificates, not the certification of an organisation. Because ISO
    issues no certificates<sup><a class="cite" href={cite(3)}>3</a></sup>, each scheme belongs to
    the body that runs it, with its own course, exam and conditions. One example: PECB offers an
    ISO/IEC 42001 Lead Implementer credential and an ISO/IEC 42001 Lead Auditor credential, each
    after a training course and an exam, and describes the second as expertise in auditing
    organisations against ISO/IEC 42001<sup><a class="cite" href={cite(7)}>7</a></sup><sup
      ><a class="cite" href={cite(8)}>8</a></sup
    >. It is cited as an example of the category, not an endorsement. Two credentials with the same
    title can differ, so compare the scheme documents, not the name.
  </p>
  <p>
    <strong>How this body of knowledge relates.</strong> The standard itself is covered in <a
      href="/bok/principles-and-standards#the-management-system-trio">chapter 22</a
    > (with 42005 and 42006) and <a href="/bok/regulatory-map#isoiec-42001-42005-and-42006"
      >chapter 08</a
    >; the organisation that runs an AIMS, from the committee to management review, in <a
      href="/bok/governance-program">chapter 12</a
    >; and what a 42001 audit can and cannot see, in <a
      href="/bok/maturity-model#how-this-relates-to-certification-and-other-assessments"
      >chapter 07</a
    >. For the auditor's side, read <a href="/bok/governance-program#what-internal-audit-tests"
      >what internal audit tests</a
    > and <a href="/bok/governing-deployment#an-audit-programme-not-an-audit"
      >an audit programme, not an audit</a
    >; the <a href="/patterns/machine-readable-evidence-oscal">Machine-Readable Evidence (OSCAL)</a>
    pattern is how the evidence reaches an auditor as data.
  </p>

  <h2 id="aaism">AAISM (ISACA)</h2>
  <p>
    ISACA's Advanced in AI Security Management is open to candidates who hold an active CISM or
    CISSP. ISACA lists three practice areas: AI governance and program management, AI risk
    management, and AI technologies and controls. The exam is computer-based, at a test centre or
    remotely proctored<sup><a class="cite" href={cite(9)}>9</a></sup>.
  </p>
  <p>
    <strong>How this body of knowledge relates.</strong> AI security engineering is this
    discipline's sibling, not the discipline itself (see <a
      href="/bok/definition#the-disambiguation-cluster">the disambiguation cluster</a
    >). The overlap sits in Layers 03 and 04 of <a href="/bok/the-stack">the stack</a>, in <a
      href="/bok/governing-agents">governing agents</a
    > (identity, tool permissions, runtime guardrails, the kill switch) and in patterns such as the <a
      href="/patterns/adversarial-red-team-suite">Adversarial Red-Team Suite</a
    > and the <a href="/patterns/runtime-guardrail">Runtime Guardrail</a>.
  </p>

  <h2 id="aaia">AAIA (ISACA)</h2>
  <p>
    ISACA's Advanced in AI Audit is open to candidates who hold an active CISA or a qualified
    designation from a published list, which includes CIA and several national CPA credentials.
    ISACA lists three domains: AI governance and risk, AI operations, and AI auditing tools and
    techniques<sup><a class="cite" href={cite(10)}>10</a></sup>.
  </p>
  <p>
    <strong>How this body of knowledge relates.</strong> An auditor reads what Layer 05 of <a
      href="/bok/the-stack">the stack</a
    > produces: <a href="/patterns/continuous-assurance-telemetry">continuous assurance telemetry</a
    >, <a href="/patterns/machine-readable-evidence-oscal">machine-readable evidence</a> and the
    records in <a href="/resources/templates">the templates and schemas</a>. <a
      href="/bok/governance-program#the-three-lines-applied-to-ai">The three lines applied to AI</a
    > places internal audit in the programme, and <a
      href="/bok/incidents#capa-from-incident-to-risk-register-and-eval-suite">CAPA</a
    > shows how a failure becomes a corrective and preventive action, a regression eval and a risk
    register change.
  </p>

  <h2 id="what-a-certificate-shows">What a certificate shows, and what it does not</h2>
  <p>
    A personal certificate shows that its holder passed an assessment of knowledge at a point in
    time, against a blueprint the owner revises. It does not show that an eval gate blocks a build,
    that the registry is true on any Tuesday, or that evidence is machine-readable. That is the
    argument of <a href="/bok/the-role#what-employers-get-wrong-in-the-job-description"
      >chapter 06</a
    >: descriptions list certifications as if a certificate produced a control. Ask for the
    workflow first, then the certificate if it helps.
  </p>
  <p>
    No certificate is a legal requirement for AI literacy under the EU AI Act. Article 4 asks
    providers and deployers to take measures to support the development of AI literacy of their
    staff and others dealing with AI systems on their behalf, without requiring them to guarantee
    any specific level for any individual<sup
      ><a class="cite" href={cite(11)}>11</a></sup
    >, and the Commission's questions and answers say no certificate is needed and an internal
    record of trainings will do<sup><a class="cite" href={cite(12)}>12</a></sup>. How to run that
    record as code is in <a href="/bok/governance-program#ai-literacy-as-code">chapter 12</a>.
  </p>

