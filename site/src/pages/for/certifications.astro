    publisher: 'Publications Office of the EU (EUR-Lex)',
    date: '2026-07-27',
    url: 'https://eur-lex.europa.eu/eli/reg/2024/1689/2026-07-27/eng#art_4',
    verified: 'primary',
  },
  {
