---
import Doc from '../../layouts/Doc.astro';
import Diagram from '../../components/Diagram.astro';
import { site } from '../../data/site';
import { gitCreated, gitDate } from '../../lib/reading';
import { authorNodes, authorRefs, ORG_ID, WEBSITE_ID } from '../../lib/jsonld';
import { breadcrumbJsonLd } from '../../lib/breadcrumbs';
// THESIS.es.md sits at the repo root, next to THESIS.md. Imported directly so it
// goes through the same Astro Markdown pipeline (remark-lead, callouts, citations,
// diagrams, glossary) that the content collection applies to the English thesis,
// keeping this page's rendering identical to /thesis.
import { Content, getHeadings, frontmatter } from '../../../../THESIS.es.md';

const headings = getHeadings();
const title = (frontmatter.title as string | undefined) ?? 'La Tesis de la Ingeniería de Gobernanza de IA';
const summary =
  (frontmatter.summary as string | undefined) ??
  'La gobernanza como un sistema que se construye, se ejecuta y se mide, no un documento que se firma.';
const updated = gitDate('../THESIS.es.md');
const published = gitCreated('../THESIS.es.md');
const signUrl = `${site.github}/blob/main/bok/CONTRIBUTORS.md`;
// Meta description, in Spanish and to the snippet budget: the same claims the
// opening paragraph makes (política ejecutable, control en el pipeline, evidencia
// como subproducto de la construcción). The visible lede stays as it is.
const metaDescription =
  'La gobernanza como un sistema que se construye, se ejecuta y se mide: política ejecutable, control en el pipeline y evidencia producida al construir.';

// Same TechArticle as /thesis, in Spanish: `inLanguage: 'es'`, and a translation
// of the English original (`translationOfWork`). Dates come from the git history
// of THESIS.es.md, so the two pages are dated independently.
const thesisUrl = new URL('/es/thesis', site.url).href;
const jsonLd = [
  {
    '@type': 'TechArticle',
    '@id': `${thesisUrl}#article`,
    headline: title,
    description: summary,
    url: thesisUrl,
    inLanguage: 'es',
    datePublished: published,
    dateModified: updated,
    image: new URL('/og/thesis.png', site.url).href,
    author: [...authorRefs],
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': WEBSITE_ID },
    translationOfWork: { '@id': `${new URL('/thesis', site.url).href}#article` },
    // URL, not the "CC BY 4.0" label: schema.org types `license` as URL|CreativeWork.
    ...(site.licenseUrl ? { license: site.licenseUrl } : {}),
  },
  ...authorNodes,
  breadcrumbJsonLd([{ label: 'La Tesis' }]),
];
---

<Doc
  title={title}
  summary={summary}
  description={metaDescription}
  kicker="La Tesis"
  headings={headings}
  editPath="THESIS.es.md"
  updated={updated}
  sidebar={false}
  wide={true}
  activeThesis={true}
  image="/og/thesis.png"
  jsonLd={jsonLd}
  article={{ publishedTime: `${published}T00:00:00Z`, modifiedTime: `${updated}T00:00:00Z` }}
  lang="es"
  locale="es_ES"
  alternates={[
    { hreflang: 'en', href: `${site.url}/thesis` },
    { hreflang: 'es', href: `${site.url}/es/thesis` },
    { hreflang: 'x-default', href: `${site.url}/thesis` },
  ]}
>
  <div class="thesis-es">
    <p class="lang-switch">
      <a href="/thesis">Read in English</a>
    </p>
    <aside class="sign-note">
      <p>
        Este es un documento vivo. <a href={signUrl} target="_blank" rel="noopener noreferrer">Fírmalo</a>
        añadiendo tu nombre en un pull request a <code>bok/CONTRIBUTORS.md</code>.
      </p>
    </aside>
    <Diagram id="aige-in-the-org" />
    <Content />
  </div>
</Doc>

<style>
  .lang-switch {
    margin-bottom: var(--s-4);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .lang-switch a {
    color: var(--ink-2);
    font-weight: 600;
  }

  .lang-switch a:hover {
    color: var(--ink);
  }

  .sign-note {
    margin-bottom: var(--s-5);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--l5) 40%, var(--bg));
    font-size: 0.9375rem;
  }

  .sign-note p {
    color: var(--ink-2);
  }

  .sign-note a {
    color: var(--ink);
    font-weight: 600;
  }
</style>
