---
// /controls/evaluation-environment: STUB of the Evaluation Environment Control
// Profile (block orp-shell, open reference project). It carries the final title
// and description and every anchor other pages link to: scope,
// how-to-read-a-control, one section per control (aige-ctl-eval-001..009),
// mappings, open-questions, changelog, sources, machine-readable and review.
// Block orp-controls-pages deletes this file and renders the profile from the
// control registry through src/pages/controls/[profile].astro.
import Marketing from '../../layouts/Marketing.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import { site } from '../../data/site';
import { breadcrumbJsonLd } from '../../lib/breadcrumbs';
import { authorRefs, ORG_ID, WEBSITE_ID } from '../../lib/jsonld';
import { fitsSiteSuffix } from '../../lib/seo-title';
import '../../styles/pages.css';

const seoTitle = 'AI evaluation environment controls';
const description =
  'An open control profile for AI evaluation environments: isolation, tool access, telemetry and evidence requirements. Draft v0.1.';
const crumbs = [
  { label: 'Open control profiles', href: '/controls' },
  { label: 'Evaluation environment' },
];
const pageUrl = new URL('/controls/evaluation-environment', site.url).href;

// The working titles of the nine controls in the approved plan.
const controlTitles = [
  'Authorization Boundary',
  'Network Egress Control',
  'Credential Isolation',
  'Tool and Action Mediation',
  'Monitoring Integrity',
  'Stop Conditions',
  'Incident Evidence Preservation',
  'Harness and Configuration Attestation',
  'Evaluation Validity Checks',
];
const controls = controlTitles.map((title, i) => {
  const num = String(i + 1).padStart(3, '0');
  return { id: `AIGE-CTL-EVAL-${num}`, anchor: `aige-ctl-eval-${num}`, title };
});

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${pageUrl}#page`,
    name: seoTitle,
    description,
    url: pageUrl,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    publisher: { '@id': ORG_ID },
    author: [...authorRefs],
  },
  breadcrumbJsonLd(crumbs),
];
---

<Marketing
  title={seoTitle}
  titleSuffix={fitsSiteSuffix(seoTitle)}
  description={description}
  image="/og/controls.png"
  jsonLd={jsonLd}
>
  <PageHero
    variant="res"
    crumbs={crumbs}
    title="Evaluation Environment Control Profile"
    lede="Draft v0.1, open for technical review. This page is being prepared; the draft profile is published in the next release."
  />

  <Section tone="plain" id="scope" title="Scope">
    <p><!-- orp-stub -->
      The profile covers the environment an AI system is evaluated in: the harness, the tools,
      the credentials, the network and the records a run leaves. Illustrative, not a claim of
      conformity.
    </p>
  </Section>

  <Section tone="tint" id="how-to-read-a-control" title="How to read a control">
    <p>Each control will state its objective, failure modes, enforcement points, verification and evidence.</p>
  </Section>

  {
    controls.map((control, i) => (
      <Section tone={i % 2 === 0 ? 'plain' : 'tint'} id={control.anchor} title={`${control.id} ${control.title}`}>
        <p>This control is being drafted; its record is published with the profile in the next release.</p>
      </Section>
    ))
  }

  <Section tone="plain" id="mappings" title="Mappings">
    <p>The mapping of each control to obligations, ISO/IEC 42001, the NIST AI RMF and OWASP is published with the profile.</p>
  </Section>

  <Section tone="tint" id="open-questions" title="Open questions">
    <p>The questions this draft leaves open are listed here with the profile.</p>
  </Section>

  <Section tone="plain" id="changelog" title="Changelog">
    <p>Version 0.1 of this profile is in preparation and has not been published yet.</p>
  </Section>

  <Section tone="tint" id="sources" title="Sources">
    <p>The sources behind each control are listed here with the profile.</p>
  </Section>

  <Section tone="plain" id="machine-readable" title="Machine-readable">
    <p>A JSON version of the profile is published with it under the <a href="/resources/data">open data API</a>.</p>
  </Section>

  <Section tone="tint" id="review" title="Review this profile">
    <p>Technical review opens with the first published draft. See <a href="/contribute">how to contribute</a>.</p>
  </Section>
</Marketing>
