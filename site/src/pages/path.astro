---
/**
 * /path: the AI Governance Engineer learning path, roadmap-style. Four stacked
 * stages (foundations → prove it), each a grid of nodes that link back into the
 * Body of Knowledge and out to curated resources. The reader marks each node
 * done / learning / skipped; progress persists per browser. Content comes from
 * src/data/path.ts; the map, drawer and progress live in PathMap / PathDrawer /
 * public/path.js. With no JS every node body is a native <details> and every
 * link is in the DOM. A "By audience" list closes the map: one link per
 * audience hub (src/data/audiences.ts), each of which names the path nodes it
 * starts at, plus the AIGP coverage map for readers studying from the blueprint.
 */
import Marketing from '../layouts/Marketing.astro';
import '../styles/pages.css';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import PathMap from '../components/PathMap.astro';
import PathDrawer from '../components/PathDrawer.astro';
import CtaBand from '../components/CtaBand.astro';
import { stages, nodes, entries, crossStageEdges } from '../data/path';
import { audiences, audiencePath } from '../data/audiences';
import { breadcrumbJsonLd } from '../lib/breadcrumbs';
import { fitsSiteSuffix } from '../lib/seo-title';

// Search title (SXO-N3, 2026-09-25 audit): the query first; the H1 stays.
const seoTitle = 'AI governance learning path: four stages';

const edges = crossStageEdges();

// The key: each kind and state with a small sample drawn in its real node
// treatment (see PathNode.astro): solid ink, plain line + kind pill, dashed
// --ink-2; then filled, dashed over a tint, and struck through.
const legend = [
  {
    title: 'Core',
    description: 'The spine of the path. Work these in order.',
    sample: 'core',
  },
  {
    title: 'Alternative',
    description: 'A swap-in for the core node beside it. Pick the one that fits your stack.',
    sample: 'alternative',
  },
  {
    title: 'Optional',
    description: 'Deepens a stage; safe to skip on a first pass.',
    sample: 'optional',
  },
  {
    title: 'Done',
    description: 'You have worked through it; it counts toward your progress.',
    sample: 'done',
  },
  {
    title: 'Learning',
    description: 'In progress: you have started but not finished.',
    sample: 'learning',
  },
  {
    title: 'Skipped',
    description: 'Not on your route; it drops out of the progress denominator.',
    sample: 'skipped',
  },
];
---

<Marketing
  title={seoTitle}
  titleSuffix={fitsSiteSuffix(seoTitle)}
  description="AI governance learning path in four stages, from foundations to proof: each stage a grid of nodes linking into the Body of Knowledge, its tools and its reading."
  image="/og/path.png"
  jsonLd={breadcrumbJsonLd([{ label: 'The learning path' }])}
>
  <PageHero
    variant="page"
    title="Learn the role, one stage at a time."
    lede="A build order for the AI Governance Engineer: four stages from foundations to proof, each a grid of nodes that map back to the Body of Knowledge and out to the tools and reading behind them. Mark what you have done; the path remembers."
  >
    <p slot="note">
      Before stage one, read <a href="/ai-governance">an overview of AI governance</a>: what it
      is and the frameworks it answers to.
    </p>
  </PageHero>

  <Section
    tone="tint"
    title="Three kinds of node, three states."
    lede="Each stage builds on the one above it. Nodes are marked as core, alternative or optional; you mark your own as done, learning or skipped."
  >
    <div class="reveal">
      <ul class="path-key">
        {
          legend.map((item) => (
            <li class="key-item">
              <span class="key-sample" data-sample={item.sample} aria-hidden="true">
                {item.sample === 'alternative' ? <span class="key-pill">Node</span> : 'Node'}
              </span>
              <span class="key-body">
                <span class="key-title">{item.title}</span>
                <span class="key-desc">{item.description}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section tone="plain" title="Four stages, from foundations to proof.">
    <PathMap stages={stages} nodes={nodes} edges={edges} entries={entries} />
  </Section>

  <Section
    tone="tint"
    id="by-audience"
    title="By audience."
    lede="Each route orders the chapters, patterns, templates and tools one job needs, and names the path nodes to start at."
  >
    <ul class="audience-list" aria-label="Routes by audience">
      {
        audiences.map((audience) => (
          <li class="audience-item">
            <a class="audience-link" href={audiencePath(audience)}>
              {audience.navLabel}
            </a>
            <span class="audience-summary">{audience.summary}</span>
          </li>
        ))
      }
    </ul>
    <p class="audience-aigp">
      Studying from the AIGP blueprint? The <a href="/for/aigp">AIGP coverage map</a> shows where
      the book teaches each indicator, with a study path per domain.
    </p>
  </Section>

  <CtaBand
    title="Own the role, not just the reading."
    sub="The path maps to chapter 06: the role in full, workflow by workflow, against the stack that carries it."
    primary={{ label: 'Read the role in full', href: '/bok/the-role' }}
    secondary={{ label: 'See the stack', href: '/stack' }}
  />

  <PathDrawer />

  <script is:inline defer src="/inert.js"></script>
  <script is:inline defer src="/path.js"></script>
</Marketing>

<style>
  /* By audience: a two-column list on tablets and up, one link per hub with
     its one-line summary under it. */
  .audience-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4) var(--s-6);
  }

  @media (min-width: 720px) {
    .audience-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .audience-item {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .audience-link {
    font-weight: 600;
    color: var(--ink);
    text-underline-offset: 0.15em;
  }

  .audience-summary {
    font-size: var(--fs-small);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .audience-aigp {
    margin: var(--s-5) 0 0;
    max-width: var(--prose);
    color: var(--ink-2);
  }

  .audience-aigp a {
    color: var(--ink);
  }

  /* The key in one row on wide screens (three kinds, then three states), two
     rows of three on tablets, a list on phones. Each sample repeats its node
     treatment from PathNode.astro, so the legend distinguishes by form. */
  .path-key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }

  .key-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--s-4);
  }

  @media (min-width: 640px) {
    .path-key {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-6) var(--s-5);
    }

    .key-item {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }
  }

  @media (min-width: 1100px) {
    .path-key {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .key-sample {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: start;
    width: 5.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-small);
    letter-spacing: var(--tracking-display);
  }

  .key-sample[data-sample='core'] {
    border-color: var(--ink);
  }

  .key-pill {
    padding: 1px var(--s-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }

  .key-sample[data-sample='optional'] {
    border: 1px dashed var(--ink-2);
  }

  /* Done and Learning are states, not layers (SL-06): the samples take the
     neutral treatment a transversal node gets in PathNode.astro: filled ink,
     and a dashed ink border over a 35% ink tint. */
  .key-sample[data-sample='done'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }

  .key-sample[data-sample='learning'] {
    border: 1px dashed var(--ink);
    background: color-mix(in srgb, var(--ink) 35%, var(--bg));
  }

  .key-sample[data-sample='skipped'] {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .key-body {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .key-title {
    font-weight: 600;
    line-height: 1.25;
  }

  .key-desc {
    font-size: var(--fs-small);
    color: var(--muted);
    text-wrap: pretty;
  }
</style>
