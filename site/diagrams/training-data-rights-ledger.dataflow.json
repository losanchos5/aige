  "cards": [
    {
      "dot": "cyan",
      "title": "The right to train, per source",
      "items": [
        "Acquisition channel, licence or legal basis, and the permitted uses",
        "For crawled content, the reservation check with its method and date",
        "Rows are written by the pipelines that acquire the data"
      ]
    },
    {
      "dot": "emerald",
      "title": "Joined to lineage",
      "items": [
        "Every training run records the ledger rows it read",
        "Backward lineage says what trained a model; forward lineage says which models used a source",
        "Training-content summaries are queries over the ledger"
      ]
    },
    {
      "dot": "amber",
      "title": "When rights change",
      "items": [
        "A withdrawal, an erasure request or an order marks the affected rows",
        "Only the models that read those rows are retrained or retired"
      ]
    }
