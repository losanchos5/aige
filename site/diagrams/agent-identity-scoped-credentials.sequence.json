    { "id": "entry", "from": "registry", "to": "issuer", "y": 240, "label": "owner, scope, expiry", "variant": "default" },
    { "id": "issue", "from": "issuer", "to": "agent", "y": 322, "label": "issue scoped credential", "variant": "emphasis" },
    { "id": "call", "from": "agent", "to": "tool", "y": 420, "label": "call with credential", "variant": "emphasis" },
    { "id": "verify", "from": "tool", "to": "agent", "y": 462, "label": "verify scope, respond", "variant": "return" },
