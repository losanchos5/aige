        "id": "register-and-issue",
        "label": "Register, then issue",
        "focus": ["pipeline", "registry", "issuer", "agent"],
        "note": "The deploy pipeline registers the agent, and the issuer mints a scoped credential from its registry entry."
      },
      {
        "id": "call-and-verify",
        "label": "Call and verify scope",
        "focus": ["agent", "tool"],
        "note": "The agent calls the downstream tool with the credential, whose scope is verified on each call."
      },
      {
        "id": "attribute-and-expire",
        "label": "Attribute and expire",
        "focus": ["agent", "audit", "registry"],
        "note": "Every call is logged under the agent's identity, and the credential expires with the registry entry."
      }
    ]
  },
  "participants": [
