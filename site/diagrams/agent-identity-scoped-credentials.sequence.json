    { "id": "agent", "type": "external", "label": "Agent", "sublabel": "scoped credential" },
    { "id": "tool", "type": "external", "label": "Downstream tool", "sublabel": "channel auth" },
    { "id": "audit", "type": "database", "label": "Audit log", "sublabel": "signed per identity" }
  ],
  "segments": [
