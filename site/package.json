{
  "name": "aige-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/diagrams-build.mjs",
    "diagrams:fetch": "node scripts/archify-fetch.mjs",
    "diagrams:build": "node scripts/diagrams-build.mjs",
    "prebuild": "node scripts/diagrams-build.mjs",
    "build": "astro check && astro build && npm run lint:content && npm run check:links",
    "postbuild": "pagefind --site dist",
    "lint:content": "node scripts/content-lint.mjs",
    "check:links": "node scripts/check-links.mjs",
    "preview": "astro preview",
    "test": "playwright test --project=default",
    "test:visual": "playwright test --project=visual",
    "test:a11y": "playwright test --project=a11y",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^5.18.2",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "satori": "^0.33.4",
    "typescript": "^5.9.2",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@fontsource-variable/bricolage-grotesque": "^5.2.7",
    "@fontsource-variable/instrument-sans": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "hast-util-from-html": "^2.0.3",
    "pagefind": "^1.4.0"
  }
}
