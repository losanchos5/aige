# pc-eval-score-gate_test.rego: unit tests of pc-eval-score-gate.rego.
# Run: opa test policies/pc-eval-score-gate.rego policies/pc-eval-score-gate_test.rego -v
# Generated by the Policy Card builder, https://aigovernanceengineer.com/toolkit/policy-card
# Illustrative, review before use. Add the cases your own inputs need.
package aige.cards.pc_eval_score_gate_test

import rego.v1

import data.aige.cards.pc_eval_score_gate

test_score_at_the_minimum_is_allowed if {
	pc_eval_score_gate.decision == "allow" with input as {
		"action": "deploy",
		"system": {
			"id": "credit-afford",
			"version": "3.2.0"
		},
		"eval_results": [
			{
				"suite_id": "safety-core",
				"model_version": "credit-afford@3.2.0",
				"score": 0.9,
				"threshold": 0.9,
				"result": "pass",
				"timestamp": "2026-09-30T10:00:00Z"
			}
		]
	}
}

test_score_below_the_minimum_is_denied if {
	pc_eval_score_gate.decision == "deny" with input as {
		"action": "deploy",
		"system": {
			"id": "credit-afford",
			"version": "3.2.0"
		},
		"eval_results": [
			{
				"suite_id": "safety-core",
				"model_version": "credit-afford@3.2.0",
				"score": 0.89,
				"threshold": 0.9,
				"result": "fail",
				"timestamp": "2026-09-30T10:00:00Z"
			}
		]
	}
}

test_missing_result_is_denied if {
	pc_eval_score_gate.decision == "deny" with input as {
		"action": "deploy",
		"system": {
			"id": "credit-afford",
			"version": "3.2.0"
		},
		"eval_results": []
	}
}

test_result_for_another_version_is_denied if {
	pc_eval_score_gate.decision == "deny" with input as {
		"action": "deploy",
		"system": {
			"id": "credit-afford",
			"version": "3.2.0"
		},
		"eval_results": [
			{
				"suite_id": "safety-core",
				"model_version": "credit-afford@3.1.0",
				"score": 0.9,
				"threshold": 0.9,
				"result": "pass",
				"timestamp": "2026-09-30T10:00:00Z"
			}
		]
	}
}

test_merge_is_gated_too if {
	pc_eval_score_gate.decision == "deny" with input as {
		"action": "merge",
		"system": {
			"id": "credit-afford",
			"version": "3.2.0"
		},
		"eval_results": [
			{
				"suite_id": "safety-core",
				"model_version": "credit-afford@3.2.0",
				"score": 0.89,
				"threshold": 0.9,
				"result": "fail",
				"timestamp": "2026-09-30T10:00:00Z"
			}
		]
	}
}

test_verdict_carries_the_rule_id if {
	v := pc_eval_score_gate.verdict with input as {
		"action": "deploy",
		"system": {
			"id": "credit-afford",
			"version": "3.2.0"
		},
		"eval_results": [
			{
				"suite_id": "safety-core",
				"model_version": "credit-afford@3.2.0",
				"score": 0.9,
				"threshold": 0.9,
				"result": "pass",
				"timestamp": "2026-09-30T10:00:00Z"
			}
		]
	}
	v.rule_id == "evals.min-score.v1"
	v.decision == "allow"
	startswith(v.input_hash, "sha256:")
}

test_compliant_input_does_not_block_ci if {
	not pc_eval_score_gate.blocks with input as {
		"action": "deploy",
		"system": {
			"id": "credit-afford",
			"version": "3.2.0"
		},
		"eval_results": [
			{
				"suite_id": "safety-core",
				"model_version": "credit-afford@3.2.0",
				"score": 0.9,
				"threshold": 0.9,
				"result": "pass",
				"timestamp": "2026-09-30T10:00:00Z"
			}
		]
	}
}

test_denied_input_blocks_ci if {
	pc_eval_score_gate.blocks with input as {
		"action": "deploy",
		"system": {
			"id": "credit-afford",
			"version": "3.2.0"
		},
		"eval_results": [
			{
				"suite_id": "safety-core",
				"model_version": "credit-afford@3.2.0",
				"score": 0.89,
				"threshold": 0.9,
				"result": "fail",
				"timestamp": "2026-09-30T10:00:00Z"
			}
		]
	}
}
