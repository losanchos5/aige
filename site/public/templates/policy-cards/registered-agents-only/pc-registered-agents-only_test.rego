test_verdict_carries_the_rule_id if {
	v := pc_registered_agents_only.verdict with input as {
		"action": "deploy",
		"environment": "production",
		"now": "2026-10-02",
		"agent": {
			"id": "csa-01",
			"version": "2026-09-22"
		},
		"registry": [
			{
				"id": "csa-01",
				"version": "2026-09-22",
				"owner": "customer-service",
				"scope": [
					"refunds"
				],
				"expiry": "2027-03-31",
				"status": "active"
			}
		]
	}
	v.rule_id == "agents.registered-only.v1"
	v.decision == "allow"
	startswith(v.input_hash, "sha256:")
}

test_compliant_input_does_not_block_ci if {
	not pc_registered_agents_only.blocks with input as {
		"action": "deploy",
		"environment": "production",
