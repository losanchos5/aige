package aige.cards.pc_registered_agents_only_test

import rego.v1

import data.aige.cards.pc_registered_agents_only

test_registered_active_agent_is_allowed if {
	pc_registered_agents_only.decision == "allow" with input as {
		"action": "deploy",
		"environment": "production",
		"now": "2026-10-02",
		"agent": {
			"id": "csa-01",
			"version": "2026-09-22"
		},
		"registry": [
			{
				"id": "csa-01",
				"version": "2026-09-22",
				"owner": "customer-service",
				"scope": [
					"refunds"
				],
				"expiry": "2027-03-31",
				"status": "active"
			}
		]
	}
}

test_unregistered_agent_is_denied if {
	pc_registered_agents_only.decision == "deny" with input as {
