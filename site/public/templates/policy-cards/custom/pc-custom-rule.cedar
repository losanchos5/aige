// pc-custom-rule.cedar: a Cedar stub of Policy Card pc-custom-rule version 1.0.0, rule
// custom.rule.v1.
// Generated by the Policy Card builder, https://aigovernanceengineer.com/toolkit/policy-card
// Illustrative, review before use. Indicative, not legal advice and not a conformity claim.
// Cedar decides permit or deny. The @effect annotation tells the caller how to act on a deny
// from this policy: deny blocks; require_approval routes the action to a person; alert logs it
// and lets it through. Cedar skips a policy whose condition errors (for example on a wrong
// type), so validate requests against a Cedar schema before relying on it.
// Test: cedar run-tests --policies policies/pc-custom-rule.cedar --tests
// policies/pc-custom-rule.cedartests.json
//
// Request: principal Caller::"<caller>", action Action::"<action>", resource
// Resource::"<resource>"; the context carries the fields the tests show.

// Baseline for testing this card on its own: permit what the card does not forbid. In a real
// policy set, drop it and keep the system's own permits.
@id("pc-custom-rule.baseline")
permit (principal, action, resource);

@id("custom.rule.v1")
@effect("deny")
forbid (
	principal,
	action == Action::"deploy",
	resource
)
when {
	context has system &&
	context.system has risk_tier &&
	context.system.risk_tier == "prohibited"
};
