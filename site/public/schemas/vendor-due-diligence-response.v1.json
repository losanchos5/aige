{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigovernanceengineer.com/schemas/vendor-due-diligence-response.v1.json",
  "title": "Vendor due-diligence response",
  "description": "A supplier's answers to the AI due-diligence questionnaire for one product, keyed to the obligations they help the buyer evidence, plus the buyer's assessment and reassessment date.",
  "$comment": "AI Governance Engineer templates and schemas library, v1. CC BY 4.0 (attribution: Jorge García Aibar). x-evidences names the obligations a field or record helps evidence: an illustrative mapping, not a claim of conformity and not legal advice. https://aigovernanceengineer.com/resources/templates",
  "x-evidences": [
    "EU AI Act Art. 25",
    "EU AI Act Art. 26",
    "EU AI Act Art. 53(1)(b)",
    "GDPR Art. 28",
    "ISO/IEC 42001 A.10",
    "NIST AI RMF GOVERN 6.1",
    "NIST AI RMF MANAGE 3.1"
  ],
  "x-layer": [
    2,
    5
  ],
  "x-pattern": [
    "https://aigovernanceengineer.com/bok/patterns#pattern-vendor--model-due-diligence-gate"
  ],
  "x-lifecycle-stage": "intake",
  "type": "object",
  "required": [
    "response_id",
    "vendor",
    "product",
    "received_at",
    "answers",
    "assessment"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://aigovernanceengineer.com/schemas/vendor-due-diligence-response.v1.json",
      "description": "The URI of this schema, so a record says what it claims to be."
    },
    "response_id": {
      "type": "string",
      "description": "Identifier of the response.",
      "minLength": 1
    },
    "questionnaire_version": {
      "type": "string",
      "description": "Version of the questionnaire answered."
    },
    "vendor": {
      "type": "object",
      "description": "The supplier.",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Supplier name.",
          "minLength": 1
        },
        "contact": {
          "type": "string",
          "description": "Contact mailbox or portal."
        }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "description": "The product assessed.",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Product name.",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "description": "Version assessed."
        },
        "model_ids": {
          "type": "array",
          "description": "Models inside the product.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "requested_by": {
      "type": "string",
      "description": "Buying team.",
      "minLength": 1
    },
    "received_at": {
      "type": "string",
      "format": "date",
      "description": "When the answers arrived."
    },
    "answers": {
      "type": "object",
      "description": "The supplier's answers.",
      "required": [
        "provider_role",
        "training_on_customer_data",
        "incident_notification"
      ],
      "properties": {
        "provider_role": {
          "type": "string",
          "enum": [
            "provider",
            "gpai_provider",
            "component_supplier",
            "reseller",
            "other"
          ],
          "description": "The supplier's role under the EU AI Act.",
          "x-evidences": [
            "EU AI Act Art. 25"
          ]
        },
        "eu_ai_act_category": {
          "type": "string",
          "enum": [
            "not_assessed",
            "out_of_scope",
            "minimal",
            "transparency",
            "high_risk_annex_i",
            "high_risk_annex_iii",
            "gpai",
            "gpai_systemic_risk",
            "prohibited"
          ],
          "description": "The supplier's own classification."
        },
        "documentation": {
          "type": "object",
          "description": "Documentation supplied.",
          "properties": {
            "model_card": {
              "type": "string",
              "format": "uri",
              "description": "Model or system card."
            },
            "instructions_for_use": {
              "type": "string",
              "format": "uri",
              "description": "Instructions for use, for high-risk systems."
            },
            "downstream_information": {
              "type": "string",
              "format": "uri",
              "description": "Information for downstream providers, for GPAI models."
            }
          },
          "additionalProperties": false,
          "x-evidences": [
            "EU AI Act Art. 13",
            "EU AI Act Art. 53(1)(b)"
          ]
        },
        "training_on_customer_data": {
          "type": "object",
          "description": "Use of customer data for training.",
          "required": [
            "used"
          ],
          "properties": {
            "used": {
              "type": "boolean",
              "description": "Whether customer inputs or outputs train the supplier's models."
            },
            "opt_out": {
              "type": "boolean",
              "description": "Whether the customer can opt out."
            },
            "contract_clause": {
              "type": "string",
              "description": "Clause reference."
            }
          },
          "additionalProperties": false,
          "x-evidences": [
            "GDPR Art. 28(3)(a)"
          ]
        },
        "data_processing": {
          "type": "object",
          "description": "Data processing.",
          "properties": {
            "locations": {
              "type": "array",
              "description": "Where data is processed and stored.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "retention": {
              "type": "string",
              "description": "How long prompts, outputs and logs are kept."
            },
            "subprocessors": {
              "type": "array",
              "description": "Sub-processors.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false,
          "x-evidences": [
            "GDPR Art. 28(2)",
            "GDPR Art. 28(3)"
          ]
        },
        "security": {
          "type": "object",
          "description": "Security posture.",
          "properties": {
            "certifications": {
              "type": "array",
              "description": "Certifications held (for example ISO/IEC 27001, ISO/IEC 42001).",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "last_penetration_test": {
              "type": "string",
              "format": "date",
              "description": "Date of the last independent test."
            }
          },
          "additionalProperties": false
        },
        "evaluations": {
          "type": "array",
          "description": "Evaluations and red-team results the supplier shares.",
          "items": {
            "type": "object",
            "description": "One evaluation.",
            "required": [
              "suite",
              "summary"
            ],
            "properties": {
              "suite": {
                "type": "string",
                "description": "What was evaluated.",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "description": "Result in a sentence.",
                "minLength": 1
              },
              "report": {
                "type": "string",
                "format": "uri",
                "description": "Report."
              }
            },
            "additionalProperties": false
          },
          "x-evidences": [
            "EU AI Act Art. 15"
          ]
        },
        "incident_notification": {
          "type": "object",
          "description": "Incident notice to the customer.",
          "required": [
            "window_hours"
          ],
          "properties": {
            "window_hours": {
              "type": "integer",
              "description": "Hours within which the supplier notifies the customer of an incident.",
              "minimum": 0
            },
            "channel": {
              "type": "string",
              "description": "How."
            }
          },
          "additionalProperties": false,
          "x-evidences": [
            "ISO/IEC 42001 A.10",
            "EU AI Act Art. 26(5)"
          ]
        },
        "change_notification": {
          "type": "object",
          "description": "Change notice.",
          "required": [
            "notice_days"
          ],
          "properties": {
            "notice_days": {
              "type": "integer",
              "description": "Days of notice before a material change, including model updates.",
              "minimum": 0
            },
            "covers_model_updates": {
              "type": "boolean",
              "description": "Whether model version changes are notified."
            }
          },
          "additionalProperties": false
        },
        "audit_rights": {
          "type": "boolean",
          "description": "Whether the customer may audit or receive audit reports.",
          "x-evidences": [
            "GDPR Art. 28(3)(h)"
          ]
        },
        "logging_support": {
          "type": "string",
          "description": "What logs the customer receives or can export, and for how long.",
          "x-evidences": [
            "EU AI Act Art. 12",
            "EU AI Act Art. 26(6)"
          ]
        },
        "copyright_policy": {
          "type": "string",
          "format": "uri",
          "description": "For GPAI models: the copyright compliance policy.",
          "x-evidences": [
            "EU AI Act Art. 53(1)(c)"
          ]
        },
        "training_content_summary": {
          "type": "string",
          "format": "uri",
          "description": "For GPAI models: the public summary of training content.",
          "x-evidences": [
            "EU AI Act Art. 53(1)(d)"
          ]
        },
        "aibom": {
          "type": "string",
          "format": "uri",
          "description": "AIBOM for the product, if supplied."
        },
        "exit": {
          "type": "object",
          "description": "Exit terms.",
          "properties": {
            "data_return_days": {
              "type": "integer",
              "description": "Days to return customer data at exit.",
              "minimum": 0
            },
            "deletion_certificate": {
              "type": "boolean",
              "description": "Whether deletion is certified."
            }
          },
          "additionalProperties": false,
          "x-evidences": [
            "GDPR Art. 28(3)(g)"
          ]
        }
      },
      "additionalProperties": false
    },
    "open_questions": {
      "type": "array",
      "description": "Questions the supplier did not answer or answered unclearly. Unverifiable answers are recorded, not assumed.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment": {
      "type": "object",
      "description": "The buyer's assessment.",
      "required": [
        "risk_tier",
        "decision",
        "reviewer",
        "reviewed_at",
        "reassess_by"
      ],
      "properties": {
        "risk_tier": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Supplier risk tier (criticality, data sensitivity, autonomy, regulatory context)."
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "approve_with_conditions",
            "reject"
          ],
          "description": "Decision."
        },
        "conditions": {
          "type": "array",
          "description": "Conditions, typically contract clauses or technical controls.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewer": {
          "type": "string",
          "description": "Reviewing role.",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date",
          "description": "When."
        },
        "reassess_by": {
          "type": "string",
          "format": "date",
          "description": "Reassessment date; also on renewal or material change."
        }
      },
      "additionalProperties": false,
      "x-evidences": [
        "NIST AI RMF GOVERN 6.1",
        "NIST AI RMF MANAGE 3.1",
        "ISO/IEC 42001 A.10"
      ]
    },
    "extensions": {
      "type": "object",
      "description": "Organisation-specific fields. Validators ignore their content; keep evidence-bearing fields in the core record."
    }
  },
  "additionalProperties": false
}
