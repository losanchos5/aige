# Dependencies
node_modules

# Build output
dist
.astro
.astro-cache
site/dist

# Diagram pipeline (generated by scripts/diagrams-build.mjs; see site/README.md)
site/.archify
site/public/diagrams
site/src/generated

# Figure exports (generated by scripts/figures-build.mjs at every build: SVG and
# PNG downloads under /downloads/figures, plus the render and font cache)
site/public/downloads/figures
site/.figures-cache

# Python
build/__pycache__
*.pyc

# OS
.DS_Store
Thumbs.db

# Env
.env*

# Test artifacts
test-results
playwright-report

# Lighthouse CI reports
.lighthouseci
site/.lighthouseci

# HyperFrames video projects (source is versioned; heavy artefacts are not)

# Claude Code agent worktrees
.claude/worktrees/

# Local launch drafts and operational planning (not public site content)
.local-growth/
site/.impeccable

# Source material dropped in the repo root is never published
/*.pdf
/*.epub

# Local build log written by the parallel-worktree build gate
.build.log
